  {
   "cell_type": "markdown",
   "id": "31724c1a",
   "metadata": {},
   "source": [
    "### OSCE"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5b468296",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Config ────────────────────────────────────────────────────────────────────\n",
    "useAll         = True\n",
    "replaceExisting = True\n",
    "includeCohorts = [\"BOH1\"]\n",
    "excludeCohorts = []\n",
    "year           = 2026\n",
    "type_          = \"osce\"\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "cohortList  = buildCohortList(useAll, allCohorts, includeCohorts, excludeCohorts)   # reuses the function already defined above\n",
    "cohortText  = \",\".join(cohortList)\n",
    "\n",
    "def mainOsce():\n",
    "    apiUrl = (f\"https://api.unimelb-dash.com/assessment/{type_}/get?page_size=max&page=1&cohort={cohortText}&year={year}&ordering=id\")\n",
    "    print(apiUrl)\n",
    "    if not bearerToken:\n",
    "        raise RuntimeError(\"Set DASH_TOKEN environment variable to your Bearer token\")\n",
    "\n",
    "    records = fetchAllAssessments(apiUrl, bearerToken)\n",
    "\n",
    "    with open(f\"temp {year} {type_}.json\", \"w\", encoding=\"utf-8\") as f:\n",
    "        json.dump(records, f, ensure_ascii=False, indent=2)\n",
    "    print(f\"Fetched {len(records)} OSCE records from API.\")\n",
    "\n",
    "    rows = toRowsOsce(records)\n",
    "    print(f\"Prepared {len(rows)} rows for insertion.\")\n",
    "    deletedRows = [r for r in rows if (r[\"student_name\"] or \"\").lower() in excludeNames]\n",
    "    print(f\"Rows to be deleted post-insert: {len(deletedRows)}\")\n",
    "    for r in deletedRows:\n",
    "        print(r[\"student_name\"], r[\"assessmentId\"])\n",
    "\n",
    "    # print details of duplicates\n",
    "    idCounts = Counter(r[\"assessmentId\"] for r in rows)\n",
    "    dupes = {aid: cnt for aid, cnt in idCounts.items() if cnt > 1}\n",
    "    print(\"Duplicate assessmentIds:\", dupes)\n",
    "    for aid in dupes:\n",
    "        print(f\"Duplicate assessmentId: {aid}\")\n",
    "        for r in rows:\n",
    "            if r[\"assessmentId\"] == aid:\n",
    "                print(\"  \", r[\"student_name\"], r[\"datetimeUtc\"], r[\"cohort\"], r[\"assessor_name\"])\n",
    "\n",
    "    # insert into DB\n",
    "    insertSql = getOsceInsertSql(replaceExisting)\n",
    "    insertOsceRows(engine, rows, insertSql)\n",
    "    # with engine.begin() as conn:\n",
    "    #     runDdl(conn, getDeleteSql(f\"{OSCE_NAME}\"))\n",
    "    print(\"Done.\")\n",
    "\n",
    "mainOsce()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f69717f9",
   "metadata": {},
   "outputs": [],
   "source": [
    "from osce_pdfs import (\n",
    "    computeCohortStats, buildPdf,\n",
    "    DEFAULT_STATION_SCALES, DEFAULT_STATION_MC_COLS,\n",
    ")\n",
    "\n",
    "# ── Config ────────────────────────────────────────────────────────────────────\n",
    "COHORT            = \"BOH1\"\n",
    "YEAR              = 2026\n",
    "COURSE_CODE       = \"ORAL10005\"\n",
    "DATA_FILE         = f\"temp {YEAR} osce.json\"\n",
    "OUT_DIR           = f\"OSCE/{COHORT}/Student Reports\"\n",
    "\n",
    "# Assessors to exclude from cohort stats and PDF generation\n",
    "EXCLUDE_ASSESSORS = {\"Suhrid Gupta\"}   # set() to exclude none\n",
    "\n",
    "# Student names (lowercase) to skip during generation\n",
    "SKIP_STUDENTS     = {\"model 1\", \"model 2\"}\n",
    "\n",
    "# Override these dicts if station structure differs for the cohort:\n",
    "#   STATION_MC_COLS = {1: [\"MC1\",...], 2: [...], 3: [...]}\n",
    "#   STATION_SCALES  = {1: [\"scale-global-rating\",...], ...}\n",
    "STATION_MC_COLS   = DEFAULT_STATION_MC_COLS\n",
    "STATION_SCALES    = DEFAULT_STATION_SCALES\n",
    "# ──────────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "with open(DATA_FILE, encoding=\"utf-8\") as f:\n",
    "    raw = json.load(f)\n",
    "\n",
    "data = [\n",
    "    r for r in raw\n",
    "    if r.get(\"submitted\") and r.get(\"assessor\") not in EXCLUDE_ASSESSORS\n",
    "]\n",
    "print(f\"{len(data)} submitted records loaded ({len(raw) - len(data)} excluded)\")\n",
    "\n",
    "cohort_scale_avgs, cohort_mc_avgs, ck_fields, sc_fields, by_student = \\\n",
    "    computeCohortStats(data, station_mc_cols=STATION_MC_COLS)\n",
    "\n",
    "os.makedirs(OUT_DIR, exist_ok=True)\n",
    "\n",
    "generated = 0\n",
    "for student, st_data in sorted(by_student.items()):\n",
    "    if student.lower() in SKIP_STUDENTS:\n",
    "        continue\n",
    "    buildPdf(\n",
    "        student, st_data, OUT_DIR,\n",
    "        cohort_scale_avgs, cohort_mc_avgs, ck_fields, sc_fields,\n",
    "        station_mc_cols=STATION_MC_COLS,\n",
    "        station_scales=STATION_SCALES,\n",
    "        year=YEAR,\n",
    "        course_code=COURSE_CODE,\n",
    "    )\n",
    "    generated += 1\n",
    "\n",
    "print(f\"Done — {generated} PDFs written to {OUT_DIR}\")\n"
   ]
