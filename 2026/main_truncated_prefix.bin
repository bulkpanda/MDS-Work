    "# if for item code there are values like 2026-Week-1 turn to 2026-Week-01 etc. making sure week number is always 2 digits for consistency\n",
    "def createDateReport(date):\n",
    "    dataDf = readDf(engine, getWeeklySimDataSqlDDS2(date))\n",
    "    dataDf[ITEM_CODE_COL] = dataDf[ITEM_CODE_COL].apply(standardizeWeekFormat)\n",
    "    itables.show(dataDf, pageLength = 5)\n",
    "    # Expand JSON into columns\n",
    "    mcDf = pd.json_normalize(dataDf[\"mc_json\"])\n",
    "\n",
    "    # Convert O-values to numeric\n",
    "    mcDf = mcDf.replace(scoreMap)\n",
    "\n",
    "    # Ensure numeric dtype\n",
    "    mcDf = mcDf.apply(pd.to_numeric, errors=\"coerce\")\n",
    "\n",
    "    # Merge back\n",
    "    dataDf = pd.concat([dataDf.drop(columns=[\"mc_json\"]), mcDf], axis=1)\n",
    "    # dataDf.drop(columns = \"mc_json\", inplace=True)\n",
    "    print(f\"Data rows: {len(dataDf)}\")\n",
    "    itables.show(dataDf, pageLength = 5)\n",
    "\n",
    "    dataDf.to_excel(f\"{folder}/dds2 {date} assessment_data.xlsx\", index=False)\n",
    "    # autofit columns in the saved excel file\n",
    "    with pd.ExcelWriter(f\"{folder}/dds2 {date} assessment_data.xlsx\", engine='openpyxl', mode='a', if_sheet_exists='overlay') as writer:\n",
    "        ws = writer.sheets['Sheet1']\n",
    "        autoFitColumns(ws)\n",
    "        \n",
    "    addAssessmentChartsDDS2(f\"{folder}/dds2 {date} assessment_data.xlsx\", sheet1Name='Sheet1', chartSheetName='Charts', blrFilter=\"BLR\")\n",
    "\n",
