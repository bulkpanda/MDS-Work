  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fd3a74b5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── SCBD Excel Report ─────────────────────────────────────────────────────────\n",
    "\n",
    "scbdSql = \"\"\"\n",
    "SELECT\n",
    "    s.assessmentid,\n",
    "    s.datetimeutc::date                                                  AS date,\n",
    "    s.student_name,\n",
    "    s.assessor_name,\n",
    "    s.cohort,\n",
    "    s.subject,\n",
    "    s.checklist_key,\n",
    "\n",
    "    -- MC labels (raw strings e.g. \"Good (3)\")\n",
    "    s.checklist_data->>'MC1'  AS mc1_label,\n",
    "    s.checklist_data->>'MC2'  AS mc2_label,\n",
    "    s.checklist_data->>'MC3'  AS mc3_label,\n",
    "    s.checklist_data->>'MC4'  AS mc4_label,\n",
    "\n",
    "    -- MC numeric scores extracted from the \"(N)\" suffix\n",
    "    substring(s.checklist_data->>'MC1' FROM '\\((\\d+)\\)')::int  AS mc1,\n",
    "    substring(s.checklist_data->>'MC2' FROM '\\((\\d+)\\)')::int  AS mc2,\n",
    "    substring(s.checklist_data->>'MC3' FROM '\\((\\d+)\\)')::int  AS mc3,\n",
    "    substring(s.checklist_data->>'MC4' FROM '\\((\\d+)\\)')::int  AS mc4,\n",
    "\n",
    "    s.global_rating                                                      AS gr,\n",
    "    s.form->'scales'->'scale-global-rating'->'fields'\n",
    "        ->> s.global_rating::text                                        AS gr_label,\n",
    "\n",
    "    s.assessor_comments\n",
    "FROM scbd s\n",
    "WHERE s.datetimeutc >= '2026-01-01'\n",
    "  AND s.submitted = true\n",
    "ORDER BY s.cohort, s.student_name, s.datetimeutc\n",
    "\"\"\"\n",
    "\n",
    "df = readDf(engine, scbdSql)\n",
    "\n",
    "# ── Derived columns ───────────────────────────────────────────────────────────\n",
    "mcCols = [\"mc1\", \"mc2\", \"mc3\", \"mc4\"]\n",
    "df[\"avg_mc\"]  = df[mcCols].mean(axis=1).round(2)   # 0–4\n",
    "df[\"avg_pct\"] = (df[\"avg_mc\"] / 4 * 100).round(1)  # 0–100 %\n",
    "\n",
    "# ── Summary per student ───────────────────────────────────────────────────────\n",
    "summaryDf = (\n",
    "    df.groupby([\"cohort\", \"student_name\"], sort=True)\n",
    "    .agg(\n",
    "        n          = (\"assessmentid\", \"count\"),\n",
    "        mc1_mean   = (\"mc1\",      \"mean\"),\n",
    "        mc2_mean   = (\"mc2\",      \"mean\"),\n",
    "        mc3_mean   = (\"mc3\",      \"mean\"),\n",
    "        mc4_mean   = (\"mc4\",      \"mean\"),\n",
    "        avg_mc_mean = (\"avg_mc\",  \"mean\"),\n",
    "        avg_pct_mean= (\"avg_pct\", \"mean\"),\n",
    "        gr_mean    = (\"gr\",       \"mean\"),\n",
    "    )\n",
    "    .round(2)\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "# ── Column ordering for the raw sheet ────────────────────────────────────────\n",
    "rawCols = [\n",
    "    \"date\", \"cohort\", \"student_name\", \"assessor_name\", \"subject\", \"checklist_key\",\n",
    "    \"mc1_label\", \"mc2_label\", \"mc3_label\", \"mc4_label\",\n",
    "    \"mc1\", \"mc2\", \"mc3\", \"mc4\",\n",
    "    \"avg_mc\", \"avg_pct\",\n",
    "    \"gr\", \"gr_label\",\n",
    "    \"assessor_comments\",\n",
    "    \"assessmentid\",\n",
    "]\n",
    "rawDf = df[rawCols].copy()\n",
    "\n",
    "# ── GR colour map (fill hex, no leading #) ───────────────────────────────────\n",
    "grFills = {\n",
    "    1: \"FFC7CE\",   # Fail          – red\n",
    "    2: \"FFEB9C\",   # Borderline    – amber\n",
    "    3: \"C6EFCE\",   # Pass          – green\n",
    "    4: \"9DC3E6\",   # Very Good     – blue\n",
    "    5: \"D9D9D9\",   # Excellent     – grey (or swap for gold if preferred)\n",
    "}\n",
    "\n",
    "def styleSheet(ws, grColName=\"gr\"):\n",
    "\n",
    "    headerFill = PatternFill(\"solid\", start_color=HEADER_COLOR, end_color=HEADER_COLOR)\n",
    "    headerFont = Font(bold=True, color=HEADER_FONT, name=\"Arial\", size=10)\n",
    "    bodyFont   = Font(name=\"Arial\", size=10)\n",
    "    centerAlign = Alignment(horizontal=\"center\", vertical=\"top\", wrap_text=False)\n",
    "    leftAlign   = Alignment(horizontal=\"left\",   vertical=\"top\", wrap_text=True)\n",
    "\n",
    "    headers = {cell.value: cell.column for cell in ws[1]}\n",
    "\n",
    "    # Header row\n",
    "    for cell in ws[1]:\n",
    "        cell.fill = headerFill\n",
    "        cell.font = headerFont\n",
    "        cell.alignment = centerAlign\n",
    "\n",
    "    # Body\n",
    "    grIdx = headers.get(grColName)\n",
    "    for row in ws.iter_rows(min_row=2):\n",
    "        for cell in row:\n",
    "            cell.font = bodyFont\n",
    "            # GR column: colour by value\n",
    "            if grIdx and cell.column == grIdx and cell.value in grFills:\n",
    "                cell.fill = PatternFill(\"solid\",\n",
    "                                        start_color=grFills[cell.value],\n",
    "                                        end_color=grFills[cell.value])\n",
    "                cell.alignment = centerAlign\n",
    "            else:\n",
    "                cell.alignment = leftAlign\n",
    "\n",
    "    autoFitColumns(ws, minWidth=8, maxWidth=50)\n",
    "    # Widen the comments column\n",
    "    commentsCol = headers.get(\"assessor_comments\")\n",
    "    if commentsCol:\n",
    "        ws.column_dimensions[get_column_letter(commentsCol)].width = 55\n",
    "        for row in ws.iter_rows(min_row=2, min_col=commentsCol, max_col=commentsCol):\n",
    "            row[0].alignment = Alignment(horizontal=\"left\", vertical=\"top\", wrap_text=True)\n",
    "\n",
    "# ── Write workbook ────────────────────────────────────────────────────────────\n",
    "scbdPath = f\"SCBD/SCBD_Report_{today}.xlsx\"\n",
    "os.makedirs(\"SCBD\", exist_ok=True)\n",
    "\n",
    "with pd.ExcelWriter(scbdPath, **getmodeArgs(scbdPath)) as writer:\n",
    "    rawDf.to_excel(writer,     sheet_name=\"Raw Data\",        index=False)\n",
    "    summaryDf.to_excel(writer, sheet_name=\"Student Summary\", index=False)\n",
    "\n",
    "    wb = writer.book\n",
    "    styleSheet(wb[\"Raw Data\"],        grColName=\"gr\")\n",
    "    styleSheet(wb[\"Student Summary\"], grColName=\"gr_mean\")\n",
    "\n",
    "print(f\"Written: {scbdPath}  ({len(rawDf)} rows, {summaryDf['student_name'].nunique()} students)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "28370712",
   "metadata": {},
   "source": [
    "### SCBD — June Data report\n",
    "\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b6df0509",
   "metadata": {},
   "source": [
    "Newer SCBD checklists (`DDS3-10-JUN`) don't embed the score in the label like the legacy report above (`\"Good (3)\"`). Instead each MC item's real number of levels is defined per-item in `form.checklists.<checklist_key>.extra_config.rubric` — only the non-blank `O1..O5` slots are valid for that item (2, 3, 4 or 5 levels). This section:\n",
    "\n",
    "1. Maps the assessor's recorded answer (`\"Done\"`, `\"Mostly done\"`, ...) to its `O`-letter via `form.checklists.<checklist_key>.extra_config.options.assessor`.\n",
    "2. Finds which `O1..O5` slots are non-blank for that specific MC in `extra_config.rubric` → that count is `n`.\n",
    "3. Scores the item as a raw rank `0..(n-1)` based on where its O-letter ranks among the active levels — this raw integer (not a percentage) is what's written to the `MCn (/d)` column, where `d = n-1` for that item.\n",
    "4. Separately normalizes that rank to `0–1` so items with different numbers of levels can still be averaged fairly → overall %, plus a per-domain % using the `extra_config.headers` section groupings (Clinical Info Gathering / Diagnosis & Prognosis / Treatment Planning / Presentation). Checklists with no `headers` config (the 4-item AM/PM checklists) roll up under \"Other\".\n",
    "\n",
    "**Note:** `options`, `rubric` and `headers` all live *inside* `extra_config` — confirmed against the live data (not as siblings of it, which the original sample looked like but wasn't).\n",
    "\n",
    "**Raw Data sheet columns:** identity columns, then one `MCn (/d)` column per checklist item holding the assessor's raw score (an integer from 0 to `d`, not a percentage) — `d` is the largest rubric max seen for that MC index across all checklist_keys in the run, since different checklists (e.g. the 4-item AM/PM ones vs. the main one) can define a different number of levels for the same MC index; if a given row's own rubric had a smaller max than its column's `d`, that mismatch is noted in `Flags` — then one `D# <domain> %` column per section (still a normalized percentage, since each domain mixes items with different level counts), then `Overall %`, GR, comments and metadata.\n",
    "\n",
    "**Other sheets:** `Student Summary` (per-student averages, overall + per-domain %), `Item Detail` (long format, one row per item per assessment, with both a raw `MC Score` and its `Max Score` for that specific row), `Checklist Legend` (MC key → domain → question text, deduplicated per checklist_key — explains what each `MCn (/d)` column actually measures).\n",
    "\n",
    "Rows whose `checklist_key` has no rubric config are left unscored here and flagged, not crashed."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e1705c5e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── SCBD Rubric-Based Scoring (handles per-item variable level counts) ───────\n",
    "# Relies on styleSheet / grFills / HEADER_COLOR / HEADER_FONT / autoFitColumns\n",
    "# already defined in the legacy \"SCBD Excel Report\" cell above — run that cell first.\n",
    "\n",
    "def parseJsonCol(value):\n",
    "    \"\"\"scbd.checklist_data / scbd.form come back as dict via psycopg jsonb, but\n",
    "    handle the str case defensively too.\"\"\"\n",
    "    if value is None:\n",
    "        return {}\n",
    "    if isinstance(value, str):\n",
    "        try:\n",
    "            return json.loads(value)\n",
    "        except (TypeError, ValueError):\n",
    "            return {}\n",
    "    return value\n",
    "\n",
    "def neatDomainLabel(title):\n",
    "    \"\"\"'1. Clinical Information Gathering' -> 'D1 Clinical Information Gathering'.\"\"\"\n",
    "    m = re.match(r'^(\\d+)\\.\\s*(.+)$', str(title))\n",
    "    if m:\n",
    "        return f\"D{m.group(1)} {m.group(2).strip().title()}\"\n",
    "    return str(title)\n",
    "\n",
    "def scoreScbdRow(checklistData, formJson, checklistKey):\n",
    "    \"\"\"\n",
    "    Score one SCBD assessment against its own checklist_key's rubric.\n",
    "\n",
    "    Each MCn item in form.checklists[checklistKey].extra_config.rubric has up to\n",
    "    5 slots (O1..O5, O1=best..O5=\"Not done\"). Many are blank — blank means that\n",
    "    level doesn't apply to that item, so the *count of non-blank slots* is the\n",
    "    real number of levels for that item (2, 3, 4 or 5).\n",
    "\n",
    "    The assessor's recorded text answer (e.g. \"Mostly done\") is generic across\n",
    "    all items (form.checklists[checklistKey].extra_config.options.assessor maps\n",
    "    O1->\"Done well\", O2->\"Done\", O3->\"Mostly done\", O4->\"Sometimes done\",\n",
    "    O5->\"Not done\"). We:\n",
    "      1. map the recorded text -> its O-letter via extra_config.options.assessor\n",
    "      2. find which O-letters are active (non-blank) for that specific MC\n",
    "      3. rank the active letters worst->best as 0..(n-1) and locate the chosen one\n",
    "      4. keep both the raw rank (0..n-1, an integer \"score out of n-1\") and a\n",
    "         normalized 0..1 version for domain/overall averaging, which still needs\n",
    "         to stay comparable across items with different numbers of levels.\n",
    "    All items are then averaged with equal weight (no item weighted more than\n",
    "    another) for the overall %, and again per-domain using the\n",
    "    extra_config.headers section groupings (e.g. MC1..\"1. Clinical Information\n",
    "    Gathering\", MC5..\"2. Diagnosis...\"). Checklists with no `headers` config\n",
    "    (e.g. the 4-item DDS3-SCBD-PM/AM checklists) bucket everything under \"Other\".\n",
    "    \"\"\"\n",
    "    checklists = (formJson or {}).get(\"checklists\", {}) or {}\n",
    "    cdef = checklists.get(checklistKey, {}) or {}\n",
    "    extraConfig = cdef.get(\"extra_config\") or {}\n",
    "    optionsAssessor = (extraConfig.get(\"options\") or {}).get(\"assessor\") or {}\n",
    "    rubric = extraConfig.get(\"rubric\") or {}\n",
    "    headers = extraConfig.get(\"headers\") or {}\n",
    "    fields = cdef.get(\"fields\") or {}\n",
    "\n",
    "    if not rubric or not optionsAssessor:\n",
    "        return {\n",
    "            \"item_scores\": {}, \"item_raw\": {}, \"item_max\": {}, \"domain_pct\": {}, \"overall_pct\": None,\n",
    "            \"legend\": {}, \"flags\": [f\"No rubric/options config found for checklist_key '{checklistKey}'\"],\n",
    "        }\n",
    "\n",
    "    textToLetter = {v: k for k, v in optionsAssessor.items() if v}\n",
    "    mcKeys = sorted(\n",
    "        [k for k in (checklistData or {}) if re.match(r'^MC\\d+$', k)],\n",
    "        key=lambda k: int(k[2:])\n",
    "    )\n",
    "\n",
    "    headerStarts = sorted(\n",
    "        [(int(k[2:]), neatDomainLabel(v[0].get('title') if isinstance(v, list) and v else str(v)))\n",
    "         for k, v in headers.items() if re.match(r'^MC\\d+$', k)],\n",
    "        key=lambda x: x[0]\n",
    "    )\n",
    "\n",
    "    def domainFor(mcNum):\n",
    "        domain = None\n",
    "        for startNum, title in headerStarts:\n",
    "            if mcNum >= startNum:\n",
    "                domain = title\n",
    "            else:\n",
    "                break\n",
    "        return domain or \"Other\"\n",
    "\n",
    "    itemScores, itemRaw, itemMax, flags, legend = {}, {}, {}, [], {}\n",
    "    domainScores = defaultdict(list)\n",
    "\n",
    "    for mc in mcKeys:\n",
    "        legend[mc] = {\"domain\": domainFor(int(mc[2:])), \"description\": fields.get(mc, \"\")}\n",
    "\n",
    "        itemRubric = rubric.get(mc, {}) or {}\n",
    "        active = sorted(\n",
    "            [o for o in (\"O1\", \"O2\", \"O3\", \"O4\", \"O5\") if str(itemRubric.get(o, \"\")).strip() != \"\"],\n",
    "            key=lambda o: int(o[1])\n",
    "        )\n",
    "        n = len(active)\n",
    "        if n > 1:\n",
    "            itemMax[mc] = n - 1\n",
    "\n",
    "        value = checklistData.get(mc)\n",
    "        letter = textToLetter.get(value)\n",
    "        if letter is None:\n",
    "            flags.append(f\"{mc}: unrecognized value '{value}'\")\n",
    "            itemScores[mc] = None\n",
    "            itemRaw[mc] = None\n",
    "            continue\n",
    "\n",
    "        if n <= 1 or letter not in active:\n",
    "            flags.append(f\"{mc}: value '{value}' ({letter}) not active in rubric (active={active})\")\n",
    "            itemScores[mc] = None\n",
    "            itemRaw[mc] = None\n",
    "            continue\n",
    "\n",
    "        rank = {o: (n - 1 - idx) for idx, o in enumerate(active)}\n",
    "        score = rank[letter] / (n - 1)\n",
    "        itemScores[mc] = round(score, 4)\n",
    "        itemRaw[mc] = rank[letter]\n",
    "        domainScores[domainFor(int(mc[2:]))].append(score)\n",
    "\n",
    "    validScores = [s for s in itemScores.values() if s is not None]\n",
    "    overallPct = round(100 * sum(validScores) / len(validScores), 1) if validScores else None\n",
    "    domainPct = {d: round(100 * sum(v) / len(v), 1) for d, v in domainScores.items()}\n",
    "\n",
    "    return {\"item_scores\": itemScores, \"item_raw\": itemRaw, \"item_max\": itemMax,\n",
    "            \"domain_pct\": domainPct, \"overall_pct\": overallPct,\n",
    "            \"legend\": legend, \"flags\": flags}\n",
    "\n",
    "# ── Fetch ──────────────────────────────────────────────────────────────────\n",
    "scbdV2Sql = \"\"\"\n",
    "SELECT\n",
    "    s.assessmentid,\n",
    "    s.datetimeutc::date AS date,\n",
    "    s.student_name,\n",
    "    s.assessor_name,\n",
    "    s.cohort,\n",
    "    s.subject,\n",
    "    s.checklist_key,\n",
    "    s.checklist_data,\n",
    "    s.form,\n",
    "    s.global_rating AS gr,\n",
    "    s.form->'scales'->'scale-global-rating'->'fields'\n",
    "        ->> s.global_rating::text AS gr_label,\n",
    "    s.assessor_comments\n",
    "FROM scbd s\n",
    "WHERE s.datetimeutc >= '2026-06-01'\n",
    "  AND s.submitted = true\n",
    "ORDER BY s.cohort, s.student_name, s.datetimeutc\n",
    "\"\"\"\n",
    "\n",
    "scbdV2Df = readDf(engine, scbdV2Sql)\n",
    "\n",
    "# ── Pass 1: score every row, track the largest denominator seen per MC index ─\n",
    "# (different checklist_keys can define a different rubric level-count for the\n",
    "#  same MCn — e.g. the 4-item AM/PM checklists vs. the main checklist — so the\n",
    "#  column header denominator is the max across all rows; any row scored on a\n",
    "#  smaller rubric than its column's denominator gets a note in Flags instead of\n",
    "#  silently mislabeling the column.)\n",
    "scoredRows = []\n",
    "mcMaxByIndex = {}\n",
    "legendSeen = {}\n",
    "itemRows = []\n",
    "\n",
    "for _, r in scbdV2Df.iterrows():\n",
    "    checklistData = parseJsonCol(r[\"checklist_data\"])\n",
    "    formJson = parseJsonCol(r[\"form\"])\n",
    "    result = scoreScbdRow(checklistData, formJson, r[\"checklist_key\"])\n",
    "    assessorData = (formJson.get(\"data\", {}) or {}).get(\"assessor\", {}) or {}\n",
    "    scoredRows.append((r, checklistData, formJson, assessorData, result))\n",
    "\n",
    "    for mc, mx in result[\"item_max\"].items():\n",
    "        if mx is not None and mx > mcMaxByIndex.get(mc, -1):\n",
    "            mcMaxByIndex[mc] = mx\n",
    "\n",
    "    for mc, raw in result[\"item_raw\"].items():\n",
    "        itemRows.append({\n",
    "            \"Assessment ID\": r[\"assessmentid\"],\n",
    "            \"Student\": r[\"student_name\"],\n",
    "            \"Cohort\": r[\"cohort\"],\n",
    "            \"Checklist\": r[\"checklist_key\"],\n",
    "            \"MC Key\": mc,\n",
    "            \"MC Number\": int(mc[2:]),\n",
    "            \"MC Label\": checklistData.get(mc),\n",
    "            \"MC Score\": raw,\n",
    "            \"Max Score\": result[\"item_max\"].get(mc),\n",
    "        })\n",
    "\n",
    "    for mc, info in result[\"legend\"].items():\n",
    "        key = (r[\"checklist_key\"], mc)\n",
    "        if key not in legendSeen:\n",
    "            legendSeen[key] = {\n",
    "                \"Checklist\": r[\"checklist_key\"],\n",
    "                \"MC Key\": mc,\n",
    "                \"MC Number\": int(mc[2:]),\n",
    "                \"Domain\": info[\"domain\"],\n",
    "                \"Description\": info[\"description\"],\n",
    "            }\n",
    "\n",
    "def mcColName(mc):\n",
    "    denom = mcMaxByIndex.get(mc)\n",
    "    return f\"{mc} (/{denom})\" if denom is not None else f\"{mc} (/?)\"\n",
    "\n",
    "# ── Pass 2: build the wide Raw Data rows now that column denominators are known ─\n",
    "rawRows = []\n",
    "for r, checklistData, formJson, assessorData, result in scoredRows:\n",
    "    mismatchNotes = []\n",
    "    rawRow = {\n",
    "        \"Date\": r[\"date\"],\n",
    "        \"Cohort\": r[\"cohort\"],\n",
    "        \"Student\": r[\"student_name\"],\n",
    "        \"Assessor\": r[\"assessor_name\"],\n",
    "        \"Subject\": r[\"subject\"],\n",
    "        \"Checklist\": r[\"checklist_key\"],\n",
    "        \"Overall %\": result[\"overall_pct\"],\n",
    "        \"GR\": r[\"gr\"],\n",
    "        \"GR Label\": r[\"gr_label\"],\n",
    "        \"Critical Concerns\": assessorData.get(\"critical_concerns\"),\n",
    "        \"Critical Concerns Comments\": assessorData.get(\"critical_concerns_comments\") or None,\n",
    "        \"Examiner 2\": formJson.get(\"examiner_2\"),\n",
    "        \"Assessor Comments\": r[\"assessor_comments\"],\n",
    "        \"Assessment ID\": r[\"assessmentid\"],\n",
    "    }\n",
    "    for mc, raw in result[\"item_raw\"].items():\n",
    "        rawRow[mcColName(mc)] = raw\n",
    "        rowMax = result[\"item_max\"].get(mc)\n",
    "        denom = mcMaxByIndex.get(mc)\n",
    "        if raw is not None and rowMax is not None and denom is not None and rowMax != denom:\n",
    "            mismatchNotes.append(f\"{mc}: scored out of {rowMax}, column shown as /{denom}\")\n",
    "    for domain, pct in result[\"domain_pct\"].items():\n",
    "        rawRow[f\"{domain} %\"] = pct\n",
    "    rawRow[\"Flags\"] = \"; \".join(list(result[\"flags\"]) + mismatchNotes) or None\n",
    "    rawRows.append(rawRow)\n",
    "\n",
    "rawDf2 = pd.DataFrame(rawRows)\n",
    "itemDf2 = pd.DataFrame(itemRows).sort_values([\"Assessment ID\", \"MC Number\"])\n",
    "legendDf2 = (\n",
    "    pd.DataFrame(legendSeen.values()).sort_values([\"Checklist\", \"MC Number\"])\n",
    "    if legendSeen else\n",
    "    pd.DataFrame(columns=[\"Checklist\", \"MC Key\", \"MC Number\", \"Domain\", \"Description\"])\n",
    ")\n",
    "\n",
    "# ── Column ordering: identity -> per-item raw score -> per-domain % -> overall -> meta ─\n",
    "fixedCols2 = [\n",
    "    \"Date\", \"Cohort\", \"Student\", \"Assessor\", \"Subject\", \"Checklist\",\n",
    "    \"Overall %\", \"GR\", \"GR Label\", \"Critical Concerns\", \"Critical Concerns Comments\",\n",
    "    \"Examiner 2\", \"Assessor Comments\", \"Flags\", \"Assessment ID\",\n",
    "]\n",
    "\n",
    "def mcSortKey(name):\n",
    "    m = re.match(r'^MC(\\d+) \\(/', str(name))\n",
    "    return int(m.group(1)) if m else 9999\n",
    "\n",
    "def domainSortKey(name):\n",
    "    m = re.match(r'^D(\\d+)\\s', str(name))\n",
    "    return int(m.group(1)) if m else 999\n",
    "\n",
    "mcCols2 = sorted([c for c in rawDf2.columns if re.match(r'^MC\\d+ \\(/', str(c))], key=mcSortKey)\n",
    "domainCols2 = sorted(\n",
    "    [c for c in rawDf2.columns if c not in fixedCols2 and c not in mcCols2],\n",
    "    key=domainSortKey\n",
    ")\n",
    "\n",
    "rawCols2 = (\n",
    "    [\"Date\", \"Cohort\", \"Student\", \"Assessor\", \"Subject\", \"Checklist\"]\n",
    "    + mcCols2\n",
    "    + domainCols2\n",
    "    + [\"Overall %\", \"GR\", \"GR Label\", \"Critical Concerns\", \"Critical Concerns Comments\",\n",
    "       \"Examiner 2\", \"Assessor Comments\", \"Flags\", \"Assessment ID\"]\n",
    ")\n",
    "rawDf2 = rawDf2[rawCols2]\n",
    "\n",
    "# ── Summary per student (overall + per-domain averages; item-level kept in Raw Data) ─\n",
    "summaryAgg2 = {\n",
    "    \"Assessments (n)\": (\"Assessment ID\", \"count\"),\n",
    "    \"Overall % (avg)\": (\"Overall %\", \"mean\"),\n",
    "    \"GR (avg)\": (\"GR\", \"mean\"),\n",
    "}\n",
    "for d in domainCols2:\n",
    "    summaryAgg2[f\"{d} (avg)\"] = (d, \"mean\")\n",
    "\n",
    "summaryDf2 = (\n",
    "    rawDf2.groupby([\"Cohort\", \"Student\"], sort=True)\n",
    "    .agg(**summaryAgg2)\n",
    "    .round(2)\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "# ── Write workbook ────────────────────────────────────────────────────────\n",
    "scbdV2Path = f\"SCBD/SCBD_Rubric_Report_{today}.xlsx\"\n",
    "os.makedirs(\"SCBD\", exist_ok=True)\n",
    "\n",
    "with pd.ExcelWriter(scbdV2Path, **getmodeArgs(scbdV2Path)) as writer:\n",
    "    rawDf2.to_excel(writer, sheet_name=\"Raw Data\", index=False)\n",
    "    summaryDf2.to_excel(writer, sheet_name=\"Student Summary\", index=False)\n",
    "    itemDf2.to_excel(writer, sheet_name=\"Item Detail\", index=False)\n",
    "    legendDf2.to_excel(writer, sheet_name=\"Checklist Legend\", index=False)\n",
    "\n",
    "    wb = writer.book\n",
    "    styleSheet(wb[\"Raw Data\"], rawDf2, grColName=\"GR\")\n",
    "    styleSheet(wb[\"Student Summary\"], summaryDf2, grColName=\"GR (avg)\")\n",
    "    autoFitColumns(wb[\"Item Detail\"])\n",
    "    autoFitColumns(wb[\"Checklist Legend\"], maxWidth=70)\n",
    "\n",
    "    # Widen long free-text columns on the Raw Data sheet (styleSheet only auto-widens\n",
    "    # the legacy report's \"assessor_comments\" column by exact name).\n",
    "    rawHeaders = {cell.value: cell.column for cell in wb[\"Raw Data\"][1]}\n",
    "    for longCol in (\"Assessor Comments\", \"Critical Concerns Comments\", \"Flags\"):\n",
    "        colIdx = rawHeaders.get(longCol)\n",
    "        if colIdx:\n",
    "            wb[\"Raw Data\"].column_dimensions[get_column_letter(colIdx)].width = 50\n",
    "\n",
    "flaggedCount = rawDf2[\"Flags\"].notna().sum()\n",
    "print(f\"Written: {scbdV2Path}  ({len(rawDf2)} assessments, {summaryDf2['Student'].nunique()} students)\")\n",
    "print(f\"Per-item columns: {mcCols2}\")\n",
    "print(f\"Domain columns: {domainCols2}\")\n",
    "print(f\"Rows with data-quality flags: {flaggedCount}\")\n",
    "if flaggedCount:\n",
    "    display(rawDf2.loc[rawDf2[\"Flags\"].notna(), [\"Assessment ID\", \"Student\", \"Checklist\", \"Flags\"]])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4b67785e",
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import os\n",
    "import argparse\n",
    "from pathlib import Path\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from openpyxl import Workbook\n",
    "from openpyxl.styles import Font, PatternFill, Alignment, Border, Side\n",
    "from openpyxl.utils import get_column_letter\n",
    "\n",
    "\n",
    "# ── Colour / style constants ───────────────────────────────────────────────────\n",
    "HEADER_BG  = 'FF1F3864'\n",
    "HEADER_FG  = 'FFFFFFFF'\n",
    "SUBHDR_BG  = 'FF2E75B6'\n",
    "SUBHDR_FG  = 'FFFFFFFF'\n",
    "ALT_ROW_BG = 'FFDCE6F1'\n",
    "EASY_BG    = 'FFE2EFDA'\n",
    "MOD_BG     = 'FFFFEB9C'\n",
    "HARD_BG    = 'FFFFC7CE'\n",
    "GR_COLORS  = {1:'FFFFC7CE', 2:'FFFFEB9C', 3:'FFFFF2CC', 4:'FFE2EFDA', 5:'FF92D050'}\n",
    "SCORE_COLORS = {0:'FFFFC7CE', 1:'FFFFEB9C', 2:'FFD9E1F2', 3:'FFE2EFDA', 4:'FF70AD47'}\n",
    "\n",
    "\n",
    "def hFill(hex_col):\n",
    "    return PatternFill('solid', start_color=hex_col, end_color=hex_col)\n",
    "\n",
    "def hFont(hex_col, bold=False, size=10):\n",
    "    return Font(color=hex_col, bold=bold, name='Arial', size=size)\n",
    "\n",
    "def thinBorder():\n",
    "    s = Side(style='thin', color='FFB0B0B0')\n",
    "    return Border(left=s, right=s, top=s, bottom=s)\n",
    "\n",
    "def centerAlign():\n",
    "    return Alignment(horizontal='center', vertical='center', wrap_text=True)\n",
    "\n",
    "def leftAlign():\n",
    "    return Alignment(horizontal='left', vertical='center', wrap_text=True)\n",
    "\n",
    "DIFF_FILLS = {\n",
    "    'Easy':     hFill(EASY_BG),\n",
    "    'Moderate': hFill(MOD_BG),\n",
    "    'Hard':     hFill(HARD_BG),\n",
    "}\n",
    "\n",
    "\n",
    "# ── Data loading ───────────────────────────────────────────────────────────────\n",
    "def loadData(inputPath):\n",
    "    xl = pd.read_excel(inputPath, sheet_name=None)\n",
    "\n",
    "    requiredSheets = {'Raw Data', 'Checklist Legend'}\n",
    "    missing = requiredSheets - set(xl.keys())\n",
    "    if missing:\n",
    "        raise ValueError(f\"Input file missing required sheets: {missing}\")\n",
    "\n",
    "    raw    = xl['Raw Data'].copy()\n",
    "    legend = xl['Checklist Legend'].copy()\n",
    "\n",
    "    # MC columns inferred from header pattern \"MCN (/denom)\"\n",
    "    mcColsOrig = [c for c in raw.columns if c.startswith('MC')]\n",
    "    if not mcColsOrig:\n",
    "        raise ValueError(\"No MC columns found in 'Raw Data' sheet.\")\n",
    "\n",
    "    mcDenomMap  = {c: int(c.split('/')[1].rstrip(')')) for c in mcColsOrig}\n",
    "    mcShortMap  = {c: f\"MC{i+1}\" for i, c in enumerate(mcColsOrig)}\n",
    "    mcDenoms    = {mcShortMap[c]: mcDenomMap[c] for c in mcColsOrig}\n",
    "\n",
    "    scoresdf = raw[['Student', 'Assessor'] + mcColsOrig].copy()\n",
    "    scoresdf.columns = ['Student', 'Assessor'] + [mcShortMap[c] for c in mcColsOrig]\n",
    "\n",
    "    domainCols = [\n",
    "        'D1 Clinical Information Gathering %',\n",
    "        'D2 Diagnosis, Risk Assessment & Prognosis %',\n",
    "        'D3 Treatment Planning %',\n",
    "        'D4 Presentation %',\n",
    "        'Overall %', 'GR', 'GR Label',\n",
    "    ]\n",
    "    for col in domainCols:\n",
    "        if col not in raw.columns:\n",
    "            raise ValueError(f\"Expected column '{col}' not found in 'Raw Data'.\")\n",
    "        scoresdf[col] = raw[col].values\n",
    "\n",
    "    # MC descriptions from legend\n",
    "    mcDesc = {}\n",
    "    for _, row in legend.iterrows():\n",
    "        mcDesc[row['MC Key']] = {'domain': row['Domain'], 'desc': row['Description']}\n",
    "\n",
    "    return scoresdf, mcDenoms, mcDesc\n",
    "\n",
    "\n",
    "# ── Item difficulty stats ──────────────────────────────────────────────────────\n",
    "def buildItemStats(scoresdf, mcDenoms, mcDesc):\n",
    "    rows = []\n",
    "    for mc in mcDenoms:\n",
    "        denom  = mcDenoms[mc]\n",
    "        vals   = scoresdf[mc]\n",
    "        meanPct = (vals / denom).mean() * 100\n",
    "        pMax    = (vals == denom).mean() * 100\n",
    "        sd      = (vals / denom).std() * 100\n",
    "\n",
    "        if meanPct >= 90:\n",
    "            diffLabel = 'Easy'\n",
    "        elif meanPct >= 70:\n",
    "            diffLabel = 'Moderate'\n",
    "        else:\n",
    "            diffLabel = 'Hard'\n",
    "\n",
    "        flags = []\n",
    "        if meanPct >= 90:\n",
    "            flags.append('⚠ Very easy — red flag if missed')\n",
    "        if meanPct < 65:\n",
    "            flags.append('★ Hard — good discriminator')\n",
    "        if sd >= 25:\n",
    "            flags.append('↔ Wide spread — separates competency')\n",
    "        if pMax >= 90:\n",
    "            flags.append('✓ Near-ceiling')\n",
    "\n",
    "        rows.append({\n",
    "            'MC': mc, 'Denominator': denom,\n",
    "            'Domain':      mcDesc.get(mc, {}).get('domain', ''),\n",
    "            'Description': mcDesc.get(mc, {}).get('desc', ''),\n",
    "            'Mean %': round(meanPct, 1),\n",
    "            'SD %':   round(sd, 1),\n",
    "            '% at Max': round(pMax, 1),\n",
    "            'Difficulty': diffLabel,\n",
    "            'Flags': '  |  '.join(flags),\n",
    "        })\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "# ── Sheet builders ─────────────────────────────────────────────────────────────\n",
    "def buildCohortOverview(wb, scoresdf, inputPath):\n",
    "    ws = wb.create_sheet('Cohort Overview')\n",
    "    n  = len(scoresdf)\n",
    "\n",
    "    filename = Path(inputPath).stem\n",
    "\n",
    "    ws.merge_cells('A1:H1')\n",
    "    c = ws['A1']\n",
    "    c.value = f'SCBD — Cohort Overview  |  {filename}'\n",
    "    c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 14)\n",
    "    c.alignment = centerAlign()\n",
    "    ws.row_dimensions[1].height = 28\n",
    "\n",
    "    domains    = [\n",
    "        'D1 Clinical Information Gathering %',\n",
    "        'D2 Diagnosis, Risk Assessment & Prognosis %',\n",
    "        'D3 Treatment Planning %', 'D4 Presentation %', 'Overall %',\n",
    "    ]\n",
    "    domShort   = ['D1 Info Gathering', 'D2 Diagnosis & Risk',\n",
    "                  'D3 Tx Planning', 'D4 Presentation', 'Overall']\n",
    "\n",
    "    ws.cell(3, 1, 'Statistic').fill  = hFill(SUBHDR_BG)\n",
    "    ws.cell(3, 1).font = hFont(SUBHDR_FG, True)\n",
    "    ws.cell(3, 1).alignment = centerAlign(); ws.cell(3, 1).border = thinBorder()\n",
    "    ws.column_dimensions['A'].width = 18\n",
    "    for j, d in enumerate(domShort):\n",
    "        c = ws.cell(3, j+2, d)\n",
    "        c.fill = hFill(SUBHDR_BG); c.font = hFont(SUBHDR_FG, True)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "        ws.column_dimensions[get_column_letter(j+2)].width = 18\n",
    "    ws.row_dimensions[3].height = 30\n",
    "\n",
    "    statNames = ['N', 'Mean', 'Median', 'SD', 'Min', 'Max', 'Pass Rate (GR≥3)']\n",
    "    for i, stat in enumerate(statNames):\n",
    "        r = i + 4\n",
    "        ws.cell(r, 1, stat).fill = hFill('FFD9E1F2')\n",
    "        ws.cell(r, 1).font = hFont('FF000000', True)\n",
    "        ws.cell(r, 1).alignment = centerAlign(); ws.cell(r, 1).border = thinBorder()\n",
    "        for j, col in enumerate(domains):\n",
    "            s = scoresdf[col]\n",
    "            if stat == 'N':                v = n\n",
    "            elif stat == 'Mean':           v = round(s.mean(), 1)\n",
    "            elif stat == 'Median':         v = round(s.median(), 1)\n",
    "            elif stat == 'SD':             v = round(s.std(), 1)\n",
    "            elif stat == 'Min':            v = round(s.min(), 1)\n",
    "            elif stat == 'Max':            v = round(s.max(), 1)\n",
    "            elif stat == 'Pass Rate (GR≥3)':\n",
    "                v = f\"{(scoresdf['GR'] >= 3).mean()*100:.1f}%\" if col == 'Overall %' else '—'\n",
    "            cell = ws.cell(r, j+2, v)\n",
    "            cell.alignment = centerAlign(); cell.border = thinBorder()\n",
    "            if i % 2 == 1: cell.fill = hFill(ALT_ROW_BG)\n",
    "\n",
    "    # GR distribution\n",
    "    grCounts   = scoresdf['GR'].value_counts().sort_index()\n",
    "    grLabelsMap = {1:'Fail', 2:'Borderline Fail', 3:'Pass', 4:'Good', 5:'Excellent'}\n",
    "    rowG = 12\n",
    "    ws.merge_cells(f'A{rowG}:H{rowG}')\n",
    "    c = ws.cell(rowG, 1, 'Grade Distribution')\n",
    "    c.fill = hFill(SUBHDR_BG); c.font = hFont(SUBHDR_FG, True); c.alignment = centerAlign()\n",
    "\n",
    "    for col_idx, hdr in enumerate(['GR', 'Label', 'N', '%'], 1):\n",
    "        c = ws.cell(rowG+1, col_idx, hdr)\n",
    "        c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "\n",
    "    for i, gr in enumerate([1, 2, 3, 4, 5]):\n",
    "        r = rowG + 2 + i\n",
    "        count = grCounts.get(gr, 0)\n",
    "        for col_idx, val in enumerate([gr, grLabelsMap[gr], int(count), f\"{count/n*100:.1f}%\"], 1):\n",
    "            c = ws.cell(r, col_idx, val)\n",
    "            c.fill = hFill(GR_COLORS[gr])\n",
    "            c.alignment = centerAlign() if col_idx != 2 else leftAlign()\n",
    "            c.border = thinBorder()\n",
    "\n",
    "    ws.freeze_panes = 'A3'\n",
    "\n",
    "\n",
    "def buildStudentScores(wb, scoresdf, mcDenoms, inputPath):\n",
    "    ws   = wb.create_sheet('Student Scores')\n",
    "    mcKeys = list(mcDenoms.keys())\n",
    "    n    = len(scoresdf)\n",
    "    filename = Path(inputPath).stem\n",
    "\n",
    "    lastCol = get_column_letter(2 + len(mcKeys) + 7)\n",
    "    ws.merge_cells(f'A1:{lastCol}1')\n",
    "    c = ws['A1']\n",
    "    c.value = f'SCBD — Student Raw Scores (integer 0 → max)  |  {filename}'\n",
    "    c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 13)\n",
    "    c.alignment = centerAlign()\n",
    "    ws.row_dimensions[1].height = 24\n",
    "\n",
    "    # Domain group header spans\n",
    "    domainRanges = [(1,4), (5,10), (11,18), (19,23)]\n",
    "    domainLabels = [\n",
    "        'D1 — Clinical Information Gathering',\n",
    "        'D2 — Diagnosis, Risk Assessment & Prognosis',\n",
    "        'D3 — Treatment Planning',\n",
    "        'D4 — Presentation',\n",
    "    ]\n",
    "    ws.cell(2, 1, '#').fill = hFill(SUBHDR_BG); ws.cell(2,1).font = hFont(SUBHDR_FG,True); ws.cell(2,1).alignment = centerAlign(); ws.cell(2,1).border = thinBorder()\n",
    "    ws.cell(2, 2, 'Student').fill = hFill(SUBHDR_BG); ws.cell(2,2).font = hFont(SUBHDR_FG,True); ws.cell(2,2).alignment = centerAlign(); ws.cell(2,2).border = thinBorder()\n",
    "    for label, (start, end) in zip(domainLabels, domainRanges):\n",
    "        startCol = 2 + start\n",
    "        endCol   = 2 + end\n",
    "        ws.merge_cells(start_row=2, start_column=startCol, end_row=2, end_column=endCol)\n",
    "        c = ws.cell(2, startCol, label)\n",
    "        c.fill = hFill(SUBHDR_BG); c.font = hFont(SUBHDR_FG, True, 9)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "    ws.row_dimensions[2].height = 30\n",
    "\n",
    "    # MC column headers (row 3)\n",
    "    ws.cell(3,1,'#').fill = hFill(HEADER_BG); ws.cell(3,1).font = hFont(HEADER_FG,True,8); ws.cell(3,1).alignment = centerAlign(); ws.cell(3,1).border = thinBorder()\n",
    "    ws.cell(3,2,'Student').fill = hFill(HEADER_BG); ws.cell(3,2).font = hFont(HEADER_FG,True,8); ws.cell(3,2).alignment = centerAlign(); ws.cell(3,2).border = thinBorder()\n",
    "    for j, mc in enumerate(mcKeys):\n",
    "        c = ws.cell(3, j+3, f'{mc}\\n(/{mcDenoms[mc]})')\n",
    "        c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 8)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "    extraHdrs = ['D1 %', 'D2 %', 'D3 %', 'D4 %', 'Overall %', 'GR', 'Grade']\n",
    "    for k, h in enumerate(extraHdrs):\n",
    "        c = ws.cell(3, 3+len(mcKeys)+k, h)\n",
    "        c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 8)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "    ws.row_dimensions[3].height = 36\n",
    "\n",
    "    sortedDf = scoresdf.sort_values('Overall %', ascending=False).reset_index(drop=True)\n",
    "    domainColsFull = [\n",
    "        'D1 Clinical Information Gathering %',\n",
    "        'D2 Diagnosis, Risk Assessment & Prognosis %',\n",
    "        'D3 Treatment Planning %', 'D4 Presentation %', 'Overall %',\n",
    "    ]\n",
    "\n",
    "    for i, row in sortedDf.iterrows():\n",
    "        r = i + 4\n",
    "        ws.cell(r, 1, i+1).alignment = centerAlign(); ws.cell(r,1).border = thinBorder()\n",
    "        ws.cell(r, 2, row['Student']).alignment = leftAlign(); ws.cell(r,2).border = thinBorder()\n",
    "        if i % 2 == 0:\n",
    "            ws.cell(r,1).fill = hFill('FFF2F2F2')\n",
    "            ws.cell(r,2).fill = hFill('FFF2F2F2')\n",
    "\n",
    "        for j, mc in enumerate(mcKeys):\n",
    "            val   = int(row[mc]) if pd.notna(row[mc]) else 0\n",
    "            denom = mcDenoms[mc]\n",
    "            cell  = ws.cell(r, j+3, val)\n",
    "            cell.alignment = centerAlign(); cell.border = thinBorder()\n",
    "            cell.fill = hFill(EASY_BG if val == denom else (HARD_BG if val == 0 else MOD_BG))\n",
    "\n",
    "        for k, col in enumerate(domainColsFull):\n",
    "            cell = ws.cell(r, 3+len(mcKeys)+k, round(row[col], 1))\n",
    "            cell.alignment = centerAlign(); cell.border = thinBorder()\n",
    "\n",
    "        gr = int(row['GR'])\n",
    "        grCol = 3 + len(mcKeys) + 5\n",
    "        ws.cell(r, grCol, gr).alignment = centerAlign(); ws.cell(r,grCol).border = thinBorder()\n",
    "        ws.cell(r, grCol).fill = hFill(GR_COLORS[gr])\n",
    "        ws.cell(r, grCol+1, row['GR Label']).alignment = centerAlign(); ws.cell(r,grCol+1).border = thinBorder()\n",
    "        ws.cell(r, grCol+1).fill = hFill(GR_COLORS[gr])\n",
    "\n",
    "    # Cohort mean row\n",
    "    meanR = 4 + n\n",
    "    ws.cell(meanR, 2, 'COHORT MEAN').fill = hFill(SUBHDR_BG)\n",
    "    ws.cell(meanR, 2).font = hFont(SUBHDR_FG, True, 9); ws.cell(meanR, 2).alignment = centerAlign()\n",
    "    for j, mc in enumerate(mcKeys):\n",
    "        c = ws.cell(meanR, j+3, round(scoresdf[mc].mean(), 2))\n",
    "        c.fill = hFill(SUBHDR_BG); c.font = hFont(SUBHDR_FG, True, 8)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "    for k, col in enumerate(domainColsFull):\n",
    "        c = ws.cell(meanR, 3+len(mcKeys)+k, round(scoresdf[col].mean(), 1))\n",
    "        c.fill = hFill(SUBHDR_BG); c.font = hFont(SUBHDR_FG, True, 8); c.alignment = centerAlign()\n",
    "\n",
    "    ws.column_dimensions['A'].width = 5\n",
    "    ws.column_dimensions['B'].width = 24\n",
    "    for j in range(len(mcKeys)):\n",
    "        ws.column_dimensions[get_column_letter(j+3)].width = 7\n",
    "    for k in range(len(extraHdrs)):\n",
    "        ws.column_dimensions[get_column_letter(3+len(mcKeys)+k)].width = 10\n",
    "    ws.freeze_panes = 'C4'\n",
    "\n",
    "\n",
    "def buildItemAnalysis(wb, itemStatsdf):\n",
    "    ws = wb.create_sheet('Item Analysis')\n",
    "\n",
    "    ws.merge_cells('A1:J1')\n",
    "    c = ws['A1']; c.value = 'SCBD — Item (MC) Difficulty Analysis'\n",
    "    c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 13); c.alignment = centerAlign()\n",
    "    ws.row_dimensions[1].height = 24\n",
    "\n",
    "    hdrs = ['MC', 'Denominator', 'Domain', 'Description',\n",
    "            'Mean %', 'SD %', '% at Max', 'Difficulty', 'Score Distribution', 'Flags']\n",
    "    colWidths = [8, 12, 30, 60, 10, 8, 10, 12, 35, 40]\n",
    "    for j, (h, w) in enumerate(zip(hdrs, colWidths)):\n",
    "        c = ws.cell(2, j+1, h)\n",
    "        c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 9)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "        ws.column_dimensions[get_column_letter(j+1)].width = w\n",
    "    ws.row_dimensions[2].height = 30\n",
    "    ws.freeze_panes = 'A3'\n",
    "\n",
    "\n",
    "def buildItemScoreGrid(wb, scoresdf, mcDenoms, itemStatsdf):\n",
    "    ws  = wb.create_sheet('Item Score Grid')\n",
    "    mcKeys  = list(mcDenoms.keys())\n",
    "    maxDenom = max(mcDenoms.values())\n",
    "\n",
    "    ws.merge_cells(f'A1:{get_column_letter(1+len(mcKeys))}1')\n",
    "    c = ws['A1']\n",
    "    c.value = 'SCBD — Score Count per Item  (each cell = number of students at that score level)'\n",
    "    c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 12); c.alignment = centerAlign()\n",
    "    ws.row_dimensions[1].height = 22\n",
    "\n",
    "    ws.cell(2, 1, 'Score').fill = hFill(HEADER_BG)\n",
    "    ws.cell(2, 1).font = hFont(HEADER_FG, True); ws.cell(2,1).alignment = centerAlign(); ws.cell(2,1).border = thinBorder()\n",
    "    for j, mc in enumerate(mcKeys):\n",
    "        c = ws.cell(2, j+2, f'{mc}\\n(/{mcDenoms[mc]})')\n",
    "        c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 8)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "    ws.row_dimensions[2].height = 36\n",
    "\n",
    "    # Difficulty row\n",
    "    ws.cell(3, 1, 'Difficulty').fill = hFill(SUBHDR_BG)\n",
    "    ws.cell(3,1).font = hFont(SUBHDR_FG,True,8); ws.cell(3,1).alignment = centerAlign(); ws.cell(3,1).border = thinBorder()\n",
    "    for j, (_, stat) in enumerate(itemStatsdf.iterrows()):\n",
    "        c = ws.cell(3, j+2, stat['Difficulty'])\n",
    "        c.fill = DIFF_FILLS[stat['Difficulty']]\n",
    "        c.font = Font(bold=True, name='Arial', size=8)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "\n",
    "    # Mean % row\n",
    "    ws.cell(4, 1, 'Mean %').fill = hFill(SUBHDR_BG)\n",
    "    ws.cell(4,1).font = hFont(SUBHDR_FG,True,8); ws.cell(4,1).alignment = centerAlign(); ws.cell(4,1).border = thinBorder()\n",
    "    for j, (_, stat) in enumerate(itemStatsdf.iterrows()):\n",
    "        c = ws.cell(4, j+2, stat['Mean %'])\n",
    "        c.fill = hFill(SUBHDR_BG); c.font = hFont(SUBHDR_FG, True, 8)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "\n",
    "    for score in range(maxDenom+1):\n",
    "        r = score + 5\n",
    "        ws.cell(r, 1, score).fill = hFill(SCORE_COLORS.get(score, 'FFD9D9D9'))\n",
    "        ws.cell(r, 1).font = Font(bold=True, name='Arial', size=10)\n",
    "        ws.cell(r, 1).alignment = centerAlign(); ws.cell(r, 1).border = thinBorder()\n",
    "        for j, mc in enumerate(mcKeys):\n",
    "            denom = mcDenoms[mc]\n",
    "            if score > denom:\n",
    "                c = ws.cell(r, j+2, '—')\n",
    "                c.fill = hFill('FFD9D9D9'); c.alignment = centerAlign(); c.border = thinBorder()\n",
    "            else:\n",
    "                cnt  = int((scoresdf[mc] == score).sum())\n",
    "                c = ws.cell(r, j+2, cnt)\n",
    "                c.fill = hFill(SCORE_COLORS.get(score, 'FFD9D9D9'))\n",
    "                c.alignment = centerAlign(); c.border = thinBorder()\n",
    "\n",
    "    ws.cell(maxDenom+6, 1, '% at Max').fill = hFill('FF4472C4')\n",
    "    ws.cell(maxDenom+6,1).font = hFont(HEADER_FG, True, 8); ws.cell(maxDenom+6,1).alignment = centerAlign(); ws.cell(maxDenom+6,1).border = thinBorder()\n",
    "    for j, (_, stat) in enumerate(itemStatsdf.iterrows()):\n",
    "        c = ws.cell(maxDenom+6, j+2, f\"{stat['% at Max']}%\")\n",
    "        c.fill = hFill('FF4472C4'); c.font = hFont(HEADER_FG, True, 8)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "\n",
    "    ws.column_dimensions['A'].width = 12\n",
    "    for j in range(len(mcKeys)):\n",
    "        ws.column_dimensions[get_column_letter(j+2)].width = 9\n",
    "    ws.freeze_panes = 'B3'\n",
    "\n",
    "\n",
    "def buildWeightingSimulator(wb, scoresdf):\n",
    "    ws  = wb.create_sheet('Weighting Simulator')\n",
    "\n",
    "    ws.merge_cells('A1:J1')\n",
    "    c = ws['A1']\n",
    "    c.value = 'SCBD — Weighting Simulator  |  Edit yellow cells (B4:B7, must sum to 100) to reweight domains'\n",
    "    c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 12); c.alignment = centerAlign()\n",
    "    ws.row_dimensions[1].height = 22\n",
    "\n",
    "    domDefs = [\n",
    "        ('D1 Clinical Info Gathering',  'D1 Clinical Information Gathering %'),\n",
    "        ('D2 Diagnosis & Risk',          'D2 Diagnosis, Risk Assessment & Prognosis %'),\n",
    "        ('D3 Treatment Planning',        'D3 Treatment Planning %'),\n",
    "        ('D4 Presentation',              'D4 Presentation %'),\n",
    "    ]\n",
    "    for hdr, col in [('Domain',''), ('Weight (%)',''), ('Actual Mean %','')]:\n",
    "        pass\n",
    "    ws.cell(3,1,'Domain').fill = hFill(SUBHDR_BG); ws.cell(3,1).font = hFont(SUBHDR_FG,True); ws.cell(3,1).alignment = centerAlign()\n",
    "    ws.cell(3,2,'Weight (%)').fill = hFill(SUBHDR_BG); ws.cell(3,2).font = hFont(SUBHDR_FG,True); ws.cell(3,2).alignment = centerAlign()\n",
    "    ws.cell(3,3,'Cohort Mean %').fill = hFill(SUBHDR_BG); ws.cell(3,3).font = hFont(SUBHDR_FG,True); ws.cell(3,3).alignment = centerAlign()\n",
    "\n",
    "    for i, (name, col) in enumerate(domDefs):\n",
    "        r = 4 + i\n",
    "        ws.cell(r, 1, name).alignment = leftAlign(); ws.cell(r,1).border = thinBorder()\n",
    "        wCell = ws.cell(r, 2, 25)\n",
    "        wCell.fill = hFill('FFFFFF00'); wCell.font = Font(bold=True, color='FF000000', name='Arial')\n",
    "        wCell.alignment = centerAlign(); wCell.border = thinBorder()\n",
    "        ws.cell(r, 3, round(scoresdf[col].mean(), 1)).alignment = centerAlign(); ws.cell(r,3).border = thinBorder()\n",
    "\n",
    "    ws.cell(8, 1, 'Total Weight').font = Font(bold=True, name='Arial')\n",
    "    ws.cell(8, 2, '=SUM(B4:B7)').alignment = centerAlign()\n",
    "    ws.cell(8, 2).font = Font(bold=True, name='Arial'); ws.cell(8,2).border = thinBorder()\n",
    "    ws.cell(11, 1, 'NOTE: Edit B4:B7 weights (must sum to 100). Columns G and H recalculate automatically.').font = Font(italic=True, name='Arial', size=9, color='FF666666')\n",
    "\n",
    "    dataStart = 13\n",
    "    hdrs5 = ['Student','D1 %','D2 %','D3 %','D4 %','Current Overall %','Reweighted Overall %','Δ vs Current','GR (Current)']\n",
    "    for j, h in enumerate(hdrs5):\n",
    "        c = ws.cell(dataStart, j+1, h)\n",
    "        c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 9)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "\n",
    "    sortedDf = scoresdf.sort_values('Overall %', ascending=False).reset_index(drop=True)\n",
    "    for i, row in sortedDf.iterrows():\n",
    "        r = dataStart + 1 + i\n",
    "        ws.cell(r, 1, row['Student']).alignment = leftAlign(); ws.cell(r,1).border = thinBorder()\n",
    "        vals = [\n",
    "            round(row['D1 Clinical Information Gathering %'], 1),\n",
    "            round(row['D2 Diagnosis, Risk Assessment & Prognosis %'], 1),\n",
    "            round(row['D3 Treatment Planning %'], 1),\n",
    "            round(row['D4 Presentation %'], 1),\n",
    "        ]\n",
    "        for j, v in enumerate(vals):\n",
    "            ws.cell(r, j+2, v).alignment = centerAlign(); ws.cell(r,j+2).border = thinBorder()\n",
    "        ws.cell(r, 6, round(row['Overall %'], 1)).alignment = centerAlign(); ws.cell(r,6).border = thinBorder()\n",
    "        ws.cell(r, 7, f'=(B{r}*$B$4+C{r}*$B$5+D{r}*$B$6+E{r}*$B$7)/100').alignment = centerAlign(); ws.cell(r,7).border = thinBorder()\n",
    "        ws.cell(r, 8, f'=G{r}-F{r}').alignment = centerAlign(); ws.cell(r,8).border = thinBorder()\n",
    "        gr = int(row['GR'])\n",
    "        ws.cell(r, 9, gr).alignment = centerAlign(); ws.cell(r,9).border = thinBorder()\n",
    "        ws.cell(r, 9).fill = hFill(GR_COLORS[gr])\n",
    "        if i % 2 == 0:\n",
    "            for j in [1,2,3,4,5,6]:\n",
    "                cell = ws.cell(r,j)\n",
    "                if cell.fill.fgColor.rgb in ('FF000000', '00000000'):\n",
    "                    cell.fill = hFill('FFF2F2F2')\n",
    "\n",
    "    ws.column_dimensions['A'].width = 26\n",
    "    for j in range(1, 9):\n",
    "        ws.column_dimensions[get_column_letter(j+1)].width = 16\n",
    "    ws.freeze_panes = 'B14'\n",
    "\n",
    "\n",
    "def buildExaminerHarshness(wb, scoresdf):\n",
    "    ws = wb.create_sheet('Examiner Harshness')\n",
    "\n",
    "    ws.merge_cells('A1:H1')\n",
    "    c = ws['A1']; c.value = 'SCBD — Examiner Harshness Comparison  |  Mean scores per assessor (green/red = >5% from cohort mean)'\n",
    "    c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 12); c.alignment = centerAlign()\n",
    "    ws.row_dimensions[1].height = 22\n",
    "\n",
    "    examinerStats = scoresdf.groupby('Assessor').agg(\n",
    "        N=('Overall %', 'count'),\n",
    "        MeanOverall=('Overall %', 'mean'),\n",
    "        SDOverall=('Overall %', 'std'),\n",
    "        MeanD1=('D1 Clinical Information Gathering %', 'mean'),\n",
    "        MeanD2=('D2 Diagnosis, Risk Assessment & Prognosis %', 'mean'),\n",
    "        MeanD3=('D3 Treatment Planning %', 'mean'),\n",
    "        MeanD4=('D4 Presentation %', 'mean'),\n",
    "    ).reset_index().sort_values('MeanOverall', ascending=False)\n",
    "\n",
    "    hdrs6 = ['Assessor', 'N', 'Mean Overall %', 'SD Overall %',\n",
    "             'Mean D1 %', 'Mean D2 %', 'Mean D3 %', 'Mean D4 %']\n",
    "    colWidths6 = [24, 6, 16, 14, 12, 12, 12, 12]\n",
    "    for j, (h, w) in enumerate(zip(hdrs6, colWidths6)):\n",
    "        c = ws.cell(2, j+1, h)\n",
    "        c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 9)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "        ws.column_dimensions[get_column_letter(j+1)].width = w\n",
    "\n",
    "    cohortMean = scoresdf['Overall %'].mean()\n",
    "    for i, row in examinerStats.iterrows():\n",
    "        r = i + 3\n",
    "        sdVal = round(row['SDOverall'], 1) if pd.notna(row['SDOverall']) else '—'\n",
    "        rowVals = [row['Assessor'], int(row['N']), round(row['MeanOverall'], 1),\n",
    "                   sdVal, round(row['MeanD1'],1), round(row['MeanD2'],1),\n",
    "                   round(row['MeanD3'],1), round(row['MeanD4'],1)]\n",
    "        for j, v in enumerate(rowVals):\n",
    "            cell = ws.cell(r, j+1, v)\n",
    "            cell.alignment = centerAlign() if j != 0 else leftAlign()\n",
    "            cell.border = thinBorder()\n",
    "            if i % 2 == 0: cell.fill = hFill('FFF9F9F9')\n",
    "        diff = row['MeanOverall'] - cohortMean\n",
    "        if diff > 5:\n",
    "            ws.cell(r, 3).fill = hFill(EASY_BG)\n",
    "        elif diff < -5:\n",
    "            ws.cell(r, 3).fill = hFill(HARD_BG)\n",
    "\n",
    "    cr = len(examinerStats) + 3\n",
    "    ws.cell(cr, 1, 'COHORT MEAN').fill = hFill(SUBHDR_BG); ws.cell(cr,1).font = hFont(SUBHDR_FG,True); ws.cell(cr,1).alignment = centerAlign()\n",
    "    ws.cell(cr, 3, round(cohortMean, 1)).fill = hFill(SUBHDR_BG); ws.cell(cr,3).font = hFont(SUBHDR_FG,True,9); ws.cell(cr,3).alignment = centerAlign()\n",
    "\n",
    "\n",
    "# ── Item Analysis rows (factored out to avoid duplication) ────────────────────\n",
    "def populateItemAnalysis(wb, scoresdf, mcDenoms, itemStatsdf):\n",
    "    ws = wb['Item Analysis']\n",
    "    for i, (_, stat) in enumerate(itemStatsdf.iterrows()):\n",
    "        r   = i + 3\n",
    "        mc  = stat['MC']\n",
    "        vals = scoresdf[mc]\n",
    "        distParts = [f\"{v}:{int((vals==v).sum())}\" for v in range(stat['Denominator']+1) if (vals==v).sum() > 0]\n",
    "        distStr   = '  |  '.join(distParts)\n",
    "\n",
    "        rowData = [mc, stat['Denominator'], stat['Domain'], stat['Description'],\n",
    "                   stat['Mean %'], stat['SD %'], stat['% at Max'],\n",
    "                   stat['Difficulty'], distStr, stat['Flags']]\n",
    "        for j, val in enumerate(rowData):\n",
    "            cell = ws.cell(r, j+1, val)\n",
    "            cell.border = thinBorder()\n",
    "            cell.alignment = leftAlign() if j in (2, 3, 8, 9) else centerAlign()\n",
    "            if i % 2 == 0: cell.fill = hFill('FFF9F9F9')\n",
    "        ws.cell(r, 8).fill = DIFF_FILLS[stat['Difficulty']]\n",
    "        ws.cell(r, 8).font = Font(bold=True, name='Arial', size=9)\n",
    "\n",
    "\n",
    "# ── Main ───────────────────────────────────────────────────────────────────────\n",
    "def main():\n",
    "    parser = argparse.ArgumentParser(\n",
    "        description='SCBD psychometric analysis — produces a 6-sheet Excel report.'\n",
    "    )\n",
    "\n",
    "    inputPath = Path('SCBD\\SCBD_10Jun.xlsx')\n",
    "    if not inputPath.exists():\n",
    "        print(f\"ERROR: input file not found: {inputPath}\", file=sys.stderr)\n",
    "        sys.exit(1)\n",
    "\n",
    "    outputPath = inputPath.parent / f\"{inputPath.stem}_Reformatted.xlsx\"\n",
    "\n",
    "    print(f\"Loading:  {inputPath}\")\n",
    "    scoresdf, mcDenoms, mcDesc = loadData(inputPath)\n",
    "    print(f\"  {len(scoresdf)} students  |  {len(mcDenoms)} MC items\")\n",
    "\n",
    "    itemStatsdf = buildItemStats(scoresdf, mcDenoms, mcDesc)\n",
    "\n",
    "    wb = Workbook()\n",
    "    wb.remove(wb.active)\n",
    "\n",
    "    print(\"Building sheets...\")\n",
    "    buildCohortOverview(wb, scoresdf, inputPath)\n",
    "    buildStudentScores(wb, scoresdf, mcDenoms, inputPath)\n",
    "    buildItemAnalysis(wb, itemStatsdf)                         # headers only\n",
    "    populateItemAnalysis(wb, scoresdf, mcDenoms, itemStatsdf)  # fill rows\n",
    "    buildItemScoreGrid(wb, scoresdf, mcDenoms, itemStatsdf)\n",
    "    buildWeightingSimulator(wb, scoresdf)\n",
    "    buildExaminerHarshness(wb, scoresdf)\n",
    "\n",
    "    wb.save(outputPath)\n",
    "    print(f\"Saved:    {outputPath}\")\n",
    "\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    main()"
   ]
  },
