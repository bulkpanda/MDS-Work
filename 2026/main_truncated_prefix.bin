   "metadata": {},
   "source": [
    "### Build a PRP section (Progress Review Panel Report)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0bded7b3",
   "metadata": {},
   "outputs": [],
   "source": [
    "def createFlaggingReport(cohort, formType, config=None, filters=None):\n",
    "    \"\"\"\n",
    "    Run flagging for one cohort/formType and write the Excel dashboard.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    cohort   : e.g. \"DDS2\", \"BOH1\"\n",
    "    formType : \"Clinic\" or \"Simulation\"\n",
    "    config   : FlaggingConfig — defaults to PRESETS[\"clinic_full\"]\n",
    "               Use PRESETS[\"...\"].copy(...) to override specific fields.\n",
    "    filters  : dict passed to getDataDf (defaults to {\"type\": formType})\n",
    "\n",
    "    Examples\n",
    "    --------\n",
    "    # Full clinic dashboard with default preset:\n",
    "    createFlaggingReport(\"DDS2\", \"Clinic\")\n",
    "\n",
    "    # Quick triage — summary + legend only:\n",
    "    createFlaggingReport(\"DDS2\", \"Clinic\", config=PRESETS[\"clinic_quick\"])\n",
    "\n",
    "    # Simulation run:\n",
    "    createFlaggingReport(\"DDS2\", \"Simulation\", config=PRESETS[\"sim_standard\"])\n",
    "\n",
    "    # Override one threshold from a preset:\n",
    "    createFlaggingReport(\"BOH1\", \"Clinic\",\n",
    "        config=PRESETS[\"clinic_full\"].copy(minForms=8, grThreshold=2.3))\n",
    "\n",
    "    # Custom — pick flags and sheets manually:\n",
    "    cfg = FlaggingConfig(\n",
    "        flags=[\"low_es\", \"low_gr\", \"high_fta\", \"clinical_incident\"],\n",
    "        sheets=[\"summary\", \"comparison\", \"legend\"],\n",
    "        esThreshold=2.3, grThreshold=2.5, minForms=12,\n",
    "    )\n",
    "    createFlaggingReport(\"DDS3\", \"Clinic\", config=cfg)\n",
    "\n",
    "    # Inspect any config before running:\n",
    "    PRESETS[\"clinic_full\"].describe()\n",
    "    \"\"\"\n",
    "    if config is None:\n",
    "        config = PRESETS[\"clinic_full\"]\n",
    "    if filters is None:\n",
    "        filters = {\"type\": formType}\n",
    "\n",
    "    clinic = filters.get(\"clinic\")\n",
    "    label  = f\"{cohort} — {formType}\" + (f\" — {clinic}\" if clinic else \"\")\n",
    "    print(f\"=== {label} ===\")\n",
    "\n",
    "    cohortDf = getDataDf(engine, cohort, filters=filters)\n",
    "    removeStudents = REMOVE_STUDENTS_DICT.get(cohort, [])\n",
    "    cohortDf = cohortDf[~cohortDf[\"student_number\"].isin(removeStudents)]\n",
    "    cohortDf[\"scores\"] = cohortDf.apply(lambda row: calcScore(row, SCORE_MAP), axis=1)\n",
    "    print(cohortDf.columns)\n",
    "\n",
    "    flagDf, compDf, thresholds = getFlagDf(cohortDf, formType=formType, config=config)\n",
    "\n",
    "    import os\n",
    "    os.makedirs(cohort, exist_ok=True)\n",
    "    filename = f\"{cohort} {formType} {clinic + ' ' if clinic else ''}Flagging (2026).xlsx\"\n",
    "    saveFlagDfToExcel2(\n",
    "        flagDf, compDf, thresholds, cohortDf,\n",
    "        filepath=f\"{cohort}/{filename}\",\n",
    "        formType=formType,\n",
    "        cohort=cohort,\n",
    "        config=config,\n",
    "    )\n",
    "\n",
    "\n",
    "# ── Run ──────────────────────────────────────────────────────────────────\n",
    "# createFlaggingReport(\"DDS2\", \"Clinic\")\n",
    "# createFlaggingReport(\"DDS2\", \"Clinic\",      config=PRESETS[\"dds2_clinic\"])\n",
    "# createFlaggingReport(\"DDS2\", \"Simulation\",  config=PRESETS[\"sim_standard\"])\n",
    "# createFlaggingReport(\"BOH2\", \"Simulation\", config=PRESETS[\"boh2_sim\"])\n",
    "# createFlaggingReport(\"BOH2\", \"Clinic\", config=PRESETS[\"boh2_clinic\"])\n",
    "# createFlaggingReport(\"BOH1\", \"Simulation\", config=PRESETS[\"sim_standard\"])\n",
    "createFlaggingReport(\"DDS3\", \"Clinic\", config=PRESETS[\"dds3_clinic\"])\n",
    "# createFlaggingReport(\"DDS3\", \"Clinic\", filters={\"type\": \"Clinic\", \"clinic\": \"Fixed Pros\"})\n",
    "# createFlaggingReport(\"DDS3\", \"Clinic\", filters={\"type\": \"Clinic\", \"clinic\": \"Endo\"})\n",
    "# createFlaggingReport(\"DDS3\", \"Clinic\", filters={\"type\": \"Clinic\", \"clinic\": \"Paeds\"})\n",
    "# createFlaggingReport(\"DDS3\", \"Clinic\", filters={\"type\": \"Clinic\", \"clinic\": \"Perio\"})\n",
    "# createFlaggingReport(\"DDS3\", \"Clinic\", filters={\"type\": \"Clinic\", \"clinic\": \"General Practice\"})\n"
   ]
  },
