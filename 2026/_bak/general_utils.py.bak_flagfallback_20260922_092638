# DDS2 Weekly Sim
#
# Semester split for the weekly sim workbooks. Everything on/after this date is
# semester 2 (2026); semester 1 workbooks were already built and live in
# "DDS2/Weekly Sim". The builders default to minDate = this value so a re-run
# never rebuilds semester 1. To build semester 1 instead, call with
# minDate=None, maxDate='2026-06-14' (maxDate is an inclusive <= bound).
SEMESTER_SPLIT_DATE = "2026-06-15"

# O-code -> 0..1 score used when expanding the flattened checklist json (mc_json).
# Mirrors the CASE expression inside getWeeklySimDataSql so the python-side
# MC columns and the SQL-side "Assessor Score"/"Student Score" always agree.
WEEKLY_SIM_SCORE_MAP = {
    "O1": 1.00,
    "O2": 0.80,
    "O3": 0.60,
    "O4": 0.40,
    "O5": 0.00,
    "Yes": 1.00,
    "No": 0.00,
}

# How the MC (checklist item) columns are written into the weekly workbook.
#
#   '0-1'  the original proportion scale, matching "Assessor Score"/"Student Score"
#   '1-5'  the O-codes as levels, 5 = best — reads the same way round as GR, so a low
#          number means a weak result on both
#
# These are NOT linear rescales of one another: O5 is 0.00 on '0-1' but 1 on '1-5'. That
# matters in exactly one place — runBlrAnalysis computes its per-item stats and Cronbach's
# alpha from the MC columns, so those shift when the scale changes. The regression CUTOFF
# and all flagging read "Assessor Score", which comes from SQL and is always 0-1, so
# Pass/Fail is unaffected either way.
WEEKLY_MC_SCALES = {
    "0-1": {"O1": 1.00, "O2": 0.80, "O3": 0.60, "O4": 0.40, "O5": 0.00,
            "Yes": 1.00, "No": 0.00},
    "1-5": {"O1": 5, "O2": 4, "O3": 3, "O4": 2, "O5": 1,
            "Yes": 5, "No": 1},
}

# "This is a weak result" per scale, so switching scale can't leave the colours pointing
# at the wrong end of the range — on '0-1' the low end is 0.0, on '1-5' it is 1.
WEEKLY_MC_HIGHLIGHT_BY_SCALE = {
    "1-5": {1: "red", 2: "amber"},
    "0-1": {0.0: "red", 0.4: "amber"},
}

WEEKLY_GR_HIGHLIGHT = {1: "red", 2: "amber", 5: "green"}


def resolveMcScale(scale=None):
    """(scoreMap, label) from a scale name ('0-1' / '1-5'), an explicit dict, or None.

    None keeps the historical 0-1 behaviour, so nothing changes unless asked.
    """
    if scale is None:
        return dict(WEEKLY_SIM_SCORE_MAP), "0-1"
    if isinstance(scale, dict):
        return dict(scale), "custom"
    key = str(scale).strip()
    if key not in WEEKLY_MC_SCALES:
        raise ValueError(f"Unknown MC scale {scale!r} — use one of "
                         f"{list(WEEKLY_MC_SCALES)} or pass an explicit dict.")
    return dict(WEEKLY_MC_SCALES[key]), key


# ---------------------------------------------------------------------------------------
# Weekly sheet PRESENTATION layer (added 2026-08-18).
#
# The per-date weekly workbook is read by humans against a paper list, so it carries the
# reader's vocabulary, not the database's. Three things happen on the way out, and ONLY on
# the way out — every dataframe inside the pipeline stays snake_case:
#
#   1. columns in WEEKLY_SHEET_DROP_COLS are dropped,
#   2. the MC block is moved to sit immediately BEFORE WEEKLY_SHEET_MC_BEFORE,
#   3. the remaining columns are relabelled through WEEKLY_SHEET_COLUMN_LABELS.
#
# loadWeeklyFiles reverses (3) on the way back in, so the combined workbook, BLR and the
# flagging chain keep seeing 'student_number' / 'item_code' and neither knows nor cares
# which layout a workbook on disk was written with. Workbooks built before this change
# load unchanged.
#
# GR / TS / CS / PS / PR / PEC keep their acronyms deliberately: addAssessmentCharts looks
# up 'GR' by header text, styleWeeklySheet's grCols defaults to ('GR',), and
# runBlrAnalysis takes grCol='GR'. Renaming them means touching all three.

# Dropped from the sheet. 'date' is safe to lose because every downstream reader takes the
# date from the FILENAME (loadWeeklyFiles -> buildWideDf sets tmp['date'] = dateStr), and
# assessmentid / form_code / student_email are identifiers nobody reads off this sheet.
# 'subject' is deliberately KEPT: cell 39 guards on `if "subject" in columns` to emit the
# combined workbook's subject_mismatches sheet. Add it here to drop that cross-check —
# cell 37's DB-driven `<COHORT> subject code mismatches.xlsx` covers the same ground.
WEEKLY_SHEET_DROP_COLS = ["student_email", "date", "assessmentid", "form_code"]

# The MC block lands immediately before this column, so the sheet reads
# per-item marks -> the score they roll up into. Set to None to leave MC at the end.
WEEKLY_SHEET_MC_BEFORE = "Assessor Score"

# snake_case -> what the reader sees. Anything not listed passes through untouched, which
# is what keeps GR/TS/CS/PS/PR/PEC and the MCn columns as they are.
WEEKLY_SHEET_COLUMN_LABELS = {
    "student_number":      "Student Number",
    "last_name":           "Last Name",
    "first_name":          "First Name",
    "student_name":        "Student Name",
    "student_email":       "Student Email",
    "assessor_name":       "Assessor Name",
    "subject":             "Subject",
    "item_code":           "Item Code",
    "date":                "Date",
    "clinical_incident":   "Clinical Incident",
    "assessor_reflection": "Assessor Reflection",
    "student_reflection":  "Student Reflection",
    "assessmentid":        "Assessment ID",
    "form_code":           "Form Code",
}

# Read back the other way in loadWeeklyFiles. Built once so a typo in one map can't
# desynchronise the two directions.
WEEKLY_SHEET_COLUMN_LABELS_INVERSE = {v: k for k, v in WEEKLY_SHEET_COLUMN_LABELS.items()}


# ---------------------------------------------------------------------------------------
# Weekly sheet ATTENDANCE layer (added 2026-08-18).
#
# Two questions the sheet could not answer before:
#   "who was not assessed at all?"          -> a blank row per absentee, greyed
#   "did anyone get more than one form?"    -> those students' rows go amber
#
# The absentee rows come from the cohort roster (BOH2/BOH2 Roster 2026.xlsx via loadRoster).
# No roster file, no absentee rows; the counts still reach the Session Summary sheet, so
# DDS2 (which has no roster) gets the summary and nothing else.
#
# A placeholder row carries the student's number and name and NOTHING else — in particular
# no item_code — which is how BOTH the styling (grey where Item Code is blank) and
# loadWeeklyFiles (drop those rows) recognise it. The analysis chain never sees them.
#
# HISTORY: 18 Aug 2026 this also wrote a per-row `Forms` column carrying that student's
# form count. It was dropped the same day — the number is identical down every row of a
# student, and the Session Summary already names the absentees and the duplicates. The
# column can be brought back with addForms=True; everything that reads it still works.

WEEKLY_FORMS_COL = "Forms"

# Colouring for the Forms column, used only when addForms=True. 0 = nobody assessed this
# student, 2+ = more than one form where the session expects one.
WEEKLY_FORMS_HIGHLIGHT = {0: "grey", 2: "amber", 3: "red"}

# Applied to a duplicate student's rows when there is no Forms column to colour.
WEEKLY_DUPLICATE_COLOR = "amber"


def addWeeklyAttendance(df, roster=None, formsCol=WEEKLY_FORMS_COL,
                        idCol="student_number", nameCol="student_name",
                        countCol="assessmentid", addForms=False, addAbsent=True):
    """Count forms per student and add one blank row per roster student with no data.

    Returns ``(out, stats)``. ``stats`` feeds sessionSummaryLines and styleWeeklySheet and
    holds: expected, assessed, missing, duplicate, extra (in data but not on the roster),
    absentDf, duplicateDf, duplicateIds, extraDf, itemCodes, hasRoster.

    The form count is ALWAYS computed — it is what `duplicate` / `duplicateIds` are built
    from — but it is only written into the sheet as a column when ``addForms=True``
    (off by default since 18 Aug 2026; the value is identical down every row of a student
    and the Session Summary names the duplicates instead).

    The count is of DISTINCT ``countCol`` (assessmentid), not rows: a DDS2 form carrying
    three checklists is ONE form on three rows. Falls back to a row count if assessmentid
    is absent — which over-counts multi-checklist forms, so keep assessmentid in the frame
    until after this call.

    Placeholder rows are appended, not sorted — call applyRosterOrder afterwards to fold
    them into last-name order. They deliberately carry no item_code (see loadWeeklyFiles).
    """
    out = df.copy()
    stats = {"expected": None, "assessed": 0, "missing": 0, "duplicate": 0, "extra": 0,
             "absentDf": pd.DataFrame(), "duplicateDf": pd.DataFrame(),
             "extraDf": pd.DataFrame(), "duplicateIds": [], "itemCodes": [],
             "hasRoster": False}

    if idCol not in out.columns:
        return out, stats

    if ITEM_CODE_COL in out.columns:
        stats["itemCodes"] = sorted(out[ITEM_CODE_COL].dropna().astype(str).unique())
    stats["assessed"] = int(out[idCol].nunique())

    # ── the count, computed BEFORE any placeholder row exists ──────────────────
    if countCol in out.columns:
        perStudent = out.groupby(idCol)[countCol].nunique()
    else:
        perStudent = out.groupby(idCol).size()
    if addForms:
        out[formsCol] = out[idCol].map(perStudent).fillna(0)
    dup = perStudent[perStudent > 1]
    stats["duplicate"] = int(len(dup))
    stats["duplicateIds"] = list(dup.index)
    if len(dup):
        names = (out.drop_duplicates(idCol).set_index(idCol)[nameCol]
                 if nameCol in out.columns else None)
        stats["duplicateDf"] = pd.DataFrame({
            idCol: dup.index,
            nameCol: [names.get(i) if names is not None else None for i in dup.index],
            formsCol: dup.values})

    # ── one blank row per roster student with nothing in the data ──────────────
    hasRoster = roster is not None and not getattr(roster, "empty", True)
    if hasRoster:
        stats["hasRoster"] = True
        stats["expected"] = int(len(roster))
        present = set(out[idCol].dropna())
        absent = roster[~roster[idCol].isin(present)].copy()
        stats["missing"] = int(len(absent))
        stats["extra"] = int(len(present - set(roster[idCol].dropna())))
        if stats["extra"]:
            extra = out[~out[idCol].isin(set(roster[idCol].dropna()))]
            stats["extraDf"] = extra[[c for c in (idCol, nameCol) if c in extra.columns]] \
                .drop_duplicates().reset_index(drop=True)
        if addAbsent and not absent.empty:
            blanks = pd.DataFrame(index=range(len(absent)), columns=out.columns)
            blanks[idCol] = absent[idCol].values
            if nameCol in blanks.columns and {"first_name", "last_name"}.issubset(absent.columns):
                blanks[nameCol] = (absent["first_name"].fillna("").astype(str) + " "
                                   + absent["last_name"].fillna("").astype(str)).str.strip().values
            if formsCol in blanks.columns:
                blanks[formsCol] = 0
            stats["absentDf"] = pd.DataFrame({
                idCol: blanks[idCol].values,
                nameCol: blanks[nameCol].values if nameCol in blanks.columns else None,
                "notes": (absent["notes"].values if "notes" in absent.columns else None)})
            # dropna(how='all') keeps the FutureWarning about all-NA frames away and is a
            # no-op here — every placeholder carries at least a student number.
            out = pd.concat([out, blanks.dropna(axis=1, how="all")], ignore_index=True)
            # student_number must not become 1746763.0 in the sheet just because the
            # placeholder rows introduced NaNs elsewhere.
            if pd.api.types.is_numeric_dtype(df[idCol]):
                out[idCol] = pd.to_numeric(out[idCol], errors="coerce").astype("Int64")

    if addForms and formsCol in out.columns:
        out[formsCol] = pd.to_numeric(out[formsCol], errors="coerce").fillna(0).astype(int)
        # Sits with the identity block, not the scores: on an absentee row it is the only
        # non-blank cell after the name, which is what makes the sheet read as a register.
        anchor = nameCol if nameCol in out.columns else idCol
        cols = [c for c in out.columns if c != formsCol]
        at = cols.index(anchor) + 1
        out = out[cols[:at] + [formsCol] + cols[at:]]

    return out, stats


def sessionSummaryLines(stats, date=None, cohort=None, stream=None, formsCol=WEEKLY_FORMS_COL):
    """(label, value) rows for writeDescriptionSheet — the Session Summary sheet."""
    lines = [("Session", None)]
    if date:
        lines.append(("Date", str(date)))
    if cohort:
        lines.append(("Cohort", str(cohort)))
    if stream:
        lines.append(("Stream", str(stream)))
    if stats.get("itemCodes"):
        lines.append(("Item code(s)", ", ".join(stats["itemCodes"])))
    lines += [(None, None), ("Attendance", None)]

    if stats.get("hasRoster"):
        lines.append(("Expected (roster)", str(stats["expected"])))
    lines.append(("Assessed", str(stats["assessed"])))
    if stats.get("hasRoster"):
        lines.append(("Not assessed", str(stats["missing"])))
    lines.append(("More than one form", str(stats["duplicate"])))
    if stats.get("extra"):
        lines.append(("In data but not on the roster", str(stats["extra"])))
    if not stats.get("hasRoster"):
        lines.append(("Roster", "Not found for this cohort — no absentee rows were added. "
                                "Add <COHORT>/<COHORT> Roster <year>.xlsx to enable them."))

    def _names(frame, extra=None):
        if frame is None or frame.empty:
            return None
        parts = []
        for _, row in frame.iterrows():
            label = f"{row.iloc[0]} {row.iloc[1]}" if len(row) > 1 and pd.notna(row.iloc[1]) \
                else str(row.iloc[0])
            if extra and extra in frame.columns and pd.notna(row.get(extra)):
                label += f" ({row[extra]})"
            parts.append(label.strip())
        return "; ".join(parts)

    absent = _names(stats.get("absentDf"), extra="notes")
    if absent:
        lines += [(None, None), ("Not assessed this session", None), ("Students", absent)]
    dupes = _names(stats.get("duplicateDf"), extra=formsCol)
    if dupes:
        lines += [(None, None), ("More than one form", None), ("Students", dupes)]
    extras = _names(stats.get("extraDf"))
    if extras:
        lines += [(None, None), ("Not on the roster", None), ("Students", extras)]

    lines += [(None, None), ("How to read this", None),
              ("Grey rows", "Roster students with no data this session — the row is a "
                            "placeholder carrying only a number and a name. It has no item "
                            "code, which is how loadWeeklyFiles drops it, so an absentee "
                            "never reaches the combined workbook or the flagging."),
              ("Amber student number", "That student has more than one form this session — a "
                                       "repeat, or a duplicate submission. Every session is "
                                       "expected to be one form per student."),
              ("Counting", "'More than one form' counts distinct forms, not rows. One form "
                           "carrying several checklists is one form on several rows."),
              ("Absent students", "Cross-check against leave applications before treating a "
                                  "blank row as a missed session — the roster cannot know "
                                  "about leave.")]
    return lines


def formatWeeklySheet(df, dropCols=None, labels=None, mcBefore=None):
    """Drop, reorder and relabel a weekly-sim frame for writing to Excel.

    Returns a NEW frame; the caller's is untouched. Pass dropCols=[] / labels={} /
    mcBefore=None to switch any one of the three steps off.

    The MC move is positional, not a full column list, so a stream that ships an unusual
    column set (or a future column added to getWeeklySimDataSql) keeps its natural order
    instead of silently vanishing.
    """
    dropCols = WEEKLY_SHEET_DROP_COLS if dropCols is None else dropCols
    labels = WEEKLY_SHEET_COLUMN_LABELS if labels is None else labels
    mcBefore = WEEKLY_SHEET_MC_BEFORE if mcBefore is None else mcBefore

    out = df.drop(columns=[c for c in (dropCols or []) if c in df.columns])

    if mcBefore:
        cols = list(out.columns)
        mcCols = _sortMcColumns([c for c in cols if re.match(r"^MC\d+$", str(c))])
        # mcBefore is given as the FINAL label, but this runs pre-rename — accept either.
        anchors = {mcBefore, WEEKLY_SHEET_COLUMN_LABELS_INVERSE.get(mcBefore, mcBefore)}
        rest = [c for c in cols if c not in mcCols]
        anchorAt = next((i for i, c in enumerate(rest) if c in anchors), None)
        if mcCols and anchorAt is not None:
            out = out[rest[:anchorAt] + mcCols + rest[anchorAt:]]
        elif mcCols:
            out = out[rest + mcCols]          # anchor absent: leave MC at the end

    if labels:
        out = out.rename(columns={c: labels[c] for c in out.columns if c in labels})
    return out


# ---------------------------------------------------------------------------------------
# DDS2 simulation STREAMS.
#
# From semester 2 DDS2 sim runs three parallel subjects on three different weekdays, each
# with its own checklist family. They are told apart by ITEM CODE, never by subject code:
# students pick the subject themselves and get it wrong often (measured on the 2026 data,
# 76 of 1,859 semester-2 forms carry the wrong subject — 37 FP and 16 Endo forms tagged
# DENT90146, 23 Paeds tagged DENT90148). The item code, by contrast, comes from the
# checklist the assessor actually opened, and lines up with the weekday almost perfectly
# (Paeds 526/526 Mon, FP 733/737 Tue, Endo 578/581 Wed — the strays are catch-ups).
#
#   codePatterns are fnmatch globs and are FULL matches, which is what keeps them disjoint:
#   'Week-*' matches 'Week-01' but NOT 'FP-Week-01' or 'Paeds-2026-Week-01'.
#   weekday / subject are recorded for reporting and validation only — nothing routes on them.
#   folder '' means the base Weekly Sim folder itself (semester 1 workbooks already live there).
#   codePatterns = None means route by DATE RANGE ALONE — everything in the window belongs
#   to the stream. That is right for BOH2, which runs ONE weekly session whose checklist
#   code is the free-text task name ('14MODB (534 577) (preparation)'): there is no stable
#   pattern to match, and no ambiguity to resolve because nothing else shares the day.
SIM_STREAMS = {
    "DDS2": {
        # endDate is None on purpose: students still complete semester-1 checklists
        # (2026-Week-xx) during semester 2 as catch-ups — 15 such forms by 12 Aug 2026 —
        # and that work belongs to the semester-1 record, not to whichever stream owned
        # the day. Set an endDate here if you ever want semester 1 frozen instead.
