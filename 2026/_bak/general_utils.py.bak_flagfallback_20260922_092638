def toRowsOsce(records):
    rows = []
    for r in records:
        student = r.get("student")
        if not student or not isinstance(student, str):
            continue
        if student.lower() in excludeNames:
            continue

        assessorData = (r.get("form") or {}).get("data", {}).get("assessor", {})

        # Extract all scale-* keys as flat {key: int}
        scalesData = {}
        for k, v in assessorData.items():
            if k.startswith("scale-") and isinstance(v, dict):
                raw = v.get("scale")
                if raw is not None:
                    try:
                        scalesData[k] = int(raw)
                    except (ValueError, TypeError):
                        pass

        globalRating = scalesData.get("scale-global-rating")

        # First non-scale key is the checklist
        checklistKey, checklistData = None, None
        for k, v in assessorData.items():
            if not k.startswith("scale-") and isinstance(v, dict):
                checklistKey = k
                checklistData = v
                break

        rows.append({
            "assessmentId":   r.get("id"),
            "student_name":   student,
            "assessor_name":  r.get("assessor"),
            "datetimeUtc":    r.get("datetime"),
