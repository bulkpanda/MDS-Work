def formatCombinedSheet(df, idCols=None, labels=None, protect=None):
    """Relabel a combined-workbook frame for writing. Returns ``(out, outIdCols)``.

    ``out`` is a NEW frame; the caller's is untouched. ``outIdCols`` is ``idCols`` mapped
    through the same labels, so styleCombinedSheet / highlightRepeatAssessors keep
    resolving after the rename — pass it on rather than reusing the original list.

    Only names present in ``labels`` are renamed, so item-code columns pass through
    untouched. ``protect`` is an explicit belt-and-braces set for a column that must keep
    its name even if it collides with a label key (no real case today).

    ``labels={}`` is the escape hatch: it returns the frame and idCols unchanged, which
    reproduces the pre-2026-08-18 workbook exactly.
    """
    labels = COMBINED_SHEET_COLUMN_LABELS if labels is None else labels
    protect = set(protect or ())
    if not labels:
        return df.copy(), list(idCols or [])
    mapping = {c: labels[c] for c in df.columns if c in labels and c not in protect}
    out = df.rename(columns=mapping)
    outIdCols = [mapping.get(c, c) for c in (idCols or [])]
    return out, outIdCols


def resolveLevelColors(spec):
    """Normalise a level spec into {float(level): (bgHex, textHex)}.

    Accepts a dict of level -> palette name or (bg, text) pair, a list/set of levels
    (all red), or None. Levels are keyed as floats so 2, 2.0 and '2' all match the value
    openpyxl hands back.
    """
    if spec is None:
        return {}
    if isinstance(spec, str):                       # "scale" is handled by the caller
        return {}
    if isinstance(spec, dict):
        items = spec.items()
    else:
        items = [(lvl, "red") for lvl in spec]
    out = {}
    for level, colour in items:
        if isinstance(colour, str):
            if colour not in CW_LEVEL_PALETTE:
                raise ValueError(f"Unknown colour {colour!r} — use one of "
                                 f"{list(CW_LEVEL_PALETTE)} or an explicit (bg, text) pair.")
            colour = CW_LEVEL_PALETTE[colour]
        try:
            out[float(level)] = tuple(colour)
        except (TypeError, ValueError):
            raise ValueError(f"Level {level!r} is not numeric.")
    return out


def highlightLevelCells(ws, df, valueCols, levelColors, firstRow=2):
    """Fill only the cells whose value matches one of the listed levels.

    Used for GR and PR, where a full gradient over every cell saturates the sheet and the
    only thing anyone looks for is the low end.
    """
    colours = resolveLevelColors(levelColors)
    if not colours:
        return 0
    colIndex = {col: i + 1 for i, col in enumerate(df.columns)}
    n = 0
    for col in valueCols:
        cIdx = colIndex[col]
        for rOffset, val in enumerate(df[col]):
            if pd.isna(val):
                continue
            try:
                hit = colours.get(float(val))
            except (TypeError, ValueError):
                continue
            if hit:
                bg, txt = hit
                cell = ws.cell(row=firstRow + rOffset, column=cIdx)
                cell.fill = cwFill(bg)
                cell.font = Font(name="Arial", size=9, color=txt, bold=True)
                n += 1
    return n


def cwFill(hexColor):
    return PatternFill(start_color=hexColor, end_color=hexColor, fill_type="solid")


def cwBorder():
    s = Side(style="thin", color="D9D9D9")
    return Border(left=s, right=s, top=s, bottom=s)


def styleHeaderRow(ws, nCols, row=1, height=32):
    """Navy column headers, white bold text, wrapped and centred."""
    for c in range(1, nCols + 1):
        cell = ws.cell(row=row, column=c)
        cell.font = CW_HEADER_FONT
        cell.fill = cwFill(CW_NAVY)
        cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
        cell.border = cwBorder()
    ws.row_dimensions[row].height = height


def freezeAfter(ws, nIdCols, headerRow=1):
    """Freeze the header row and the leading identity columns."""
    ws.freeze_panes = f"{get_column_letter(nIdCols + 1)}{headerRow + 1}"


def fillEmptyCells(ws, firstRow, lastRow, firstCol, lastCol, color=CW_EMPTY_BG):
    """Grey out cells with no value — 'not assessed', which is different from a low score."""
    n = 0
    for r in range(firstRow, lastRow + 1):
        for c in range(firstCol, lastCol + 1):
            cell = ws.cell(row=r, column=c)
            if cell.value is None or (isinstance(cell.value, str) and not cell.value.strip()):
                cell.fill = cwFill(color)
                n += 1
    return n


def applyGrColorScale(ws, firstRow, lastRow, firstCol, lastCol):
    """Fixed 1-5 red -> amber -> green scale over a block of GR cells."""
    if lastRow < firstRow or lastCol < firstCol:
        return
    rng = (f"{get_column_letter(firstCol)}{firstRow}:"
           f"{get_column_letter(lastCol)}{lastRow}")
    ws.conditional_formatting.add(rng, ColorScaleRule(
        start_type="num", start_value=GR_SCALE_MIN, start_color=CW_RED_BG,
        mid_type="num",   mid_value=GR_SCALE_MID,   mid_color=CW_AMBER_BG,
        end_type="num",   end_value=GR_SCALE_MAX,   end_color=CW_GREEN_BG))


def highlightBelowThreshold(ws, df, thresholds, valueCols, firstRow=2, amberMargin=0.0):
    """Red-fill every cell at or below its column's cutoff.

    ``thresholds`` is a per-column Series/dict (one cutoff per item code). Columns with
    no cutoff are left alone rather than being treated as zero. ``amberMargin`` > 0 also
    ambers cells within that fraction above the cutoff.
    """
    colIndex = {col: i + 1 for i, col in enumerate(df.columns)}
    nRed = nAmber = 0
    for col in valueCols:
        cutoff = thresholds.get(col) if hasattr(thresholds, "get") else None
        if cutoff is None or pd.isna(cutoff):
            continue
        cIdx = colIndex[col]
        for rOffset, val in enumerate(df[col]):
            if pd.isna(val):
                continue
            cell = ws.cell(row=firstRow + rOffset, column=cIdx)
            if val <= cutoff:
                cell.fill = cwFill(CW_RED_BG)
                cell.font = Font(name="Arial", size=9, color=CW_RED_TEXT, bold=True)
                nRed += 1
            elif amberMargin and val <= cutoff * (1 + amberMargin):
                cell.fill = cwFill(CW_AMBER_BG)
                cell.font = Font(name="Arial", size=9, color=CW_AMBER_TEXT)
                nAmber += 1
    return nRed, nAmber


# ── Per-student GR/PR level-count summary columns (scores_flagged sheet) ──────
# COUNT_LEVEL_SOURCES maps a spec's source token to the wide combined-workbook frame
# it reads. exportCombinedNotebook builds those frames; these helpers turn one into a
# per-student count column. Kept data-driven so columns can be added/re-levelled from
# the notebook config without touching this module.
COUNT_LEVEL_SOURCES = {"GR": "global_ratings", "PR": "practice_readiness"}


def countLevelColumnLabel(source, levels):
    """Header for a level-count column, generated FROM the levels so it always matches
    the config, e.g. ('GR', (2, 1)) -> 'GR Level 2 & 1 Count', ('PR', (1,)) -> 'PR Level 1 Count'."""
    return f"{source} Level {' & '.join(str(l) for l in levels)} Count"


def countLevelsPerStudent(wideDf, idCols, levels, excludeCols=None):
    """Series (indexed by the first id column) giving, per student, the number of
    item-code cells in *wideDf* whose value is one of *levels*.

    *wideDf* is a combined-workbook wide frame: id columns, one column per item code,
    plus a trailing 'Avg Score'. Blank / non-numeric cells never count. Returns None
    when there is nothing to count so the caller can fall back to zeros.
    """
    if wideDf is None or wideDf.empty or not levels:
        return None
    keyCol = idCols[0]
    valueCols = [c for c in wideDf.columns if c not in idCols and c != "Avg Score"]
    if excludeCols:
        _skip = set(excludeCols)
        valueCols = [c for c in valueCols if c not in _skip]
    if not valueCols:
        return None
    wanted = {float(l) for l in levels}
    vals = wideDf[valueCols].apply(pd.to_numeric, errors="coerce")
    counts = vals.isin(wanted).sum(axis=1).astype("Int64")
    return pd.Series(counts.values, index=wideDf[keyCol].values)


def styleCombinedSheet(ws, df, idCols, kind="plain", thresholds=None,
                       amberMargin=0.0, greyEmpty=True, levelColors=GR_LEVEL_COLORS,
                       extraMetaCols=None, skipHighlightCols=None):
    """Header + freeze panes + borders + per-kind colouring for one combined-workbook sheet.

    kind:
      'gr'      highlight only the levels in ``levelColors`` (default 1 red, 2 amber).
                Pass levelColors="scale" for the old full 1-5 gradient, or None for none.
      'score'   red only where the value is at or below that item code's cutoff
      'flagged' same as 'score', plus the Pass/Fail column coloured
      'plain'   header and freeze panes only
    """
    nRows, nCols = len(df), len(df.columns)
    styleHeaderRow(ws, nCols)
    freezeAfter(ws, len(idCols))
    if nRows == 0:
        return

    # COMBINED_META_COLS carries BOTH spellings of low_count, so this works on a sheet
    # written before the 2026-08-18 relabel and one written after.
    metaCols = COMBINED_META_COLS | set(extraMetaCols or ())
    valueCols = [c for c in df.columns if c not in idCols and c not in metaCols]
    if not valueCols:
        return
    # Columns kept as data but excluded from highlighting (still bordered/greyed).
    _skipHL = set(skipHighlightCols or ())
    highlightCols = [c for c in valueCols if c not in _skipHL]
    firstCol = df.columns.get_loc(valueCols[0]) + 1
    lastCol = df.columns.get_loc(valueCols[-1]) + 1
    firstRow, lastRow = 2, nRows + 1

    for r in range(firstRow, lastRow + 1):
        for c in range(1, nCols + 1):
            ws.cell(row=r, column=c).border = cwBorder()

    if kind == "gr":
        if isinstance(levelColors, str) and levelColors.lower() == "scale":
            applyGrColorScale(ws, firstRow, lastRow, firstCol, lastCol)
        else:
            highlightLevelCells(ws, df, highlightCols, levelColors, firstRow)
    elif kind in ("score", "flagged") and thresholds is not None:
        highlightBelowThreshold(ws, df, thresholds, highlightCols, firstRow, amberMargin)

    if kind == "flagged" and "Pass/Fail" in df.columns:
        pfCol = df.columns.get_loc("Pass/Fail") + 1
        for rOffset, val in enumerate(df["Pass/Fail"]):
            cell = ws.cell(row=firstRow + rOffset, column=pfCol)
            if val == "Fail":
                cell.fill = cwFill(CW_RED_BG)
                cell.font = Font(name="Arial", size=9, color=CW_RED_TEXT, bold=True)
            else:
                cell.fill = cwFill(CW_GREEN_BG)
                cell.font = Font(name="Arial", size=9, color=CW_GREEN_TEXT)

    # Grey AFTER the colour work: a blank cell means "not assessed", which must not be
    # confused with a low score, and the GR colour scale simply skips blanks.
    if greyEmpty:
        fillEmptyCells(ws, firstRow, lastRow, firstCol, lastCol)


ASSESSOR_REPEAT_COLORS = {2: "amber", 3: "red"}     # count -> colour, applied as ">= count"


def buildAssessorPivot(longDf, idCols, pivotCol=ITEM_CODE_COL, assessorCol="assessor_name",
                       sep=" | "):
    """student x item code grid filled with assessor name(s), for spotting repeat assessors.

    A student who sat the same item code twice shows BOTH names joined by ``sep`` — a repeat
    is exactly where a second exposure to the same assessor turns up, so dropping one would
    defeat the point.

    Returns (wideDf, repeatCounts):
      wideDf       idCols + one column per item code + n_forms, n_assessors,
                   most_seen_assessor, most_seen_count
      repeatCounts {(idTuple, assessorName): timesSeen} — drives the highlighting.
    """
    cols = idCols + [pivotCol, assessorCol]
    missing = [c for c in cols if c not in longDf.columns]
    if missing:
        raise KeyError(f"buildAssessorPivot needs column(s) {', '.join(missing)}.")

    df = longDf[cols + (["date"] if "date" in longDf.columns else [])].dropna(subset=[assessorCol])
    df = df.drop_duplicates()
    if df.empty:
        return pd.DataFrame(columns=idCols), {}

    sortCols = idCols + [pivotCol] + (["date"] if "date" in df.columns else [])
    df = df.sort_values(sortCols)

    wide = (df.groupby(idCols + [pivotCol])[assessorCol]
              .agg(lambda s: sep.join(dict.fromkeys(s)))      # de-dup, keep order
              .unstack(pivotCol))
    wide = wide.reindex(sorted(wide.columns), axis=1).reset_index()

    # How many times each student saw each assessor, across all their item codes.
    perStudent = df.groupby(idCols + [assessorCol]).size()
    repeatCounts = {}
    for key, n in perStudent.items():
        ids, name = tuple(key[:len(idCols)]), key[len(idCols)]
        repeatCounts[(ids, name)] = int(n)

    stats = df.groupby(idCols).agg(
        n_forms=(assessorCol, "size"),
        n_assessors=(assessorCol, "nunique")).reset_index()
    top = (perStudent.rename("n").reset_index()
             .sort_values(idCols + ["n"], ascending=[True] * len(idCols) + [False])
             .groupby(idCols).head(1)
             .rename(columns={assessorCol: "most_seen_assessor", "n": "most_seen_count"}))
    wide = wide.merge(stats, on=idCols, how="left").merge(top, on=idCols, how="left")
    return wide, repeatCounts


def highlightRepeatAssessors(ws, df, idCols, repeatCounts, valueCols,
                             levelColors=ASSESSOR_REPEAT_COLORS, sep=" | ", firstRow=2):
    """Colour cells where the student has seen that assessor more than once.

    ``levelColors`` maps a MINIMUM count to a palette name, e.g. {2: 'amber', 3: 'red'} —
    the highest matching threshold wins, so 3+ shows red and exactly 2 shows amber.
    ``None`` (or an empty dict) means NO highlighting — the default lives in the signature
    rather than behind a None-check, so passing None genuinely turns it off.
    """
    tiers = sorted(((int(k), CW_LEVEL_PALETTE.get(v, v)) for k, v in (levelColors or {}).items()),
                   reverse=True)
    if not tiers:
        return 0
    colIndex = {col: i + 1 for i, col in enumerate(df.columns)}
    n = 0
    for rOffset, (_, row) in enumerate(df.iterrows()):
        ids = tuple(row[c] for c in idCols)
        for col in valueCols:
            val = row[col]
            if not isinstance(val, str) or not val.strip():
                continue
            best = max((repeatCounts.get((ids, name.strip()), 0)
                        for name in val.split(sep)), default=0)
            hit = next((colour for threshold, colour in tiers if best >= threshold), None)
            if hit:
                bg, txt = hit
                cell = ws.cell(row=firstRow + rOffset, column=colIndex[col])
                cell.fill = cwFill(bg)
                cell.font = Font(name="Arial", size=9, color=txt, bold=True)
                n += 1
    return n


# Both spellings on purpose: styleWeeklySheet is handed the RELABELLED frame for a new
# build, but is still callable on a raw snake_case frame. Names absent from the frame are
# ignored, so listing both costs nothing.
WEEKLY_FREEZE_AFTER = ["student_number", "last_name", "first_name", "student_name",
                       "Student Number", "Last Name", "First Name", "Student Name"]


# Both spellings, because styleWeeklySheet is handed the RELABELLED frame for a new build
# but is still callable on a raw snake_case one.
WEEKLY_ITEM_CODE_COLS = (ITEM_CODE_COL, "Item Code")
WEEKLY_ID_COLS = ("student_number", "Student Number")


def _firstPresent(df, names):
    return next((c for c in names if c in df.columns), None)


def styleWeeklySheet(ws, df, grLevels=None, mcLevels=None, grCols=("GR",),
                     freezeAfterCols=None, greyEmpty=True,
                     formsCol=WEEKLY_FORMS_COL, formsLevels=None, greyAbsentRows=True,
                     absentCol=None, duplicateIds=None, idCol=None,
                     duplicateColor=WEEKLY_DUPLICATE_COLOR):
    """Header, freeze panes and level colouring for a per-date weekly workbook.

    grLevels  colouring for the GR column(s) — default {1:'red', 2:'amber', 5:'green'}.
              Add 'TS','CS','PS','PR','PEC' to ``grCols`` to treat the other 1-5 scales
              the same way; they are left plain by default.
    mcLevels  colouring for the MC columns. Pass the value that matches the ACTIVE scale
              (see WEEKLY_MC_HIGHLIGHT_BY_SCALE) — 1 means "worst" on the 1-5 scale but
              "best" on the 0-1 scale, so the wrong one here inverts the meaning.

    Attendance (§6f) — the sheet has no Forms column by default, so both signals are read
    off the data itself:
    greyAbsentRows  fill the whole row light grey where ``absentCol`` is blank. An
                  absentee placeholder row is precisely "a row with no item code", so
                  ``absentCol`` defaults to the item-code column under either spelling.
                  A real row can never have a blank item code — the extraction query
                  inner-joins the checklist CTE.
    duplicateIds  student ids with more than one form this session (stats['duplicateIds']
                  from addWeeklyAttendance). Their id cell goes ``duplicateColor``. Passed
                  in rather than recomputed because assessmentid — the only correct thing
                  to count — has already been dropped from the sheet by this point.
    formsCol / formsLevels
                  only used when the sheet still HAS a Forms column (addForms=True); see
                  WEEKLY_FORMS_HIGHLIGHT. Note it matches EXACT values, so 3 means exactly
                  three forms, not three or more.
    """
    grLevels = WEEKLY_GR_HIGHLIGHT if grLevels is None else grLevels
    nRows, nCols = len(df), len(df.columns)
    styleHeaderRow(ws, nCols)

    freezeAfterCols = WEEKLY_FREEZE_AFTER if freezeAfterCols is None else freezeAfterCols
    present = [c for c in freezeAfterCols if c in df.columns]
    nFreeze = max((df.columns.get_loc(c) for c in present), default=-1) + 1
    ws.freeze_panes = f"{get_column_letter(nFreeze + 1)}2" if nFreeze else "A2"
    if nRows == 0:
        return

    mcCols = [c for c in df.columns if re.match(r"^MC\d+$", str(c))]
    grPresent = [c for c in grCols if c in df.columns]
    if grPresent and grLevels:
        highlightLevelCells(ws, df, grPresent, grLevels)
    if mcCols and mcLevels:
        highlightLevelCells(ws, df, mcCols, mcLevels)
    if greyEmpty and mcCols:
        first = df.columns.get_loc(mcCols[0]) + 1
        last = df.columns.get_loc(mcCols[-1]) + 1
        fillEmptyCells(ws, 2, nRows + 1, first, last)

    # ── Attendance ────────────────────────────────────────────────────────────
    # Row fills go on FIRST so the per-cell colours below survive them.
    absentCol = _firstPresent(df, WEEKLY_ITEM_CODE_COLS) if absentCol is None else absentCol
    if greyAbsentRows and absentCol in df.columns:
        fill = cwFill(CW_LIGHT_GREY)
        # POSITIONAL, matching highlightLevelCells — the frame's index may not be a clean
        # RangeIndex after the concat that added the placeholder rows.
        for rOffset, val in enumerate(df[absentCol]):
            if pd.isna(val):
                for col in range(1, nCols + 1):
                    ws.cell(row=2 + rOffset, column=col).fill = fill

    idCol = _firstPresent(df, WEEKLY_ID_COLS) if idCol is None else idCol
    if duplicateIds and idCol in df.columns and duplicateColor:
        bg, txt = CW_LEVEL_PALETTE[duplicateColor] if isinstance(duplicateColor, str) \
            else tuple(duplicateColor)
        # Compare as strings: the id column is Int64 in the frame but the ids come from a
        # groupby index that may be plain int64, and 1746763 != numpy.int64(1746763) is
        # not a risk worth taking.
        wanted = {str(i) for i in duplicateIds}
        cIdx = df.columns.get_loc(idCol) + 1
        for rOffset, val in enumerate(df[idCol]):
            if pd.notna(val) and str(val) in wanted:
                cell = ws.cell(row=2 + rOffset, column=cIdx)
                cell.fill = cwFill(bg)
                cell.font = Font(name="Arial", size=9, color=txt, bold=True)

    if formsCol in df.columns:
        formsLevels = WEEKLY_FORMS_HIGHLIGHT if formsLevels is None else formsLevels
        if formsLevels:
            highlightLevelCells(ws, df, [formsCol], formsLevels)


def writeDescriptionSheet(wb, lines, title="How to read this workbook", sheetName="Description",
                          index=0):
    """Leading sheet documenting how the numbers were produced.

    ``lines`` is a list of ('section', None) headers, ('label', 'value') rows, or
    (None, None) spacers. ``index`` is the sheet position: 0 (default) puts it first so
    it opens first — what the combined workbook wants. ``index=None`` appends instead,
    which is what the weekly workbook wants so ``Sheet1`` still opens first.
    """
    ws = wb.create_sheet(sheetName) if index is None else wb.create_sheet(sheetName, index)
    ws.sheet_view.showGridLines = False
    ws.column_dimensions["A"].width = 34
    ws.column_dimensions["B"].width = 104

    ws.merge_cells("A1:B1")
    c = ws.cell(row=1, column=1, value=title)
    c.font = Font(name="Arial", bold=True, size=14, color=CW_WHITE)
    c.fill = cwFill(CW_NAVY)
    c.alignment = Alignment(horizontal="left", vertical="center")
    ws.row_dimensions[1].height = 28

    r = 3
    for label, value in lines:
        if label is None and value is None:
            r += 1
            continue
        if value is None:                                  # section header
            ws.merge_cells(start_row=r, start_column=1, end_row=r, end_column=2)
            cell = ws.cell(row=r, column=1, value=label)
            cell.font = CW_HEADER_FONT
            cell.fill = cwFill(CW_NAVY)
            cell.alignment = Alignment(horizontal="left", vertical="center")
            ws.row_dimensions[r].height = 20
        else:
            a = ws.cell(row=r, column=1, value=label)
            b = ws.cell(row=r, column=2, value=str(value))
            a.font, b.font = CW_BOLD_BODY, CW_BODY_FONT
            a.fill = cwFill(CW_LIGHT_GREY)
            a.alignment = Alignment(vertical="top")
            b.alignment = Alignment(vertical="top", wrap_text=True)
            a.border = b.border = cwBorder()
            ws.row_dimensions[r].height = max(15, 12 * (1 + len(str(value)) // 100))
        r += 1
    return ws


def describeLevelColors(spec):
    """Plain-English description of a GR/PR level spec, for the Description sheet.

    Public (no leading underscore) on purpose: the notebook uses `from general_utils import *`,
    which skips underscore-prefixed names, so a private helper called from a cell raises
    NameError at runtime.
    """
    if spec is None:
        return "not colour-coded."
    if isinstance(spec, str) and spec.lower() == "scale":
        return ("full 1-5 gradient — 1 = red, 3 = amber, 5 = green, across every cell.")
    colours = resolveLevelColors(spec)
    if not colours:
        return "not colour-coded."
    nameFor = {v: k for k, v in CW_LEVEL_PALETTE.items()}
    parts = [f"level {int(lvl) if float(lvl).is_integer() else lvl} = "
             f"{nameFor.get(rgb, 'custom')}" for lvl, rgb in sorted(colours.items())]
    return ("only these levels are highlighted (" + ", ".join(parts)
            + "); every other level is left plain so the sheet stays readable.")


def describeRepeatColors(spec):
    """Plain-English description of an assessor-repeat spec, for the Description sheet.

    Public for the same reason as describeLevelColors — `import *` skips `_name`."""
    colours = {} if spec is None else spec
    if not colours:
        return "Repeat pairings are not colour-coded."
    nameFor = {v: k for k, v in CW_LEVEL_PALETTE.items()}
    parts = [f"{nameFor.get(CW_LEVEL_PALETTE.get(c, c), c) if isinstance(c, str) else 'custom'}"
             f" from {int(n)} forms" for n, c in sorted(colours.items())]
    return ("Cells are coloured where that student has seen that assessor repeatedly ("
            + ", ".join(parts) + "); the highest matching threshold wins.")


def colourKeyLines(kind="all", levelColors=GR_LEVEL_COLORS, amberMargin=0.0):
    """The colour-key rows shared by every Description sheet."""
    amber = ("Within the amber margin just above the cutoff."
             if amberMargin else "Not in use this run (amberMargin = 0).")
    return [
        ("Colour key", None),
        ("Red cell (scores)", "Score at or below that item code's cutoff — this is what "
                              "low_count counts."),
        ("Amber cell (scores)", amber),
        ("Green / red Pass-Fail", "Overall outcome for the student."),
        ("Grey cell", "No assessment recorded for that item code — NOT a low score."),
        ("GR / PR highlighting", describeLevelColors(levelColors)),
    ]


