        assessmentid, student_name, assessor_name, datetimeutc, cohort, subject,
        submitted, version, global_rating, assessor_comments,
        checklist_key, checklist_data, form
    ) VALUES (
        :assessmentId, :student_name, :assessor_name, :datetimeUtc, :cohort, :subject,
        :submitted, :version, :global_rating, :assessor_comments,
        :checklist_key, :checklist_data, :form
    )
    {onconflict}
    """

def toRowsScbd(records):
    rows = []

    for r in records:
        student = r.get("student")
        if not student or not isinstance(student, str):
            continue
        if student.lower() in excludeNames:
            continue

        assessorData = (r.get("form") or {}).get("data", {}).get("assessor", {})

        grRaw = (assessorData.get("scale-global-rating") or {}).get("scale")
        globalRating = int(grRaw) if grRaw is not None else None

        # Checklist key = the one key that isn't comments or a scale
        checklistKey, checklistData = None, None
        for k, v in assessorData.items():
            if k not in ("comments", "scale-global-rating") and isinstance(v, dict):
                checklistKey = k
                checklistData = v
                break

        rows.append({
            "assessmentId":    r.get("id"),
            "student_name":    student,
            "assessor_name":   r.get("assessor"),
            "datetimeUtc":     r.get("datetime"),
