# Back-compat: the DDS2 registry used to be its own module-level dict.
DDS2_SIM_STREAMS = SIM_STREAMS["DDS2"]

DEFAULT_COHORT = "DDS2"
STREAM_ALL = "ALL"


def cohortStreams(cohort=DEFAULT_COHORT):
    """Stream registry for one cohort. An unknown cohort raises rather than returning
    nothing, so a typo can't produce an empty run that looks like 'no data'."""
    if cohort not in SIM_STREAMS:
        raise ValueError(f"No sim streams defined for cohort {cohort!r} — known: "
                         f"{list(SIM_STREAMS)}. Add an entry to SIM_STREAMS.")
    return SIM_STREAMS[cohort]


def weeklySimBaseFolder(cohort=DEFAULT_COHORT):
    """'DDS2/Weekly Sim', 'BOH2/Weekly Sim', …"""
    return os.path.join(cohort, "Weekly Sim")


def weeklySimFileTemplate(cohort=DEFAULT_COHORT):
    """'dds2 {date} assessment_data.xlsx' — lower-cased cohort, matching the existing
    DDS2 filenames exactly so nothing already on disk is orphaned."""
    return f"{cohort.lower()} {{date}} assessment_data.xlsx"


def resolveStreams(stream=STREAM_ALL, streams=None, cohort=DEFAULT_COHORT):
    """Normalise a stream selector into an ordered list of (key, cfg) pairs.

    Accepts 'ALL', a single key ('PAEDS'), a list of keys (['PAEDS','FP']), or a stream
    name ('Endodontics Sim'). Case-insensitive. Unknown keys raise rather than silently
    resolving to nothing.
    """
    streams = cohortStreams(cohort) if streams is None else streams
    if stream is None or (isinstance(stream, str) and stream.strip().upper() == STREAM_ALL):
        return list(streams.items())
    wanted = [stream] if isinstance(stream, str) else list(stream)
    byName = {cfg["name"].strip().casefold(): key for key, cfg in streams.items()}
    out = []
    for item in wanted:
        key = str(item).strip().upper()
        if key not in streams:
            key = byName.get(str(item).strip().casefold())
        if key is None or key not in streams:
            raise ValueError(f"Unknown stream {item!r} — use 'ALL' or any of {list(streams)}.")
        if key not in [k for k, _ in out]:
            out.append((key, streams[key]))
    return out


def streamForItemCode(itemCode, streams=None, cohort=DEFAULT_COHORT):
    """Which stream an item code belongs to, or None.

    Only streams that declare codePatterns can be identified from a code alone; a
    date-range stream (codePatterns=None, e.g. all of BOH2) returns None here, because
    the code genuinely carries no stream information."""
    streams = cohortStreams(cohort) if streams is None else streams
    for key, cfg in streams.items():
        if cfg.get("codePatterns") and matchesIgnoreCode(itemCode, cfg["codePatterns"]):
            return key
    return None


def streamForDate(date, streams=None, cohort=DEFAULT_COHORT):
    """Which stream a DATE falls in, for cohorts whose streams route on dates.

    Only consulted when the code patterns cannot answer — a date-range stream carries no
    information in the item code, so asking streamForItemCode about a BOH2 task name
    always returns None. The narrowest matching window wins, so a bounded stream beats a
    catch-all with no dates.
    """
    streams = cohortStreams(cohort) if streams is None else streams
    d = _asDateStr(date)
    if d is None:
        return None
    best, bestSpan = None, None
    for key, cfg in streams.items():
        lo, hi = _asDateStr(cfg.get("startDate")), _asDateStr(cfg.get("endDate"))
        if (lo and d < lo) or (hi and d > hi):
            continue
        span = (lo is not None) + (hi is not None)      # more bounds = more specific
        if bestSpan is None or span > bestSpan:
            best, bestSpan = key, span
    return best


def weeklySimFolder(baseFolder, streamKey, streams=None, cohort=DEFAULT_COHORT):
    """Folder a stream's workbooks live in. '' folder -> the base folder itself."""
    streams = cohortStreams(cohort) if streams is None else streams
    sub = streams.get(streamKey, {}).get("folder", "") if streamKey else ""
    return os.path.join(baseFolder, sub) if sub else baseFolder


def weeklySimFolders(baseFolder, stream=STREAM_ALL, streams=None, existingOnly=True,
                     cohort=DEFAULT_COHORT):
    """Folders to read for a stream selector — a list, so 'ALL' spans every subfolder.

    Deduplicated and (by default) restricted to folders that actually exist, so a pooled
    read doesn't fail on a stream you haven't built yet.
    """
    out = []
    for key, _ in resolveStreams(stream, streams, cohort):
        path = weeklySimFolder(baseFolder, key, streams, cohort)
        if path not in out and (not existingOnly or os.path.isdir(path)):
            out.append(path)
    return out


def weeklySimOutFolder(baseFolder, stream=STREAM_ALL, streams=None, cohort=DEFAULT_COHORT):
    """Where a stream-scoped analysis (combined / BLR / risk) should write.

    A single stream writes into that stream's own folder; 'ALL' or several streams
    write into the base folder, since the result spans them.
    """
    selected = resolveStreams(stream, streams, cohort)
    if len(selected) == 1:
        return weeklySimFolder(baseFolder, selected[0][0], streams, cohort)
    return baseFolder


def weeklySimOutPath(baseFolder, filename, stream=STREAM_ALL, period=None, streams=None,
                     cohort=DEFAULT_COHORT):
    """Full, collision-free output path for a stream-scoped analysis.

    Single stream  -> that stream's own folder, plain filename.
    Several streams-> base folder with ' (All streams)' inserted before the extension.
    That suffix is not cosmetic: semester 1's folder IS the base folder, so a pooled
    run would otherwise overwrite the semester-1 workbook of the same name.
    ``period`` (optional) adds the usual ' (FHY)' / ' (SHY)' suffix on top.
    """
    selected = resolveStreams(stream, streams, cohort)
    path = os.path.join(weeklySimOutFolder(baseFolder, stream, streams, cohort), filename)
    if len(selected) > 1:
        root, ext = os.path.splitext(path)
        path = f"{root} (All streams){ext}"
    return periodSuffixPath(path, period) if period else path


def _globToSqlLike(pattern):
    """fnmatch glob -> SQL LIKE pattern ('Paeds*' -> 'Paeds%', 'FP-Week-0?' -> 'FP-Week-0_')."""
    out = []
    for ch in str(pattern):
        if ch == "*":
            out.append("%")
        elif ch == "?":
            out.append("_")
        elif ch in ("%", "_"):
            out.append("\\" + ch)
        else:
            out.append(ch)
    return "".join(out)


def _streamCodeSqlFilter(columnExpr, stream=STREAM_ALL, streams=None, cohort=DEFAULT_COHORT):
    """SQL predicate restricting an item-code column to the selected stream(s).

    Returns 'TRUE' for ALL. Case-insensitive (ILIKE) because the raw DASH codes are not
    normalised — 'Paeds 2026-Week-1' with a space is matched by 'Paeds%' just the same.
    """
    if stream is None or (isinstance(stream, str) and str(stream).strip().upper() == STREAM_ALL):
        return "TRUE"
    likes = []
    for _, cfg in resolveStreams(stream, streams, cohort):
        if not cfg.get('codePatterns'):
            return 'TRUE'          # date-range stream: the window already selects it
        for pattern in cfg["codePatterns"]:
            likes.append(_globToSqlLike(pattern).replace("%", "%%"))
    if not likes:
        return "TRUE"
    return "(" + " OR ".join(f"{columnExpr} ILIKE '{l}'" for l in likes) + ")"


def createWeeklySimWhere(prefix, date=None, minDate=None, maxDate=None,
                             cohort="DDS2", type_="Simulation"):
    """WHERE clause shared by every DDS2 weekly-sim query.

    Pass ``date`` for a single day (the original behaviour) and/or ``minDate`` /
    ``maxDate`` for an inclusive range. All three compare against
    ``datetimeutc::date``, which resolves in the *Postgres session* timezone.
    The DASH feed stores each session as local midnight (13:00Z under AEDT,
    14:00Z under AEST), so the ::date only matches the human-facing session date
    while the session TimeZone is Australia/Melbourne. Discovery and extraction
    both go through this helper, so they can never disagree about a date.
    """
    clauses = [
        f"{prefix}.cohort = '{cohort}'",
        f"{prefix}.submitted_by_assessor",
        f"{prefix}.type = '{type_}'",
    ]
    if date is not None:
        clauses.insert(0, f"{prefix}.datetimeutc::date = DATE '{date}'")
    if minDate is not None:
        clauses.append(f"{prefix}.datetimeutc::date >= DATE '{minDate}'")
    if maxDate is not None:
        clauses.append(f"{prefix}.datetimeutc::date <= DATE '{maxDate}'")
    return "\n      where " + "\n      and ".join(clauses) + "\n      "

def getGlobalRatingSql(date='2026-04-13', minDate=None, maxDate=None,
                       cohort=DEFAULT_COHORT, type_='Simulation'):
    """Global-rating distribution for one DDS2 sim date (or an inclusive range).

    v3 shape: scales are nested under assessor_data->'scales' with PREFIXED keys
    and the graded level lives under ->>'key' (see rawforms-v3-scale-keys).
    """
    globalratingsSql = f"""
    SELECT
    global_rating,
    COUNT(*) AS n
    FROM (
    SELECT NULLIF(v->>'key','')::int AS global_rating
    FROM {RAWFORM_FORMS_NAME} f
    CROSS JOIN LATERAL jsonb_each(COALESCE(f.assessor_data->'scales','{{}}'::jsonb)) k(key, v)
    {createWeeklySimWhere('f', date, minDate, maxDate, cohort, type_)}
        AND k.key = 'scale-global-rating'
    ) x
    GROUP BY global_rating
    ORDER BY global_rating;
    """
    return globalratingsSql


def getWeeklySimDatesSql(minDate=SEMESTER_SPLIT_DATE, maxDate=None,
                             cohort=DEFAULT_COHORT, type_="Simulation", stream=STREAM_ALL):
    """SQL listing every assessment date that has weekly-sim data, with counts.

    Returns one row per ``datetimeutc::date`` with:
      date        - the session date (same expression the data query filters on)
      n_forms     - forms on that date CARRYING A MATCHING ITEM CODE (see below)
      n_students  - distinct students on that date
      week_keys   - comma-separated checklist/item codes used on that date
                    (e.g. 'FP-Week-03' or 'Paeds-2026-Week-02'), so a low-volume
                    catch-up day is obvious before you build a workbook for it.

    ``stream`` ('ALL', 'PAEDS', ['FP','ENDO'], …) restricts to that stream's item codes,
    so the counts are the stream's own — a Monday Paeds day carrying one stray FP form
    reports 106 under PAEDS and 1 under FP, not 107 under both.

    Note the counts are per (form × matching item code): a form is normally one code, but
    a form with two checklists counts once per code. That matches what the data query and
    the workbook produce, which is the number that matters when sanity-checking a build.
    """
    codeFilter = _streamCodeSqlFilter("ck.ckey", stream, cohort=cohort)
    return f"""
        WITH forms AS (
            SELECT f.form_code, f.assessmentid, f.student_number,
                   f.datetimeutc::date AS date,
                   f.assessor_data
            FROM {RAWFORM_FORMS_NAME} f
            {createWeeklySimWhere('f', None, minDate, maxDate, cohort, type_)}
        ),
        itemrows AS (
            SELECT b.date, b.student_number, b.form_code, b.assessmentid, ck.ckey AS item_code
            FROM forms b
            CROSS JOIN LATERAL jsonb_each(COALESCE(b.assessor_data,'{{}}'::jsonb)) ck(ckey, cval)
            WHERE NOT ck.ckey LIKE 'scale-%%'
              AND ck.ckey NOT IN ('radio','texts','scales','checklists','multi-select')
              AND jsonb_typeof(ck.cval) = 'object'
              AND NOT (ck.cval ? 'scale')
              AND {codeFilter}
        )
        SELECT
            r.date,
            COUNT(*)                          AS n_forms,
            COUNT(DISTINCT r.student_number)  AS n_students,
            string_agg(DISTINCT r.item_code, ', ' ORDER BY r.item_code) AS week_keys
        FROM itemrows r
        GROUP BY r.date
        ORDER BY r.date
    """


def getSubjectMismatchSql(minDate=SEMESTER_SPLIT_DATE, maxDate=None,
                              cohort=DEFAULT_COHORT, type_="Simulation"):
    """Every weekly-sim form with its subject code and its item code, for cross-checking.

    Classification never uses ``subject`` (students pick it themselves and get it wrong),
    but the disagreements are worth chasing, so this pulls both and lets python decide.
    """
    return f"""
        WITH forms AS (
            SELECT f.form_code, f.assessmentid, f.student_number, f.student_name,
                   f.student_email, f.assessor_name, f.subject,
                   f.datetimeutc::date AS date,
                   f.assessor_data
            FROM {RAWFORM_FORMS_NAME} f
            {createWeeklySimWhere('f', None, minDate, maxDate, cohort, type_)}
        )
        SELECT b.date, b.student_number, b.student_name, b.student_email,
               b.assessor_name, b.subject, ck.ckey AS item_code,
               b.form_code, b.assessmentid
        FROM forms b
        CROSS JOIN LATERAL jsonb_each(COALESCE(b.assessor_data,'{{}}'::jsonb)) ck(ckey, cval)
        WHERE NOT ck.ckey LIKE 'scale-%%'
          AND ck.ckey NOT IN ('radio','texts','scales','checklists','multi-select')
          AND jsonb_typeof(ck.cval) = 'object'
          AND NOT (ck.cval ? 'scale')
        ORDER BY b.date, b.student_number, ck.ckey
    """


def getWeeklySimDataSql(date='2026-04-13', stream=STREAM_ALL,
                        cohort=DEFAULT_COHORT, type_='Simulation'):
    dataSql = f"""
        WITH base AS (
        SELECT
            f.form_code,
            f.assessmentid,
            f.student_number,
            f.student_name,
            f.student_email,
            f.assessor_name,
            f.cohort,
            f.subject,
            f.type,
            f.datetimeutc,
            f.clinic,
            f.assessor_reflection,
            f.student_reflection,
            f.clinical_incident,

            MAX(CASE WHEN s.key = 'scale-global-rating'       THEN NULLIF(s.value->>'key','')::int END) AS "GR",
            MAX(CASE WHEN s.key = 'scale-time-mgmt'           THEN NULLIF(s.value->>'key','')::int END) AS "TS",
            MAX(CASE WHEN s.key = 'scale-communication'       THEN NULLIF(s.value->>'key','')::int END) AS "CS",
            MAX(CASE WHEN s.key = 'scale-professionalism'     THEN NULLIF(s.value->>'key','')::int END) AS "PS",
            MAX(CASE WHEN s.key = 'scale-practice-readiness'  THEN NULLIF(s.value->>'key','')::int END) AS "PR",
            MAX(CASE WHEN s.key = 'scale-position-ergonomics' THEN NULLIF(s.value->>'key','')::int END) AS "PEC"

        FROM {RAWFORM_FORMS_NAME} f
        LEFT JOIN LATERAL jsonb_each(COALESCE(f.assessor_data->'scales','{{}}'::jsonb)) s(key, value)
            ON jsonb_typeof(s.value) = 'object' AND (s.value ? 'key')
        {createWeeklySimWhere('f', date, cohort=cohort, type_=type_)}
        GROUP BY f.form_code, f.assessmentid
        ),

        -- One row per (assessment, session key) with per-session avg + raw json
        sessionChecklist AS (
        SELECT
            f.form_code,
            f.assessmentid,
            ck.ckey                                    AS item_code,
            ck.cval                                    AS mc_json,
            ROUND(AVG(
            CASE it.value
                WHEN 'O1' THEN 1.00 WHEN 'O2' THEN 0.80 WHEN 'O3' THEN 0.60
                WHEN 'O4' THEN 0.40 WHEN 'O5' THEN 0.00
                WHEN 'Yes' THEN 1.00 WHEN 'No'  THEN 0.00
                ELSE NULL::numeric
            END
            ), 2)                                      AS assessor_score01
        FROM {RAWFORM_FORMS_NAME} f
        CROSS JOIN LATERAL jsonb_each(COALESCE(f.assessor_data,'{{}}'::jsonb)) ck(ckey, cval)
        CROSS JOIN LATERAL jsonb_each_text(ck.cval) it(key, value)
        {createWeeklySimWhere('f', date, cohort=cohort, type_=type_)}
            AND NOT ck.ckey LIKE 'scale-%%'
            AND ck.ckey NOT IN ('radio','texts','scales','checklists','multi-select')
            AND jsonb_typeof(ck.cval) = 'object'
            AND NOT (ck.cval ? 'scale')
            AND {_streamCodeSqlFilter('ck.ckey', stream, cohort=cohort)}
        GROUP BY f.form_code, f.assessmentid, ck.ckey, ck.cval
        ),

        studentRubricAvgPerSession AS (
        SELECT
            f.form_code,
            f.assessmentid,
            ck.ckey                                    AS item_code,
            ROUND(AVG(
            CASE it.value
                WHEN 'O1' THEN 1.00 WHEN 'O2' THEN 0.80 WHEN 'O3' THEN 0.60
                WHEN 'O4' THEN 0.40 WHEN 'O5' THEN 0.00
                WHEN 'Yes' THEN 1.00 WHEN 'No'  THEN 0.00
                ELSE NULL::numeric
            END
            ), 2)                                      AS student_score01
        FROM {RAWFORM_FORMS_NAME} f
        CROSS JOIN LATERAL jsonb_each(COALESCE(f.student_data,'{{}}'::jsonb)) ck(ckey, cval)
        CROSS JOIN LATERAL jsonb_each_text(ck.cval) it(key, value)
        {createWeeklySimWhere('f', date, cohort=cohort, type_=type_)}
            AND NOT ck.ckey LIKE 'scale-%%'
            AND ck.ckey NOT IN ('radio','texts','scales','checklists','multi-select')
            AND jsonb_typeof(ck.cval) = 'object'
            AND NOT (ck.cval ? 'scale')
        GROUP BY f.form_code, f.assessmentid, ck.ckey
        )

        SELECT
        b.student_number,
        b.student_name,
        b.student_email,
        b.assessor_name,
        b.subject,
        sc.item_code,
        b.datetimeutc::date                          AS date,
        sc.mc_json,
        b."GR",
        b."TS",
        b."CS",
        b."PS",
        b."PR",
        b."PEC",
        sc.assessor_score01                          AS "Assessor Score",
        sr.student_score01                           AS "Student Score",
        b.clinical_incident,
        b.assessor_reflection,
        b.student_reflection,
        b.assessmentid,
        b.form_code
        FROM base b
        JOIN sessionChecklist sc
        ON  sc.assessmentid = b.assessmentid
        AND sc.form_code    = b.form_code
        LEFT JOIN studentRubricAvgPerSession sr
        ON  sr.assessmentid = b.assessmentid
        AND sr.form_code    = b.form_code
        AND sr.item_code    = sc.item_code
        ORDER BY b.cohort, b.student_number, b.datetimeutc, b.form_code, sc.item_code;
        """
    return dataSql

_WEEK_KEY_RE = re.compile(r'^(?P<prefix>.*?)[-\s]*Week[-\s]*(?P<num>\d{1,2})$', re.IGNORECASE)


def standardizeWeekFormat(itemCode):
    """Normalise a weekly checklist / item code so it sorts and groups correctly.

    Handles every family DDS2 has used in 2026 (verified against the raw pull):
      sem 1 : '2026-Week-1'        -> '2026-Week-01'
      sem 2 : 'Week-01'            -> 'Week-01'          (unchanged)
              'FP-Week-3'          -> 'FP-Week-03'
              'Paeds 2026-Week-1'  -> 'Paeds-2026-Week-01'
              'Paeds-2026-Week-2'  -> 'Paeds-2026-Week-02'

    Two things are fixed: the week number is always zero-padded to 2 digits, and
    the separator before 'Week' is always a hyphen. DDS2 sem 2 shipped the Paeds
    checklist under BOTH 'Paeds 2026-Week-1' (space) and 'Paeds-2026-Week-2'
    (hyphen), which otherwise split one item into two in every pivot.
    Non-week codes (e.g. 'positioning', 'DDS2-MAR-31', '19-Jan-SIM') pass through
    untouched. Used by both getChecklistBank and the weekly-sim builders, so the
    checklist bank and the data always agree on a key.
    """
    if not isinstance(itemCode, str):
        return itemCode
    m = _WEEK_KEY_RE.match(itemCode.strip())
    if not m:
        return itemCode
    prefix = re.sub(r'[\s-]+', '-', m.group('prefix').strip()).strip('-')
    num = m.group('num').zfill(2)
    return f"{prefix}-Week-{num}" if prefix else f"Week-{num}"


def _sortMcColumns(columns):
    """Order MC columns numerically (MC1, MC2, ... MC10) instead of lexically."""
    def key(col):
        m = re.match(r'^MC(\d+)$', str(col))
        return (0, int(m.group(1))) if m else (1, str(col))
    return sorted(columns, key=key)

def addAssessmentCharts(filepath, sheet1Name='Sheet1', chartSheetName='Charts', blrFilter=None):
