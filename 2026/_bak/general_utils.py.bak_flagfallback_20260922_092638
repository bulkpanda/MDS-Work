# Cohorts routed to the dds4_boh3_forms_v3 table instead of here.
RAWFORM_FORMS_V3_EXCLUDE_COHORTS = ("DDS4", "BOH3")


def _flattenChecklistsSqlExpr(rawExpr):
    """Return a SQL scalar expression producing the OLD-shape flattened checklists
    {item_code:{MCk:<key-string>}} from a nested *_data jsonb passed as ``rawExpr``.
    Robust to missing/non-object checklists (returns '{}')."""
    return f"""COALESCE((
        SELECT jsonb_object_agg(c.item_code, z.flat_mc)
        FROM jsonb_each(
               CASE WHEN jsonb_typeof(({rawExpr})->'checklists') = 'object'
                    THEN ({rawExpr})->'checklists' ELSE '{{}}'::jsonb END
             ) AS c(item_code, mcs)
        CROSS JOIN LATERAL (
          SELECT jsonb_object_agg(m.mc_key, COALESCE(m.mc_val->>'key', m.mc_val#>>'{{}}')) AS flat_mc
          FROM jsonb_each(
                 CASE WHEN jsonb_typeof(c.mcs) = 'object' THEN c.mcs ELSE '{{}}'::jsonb END
               ) AS m(mc_key, mc_val)
        ) AS z
        WHERE jsonb_typeof(c.mcs) = 'object'
      ), '{{}}'::jsonb)"""


def getInsertSqlRawform_forms_v3(replace=False, cohorts=('BOH1', 'BOH2', 'DDS1', 'DDS2', 'DDS3')):
    """INSERT ... SELECT that separates rawforms into rawform_forms_v3 for the
    non-final-year cohorts. Keeps scales nested (new shape) and merges a v2-style
    flattened checklist copy onto the top level of student_data/assessor_data."""
    if replace:
        onconflict = f"""
    ON CONFLICT (form_code, assessmentid) DO UPDATE SET
    student_number = EXCLUDED.student_number, student_name = EXCLUDED.student_name, student_email = EXCLUDED.student_email,
    datetimeutc = EXCLUDED.datetimeutc, cohort = EXCLUDED.cohort, subject = EXCLUDED.subject, type = EXCLUDED.type,
    completed = EXCLUDED.completed, student_data = EXCLUDED.student_data, assessor_data = EXCLUDED.assessor_data,
    student_reflection = EXCLUDED.student_reflection, assessor_reflection = EXCLUDED.assessor_reflection,
    clinical_incident = EXCLUDED.clinical_incident, patient_complexity = EXCLUDED.patient_complexity,
    role = EXCLUDED.role, clinic = EXCLUDED.clinic, scales = EXCLUDED.scales, checklists = EXCLUDED.checklists,
    version = EXCLUDED.version, patient_data = EXCLUDED.patient_data,
    context_schema_snapshot = EXCLUDED.context_schema_snapshot,
    student_config = EXCLUDED.student_config, assessor_config = EXCLUDED.assessor_config,
    assessor_name = EXCLUDED.assessor_name, assessor_email = EXCLUDED.assessor_email,
    submitted_by_student = EXCLUDED.submitted_by_student, submitted_by_assessor = EXCLUDED.submitted_by_assessor,
    additional_checklists = EXCLUDED.additional_checklists, insertedat = now()
        """
    else:
        onconflict = "ON CONFLICT (form_code, assessmentid) DO NOTHING"

    studentFlat  = _flattenChecklistsSqlExpr("sdr.raw")
    assessorFlat = _flattenChecklistsSqlExpr("adr.raw")

    insertSql = f"""
    INSERT INTO {RAWFORM_FORMS_V3_NAME} (
      form_code, assessmentid, student_number, student_name, student_email, datetimeutc, cohort, subject, type, completed,
      student_data, assessor_data,
      student_reflection, assessor_reflection, clinical_incident, patient_complexity,
      role, clinic, scales, checklists, version,
      patient_data, context_schema_snapshot,
      student_config, assessor_config,
      assessor_name, assessor_email,
      submitted_by_student, submitted_by_assessor, additional_checklists,
      insertedat
    )
    SELECT
      f.form_code,
      r.assessmentid, r.student_number, r.student_name, r.student_email, r.datetimeutc, r.cohort, r.subject, r.type, r.completed,

      /* raw nested student_data/assessor_data, with a v2-style flattened checklist copy merged on top */
      (sdr.raw || {studentFlat})  AS student_data,
      (adr.raw || {assessorFlat}) AS assessor_data,

      (sdr.raw->'texts'->>'reflection') AS student_reflection,
      (adr.raw->'texts'->>'reflection') AS assessor_reflection,

      /* Clinical incident — TWO template shapes, both must be read (2026-08-18).
         Reading only the multi-select array (the original expression) returned
         NULL for every DDS2/BOH2/BOH1 2026 form, because those templates record
         an incident as radio 'clinical-incident-occurred' = 'yes' plus a
         free-text detail under texts->'clinical-incident'. 159 forms in the 2026
         CAF payload were lost that way (DDS2 Clinic 35, DDS2 Sim 40, BOH2 Clinic
         32, BOH1 Sim 23, DDS1 Sim 20, BOH2 Sim 9) against 87 carrying the array
         shape. ~66 of the 159 are 'yes' with nothing typed, so they get a
         placeholder — an empty string here would read as "no incident".
         NOTE: rows already in the table keep the old NULL until it is reloaded.
         getDataDf / getCriticalIncidentDf apply the SAME resolution at READ time
         (boh2_dds2_dds3_utils.clinicalIncidentSqlExpr), so reports are correct
         without a reload; this keeps the stored column right going forward. */
      COALESCE(
        (SELECT string_agg(x->>'value', '; ' ORDER BY x->>'value')
           FROM jsonb_array_elements(COALESCE(adr.raw->'multi-select'->'clinical-incident','[]'::jsonb)) x),
        CASE WHEN lower(COALESCE(adr.raw->'radio'->>'clinical-incident-occurred','')) = 'yes'
             THEN COALESCE(NULLIF(TRIM(COALESCE(adr.raw->'texts'->>'clinical-incident','')), ''),
                           'Yes (no details recorded)')
        END
      )                                                                       AS clinical_incident,

      adr.raw->'scales'->'scale-patient-complexity'->>'key'                  AS patient_complexity,

      fc.ctx->>'role'                                                        AS role,
      fc.ctx->>'clinic_type'                                                 AS clinic,
      adr.raw->'scales'                                                      AS scales,
      adr.raw->'checklists'                                                  AS checklists,
      NULLIF(f.form_value->>'version','')::int                              AS version,

      fc.ctx->'patient'                                                      AS patient_data,
      f.form_value->'context_schema_snapshot'                               AS context_schema_snapshot,
      f.form_value->'student_config'                                        AS student_config,
      f.form_value->'assessor_config'                                       AS assessor_config,

      f.form_value->>'assessor_name'                                        AS assessor_name,
      f.form_value->>'assessor_email'                                       AS assessor_email,

      (f.form_value->>'submitted_by_student')::boolean                      AS submitted_by_student,
      (f.form_value->>'submitted_by_assessor')::boolean                     AS submitted_by_assessor,
      f.form_value->'additional_checklists'                                 AS additional_checklists,

      r.insertedat
    FROM {RAWFORMS_NAME} r
    CROSS JOIN LATERAL (
      SELECT e.key AS form_code, e.value AS form_value
      FROM jsonb_each(r.forms) e
      WHERE jsonb_typeof(r.forms) = 'object'
      UNION ALL
      SELECT a.value->>'form_key' AS form_code, a.value AS form_value
      FROM jsonb_array_elements(r.forms) a
      WHERE jsonb_typeof(r.forms) = 'array'
    ) f
    CROSS JOIN LATERAL (SELECT COALESCE(f.form_value->'form_context', '{{}}'::jsonb) AS ctx) fc
    CROSS JOIN LATERAL (SELECT COALESCE(f.form_value->'student_data',  '{{}}'::jsonb) AS raw) sdr
    CROSS JOIN LATERAL (SELECT COALESCE(f.form_value->'assessor_data', '{{}}'::jsonb) AS raw) adr
    WHERE f.form_code IS NOT NULL
      AND r.cohort NOT IN {RAWFORM_FORMS_V3_EXCLUDE_COHORTS}
      AND r.cohort IN {cohorts}
      AND r.datetimeUtc >= TIMESTAMPTZ '2026-01-01'
    {onconflict}
    """
    return insertSql


