def sessionSchedulePath(cohort=DEFAULT_COHORT, year=2026):
    return os.path.join(cohort, f"{cohort} Sim Sessions {year}.xlsx")


def rosterPath(cohort=DEFAULT_COHORT, year=2026):
    return os.path.join(cohort, f"{cohort} Roster {year}.xlsx")


def loadSessionSchedule(cohort=DEFAULT_COHORT, year=2026, path=None, period=None):
    """The planned session schedule, or an EMPTY frame if the file doesn't exist.

    Columns: cohort, period, week_no, date, weekday, task, is_choice_week,
    choice_options, counts_toward_total, notes. A missing file is not an error — the
    schedule is a cross-check, not a dependency.
    """
    path = path or sessionSchedulePath(cohort, year)
    cols = ["cohort", "period", "week_no", "date", "weekday", "task",
            "is_choice_week", "choice_options", "counts_toward_total", "notes"]
    if not os.path.exists(path):
        return pd.DataFrame(columns=cols)
    df = pd.read_excel(path, sheet_name=0)
    if "date" in df.columns:
        df["date"] = pd.to_datetime(df["date"], errors="coerce").dt.strftime("%Y-%m-%d")
    if period and "period" in df.columns:
        df = df[df["period"].astype(str).str.upper() == str(period).upper()]
    return df.reset_index(drop=True)


def loadRoster(cohort=DEFAULT_COHORT, year=2026, path=None, activeOnly=True):
    """The student roster, or an EMPTY frame if the file doesn't exist.

    Columns: cohort, sort_order, student_number, first_name, last_name, status,
    supplied_student_number, notes. Returned in LAST-NAME order — that ordering is the
    point of the file, so reports can present students the way staff read them rather
    than by student number.
    """
    path = path or rosterPath(cohort, year)
    cols = ["cohort", "sort_order", "student_number", "first_name", "last_name",
            "status", "supplied_student_number", "notes"]
    if not os.path.exists(path):
        return pd.DataFrame(columns=cols)
    df = pd.read_excel(path, sheet_name=0)
    if activeOnly and "status" in df.columns:
        df = df[df["status"].astype(str).str.lower() != "inactive"]
    if {"last_name", "first_name"}.issubset(df.columns):
        df = df.sort_values(["last_name", "first_name"], kind="stable")
    df = df.reset_index(drop=True)
    df["sort_order"] = range(1, len(df) + 1)
    return df


def nameSortKey(name):
    """Sort key for a single display-name string: ``(surname, firstName)``, casefolded.

    Splits on whitespace, treating the LAST token as the surname and everything
    before it as the given name(s) — correct for the common two-part name and the
    best guess otherwise (there is no roster available at this call site, unlike
    ``boh2_dds2_dds3_utils._surnameKey``). Returns a 2-tuple so callers can append
    their own tie-breaker, e.g. ``(*nameSortKey(name), studentNumber)``.
    """
    parts = str(name or "").strip().split()
    if not parts:
        return ("", "")
    return (parts[-1].casefold(), " ".join(parts[:-1]).casefold())


def applyRosterOrder(df, roster, idCol="student_number", nameCol="student_name"):
    """Order ``df`` by the roster's last-name sequence and add last/first name columns.

    Returns (ordered, notOnRoster, noData):
      ordered      last_name / first_name inserted after the id, sorted by roster order.
                   Anyone NOT on the roster is appended at the end rather than dropped —
                   silently losing a student is worse than showing an unexpected one.
      notOnRoster  ids present in df but absent from the roster
      noData       roster rows with no matching row in df (catches ID typos as well as
                   genuine non-attendance)
    """
    if roster is None or roster.empty or idCol not in df.columns:
        return df, pd.DataFrame(), pd.DataFrame()

    order = roster[[idCol, "first_name", "last_name", "sort_order"]].copy()
    out = df.merge(order, on=idCol, how="left")
    notOnRoster = out[out["sort_order"].isna()][
        [c for c in (idCol, nameCol) if c in out.columns]].drop_duplicates()
    noData = roster[~roster[idCol].isin(df[idCol])][
        [idCol, "first_name", "last_name"] + (["notes"] if "notes" in roster.columns else [])]

    out["_missing"] = out["sort_order"].isna()
    out = (out.sort_values(["_missing", "sort_order", idCol], kind="stable")
              .drop(columns=["_missing", "sort_order"]).reset_index(drop=True))

    cols = list(out.columns)
    for c in ("last_name", "first_name"):
        cols.remove(c)
    at = cols.index(idCol) + 1
    out = out[cols[:at] + ["last_name", "first_name"] + cols[at:]]
    return out, notOnRoster.reset_index(drop=True), noData.reset_index(drop=True)


def compareSessionsToSchedule(datesDf, schedule):
    """Cross-check discovered assessment dates against the planned schedule.

    Returns week_no, date, task, is_choice_week, n_forms, n_students, week_keys, status —
    ``status`` being matched / missing (planned but nothing in the data yet) / unplanned.
    """
    cols = ["week_no", "date", "task", "is_choice_week",
            "n_forms", "n_students", "week_keys", "status"]
    if schedule is None or schedule.empty:
        return pd.DataFrame(columns=cols)
    plan = schedule[schedule["date"].notna()].copy()
    obs = datesDf.copy() if datesDf is not None else pd.DataFrame(columns=["date"])
    merged = plan.merge(obs, on="date", how="outer", indicator=True)
    merged["status"] = merged["_merge"].map(
        {"both": "matched", "left_only": "missing", "right_only": "unplanned"})
    for c in cols:
        if c not in merged.columns:
            merged[c] = None
    return merged.sort_values("date")[cols].reset_index(drop=True)


