def _asDateStr(value):
    """Coerce str / date / datetime / pd.Timestamp to 'YYYY-MM-DD'."""
    if value is None:
        return None
    if isinstance(value, str):
        return pd.to_datetime(value).strftime("%Y-%m-%d")
    return pd.Timestamp(value).strftime("%Y-%m-%d")


def getWeeklySimDates(engine, minDate=SEMESTER_SPLIT_DATE, maxDate=None,
                          cohort=DEFAULT_COHORT, type_="Simulation", minForms=1,
                          stream=STREAM_ALL, useStreamDates=True):
    """Every DDS2 weekly-sim assessment date in the DB, as a DataFrame.

    Columns: date (str 'YYYY-MM-DD'), n_forms, n_students, week_keys, and — when a single
    stream is selected — weekday plus offWeekday (True if the session did not fall on that
    stream's usual day, i.e. a catch-up).

    ``minDate`` defaults to SEMESTER_SPLIT_DATE ('2026-06-15') so semester 1
    — whose workbooks are already built — is never returned. Pass minDate=None to
    see the whole year.

    ``stream`` restricts to one stream's item codes. With ``useStreamDates`` (default) the
    stream's own startDate/endDate are applied too, intersected with minDate/maxDate — so
    getWeeklySimDates(engine, stream='PAEDS') gives Paeds Mondays from 13 July with no
    other arguments. An explicit minDate/maxDate always narrows further, never widens.

    ``minForms`` drops low-volume days. DDS2 has a handful of 1-3 form days that
    are individual catch-ups/tests rather than a cohort session; leave it at 1 to
    see everything, raise it (e.g. 20) to list only real sessions.
    """
    minDate, maxDate = _asDateStr(minDate), _asDateStr(maxDate)
    selected = resolveStreams(stream, cohort=cohort)
    if useStreamDates and len(selected) == 1:
        cfg = selected[0][1]
        sMin, sMax = _asDateStr(cfg.get("startDate")), _asDateStr(cfg.get("endDate"))
        minDate = max([d for d in (minDate, sMin) if d], default=None)
        maxDate = min([d for d in (maxDate, sMax) if d], default=None)

    sql = getWeeklySimDatesSql(minDate, maxDate, cohort, type_, stream)
    df = readDf(engine, sql)
    if df.empty:
        return pd.DataFrame(columns=["date", "n_forms", "n_students", "week_keys"])
    df["date"] = pd.to_datetime(df["date"]).dt.strftime("%Y-%m-%d")
    # Normalise the discovered checklist codes the same way the data build does.
    df["week_keys"] = df["week_keys"].apply(
        lambda s: ", ".join(sorted({standardizeWeekFormat(k.strip()) for k in s.split(",")}))
        if isinstance(s, str) and s else s
    )
    if len(selected) == 1:
        expected = selected[0][1].get("weekday")
        df["weekday"] = pd.to_datetime(df["date"]).dt.strftime("%a")
        if expected:
            df["offWeekday"] = df["weekday"] != expected
    if minForms and minForms > 1:
        df = df[df["n_forms"] >= minForms]
    return df.reset_index(drop=True)


def getSubjectMismatches(engine, minDate=SEMESTER_SPLIT_DATE, maxDate=None,
                             cohort=DEFAULT_COHORT, type_="Simulation", onlyMismatches=True):
    """Forms whose subject code disagrees with the subject implied by their item code.

    Students choose the subject themselves, so it is wrong often enough to be misleading
    (76 of 1,859 semester-2 forms in 2026). Nothing in the pipeline routes on ``subject``
    — this report exists purely so the bad ones can be chased and corrected in DASH.

    Returns date | student_number | student_name | student_email | assessor_name |
    item_code | stream | subject | expected_subject | weekday | expected_weekday |
    off_weekday | form_code | assessmentid.
    Rows whose item code belongs to no known stream are always returned (stream = None),
    since those cannot be checked and are worth eyeballing too.
    """
    df = readDf(engine, getSubjectMismatchSql(_asDateStr(minDate), _asDateStr(maxDate),
                                                  cohort, type_))
    if df.empty:
        return df
    df["item_code"] = df["item_code"].apply(standardizeWeekFormat)
    streams = cohortStreams(cohort)
    # A cohort with no code-pattern streams (BOH2) cannot be classified from the item
    # code at all, so fall back to the date window. Without this every correctly-tagged
    # form looks like a mismatch — 329 false positives out of 337 on BOH2 SHY.
    usesCodes = any(c.get("codePatterns") for c in streams.values())
    if usesCodes:
        df["stream"] = df["item_code"].apply(lambda c: streamForItemCode(c, streams, cohort))
    else:
        df["stream"] = df["date"].apply(lambda d: streamForDate(d, streams, cohort))
    df["expected_subject"] = df["stream"].map(
        lambda k: streams[k]["subject"] if k in streams else None)
    df["expected_weekday"] = df["stream"].map(
        lambda k: streams[k]["weekday"] if k in streams else None)
    df["date"] = pd.to_datetime(df["date"])
    df["weekday"] = df["date"].dt.strftime("%a")
    df["date"] = df["date"].dt.strftime("%Y-%m-%d")
    df["off_weekday"] = (df["expected_weekday"].notna()
                         & (df["weekday"] != df["expected_weekday"]))
    cols = ["date", "weekday", "student_number", "student_name", "student_email",
            "assessor_name", "item_code", "stream", "subject", "expected_subject",
            "expected_weekday", "off_weekday", "form_code", "assessmentid"]
    df = df[cols]
    if onlyMismatches:
        bad = df["stream"].isna() | (df["subject"] != df["expected_subject"])
        df = df[bad]
    return df.reset_index(drop=True)


def _sanitizeCodeForFilename(code):
    """Make one item code safe to embed in a Windows filename: strip the reserved
    characters <>:\"/\\|?* (BOH1 codes include '/' and '*', e.g. '11/12 explorer',
    'OHP1-PL-*'), collapse whitespace and stray dashes."""
    s = re.sub(r'[<>:"/\\|?*]+', '-', str(code).strip())
    s = re.sub(r'\s+', ' ', s)
    s = re.sub(r'-+', '-', s).strip(' -')
    return s or 'code'


def subsetSuffixPath(path, includeCodeList, maxTagLen=80):
    """Tag a filtered build's filename with the ACTUAL item codes it was restricted to, so a
    subset workbook is self-describing and never overwrites the complete workbook of the same
    name (e.g. 'boh1 2026-07-07 assessment_data (531, 532).xlsx'). Returns the path unchanged
    when includeCodeList is empty/None.

    Codes are sanitised for the filesystem (see _sanitizeCodeForFilename). If the joined tag
    would be too long for the path it is truncated to as many codes as fit plus '+N more' — two
    very different large selections could then share a name, so keep selections small when you
    care about distinct files. The tag always sits inside '(...)' before the extension, so the
    name never ends in 'assessment_data.xlsx' and subset files stay invisible to the
    combined/BLR reader (DEFAULT_FILE_PATTERN)."""
    if not includeCodeList:
        return path
    root, ext = os.path.splitext(path)
    codes = [_sanitizeCodeForFilename(c) for c in includeCodeList]
    tag = ", ".join(codes)
    if len(tag) > maxTagLen or len(codes) > 6:
        shown, used = [], 0
        for c in codes:
            if used + len(c) + 2 > maxTagLen:
                break
            shown.append(c); used += len(c) + 2
        remaining = len(codes) - len(shown)
        tag = ", ".join(shown) + (f" +{remaining} more" if remaining else "")
    return f"{root} ({tag}){ext}"


def buildWeeklySimWorkbook(engine, date, folder=None, scoreMap=None,
                               fileTemplate=None,
                               blrFilter="BLR", sheet1Name="Sheet1", chartSheetName="Charts",
                               returnDf=False, stream=STREAM_ALL,
                               cohort=DEFAULT_COHORT, type_="Simulation",
                               mcScale=None, roster=None, styleSheet=False,
                               grLevels=None, mcLevels=None,
                               dropCols=None, labels=None, mcBefore=None,
                               addForms=False, addAbsent=True,
                               summarySheet=True, summarySheetName="Session Summary",
                               includeCodeList=None):
    """Build ONE weekly-sim workbook for a single date. Returns the file path.

    This is the old notebook ``createDateReport`` lifted out of main.ipynb, with
    the v3 data pull, week-key normalisation and numeric MC column ordering.

    ``stream`` restricts the workbook to one stream's item codes. ``folder`` is used
    as given — the caller decides the subfolder (see weeklySimFolder).

    mcScale     '0-1' (default, unchanged) or '1-5' for the MC columns — see
                WEEKLY_MC_SCALES. ``scoreMap`` still wins if given explicitly.
    roster      order rows by LAST NAME and add last_name / first_name columns.
                Students not on the roster are kept, at the end.
    styleSheet  navy header, freeze panes, GR and MC level colouring.
    addForms    also write the per-row ``Forms`` column (distinct forms per student this
                session). OFF by default — the count is the same down every row of a
                student, and the Session Summary names the duplicates instead. The count
                is computed either way; only the column is optional.
    addAbsent   append a blank row per roster student with no data, so the sheet doubles
                as an attendance register. Needs ``roster``; without one it is a no-op.
                Absentee rows are greyed, and a student with more than one form gets an
                amber Student Number cell (both need styleSheet=True).
    summarySheet / summarySheetName
                a "Session Summary" sheet between Sheet1 and Charts: expected / assessed /
                missing / duplicate counts and the named students behind each.
    dropCols/labels/mcBefore
                overrides for the sheet presentation — see formatWeeklySheet. The
                defaults drop student_email/date/assessmentid/form_code, put the MC
                block before "Assessor Score" and relabel to Title Case. Pass
                dropCols=[], labels={}, mcBefore=False for the pre-2026-08-18 layout.

    With returnDf=True the frame returned is the one WRITTEN (dropped, reordered and
    relabelled), so it matches the file. Use getWeeklySimDataSql directly if you want
    the raw pull.
    """
    date = _asDateStr(date)
    resolvedMap, scaleLabel = resolveMcScale(mcScale)
    scoreMap = resolvedMap if scoreMap is None else scoreMap
    if mcLevels is None:
        mcLevels = WEEKLY_MC_HIGHLIGHT_BY_SCALE.get(scaleLabel)
    folder = weeklySimBaseFolder(cohort) if folder is None else folder
    fileTemplate = weeklySimFileTemplate(cohort) if fileTemplate is None else fileTemplate
    os.makedirs(folder, exist_ok=True)
    filePath = subsetSuffixPath(os.path.join(folder, fileTemplate.format(date=date)),
                                includeCodeList)

    dataDf = readDf(engine, getWeeklySimDataSql(date, stream, cohort, type_))
    if dataDf.empty:
        print(f"  [{date}] no rows returned — nothing written.")
        return (None, dataDf) if returnDf else None

    dataDf[ITEM_CODE_COL] = dataDf[ITEM_CODE_COL].apply(standardizeWeekFormat)

    # ONLY_CODES whitelist: keep just the chosen item codes (same wildcard matcher as the
    # ignore list, inverted). Applied before the MC expand / attendance so the sheet, its
    # charts and its summary all reflect the subset.
    if includeCodeList:
        dataDf = dataDf[dataDf[ITEM_CODE_COL].apply(
            lambda c: matchesIgnoreCode(c, includeCodeList))].reset_index(drop=True)
        if dataDf.empty:
            print(f"  [{date}] no rows match includeCodeList — nothing written.")
            return (None, dataDf) if returnDf else None

    # Expand the flattened checklist json ({'MC1': 'O2', ...}) into MC columns.
    mcDf = pd.json_normalize(dataDf["mc_json"])
    mcDf = mcDf.replace(scoreMap)
    mcDf = mcDf.apply(pd.to_numeric, errors="coerce")
    mcDf = mcDf[_sortMcColumns(mcDf.columns)]

    dataDf = pd.concat([dataDf.drop(columns=["mc_json"]), mcDf], axis=1)

    # Attendance BEFORE ordering, so the placeholder rows are sorted in with everyone else
    # and the sheet reads as one alphabetical register rather than data + an appendix.
    dataDf, sessionStats = addWeeklyAttendance(
        dataDf, roster if addAbsent else None, addForms=addForms, addAbsent=addAbsent)

    if roster is not None and not roster.empty:
        dataDf, _notOnRoster, _noData = applyRosterOrder(dataDf, roster)

    # Presentation last: applyRosterOrder above still works on snake_case, and everything
    # from here down (styling, charts) sees exactly what lands in the file.
    sheetDf = formatWeeklySheet(dataDf, dropCols=dropCols, labels=labels, mcBefore=mcBefore)

    sheetDf.to_excel(filePath, index=False)
    with pd.ExcelWriter(filePath, engine="openpyxl", mode="a", if_sheet_exists="overlay") as writer:
        ws = writer.sheets[sheet1Name]
        autoFitColumns(ws)
        if styleSheet:
            styleWeeklySheet(ws, sheetDf, grLevels=grLevels, mcLevels=mcLevels,
                             duplicateIds=sessionStats.get("duplicateIds"))
        if summarySheet:
            writeDescriptionSheet(
                writer.book,
                sessionSummaryLines(sessionStats, date=date, cohort=cohort,
                                    stream=None if stream == STREAM_ALL else stream),
                title=f"{cohort} session summary — {date}",
                sheetName=summarySheetName, index=None)     # after Sheet1, before Charts

    addAssessmentCharts(filePath, sheet1Name=sheet1Name,
                            chartSheetName=chartSheetName, blrFilter=blrFilter)
    return (filePath, sheetDf) if returnDf else filePath


_BUILD_SUMMARY_COLS = ["stream", "date", "n_forms", "n_students", "week_keys", "status", "path"]


def _buildWeeklySimForOneStream(engine, folder, streamKey, dates, minDate, maxDate,
                                skipExisting, minForms, dryRun, scoreMap, fileTemplate,
                                blrFilter, cohort, type_, useStreamDates,
                                mcScale=None, roster=None, styleSheet=False,
                                grLevels=None, mcLevels=None,
                                dropCols=None, labels=None, mcBefore=None,
                                addForms=False, addAbsent=True,
                                summarySheet=True, summarySheetName="Session Summary",
                                includeCodeList=None):
    """One stream (or the legacy unsplit run when streamKey is None). Internal."""
    streams = cohortStreams(cohort)
    label = streams[streamKey]["name"] if streamKey else "all item codes (unsplit)"
    outFolder = weeklySimFolder(folder, streamKey, streams, cohort) if streamKey else folder
    codeSel = streamKey if streamKey else STREAM_ALL

    if streamKey and useStreamDates:
        cfg = streams[streamKey]
        sMin, sMax = _asDateStr(cfg.get("startDate")), _asDateStr(cfg.get("endDate"))
        minDate = max([d for d in (minDate, sMin) if d], default=None)
        maxDate = min([d for d in (maxDate, sMax) if d], default=None)

    print(f"\n=== {label} -> {outFolder}"
          f"  (minDate={minDate}, maxDate={maxDate}) ===")
    os.makedirs(outFolder, exist_ok=True)

    discovered = getWeeklySimDates(engine, minDate=minDate, maxDate=maxDate,
                                       cohort=cohort, type_=type_, minForms=1,
                                       stream=codeSel, useStreamDates=False)
    counts = discovered.set_index("date").to_dict("index") if not discovered.empty else {}

    if dates is None:
        plan = list(counts.keys())
    else:
        if isinstance(dates, (str, pd.Timestamp)) or not hasattr(dates, "__iter__"):
            dates = [dates]
        plan = [_asDateStr(d) for d in dates]

    rows = []
    skippedNoMatch = 0
    for date in plan:
        info = counts.get(date, {})
        nForms = info.get("n_forms", 0)
        row = {"stream": streamKey, "date": date, "n_forms": nForms,
               "n_students": info.get("n_students", 0),
               "week_keys": info.get("week_keys"), "status": None, "path": None}
        filePath = subsetSuffixPath(os.path.join(outFolder, fileTemplate.format(date=date)),
                                    includeCodeList)

        # ONLY_CODES: a date whose codes include none of the whitelisted codes produces no
        # subset workbook. Skip it quietly rather than listing every date — this is what makes
        # the dry-run plan show only the code files you asked for.
        if includeCodeList and date in counts:
            keys = [k.strip() for k in str(info.get("week_keys") or "").split(",") if k.strip()]
            if not any(matchesIgnoreCode(k, includeCodeList) for k in keys):
                row["status"] = "skipped-no-match"
                rows.append(row)
                skippedNoMatch += 1
                continue

        if (minDate and date < minDate) or (maxDate and date > maxDate):
            row["status"] = "skipped-out-of-range"
        elif date not in counts:
            row["status"] = "no-rows"
        elif minForms and nForms < minForms:
            row["status"] = "skipped-low-volume"
        elif skipExisting and os.path.exists(filePath):
            row["status"] = "skipped-exists"
            row["path"] = filePath
        elif dryRun:
            row["status"] = "planned"
            row["path"] = filePath
        else:
            try:
                built = buildWeeklySimWorkbook(
                    engine, date, folder=outFolder, scoreMap=scoreMap,
                    fileTemplate=fileTemplate, blrFilter=blrFilter, stream=codeSel,
                    cohort=cohort, type_=type_, mcScale=mcScale, roster=roster,
                    styleSheet=styleSheet, grLevels=grLevels, mcLevels=mcLevels,
                    dropCols=dropCols, labels=labels, mcBefore=mcBefore,
                    addForms=addForms, addAbsent=addAbsent,
                    summarySheet=summarySheet, summarySheetName=summarySheetName,
                    includeCodeList=includeCodeList)
                row["status"] = "built" if built else "no-rows"
                row["path"] = built
            except Exception as exc:                      # keep going through the batch
                row["status"] = f"error: {type(exc).__name__}: {exc}"
        rows.append(row)
        offDay = " *off-day" if info.get("offWeekday") else ""
        tail = f"  -> {os.path.basename(row['path'])}" if (includeCodeList and row['path']) else ""
        print(f"  {date}  n={row['n_forms']:>4}  {row['status']:<22} "
              f"{row['week_keys'] or ''}{offDay}{tail}")
    if includeCodeList and skippedNoMatch:
        print(f"  ({skippedNoMatch} date(s) skipped \u2014 no ONLY_CODES match)")
    if not rows:
        print("  (no dates)")
    return rows


def buildWeeklySimReports(engine, folder=None, dates=None,
                              minDate=SEMESTER_SPLIT_DATE, maxDate=None,
                              skipExisting=True, minForms=1, dryRun=False,
                              scoreMap=None, fileTemplate=None,
                              blrFilter="BLR", cohort=DEFAULT_COHORT, type_="Simulation",
                              stream=None, useStreamDates=True,
                              mcScale=None, roster=None, styleSheet=False,
                              grLevels=None, mcLevels=None,
                              dropCols=None, labels=None, mcBefore=None,
                              addForms=False, addAbsent=True,
                              summarySheet=True, summarySheetName="Session Summary",
                              includeCodeList=None):
    """Build weekly-sim workbooks, optionally split by stream into subfolders.

    Parameters
    ----------
    stream       : None (default) = the original unsplit behaviour — one workbook per date
                   containing every item code, written straight into ``folder``.
                   'ALL' = build every stream in DDS2_SIM_STREAMS, each into its own
                   subfolder (Paediatrics / Fixed Prosthodontics / Endodontics; semester 1
                   has folder '' so it stays in the base folder).
                   A key or list of keys ('PAEDS', ['FP','ENDO']) builds just those.
                   Rows are routed by ITEM CODE, so a catch-up FP form filled on a Paeds
                   Monday lands in the Fixed Prosthodontics folder under its real date.
    useStreamDates : intersect each stream's own startDate/endDate with minDate/maxDate.
                   On by default, so stream='ALL' needs no dates at all.
    dates        : explicit list of dates ('2026-07-13', date, Timestamp — mixed is
                   fine). If None, the dates are read from the DB via
                   getWeeklySimDates and filtered by minDate/maxDate/minForms.
                   An explicit list is still filtered by minDate/maxDate so a stray
                   semester-1 date can't sneak back in; pass minDate=None to disable.
                   With stream='ALL' the same list is offered to every stream.
    minDate      : inclusive lower bound, default SEMESTER_SPLIT_DATE
                   ('2026-06-15') = the semester 1 / semester 2 boundary, so
                   already-built semester 1 workbooks are never reconsidered.
                   Pass None to let each stream's own startDate decide.
    maxDate      : inclusive upper bound. For semester 1 use
                   minDate=None, maxDate='2026-06-14'.
    skipExisting : True (default) never overwrites an existing workbook — the run
                   is safe to repeat weekly. Set False to force a rebuild.
    minForms     : skip dates with fewer than this many forms IN THAT STREAM.
    dryRun       : print/return the plan without touching any file.

    addForms / addAbsent / summarySheet / summarySheetName
                 : attendance options, passed straight to buildWeeklySimWorkbook. The
                   absentee rows need a `roster=`; without one they are a no-op.
    dropCols/labels/mcBefore
                 : sheet presentation overrides, passed straight to formatWeeklySheet.
                   Defaults give the 2026-08-18 layout (Title Case headers, MC block
                   before "Assessor Score", no student_email/date/assessmentid/form_code).

    Returns a summary DataFrame: stream, date, n_forms, n_students, week_keys, status, path.
    ``status`` is one of built / skipped-exists / skipped-low-volume /
    skipped-out-of-range / no-rows / planned / error.
    """
    minDate, maxDate = _asDateStr(minDate), _asDateStr(maxDate)
    folder = weeklySimBaseFolder(cohort) if folder is None else folder
    fileTemplate = weeklySimFileTemplate(cohort) if fileTemplate is None else fileTemplate
    os.makedirs(folder, exist_ok=True)

    streamKeys = [None] if stream is None else [k for k, _ in resolveStreams(stream, cohort=cohort)]

    rows = []
    for key in streamKeys:
        rows += _buildWeeklySimForOneStream(
            engine, folder, key, dates, minDate, maxDate, skipExisting, minForms,
            dryRun, scoreMap, fileTemplate, blrFilter, cohort, type_, useStreamDates,
            mcScale, roster, styleSheet, grLevels, mcLevels,
            dropCols, labels, mcBefore,
            addForms, addAbsent, summarySheet, summarySheetName,
            includeCodeList=includeCodeList)

    summary = pd.DataFrame(rows, columns=_BUILD_SUMMARY_COLS)
    built = (summary["status"] == "built").sum() if not summary.empty else 0
    print(f"\n{'DRY RUN — ' if dryRun else ''}{len(summary)} (stream, date) pair(s) considered, "
          f"{built} workbook(s) written under {folder}"
          f"  (stream={stream}, skipExisting={skipExisting}, minForms={minForms})")

    # A split run silently leaves behind any item code that matches no stream. Say so —
    # otherwise the per-stream workbooks look like a complete account of the data.
    if stream is not None:
        try:
            allCodes = readDf(engine, getWeeklySimDatesSql(minDate, maxDate, cohort,
                                                               type_, STREAM_ALL))
            seen = {standardizeWeekFormat(c.strip())
                    for s in allCodes.get("week_keys", pd.Series(dtype=str)).dropna()
                    for c in str(s).split(",")}
            streams = cohortStreams(cohort)
            # Only meaningful for cohorts that route by code; a date-range cohort has no
            # notion of an unclassified code, so skip the check entirely.
            if not any(c.get("codePatterns") for c in streams.values()):
                orphans = []
            else:
                orphans = sorted(c for c in seen
                                 if streamForItemCode(c, streams, cohort) is None)
            if orphans:
                print(f"  NOTE: {len(orphans)} item code(s) belong to no stream and were not "
                      f"built: {', '.join(orphans)}")
        except Exception as exc:                      # never let a report kill the build
            print(f"  (unclassified-code check skipped: {type(exc).__name__}: {exc})")
    return summary


