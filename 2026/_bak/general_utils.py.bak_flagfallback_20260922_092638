            "subject":         r.get("subject"),
            "submitted":       r.get("submitted"),
            "version":         r.get("version"),
            "global_rating":   globalRating,
            "assessor_comments": assessorData.get("comments") or None,
            "checklist_key":   checklistKey,
            "checklist_data":  Json(checklistData) if checklistData else None,
            "form":            Json(r.get("form")),
        })
    return rows

def insertScbdRows(engine, rows, insertSql, batchSize=1000):
    with engine.begin() as conn:
        runDdl(conn, CREATE_SCBD_TABLE_SQL)
        for i in range(0, len(rows), batchSize):
