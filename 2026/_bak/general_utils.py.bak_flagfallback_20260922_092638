# ------ Weekly Analysis utilities ────────────────────────────────────────────
#
# Semester ("half year") selector for everything that reads the Weekly Sim folder.
# Semester 1 and semester 2 workbooks live side by side in "DDS2/Weekly Sim", so a
# plain folder glob mixes them. PERIOD picks which half of the year to analyse:
#   FHY - first half year  : dates strictly BEFORE  SEMESTER_SPLIT_DATE
#   SHY - second half year : dates on/after         SEMESTER_SPLIT_DATE
#   ALL - the whole year   : no date filter (the original behaviour)
# The boundary is derived from SEMESTER_SPLIT_DATE, so moving that one constant
# moves both halves and they always stay complementary (FHY + SHY == ALL, no overlap).
PERIOD_FHY = "FHY"
PERIOD_SHY = "SHY"
PERIOD_ALL = "ALL"


def resolvePeriod(period=PERIOD_ALL, minDate=None, maxDate=None, splitDate=None):
    """Turn a period name into an inclusive (minDate, maxDate, label) triple.

    ``period`` accepts 'FHY' / 'SHY' / 'ALL' (case-insensitive, and the aliases
    'SEM1'/'S1'/'H1' and 'SEM2'/'S2'/'H2'), or None to use minDate/maxDate as given.
    Explicit ``minDate`` / ``maxDate`` always win over the period's own bounds, so
    you can narrow a half year further (e.g. period='SHY', maxDate='2026-07-31').

    Returns (minDate, maxDate, label) with dates as 'YYYY-MM-DD' strings or None.
    """
    splitDate = _asDateStr(splitDate or SEMESTER_SPLIT_DATE)
    dayBeforeSplit = (pd.Timestamp(splitDate) - pd.Timedelta(days=1)).strftime("%Y-%m-%d")

    aliases = {"FHY": PERIOD_FHY, "SEM1": PERIOD_FHY, "S1": PERIOD_FHY, "H1": PERIOD_FHY,
               "SHY": PERIOD_SHY, "SEM2": PERIOD_SHY, "S2": PERIOD_SHY, "H2": PERIOD_SHY,
               "ALL": PERIOD_ALL, "": PERIOD_ALL}
    label = PERIOD_ALL if period is None else aliases.get(str(period).strip().upper())
    if label is None:
        raise ValueError(f"Unknown period {period!r} — use 'FHY', 'SHY' or 'ALL'.")

    bounds = {PERIOD_FHY: (None, dayBeforeSplit),
              PERIOD_SHY: (splitDate, None),
              PERIOD_ALL: (None, None)}[label]
    return (_asDateStr(minDate) or bounds[0], _asDateStr(maxDate) or bounds[1], label)


def periodSuffixPath(path, period=PERIOD_ALL):
    """'…/x.xlsx' + 'SHY' -> '…/x (SHY).xlsx'. ALL/None is returned unchanged, so the
    existing whole-year filenames (and anything downstream pointing at them) keep
    working exactly as before."""
    _, _, label = resolvePeriod(period)
    if label == PERIOD_ALL:
        return path
    root, ext = os.path.splitext(path)
    return f"{root} ({label}){ext}"


def matchesIgnoreCode(itemCode, ignoreCodeList):
    """True if ``itemCode`` matches any entry in ``ignoreCodeList``.

    Entries are shell-style glob patterns, matched case-insensitively:
        'positioning'        exact (a pattern with no wildcard is just an exact match)
        '2026-Week-*'        every semester-1 catch-up code
        'Paeds*'             the whole Paeds family
        '*-Week-0?'          weeks 01-09 of any family
    BOTH sides are pushed through standardizeWeekFormat first, so listing
    'Paeds 2026-Week-1' (the raw DASH spelling) still matches the normalised
    'Paeds-2026-Week-01' that ends up in the workbooks.
    """
    if not ignoreCodeList:
        return False
    code = str(standardizeWeekFormat(str(itemCode).strip())).casefold()
    for pattern in ignoreCodeList:
        pat = str(standardizeWeekFormat(str(pattern).strip())).casefold()
        if fnmatch.fnmatch(code, pat):
            return True
    return False


def dropIgnoredItemCodes(weeklyFiles, ignoreCodeList=None, minItemCount=0, verbose=True,
                         idCol="student_number", includeCodeList=None):
    """Drop unwanted item codes from a [(dateStr, df), ...] list of weekly files.

    ignoreCodeList : glob patterns (see matchesIgnoreCode). Default None = drop nothing.
    minItemCount   : drop any item code sat by fewer than this many DISTINCT students
                     across the whole loaded set. Default 0 = off. This is the automatic
                     version of the ignore list: a code done by one catch-up student
                     still gets its own column and its own percentile threshold computed
                     over n=1, which is meaningless — minItemCount=5 removes those.
                     Counted across all dates together, so a code split over two dates
                     is judged on its combined student count, not per date.
    verbose        : print what was dropped. Silent dropping would make the combined
                     workbook look complete when it isn't.

    Returns a new [(dateStr, df), ...]; dates left with no rows are removed entirely.
    """
    if not ignoreCodeList and not minItemCount and not includeCodeList:
        return weeklyFiles

    present = [(d, df) for d, df in weeklyFiles if ITEM_CODE_COL in df.columns]
    if not present:
        return weeklyFiles

    dropped = {}                       # item code -> reason

    if includeCodeList:
        for _, df in present:
            for code in df[ITEM_CODE_COL].dropna().unique():
                if code not in dropped and not matchesIgnoreCode(code, includeCodeList):
                    dropped[code] = "not in includeCodeList"

    if ignoreCodeList:
        for _, df in present:
            for code in df[ITEM_CODE_COL].dropna().unique():
                if code not in dropped and matchesIgnoreCode(code, ignoreCodeList):
                    dropped[code] = "ignoreCodeList"

    if minItemCount:
        counts = {}
        for _, df in present:
            sub = df[[c for c in (idCol, ITEM_CODE_COL) if c in df.columns]].dropna()
            for code, grp in sub.groupby(ITEM_CODE_COL):
                seen = counts.setdefault(code, set())
                seen.update(grp[idCol].unique() if idCol in grp.columns else range(len(grp)))
        for code, seen in counts.items():
            if code not in dropped and len(seen) < minItemCount:
                dropped[code] = f"minItemCount (n={len(seen)})"

    if not dropped:
        return weeklyFiles

    out, emptied = [], []
    for dateStr, df in weeklyFiles:
        if ITEM_CODE_COL in df.columns:
            kept = df[~df[ITEM_CODE_COL].isin(dropped.keys())]
            if kept.empty:
                emptied.append(dateStr)
                continue
            df = kept.reset_index(drop=True)
        out.append((dateStr, df))

    if verbose:
        print(f"Ignored {len(dropped)} item code(s): "
              + ", ".join(f"{c} [{r}]" for c, r in sorted(dropped.items())))
        if emptied:
            print(f"  {len(emptied)} date(s) left with no rows and were dropped: {', '.join(emptied)}")
    return out


def loadWeeklyFiles(folderPath, dateRegex=DEFAULT_DATE_REGEX, filePattern=DEFAULT_FILE_PATTERN,
                    period=PERIOD_ALL, minDate=None, maxDate=None,
                    ignoreCodeList=None, minItemCount=0, verbose=True,
                    includeCodeList=None):
    """Load the weekly assessment workbooks in a folder as [(dateStr, df), ...].

    The date is taken from the FILENAME via ``dateRegex`` (files are named
    'dds2 <YYYY-MM-DD> assessment_data.xlsx'), so the filter is a plain string
    comparison — ISO dates sort and compare correctly as text.

    ``period`` ('FHY' / 'SHY' / 'ALL') selects the half year; ``minDate`` / ``maxDate``
    (inclusive) override it for an arbitrary window. Default 'ALL' reproduces the
    original whole-folder behaviour exactly.

    ``ignoreCodeList`` / ``minItemCount`` drop item codes — see dropIgnoredItemCodes.
    Both default to "nothing dropped", so the default call is unchanged behaviour.

    ``folderPath`` may be a single folder or a LIST of folders (see weeklySimFolders) —
    a pooled read across stream subfolders. Workbooks sharing a date across folders are
    concatenated into that date's frame, which is what makes an all-streams combined
    report possible without moving any files. Missing folders in a list are skipped.
    """
    minDate, maxDate, _ = resolvePeriod(period, minDate, maxDate)
    folders = [folderPath] if isinstance(folderPath, (str, os.PathLike)) else list(folderPath)
    compiledFile = re.compile(filePattern, re.IGNORECASE)
    compiledDate = re.compile(dateRegex)
    byDate = {}
    for oneFolder in folders:
        if not os.path.isdir(oneFolder):
            continue
        for filename in sorted(os.listdir(oneFolder)):
            if filename.startswith("~$"):
                continue
            if not compiledFile.search(filename):
                continue
            dateMatch = compiledDate.search(filename)
            if not dateMatch:
                continue
            dateStr = dateMatch.group(0)
            if (minDate and dateStr < minDate) or (maxDate and dateStr > maxDate):
                continue
            filePath = os.path.join(oneFolder, filename)
            df = pd.read_excel(filePath, engine="openpyxl")
            # Undo the sheet's presentation labels so everything downstream keeps working
            # in snake_case. A workbook written before 2026-08-18 has no labels to undo,
            # so the same call handles both layouts and the two can sit in one folder.
            df.rename(columns={**WEEKLY_SHEET_COLUMN_LABELS_INVERSE,
                               'Assessor Score': 'assessor_score'}, inplace=True)
            # Normalise the week keys on load as well as at build time, so a workbook
            # written before standardizeWeekFormat was generalised still lines up with
            # the rest — and so ignoreCodeList only ever has to match one spelling.
            if ITEM_CODE_COL in df.columns:
                # Attendance placeholders (a roster student with no data — see
                # addWeeklyAttendance) carry a name and nothing else. They exist so the
                # SHEET reads as a register; letting one through would put a student with
                # all-blank scores into the combined workbook, where the flagging would
                # score them Pass. Dropped here, in the single funnel, so every downstream
                # consumer is unchanged. Also drops the `Forms` column for the same reason.
                df = df[df[ITEM_CODE_COL].notna()].copy()
                df[ITEM_CODE_COL] = df[ITEM_CODE_COL].apply(standardizeWeekFormat)
            df = df.drop(columns=[c for c in (WEEKLY_FORMS_COL,) if c in df.columns])
            byDate.setdefault(dateStr, []).append(df)
    files = [(d, parts[0] if len(parts) == 1 else pd.concat(parts, ignore_index=True))
             for d, parts in sorted(byDate.items())]
    return dropIgnoredItemCodes(files, ignoreCodeList, minItemCount, verbose=verbose,
                                includeCodeList=includeCodeList)

class FlagMethod(str, Enum):
    """Method used to identify low-performing students.

    All three produce ONE cutoff PER ITEM CODE, because that is what the wide score
    table is pivoted on. A student is flagged Fail when they sit at or below the cutoff
    in at least ``min_low_count`` item codes.

    PERCENTILE - cutoff = the given quantile (default 0.15) of the cohort's scores for
                 that item code. Purely relative: some students are always below it.
    BLR        - borderline regression. Fit assessor_score ~ GR across every form
                 carrying that item code, then read the fitted score at GR =
                 borderline_gr. Uses the assessors' own global ratings to locate
                 "borderline" on the score scale.
    BORDERLINE - borderline group average. Cutoff = mean assessor_score of the forms
                 whose GR equals borderline_gr, for that item code. Same idea as BLR
                 but without assuming the score/GR relationship is linear; noisier when
                 few students sit on the borderline rating.
    """
    PERCENTILE = "percentile"
    BLR = "blr"
    BORDERLINE = "borderline"


# Human-readable description of each method, used on the Description sheet.
FLAG_METHOD_NOTES = {
    "percentile": ("Cutoff per item code = the {percentile:.0%} quantile of the cohort's scores "
                   "for that code. Relative — a fixed share of the cohort is always below it."),
    "blr": ("Borderline regression per item code: assessor_score ~ GR is fitted across every "
            "form carrying that code, and the cutoff is the fitted score at GR = {borderline_gr}. "
            "Anchored to the assessors' own global ratings."),
    "borderline": ("Borderline group average per item code: cutoff = mean assessor_score of the "
                   "forms rated GR = {borderline_gr} for that code. No linearity assumption, but "
                   "noisier when few students sit on the borderline rating."),
}

def printDuplicateItemStudents(longDf, idCols, valueCol):
    """Print students who have done the same item code more than once, with dates and scores.

    Always returns a DataFrame (columns idCols + item_code + dates + scores) — EMPTY when
    there are no repeats. It used to return None in that case, which crashed the caller in
    exportCombinedNotebook on `duplicates.to_excel(...)`; a stream with no repeated codes
    (perfectly normal early in a semester) took the whole combined build down with it.
    """
    emptyCols = idCols + [ITEM_CODE_COL, "dates", "scores"]

    # Count occurrences per student + item code
    grouped = longDf.groupby(idCols + [ITEM_CODE_COL, "date"])[valueCol].max().reset_index()

    # Find student+item combos with more than one date
    countPerCombo = grouped.groupby(idCols + [ITEM_CODE_COL])["date"].count().reset_index()
    countPerCombo.columns = idCols + [ITEM_CODE_COL, "n_attempts"]

    duplicates = countPerCombo[countPerCombo["n_attempts"] > 1]

    if duplicates.empty:
        print("No students with multiple attempts on the same item code.")
        return pd.DataFrame(columns=emptyCols)

    print(f"Students with multiple attempts on the same item code ({len(duplicates)} combos):\n")
    dupCombos = duplicates[idCols + [ITEM_CODE_COL]]
    dupsDf = grouped.merge(dupCombos, on=idCols + [ITEM_CODE_COL], how="inner").sort_values(
        idCols + [ITEM_CODE_COL, "date"]
    ).reset_index(drop=True)
    dupsDf = dupsDf.groupby(idCols + [ITEM_CODE_COL]).agg(
    dates=("date", list),
    scores=(valueCol, list)
        ).reset_index()
    for _, row in duplicates.iterrows():
        # Build filter mask across idCols + item code
        mask = pd.Series([True] * len(grouped))
        for col in idCols:
            mask &= (grouped[col] == row[col])
        mask &= (grouped[ITEM_CODE_COL] == row[ITEM_CODE_COL])
        
        attempts = grouped[mask].sort_values("date")
        
        # Header line
        idStr = "  |  ".join(f"{col}: {row[col]}" for col in idCols)
        print(f"  {idStr}  |  Item: {row[ITEM_CODE_COL]}  ({int(row['n_attempts'])} attempts)")
        
        for _, a in attempts.iterrows():
            score = a[valueCol]
            print(f"    {a['date']}  →  {score}")
        print()
    return dupsDf

def getChecklistBank(engine, cohort: str = "DDS2", type_: str = "Simulation") -> pd.DataFrame:
    sql = f"""
        SELECT DISTINCT
            week_key,
            week_name,
            mc_key,
            mc_desc,
            LENGTH(mc_key)  AS mc_key_len
        FROM {RAWFORM_FORMS_NAME},
        -- v3: checklist DEFINITIONS (name + fields:{MC:desc}) live in the config,
        -- not the data column. Prefer assessor_config, fall back to student_config
        -- (BOH1 student-only / BOH2 Smile Squad forms have only student_config).
        LATERAL jsonb_each(
            COALESCE(assessor_config->'checklists'->'selected',
                     student_config->'checklists'->'selected',
                     '{{}}'::jsonb)
        )                                                AS week_entry(week_key, week_val),
        LATERAL jsonb_each(week_val -> 'fields')         AS mc_entry(mc_key, mc_val),
        LATERAL (SELECT
            week_val ->> 'name'    AS week_name,
            mc_val #>> '{{}}'        AS mc_desc
        ) meta
        WHERE cohort                = :cohort
          AND datetimeutc >= TIMESTAMPTZ '2026-01-01'
          AND type                  = :type_
          AND submitted_by_assessor = true
          AND week_val ? 'fields'
        ORDER BY week_key, mc_key_len, mc_key
    """
    df = readDf(engine, sql, {"cohort": cohort, "type_": type_})
    df["week_key"] = df["week_key"].apply(standardizeWeekFormat)
    # remove duplicate week_key + mc_key combos keeping the first (should be the most complete description due to ordering by length desc)
    df = df.drop_duplicates(subset=["week_key", "mc_key"], keep="first").reset_index(drop=True)
    # get unique descriptions and assign numeric ids like CH1, CH2, etc for easier reference in analysis    
    uniqueMcs = df["mc_desc"].unique()
    uniqueMcs.sort()
    mcIdMap = {desc: f"CH{i+1}" for i, desc in enumerate(uniqueMcs)}
    df["mc_id"] = df["mc_desc"].map(mcIdMap)
    return df

def buildWideDf(folderPath, valueCol, dateRegex=DEFAULT_DATE_REGEX,filePattern=DEFAULT_FILE_PATTERN, idCols=DEFAULT_ID_COLS,
                pivotCol="date", period=PERIOD_ALL, minDate=None, maxDate=None,
                ignoreCodeList=None, minItemCount=0, verbose=True,
                includeCodeList=None,
                extraCols=("subject", "assessor_name"), aggfunc="max"):
    """Wide (student x pivotCol) table plus the long frame it was built from.

    ``aggfunc`` decides what happens when a student has the SAME item code more than
    once — i.e. a repeat or catch-up attempt. Default "max" keeps the student's BEST
    attempt, which is the intended behaviour: a student who redoes a week and improves
    should be judged on the improved result. Use "min"/"mean"/"last" to change it.
    'Avg Score' is then the mean across those per-code best attempts.

    ``extraCols`` are carried through into the LONG frame when the workbook has them
    (they play no part in the pivot). 'subject' is kept so callers can cross-check it
    against the item code, and 'assessor_name' so they can build the assessor pivot;
    a workbook that lacks either column simply has it skipped.
    """
    weeklyFiles = loadWeeklyFiles(folderPath, dateRegex, filePattern, period, minDate, maxDate,
                                  ignoreCodeList, minItemCount, verbose,
                                  includeCodeList=includeCodeList)
    rows = []
    for dateStr, df in weeklyFiles:
        if not all(c in df.columns for c in idCols + [valueCol]):
            continue
        keep = idCols + [valueCol, ITEM_CODE_COL] + [c for c in (extraCols or ())
                                                     if c in df.columns and c not in idCols]
        tmp = df[keep].copy()
        tmp["date"] = dateStr
        rows.append(tmp)

    if not rows:
        return pd.DataFrame(columns=idCols), pd.DataFrame(columns=idCols), pd.DataFrame(columns=idCols)

    longDf = pd.concat(rows, ignore_index=True)

    # aggfunc="max" -> a repeated item code keeps the student's BEST attempt.
    wideDf = (longDf.pivot_table(index=idCols, columns=pivotCol, values=valueCol,
                                 aggfunc=aggfunc).reset_index())

    dateCols = sorted([c for c in wideDf.columns if c not in idCols])
    wideDf = wideDf[idCols + dateCols]
    wideDf[dateCols] = wideDf[dateCols].apply(pd.to_numeric, errors="coerce").round(2)
    wideDf['Avg Score'] = wideDf[dateCols].mean(axis=1).round(2)

    missingDf = wideDf.copy()
    missingDf["missing_item_codes"] = missingDf.apply(lambda row: [col for col in dateCols if pd.isna(row[col])], axis=1)
    missingDf = missingDf[missingDf["missing_item_codes"].map(len) > 0][idCols + ["missing_item_codes"]].reset_index(drop=True)
    return wideDf, longDf, missingDf

def runBlrAnalysis(df, dateStr, borderlineGr, mcCols=None, grCol = "GR"):
    """Run full BLR analysis for a single day's data. Returns dict of results."""
    print(f"Running BLR analysis for {dateStr} (n={len(df)})...")
    if mcCols is None:
        mcCols = [c for c in df.columns if c.startswith("MC")]

    # ── 1. Borderline group method: mean score of borderline group ──
    borderlineScores = df.loc[df[grCol] == borderlineGr, "assessor_score"]
    borderlineMean = borderlineScores.mean()
    borderlineSd = borderlineScores.std()

    # ── 2. Linear regression: assessor_score ~ global_rating ──
    slope, intercept, rVal, pVal, stdErr = stats.linregress(
        df[grCol], df["assessor_score"]
    )
    regressionCutoff = slope * borderlineGr + intercept
    rSquared = rVal ** 2

    # ── 3. Per-rating group stats ──
    ratingGroups = df.groupby(grCol)["assessor_score"]
    ratingStats = ratingGroups.agg(["mean", "std", "count"]).rename(
        columns={"mean": "meanScore", "std": "sdScore", "count": "n"}
    )

    # ── 4. Item analysis ──
    itemStats = []
    for mc in mcCols:
        if mc not in df.columns:
            continue
        itemMean = df[mc].mean()
        borderlineItemMean = df.loc[df[grCol] == borderlineGr, mc].mean()
        itemTotalCorr = df[mc].corr(df["assessor_score"])
        itemStats.append({
            "item": mc,
            "mean": round(itemMean, 3),
            "borderlineMean": round(borderlineItemMean, 3),
            "itemTotalCorr": round(itemTotalCorr, 3),
        })
    itemStatsDf = pd.DataFrame(itemStats)

    # ── 5. Cronbach's alpha ──
    validMcCols = [c for c in mcCols if c in df.columns]
    mcData = df[validMcCols].dropna()
    k = len(validMcCols)
    itemVars = mcData.var(axis=0, ddof=1)
    totalVar = mcData.sum(axis=1).var(ddof=1)
    cronbachAlpha = (k / (k - 1)) * (1 - itemVars.sum() / totalVar) if k > 1 else np.nan

    # ── 6. Flag students below cutoff ──
    belowCutoffDf = df.loc[
        df["assessor_score"] <= regressionCutoff,
        ["student_number", "student_name", "assessor_score", grCol, "assessor_name"],
    ].sort_values("assessor_score")

    return {
        "date": dateStr,
        "n": len(df),
        "borderlineMean": round(borderlineMean*100, 2),
        "borderlineSd": round(borderlineSd*100, 2),
        "regressionCutoff": round(regressionCutoff*100, 2),
        "slope": round(slope, 2),
        "intercept": round(intercept, 2),
        "rSquared": round(rSquared, 2),
        "pVal": round(pVal, 4),
        "overallMean": round(df["assessor_score"].mean()*100, 2),
        "overallSd": round(df["assessor_score"].std()*100, 2),
        "cronbachAlpha": round(cronbachAlpha, 2),
        "ratingStats": ratingStats,
        "itemStatsDf": itemStatsDf,
        "belowCutoffDf": belowCutoffDf,
        "df": df,
    }

def runBlrAnalysisForAllFiles(folderPath, borderlineGr=2, dateRegex=r"\d{4}-\d{2}-\d{2}", filePattern=r"assessment_data\.xlsx$",
                              period=PERIOD_ALL, minDate=None, maxDate=None,
                              ignoreCodeList=None, minItemCount=0, minRows=3, includeCodeList=None):
    """Run BLR analysis for the weekly files in folder. Returns a DataFrame of results.

    ``folderPath`` may be one folder or a list (see loadWeeklyFiles / weeklySimFolders).
    ``period`` ('FHY' / 'SHY' / 'ALL') restricts which workbooks are analysed.
    ``ignoreCodeList`` / ``minItemCount`` drop item codes before the regression is fitted,
    so an ignored code contributes nothing to that date's cutoff.
    ``minRows`` skips dates with too few rows to regress at all — the per-stream split
    creates genuine 1-2 form catch-up days, and scipy returns an all-NaN row for those
    rather than failing, which is worse than saying so. Set 0 to keep them.
    """
    files = loadWeeklyFiles(folderPath, dateRegex, filePattern, period, minDate, maxDate,
                            ignoreCodeList, minItemCount, includeCodeList=includeCodeList)
    if not files:
        print(f"No weekly files matched in {folderPath} for period={period}.")
        return pd.DataFrame()
    allResults, tooSmall = [], []
    for dateStr, df in files:
        if minRows and len(df) < minRows:
            tooSmall.append(f"{dateStr} (n={len(df)})")
            continue
        allResults.append(runBlrAnalysis(df, dateStr, borderlineGr))
    if tooSmall:
        print(f"BLR skipped {len(tooSmall)} date(s) with fewer than {minRows} rows: "
              + ", ".join(tooSmall))
    return pd.DataFrame(allResults)


