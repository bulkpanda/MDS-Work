    "# createFlaggingReport(\"BOH2\", \"Clinic\", config=PRESETS[\"boh2_clinic\"].copy(), period=\"SHY\")\n",
    "# BOH1 Sim (2026-09-30): own preset — entrustment flags low-tier only, + Item Code Score Pivot sheet\n",
