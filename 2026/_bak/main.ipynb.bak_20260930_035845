    "           f.student_data  -> 'texts'                                                                 AS student_texts\n",
    "    FROM rawform_forms_v3 f\n",
    "    CROSS JOIN LATERAL jsonb_each(COALESCE(f.assessor_data -> 'checklists', '{}'::jsonb)) AS item(item_code, items)\n",
    "    CROSS JOIN LATERAL jsonb_each(CASE WHEN jsonb_typeof(item.items) = 'object' THEN item.items ELSE '{}'::jsonb END) AS mc(mc_key, val)\n",
    "    CROSS JOIN LATERAL (SELECT COALESCE(f.assessor_config -> 'checklists' -> 'selected' -> item.item_code,\n",
    "                                        f.student_config  -> 'checklists' -> 'selected' -> item.item_code) AS c) cfg\n",
    "    WHERE f.cohort = :cohort AND f.type = :formType AND f.submitted_by_assessor\n",
    "      AND f.datetimeutc >= :dateFrom AND f.datetimeutc < CAST(:dateTo AS date) + 1\n",
    "      AND item.item_code ~ :codeRegex AND mc.mc_key ~ '^MC[0-9]+$';\n",
    "    \"\"\"\n",
    "    return readDf(engine, sql, dict(cohort=cohort, formType=formType, codeRegex=codeRegex,\n",
    "                                    dateFrom=dateFrom, dateTo=dateTo))\n",
    "\n",
    "\n",
    "def textsToComment(texts):\n",
    "    \"\"\"All non-empty free-text fields of a form, 'Label: text' joined by blank lines.\"\"\"\n",
    "    if isinstance(texts, str):\n",
    "        texts = json.loads(texts or \"{}\")\n",
    "    parts = []\n",
    "    for k, v in (texts or {}).items():\n",
    "        v = str(v or \"\").strip()\n",
    "        if v:\n",
    "            parts.append(v if k == \"reflection\" else f\"{k.replace('-', ' ').capitalize()}: {v}\")\n",
    "    return \"\\n\\n\".join(parts)\n",
    "\n",
    "\n",
    "def prepareItemScores(raw, groupingPath, reassessDates=(), excluded=()):\n",
    "    \"\"\"Points/% per item, Melbourne session date, session type, and the groups from the grouping workbook.\"\"\"\n",
    "    df = raw.copy()\n",
    "    df[\"student_number\"] = df[\"student_number\"].astype(str)\n",
    "    df = df[~df[\"student_number\"].isin({str(s) for s in excluded})]\n",
    "    df[\"points\"] = df[\"level_key\"].map(LEVEL_POINTS)\n",
    "    df = df[df[\"points\"].notna()].copy()                       # N/A / other keys excluded\n",
    "    df[\"pct\"] = df[\"points\"] / 5 * 100\n",
    "    df[\"date\"] = pd.to_datetime(df[\"datetimeutc\"], utc=True).dt.tz_convert(\"Australia/Melbourne\").dt.date\n",
    "    df[\"is_reassess\"] = df[\"date\"].astype(str).isin(set(reassessDates))\n",
    "    df[\"assessor_comment\"] = df[\"assessor_texts\"].apply(textsToComment)\n",
    "    df[\"student_comment\"] = df[\"student_texts\"].apply(textsToComment)\n",
    "    df[\"mc_text\"] = df[\"mc_text\"].fillna(\"\").str.strip()\n",
    "\n",
    "    g = pd.read_excel(groupingPath, sheet_name=\"Grouping\", dtype=str).fillna(\"\")\n",
    "    cols = [\"group_heading\", \"group\", \"group_theme\", \"group_domain\", \"criterion_norm\", \"section_heading\", \"heading_teeth\"]\n",
    "    full = g.drop_duplicates([\"item_code\", \"MC\", \"mc_text\"])[[\"item_code\", \"MC\", \"mc_text\"] + cols]\n",
    "    byMc = g.drop_duplicates([\"item_code\", \"MC\"])[[\"item_code\", \"MC\"] + cols]\n",
    "    df = df.merge(full, on=[\"item_code\", \"MC\", \"mc_text\"], how=\"left\")\n",
    "    miss = df[\"group\"].isna()\n",
    "    if miss.any():                                             # wording not in the workbook -> fall back to item_code + MC\n",
    "        fb = df.loc[miss, [\"item_code\", \"MC\"]].merge(byMc, on=[\"item_code\", \"MC\"], how=\"left\")\n",
    "        df.loc[miss, cols] = fb[cols].values\n",
    "    df[cols] = df[cols].fillna(\"Unmapped\")\n",
    "    df.loc[df[\"group\"] == \"\", \"group\"] = df[\"group_theme\"]\n",
    "    print(f\"items {len(df)} · unmapped {(df['group'] == 'Unmapped').sum()} (re-run the grouping cell if > 0)\")\n",
    "    return df\n",
    "\n",
    "\n",
    "def labelSessions(stuDf):\n",
    "    \"\"\"One row per student form, in order, with a short label ('23-Mar W7') and a session type.\"\"\"\n",
    "    s = (stuDf.groupby([\"assessmentid\", \"form_code\"], as_index=False)\n",
    "              .agg(date=(\"date\", \"first\"), item_code=(\"item_code\", \"first\"), assessor=(\"assessor_name\", \"first\"),\n",
    "                   is_reassess=(\"is_reassess\", \"first\"), global_rating=(\"global_rating\", \"first\"),\n",
    "                   teeth=(\"heading_teeth\", lambda x: \", \".join(sorted({t for v in x for t in str(v).split(\", \") if t and t != \"Unmapped\"}))),\n",
    "                   pct=(\"pct\", \"mean\"), n_items=(\"pct\", \"size\"),\n",
    "                   assessor_comment=(\"assessor_comment\", \"first\"), student_comment=(\"student_comment\", \"first\"))\n",
    "              .sort_values([\"date\", \"assessmentid\"]).reset_index(drop=True))\n",
    "    s[\"week\"] = s[\"item_code\"].str.extract(r\"Week-0*(\\d+)\", expand=False).radd(\"W\")\n",
    "    seen, types = set(), []\n",
    "    for r in s.itertuples():\n",
    "        types.append(\"Reassessment\" if r.is_reassess else (\"Repeat\" if r.item_code in seen else \"Weekly\"))\n",
    "        seen.add(r.item_code)\n",
    "    s[\"session_type\"] = types\n",
    "    s[\"session\"] = [f\"{pd.Timestamp(d):%d-%b} {w}\" + {\"Reassessment\": \" R\", \"Repeat\": \" rpt\"}.get(t, \"\")\n",
    "                    for d, w, t in zip(s[\"date\"], s[\"week\"], s[\"session_type\"])]\n",
    "    dup = s[\"session\"].duplicated(keep=False)\n",
    "    s.loc[dup, \"session\"] += \" #\" + (s[dup].groupby(\"session\").cumcount() + 1).astype(str)\n",
    "    s[\"session_no\"] = range(1, len(s) + 1)\n",
    "    return s\n",
    "\n",
    "\n",
    "# ── 2. Analysis ───────────────────────────────────────────────────────────────\n",
    "def cohortBaseline(df, student):\n",
    "    \"\"\"Cohort mean % and SD per item_code × MC, from other students' non-reassessment forms.\"\"\"\n",
    "    base = df[(df[\"student_number\"] != student) & ~df[\"is_reassess\"]]\n",
    "    return (base.groupby([\"item_code\", \"MC\"])[\"pct\"].agg(cohort_pct=\"mean\", cohort_sd=\"std\", cohort_n=\"size\")\n",
    "                .reset_index())\n",
    "\n",
    "\n",
    "def studentItems(df, student, baseline, sessions):\n",
    "    \"\"\"The student's items with the matched cohort mean, gap (pp) and z per item, plus session labels.\"\"\"\n",
    "    s = df[df[\"student_number\"] == student].merge(baseline, on=[\"item_code\", \"MC\"], how=\"left\")\n",
    "    s = s.merge(sessions[[\"assessmentid\", \"form_code\", \"session\", \"session_no\", \"session_type\"]],\n",
    "                on=[\"assessmentid\", \"form_code\"], how=\"left\")\n",
    "    s[\"gap\"] = s[\"pct\"] - s[\"cohort_pct\"]\n",
    "    s[\"z\"] = s[\"gap\"] / s[\"cohort_sd\"].replace(0, np.nan)\n",
    "    s[\"low\"] = s[\"level_key\"].isin([\"O4\", \"O5\"])\n",
    "    s[\"high\"] = s[\"level_key\"].isin([\"O1\", \"O2\"])\n",
    "    return s\n",
    "\n",
    "\n",
    "def trendSlope(x, y):\n",
    "    \"\"\"Least-squares slope of % per session (pp per session); NaN if < 3 points.\"\"\"\n",
    "    ok = ~(np.isnan(x) | np.isnan(y))\n",
    "    return float(np.polyfit(x[ok], y[ok], 1)[0]) if ok.sum() >= 3 and np.ptp(x[ok]) > 0 else np.nan\n",
    "\n",
    "\n",
    "def groupSummary(items, groupCol, order=None):\n",
    "    \"\"\"Aggregate per group: n, student %, matched cohort %, gap, z, % Borderline/Unsat, % Outstanding/Done well, trend.\"\"\"\n",
    "    rows = []\n",
    "    for g, sub in items.groupby(groupCol):\n",
    "        n1 = sub[\"session_no\"].nunique()\n",
    "        rows.append({groupCol: g, \"n_items\": len(sub), \"n_sessions\": n1,\n",
    "                     \"student_pct\": sub[\"pct\"].mean(), \"cohort_pct\": sub[\"cohort_pct\"].mean(),\n",
    "                     \"gap_pp\": sub[\"gap\"].mean(), \"mean_z\": sub[\"z\"].mean(),\n",
    "                     \"pct_borderline_unsat\": sub[\"low\"].mean() * 100, \"pct_outstanding_donewell\": sub[\"high\"].mean() * 100,\n",
    "                     \"trend_pp_per_session\": trendSlope(sub[\"session_no\"].astype(float).values, sub[\"pct\"].values),\n",
    "                     \"first_half_pct\": sub[sub[\"session_no\"] <= sub[\"session_no\"].median()][\"pct\"].mean(),\n",
    "                     \"second_half_pct\": sub[sub[\"session_no\"] > sub[\"session_no\"].median()][\"pct\"].mean()})\n",
    "    out = pd.DataFrame(rows)\n",
    "    if order:\n",
    "        out[\"_o\"] = out[groupCol].map({k: i for i, k in enumerate(order)}).fillna(99)\n",
    "        out = out.sort_values([\"_o\", groupCol]).drop(columns=\"_o\")\n",
    "    else:\n",
    "        out = out.sort_values(\"gap_pp\")\n",
    "    return out.round(2).reset_index(drop=True)\n",
    "\n",
    "\n",
    "def groupTimeline(items, groupCol, sessions, value=\"pct\", order=None):\n",
    "    \"\"\"group × session pivot of the mean of `value` (pct, gap or cohort_pct), sessions in date order.\"\"\"\n",
    "    p = items.pivot_table(index=groupCol, columns=\"session\", values=value, aggfunc=\"mean\")\n",
    "    p = p.reindex(columns=[c for c in sessions[\"session\"] if c in p.columns])\n",
    "    if order:\n",
    "        p = p.reindex([k for k in order if k in p.index] + sorted(k for k in p.index if k not in order))\n",
    "    return p.round(1)\n",
    "\n",
    "\n",
    "def criterionTable(items):\n",
    "    \"\"\"Per criterion text: theme/heading, n, student %, cohort %, gap, and the level sequence over time.\"\"\"\n",
    "    rows = []\n",
    "    for c, sub in items.sort_values(\"session_no\").groupby(\"criterion_norm\"):\n",
    "        rows.append({\"criterion\": c, \"example_text\": sub[\"mc_text\"].iloc[0], \"group\": sub[\"group\"].iloc[0],\n",
    "                     \"group_heading\": \" | \".join(sorted(set(sub[\"group_heading\"]))), \"n_items\": len(sub),\n",
    "                     \"student_pct\": sub[\"pct\"].mean(), \"cohort_pct\": sub[\"cohort_pct\"].mean(), \"gap_pp\": sub[\"gap\"].mean(),\n",
    "                     \"levels_over_time\": \" → \".join(sub[\"points\"].astype(int).astype(str)),\n",
    "                     \"first_pct\": sub[\"pct\"].iloc[0], \"last_pct\": sub[\"pct\"].iloc[-1],\n",
    "                     \"sessions\": \", \".join(sub[\"session\"])})\n",
    "    return pd.DataFrame(rows).sort_values(\"gap_pp\").round(2).reset_index(drop=True)\n",
    "\n",
    "\n",
    "def reassessmentTable(items, sessions, groupCol):\n",
    "    \"\"\"Per group: reassessment % vs the student's earlier attempt(s) at the same item code vs cohort on those items.\"\"\"\n",
    "    re_ = items[items[\"session_type\"] == \"Reassessment\"]\n",
    "    if re_.empty:\n",
    "        return pd.DataFrame()\n",
    "    codes = set(re_[\"item_code\"])\n",
    "    orig = items[(items[\"item_code\"].isin(codes)) & (items[\"session_type\"] != \"Reassessment\")]\n",
    "    out = pd.DataFrame({\"original_pct\": orig.groupby(groupCol)[\"pct\"].mean()})\n",
    "    for sess, sub in re_.groupby(\"session\", sort=False):\n",
    "        out[sess] = sub.groupby(groupCol)[\"pct\"].mean()\n",
    "    out[\"cohort_pct\"] = re_.groupby(groupCol)[\"cohort_pct\"].mean()\n",
    "    return out.round(1).reset_index()\n",
    "\n",
    "\n",
    "# ── 3. Charts ─────────────────────────────────────────────────────────────────\n",
    "def chartHeadingSmallMultiples(items, sessions, path, order):\n",
    "    \"\"\"One panel per group heading: student % (blue) vs matched cohort % (orange dashed) by session.\"\"\"\n",
    "    heads = [h for h in order if h in set(items[\"group_heading\"])] + sorted(set(items[\"group_heading\"]) - set(order))\n",
    "    stu = groupTimeline(items, \"group_heading\", sessions, \"pct\")\n",
    "    coh = groupTimeline(items, \"group_heading\", sessions, \"cohort_pct\")\n",
    "    xs = list(stu.columns); x = np.arange(len(xs))\n",
    "    n = len(heads); ncol = 2; nrow = int(np.ceil(n / ncol))\n",
    "    fig, axes = plt.subplots(nrow, ncol, figsize=(11, 2.6 * nrow), sharex=True, sharey=True)\n",
    "    axes = np.atleast_1d(axes).ravel()\n",
    "    reX = [i for i, c in enumerate(xs) if c.endswith(\" R\") or \" R #\" in c]\n",
    "    for ax, h in zip(axes, heads):\n",
    "        for i in reX:\n",
    "            ax.axvspan(i - 0.5, i + 0.5, color=\"#F3F4F6\", zorder=0)\n",
    "        ys, yc = stu.loc[h].values.astype(float), coh.loc[h].values.astype(float)\n",
    "        m = ~np.isnan(ys)\n",
    "        ax.plot(x[m], yc[m], \"--\", color=ORANGE, lw=1.5, marker=\"o\", ms=3, label=\"Cohort (same items)\")\n",
    "        ax.plot(x[m], ys[m], \"-\", color=BLUE, lw=2, marker=\"o\", ms=5, label=\"Student\")\n",
    "        ax.set_title(h, fontsize=10, loc=\"left\", fontweight=\"bold\")\n",
    "        ax.set_ylim(-5, 105); ax.grid(axis=\"y\", alpha=0.3)\n",
    "        for s in (\"top\", \"right\"):\n",
    "            ax.spines[s].set_visible(False)\n",
    "    for ax in axes[n:]:\n",
    "        ax.set_visible(False)\n",
    "    for ax in axes[max(0, n - ncol):n]:\n",
    "        ax.set_xticks(x); ax.set_xticklabels(xs, rotation=60, ha=\"right\", fontsize=7); ax.tick_params(labelbottom=True)\n",
    "    axes[0].legend(fontsize=8, loc=\"lower left\", frameon=False)\n",
    "    fig.supylabel(\"Mean item score (%)\", fontsize=9)\n",
    "    fig.tight_layout(); fig.savefig(path, dpi=180); plt.close(fig)\n",
    "\n",
    "\n",
    "def chartGapBars(summary, groupCol, path, title):\n",
    "    \"\"\"Horizontal bars of gap vs cohort per group (blue above, orange below), n items annotated.\"\"\"\n",
    "    d = summary.sort_values(\"gap_pp\")\n",
    "    fig, ax = plt.subplots(figsize=(10, 0.38 * len(d) + 1.2))\n",
    "    ax.barh(d[groupCol], d[\"gap_pp\"], color=[BLUE if v >= 0 else ORANGE for v in d[\"gap_pp\"]])\n",
    "    for i, (v, n) in enumerate(zip(d[\"gap_pp\"], d[\"n_items\"])):\n",
    "        ax.text(v + (0.8 if v >= 0 else -0.8), i, f\"{v:+.0f} pp  (n={n})\", va=\"center\",\n",
    "                ha=\"left\" if v >= 0 else \"right\", fontsize=8)\n",
    "    lim = max(10, np.nanmax(np.abs(d[\"gap_pp\"])) * 1.45)\n",
    "    ax.set_xlim(-lim, lim); ax.axvline(0, color=\"black\", lw=0.8)\n",
    "    ax.set_xlabel(\"Student − cohort on the same items (percentage points)\", fontsize=9)\n",
    "    ax.set_title(title, fontsize=11, loc=\"left\", fontweight=\"bold\"); ax.tick_params(axis=\"y\", labelsize=8)\n",
    "    for s in (\"top\", \"right\"):\n",
    "        ax.spines[s].set_visible(False)\n",
    "    fig.tight_layout(); fig.savefig(path, dpi=180); plt.close(fig)\n",
    "\n",
    "\n",
    "def chartGapHeatmap(items, groupCol, sessions, path, title, order=None):\n",
    "    \"\"\"group × session heatmap of the gap vs cohort; empty = group not assessed that session.\"\"\"\n",
    "    p = groupTimeline(items, groupCol, sessions, \"gap\", order)\n",
    "    fig, ax = plt.subplots(figsize=(11, 0.34 * len(p) + 1.9))\n",
    "    im = ax.imshow(p.values.astype(float), cmap=GAP_CMAP, vmin=-60, vmax=60, aspect=\"auto\")\n",
    "    ax.set_xticks(range(p.shape[1])); ax.set_xticklabels(p.columns, rotation=60, ha=\"right\", fontsize=7)\n",
    "    ax.set_yticks(range(p.shape[0])); ax.set_yticklabels(p.index, fontsize=8)\n",
    "    for i in range(p.shape[0]):\n",
    "        for j in range(p.shape[1]):\n",
    "            v = p.values[i, j]\n",
    "            if not np.isnan(v):\n",
    "                ax.text(j, i, f\"{v:+.0f}\", ha=\"center\", va=\"center\", fontsize=6.5, color=\"black\")\n",
    "    fig.colorbar(im, ax=ax, fraction=0.025, pad=0.01, label=\"pp vs cohort\")\n",
    "    ax.set_title(title, fontsize=11, loc=\"left\", fontweight=\"bold\")\n",
    "    fig.tight_layout(); fig.savefig(path, dpi=180); plt.close(fig)\n",
    "\n",
    "\n",
    "# ── 4. Outputs ────────────────────────────────────────────────────────────────\n",
    "def writeReportWorkbook(path, sheets, pctSheets=(), gapSheets=()):\n",
    "    \"\"\"Excel: styled headers, widths, colour scales (orange low → blue high; gaps diverging).\"\"\"\n",
    "    with pd.ExcelWriter(path, engine=\"openpyxl\") as xw:\n",
    "        for name, d in sheets.items():\n",
    "            d.to_excel(xw, sheet_name=name, index=d.index.name is not None)\n",
    "        for name, d in sheets.items():\n",
    "            ws = xw.book[name]\n",
    "            ncol = ws.max_column\n",
    "            for j in range(1, ncol + 1):\n",
    "                c = ws.cell(row=1, column=j)\n",
    "                c.font, c.fill = XlFont(bold=True, color=\"FFFFFF\"), XlFill(\"solid\", fgColor=\"094183\")\n",
    "                c.alignment = XlAlign(wrap_text=True, vertical=\"center\")\n",
    "                head = str(c.value or \"\")\n",
    "                ws.column_dimensions[xlCol(j)].width = (60 if head in (\"example_text\", \"assessor_comment\", \"student_comment\", \"mc_text\")\n",
    "                                                        else 40 if head in (\"criterion\", \"sessions\", \"levels_over_time\")\n",
    "                                                        else max(11, min(28, len(head) + 3)))\n",
    "            ws.freeze_panes = \"B2\"; ws.auto_filter.ref = ws.dimensions\n",
    "            for row in ws.iter_rows(min_row=2):\n",
    "                for c in row:\n",
    "                    c.alignment = XlAlign(wrap_text=True, vertical=\"top\")\n",
    "            rng = f\"B2:{xlCol(ncol)}{ws.max_row}\"\n",
    "            if name in pctSheets:\n",
    "                ws.conditional_formatting.add(rng, XlColorScale(start_type=\"num\", start_value=0, start_color=\"E87722\",\n",
    "                                                                mid_type=\"num\", mid_value=60, mid_color=\"FFFFFF\",\n",
    "                                                                end_type=\"num\", end_value=100, end_color=\"094183\"))\n",
    "            if name in gapSheets:\n",
    "                ws.conditional_formatting.add(rng, XlColorScale(start_type=\"num\", start_value=-50, start_color=\"E87722\",\n",
    "                                                                mid_type=\"num\", mid_value=0, mid_color=\"FFFFFF\",\n",
    "                                                                end_type=\"num\", end_value=50, end_color=\"094183\"))\n",
    "\n",
    "\n",
    "def summaryBullets(headSum, themeSum, sessions, items, studentName):\n",
    "    \"\"\"Plain-language findings from the summaries (thresholds: |gap| ≥ 5 pp and ≥ 4 items).\"\"\"\n",
    "    main = items[items[\"session_type\"] != \"Reassessment\"]\n",
    "    b = [f\"{studentName} has {len(sessions)} assessed forms in scope \"\n",
    "         f\"({(sessions['session_type'] != 'Reassessment').sum()} weekly/repeat, {(sessions['session_type'] == 'Reassessment').sum()} reassessment), \"\n",
    "         f\"{sessions['date'].min():%d %b} – {sessions['date'].max():%d %b %Y}; {len(items)} checklist items scored.\",\n",
    "         f\"Overall mean item score {main['pct'].mean():.0f}% against {main['cohort_pct'].mean():.0f}% for the cohort on the same items \"\n",
    "         f\"({main['gap'].mean():+.0f} pp); {main['low'].mean() * 100:.0f}% of items rated Borderline or Unsatisfactory.\"]\n",
    "    strong = themeSum[(themeSum[\"gap_pp\"] >= 5) & (themeSum[\"n_items\"] >= 4)].sort_values(\"gap_pp\", ascending=False)\n",
    "    weak = themeSum[(themeSum[\"gap_pp\"] <= -5) & (themeSum[\"n_items\"] >= 4)].sort_values(\"gap_pp\")\n",
    "    fmt = lambda d: \"; \".join(f\"{r.group} ({r.student_pct:.0f}% vs {r.cohort_pct:.0f}%, n={r.n_items})\" for r in d.itertuples())\n",
    "    b.append(\"Relative strengths (theme): \" + (fmt(strong) if len(strong) else \"none at or above cohort by 5 pp.\"))\n",
    "    b.append(\"Areas for development (theme): \" + (fmt(weak) if len(weak) else \"none below cohort by 5 pp.\"))\n",
    "    solid = themeSum[(themeSum[\"student_pct\"] >= 80) & (themeSum[\"n_items\"] >= 4)].sort_values(\"student_pct\", ascending=False)\n",
    "    b.append(\"Consistently strong (theme mean ≥ 80%): \" + (fmt(solid) if len(solid) else \"none.\"))\n",
    "    hs = headSum.dropna(subset=[\"trend_pp_per_session\"])\n",
    "    up = hs[hs[\"trend_pp_per_session\"] >= 1.5][\"group_heading\"].tolist()\n",
    "    dn = hs[hs[\"trend_pp_per_session\"] <= -1.5][\"group_heading\"].tolist()\n",
    "    b.append(\"Trend by section: \" + (f\"improving in {', '.join(up)}\" if up else \"no clear improvement\")\n",
    "             + (f\"; declining in {', '.join(dn)}\" if dn else \"\") + \" (least-squares slope across sessions, ≥1.5 pp per session).\")\n",
    "    return b\n",
    "\n",
    "\n",
    "def buildStudentChecklistReport(engine, student=reportStudent, cohort=reportCohort, formType=reportFormType,\n",
    "                                codeRegex=reportCodeRegex, dateFrom=reportDateFrom, dateTo=reportDateTo,\n",
    "                                reassess=reassessDates, groupingPath=reportGrouping, outDir=reportOutDir, scopeLabel=reportScopeLabel, raw=None):\n",
    "    \"\"\"Build the Excel + PDF report for one student. Returns dict of the DataFrames.\"\"\"\n",
    "    if raw is None:\n",
    "        raw = getChecklistItemScores(engine, cohort, formType, codeRegex, dateFrom, dateTo)\n",
    "    try:\n",
    "        excluded = EXCLUDED_STUDENT_NUMBERS\n",
    "    except NameError:\n",
    "        excluded = ()\n",
    "    df = prepareItemScores(raw, groupingPath, reassess, excluded)\n",
    "    student = str(student)\n",
    "    stuRaw = df[df[\"student_number\"] == student]\n",
    "    if stuRaw.empty:\n",
    "        raise ValueError(f\"No scored items for student {student}\")\n",
    "    studentName = stuRaw[\"student_name\"].iloc[0]\n",
    "    sessions = labelSessions(stuRaw)\n",
    "    items = studentItems(df, student, cohortBaseline(df, student), sessions)\n",
    "    sessCoh = items.groupby(\"session\").agg(cohort_pct=(\"cohort_pct\", \"mean\"), gap_pp=(\"gap\", \"mean\"))\n",
    "    sessions = sessions.merge(sessCoh, on=\"session\", how=\"left\")\n",
    "\n",
    "    headSum = groupSummary(items, \"group_heading\", HEADING_ORDER)\n",
    "    themeSum = groupSummary(items, \"group\")\n",
    "    critSum = criterionTable(items)\n",
    "    out = dict(sessions=sessions, headSum=headSum, themeSum=themeSum, critSum=critSum,\n",
    "               headPct=groupTimeline(items, \"group_heading\", sessions, \"pct\", HEADING_ORDER),\n",
    "               headGap=groupTimeline(items, \"group_heading\", sessions, \"gap\", HEADING_ORDER),\n",
    "               themePct=groupTimeline(items, \"group\", sessions, \"pct\"),\n",
    "               themeGap=groupTimeline(items, \"group\", sessions, \"gap\"),\n",
    "               critPct=groupTimeline(items, \"criterion_norm\", sessions, \"pct\"),\n",
    "               reHead=reassessmentTable(items, sessions, \"group_heading\"),\n",
    "               reTheme=reassessmentTable(items, sessions, \"group\"), items=items)\n",
    "\n",
    "    os.makedirs(outDir, exist_ok=True)\n",
    "    base = os.path.join(outDir, f\"{studentName} ({student}) Checklist Theme Report\")\n",
    "    sessOut = sessions[[\"session_no\", \"session\", \"date\", \"item_code\", \"session_type\", \"assessor\", \"teeth\", \"global_rating\",\n",
    "                        \"n_items\", \"pct\", \"cohort_pct\", \"gap_pp\", \"assessor_comment\", \"student_comment\"]].round(1)\n",
    "    itemOut = items[[\"session\", \"date\", \"item_code\", \"MC\", \"mc_text\", \"criterion_norm\", \"group_heading\", \"group\", \"group_domain\",\n",
    "                     \"level_key\", \"level_label\", \"points\", \"pct\", \"cohort_pct\", \"gap\", \"assessor_name\"]].round(1)\n",
    "    writeReportWorkbook(base + \".xlsx\", {\n",
    "        \"Sessions\": sessOut.set_index(\"session_no\"), \"Heading Summary\": headSum.set_index(\"group_heading\"),\n",
    "        \"Heading Over Time %\": out[\"headPct\"], \"Heading Over Time Gap\": out[\"headGap\"],\n",
    "        \"Theme Summary\": themeSum.set_index(\"group\"), \"Theme Over Time %\": out[\"themePct\"], \"Theme Over Time Gap\": out[\"themeGap\"],\n",
    "        \"Criterion Summary\": critSum.set_index(\"criterion\"), \"Criterion Over Time %\": out[\"critPct\"],\n",
    "        \"Reassessment by Heading\": out[\"reHead\"].set_index(\"group_heading\") if len(out[\"reHead\"]) else pd.DataFrame(),\n",
    "        \"Reassessment by Theme\": out[\"reTheme\"].set_index(\"group\") if len(out[\"reTheme\"]) else pd.DataFrame(),\n",
    "        \"Item Data\": itemOut.set_index(\"session\"),\n",
    "    }, pctSheets=(\"Heading Over Time %\", \"Theme Over Time %\", \"Criterion Over Time %\"),\n",
    "       gapSheets=(\"Heading Over Time Gap\", \"Theme Over Time Gap\"))\n",
    "\n",
    "    # charts\n",
    "    figDir = base + \" figs\"; os.makedirs(figDir, exist_ok=True)\n",
    "    f1, f2, f3, f4 = (os.path.join(figDir, n) for n in (\"heading_trend.png\", \"theme_gap.png\", \"theme_heatmap.png\", \"heading_gap.png\"))\n",
    "    chartHeadingSmallMultiples(items, sessions, f1, HEADING_ORDER)\n",
    "    chartGapBars(themeSum, \"group\", f2, \"Theme: student vs cohort on the same items (all sessions)\")\n",
    "    chartGapHeatmap(items, \"group\", sessions, f3, \"Theme gap vs cohort by session (pp)\")\n",
    "    chartGapBars(headSum, \"group_heading\", f4, \"Section heading: student vs cohort on the same items\")\n",
    "\n",
    "    # PDF\n",
    "    st = getSampleStyleSheet()\n",
    "    h1 = ParagraphStyle(\"h1\", parent=st[\"Heading1\"], textColor=rlColors.HexColor(BLUE), fontSize=16, spaceAfter=4)\n",
    "    h2 = ParagraphStyle(\"h2\", parent=st[\"Heading2\"], textColor=rlColors.HexColor(BLUE), fontSize=12, spaceBefore=8, spaceAfter=4)\n",
    "    body = ParagraphStyle(\"b\", parent=st[\"BodyText\"], fontSize=8.5, leading=11)\n",
    "    small = ParagraphStyle(\"s\", parent=body, fontSize=7, leading=8.5)\n",
    "    W = A4[0] - 24 * mm\n",
    "\n",
    "    def tbl(d, widths=None, fmt=None):\n",
    "        data = [[Paragraph(f\"<b>{xmlEscape(str(c))}</b>\", small) for c in d.columns]]\n",
    "        for r in d.itertuples(index=False):\n",
    "            data.append([Paragraph(xmlEscape(fmt(c, v) if fmt else str(v)), small) for c, v in zip(d.columns, r)])\n",
    "        t = RlTable(data, colWidths=widths, repeatRows=1)\n",
    "        t.setStyle(RlTableStyle([(\"BACKGROUND\", (0, 0), (-1, 0), rlColors.HexColor(\"#DCE6F2\")),\n",
    "                                 (\"GRID\", (0, 0), (-1, -1), 0.25, rlColors.HexColor(\"#B0B7C3\")),\n",
