    "                    \"in percentage points (pp). Themes come from the grouping workbook (`group` column).\", small),\n",
    "          Paragraph(\"Section heading summary\", h2)]\n",
    "    hs = headSum[[\"group_heading\", \"n_sessions\", \"n_items\", \"student_pct\", \"cohort_pct\", \"gap_pp\", \"pct_borderline_unsat\",\n",
    "                  \"first_half_pct\", \"second_half_pct\", \"trend_pp_per_session\"]].copy()\n",
    "    hs.columns = [\"Section\", \"Sessions\", \"Items\", \"Student %\", \"Cohort %\", \"Gap pp\", \"% Borderline/Unsat\", \"1st half %\", \"2nd half %\", \"Trend pp/session\"]\n",
    "    E += [tbl(hs, [38 * mm] + [16 * mm] * 9, num), Spacer(1, 4), img(f4, 55 * mm), PageBreak(),\n",
    "          Paragraph(\"Section heading over time\", h2),\n",
    "          Paragraph(\"Blue = student, orange dashed = cohort on the same items; grey band = reassessment session.\", small),\n",
    "          img(f1, min(235 * mm, 2.6 * int(np.ceil(headSum.shape[0] / 2)) * 25.4 * mm * W / (11 * 25.4 * mm))), PageBreak(),\n",
    "          Paragraph(\"Themes (grouped by checklist text)\", h2), img(f2, min(120 * mm, (0.38 * len(themeSum) + 1.2) * 25.4 * mm * W / (10 * 25.4 * mm)))]\n",
    "    ts = themeSum[[\"group\", \"n_items\", \"student_pct\", \"cohort_pct\", \"gap_pp\", \"pct_borderline_unsat\", \"first_half_pct\", \"second_half_pct\"]].copy()\n",
    "    ts.columns = [\"Theme\", \"Items\", \"Student %\", \"Cohort %\", \"Gap pp\", \"% Borderline/Unsat\", \"1st half %\", \"2nd half %\"]\n",
    "    E += [tbl(ts, [60 * mm] + [18 * mm] * 7, num), PageBreak(), Paragraph(\"Theme gap by session\", h2),\n",
    "          img(f3, min(150 * mm, (0.34 * len(themeSum) + 1.9) * 25.4 * mm * W / (11 * 25.4 * mm)))]\n",
    "    cs = critSum[critSum[\"n_items\"] >= 2]\n",
    "    for title, d in ((\"Criteria furthest below cohort (assessed ≥ 2 times)\", cs[cs[\"gap_pp\"] < 0].head(8)),\n",
    "                     (\"Criteria above cohort (assessed ≥ 2 times)\", cs[cs[\"gap_pp\"] > 0].iloc[::-1].head(8))):\n",
    "        if d.empty:\n",
    "            continue\n",
    "        t = d[[\"example_text\", \"group\", \"n_items\", \"student_pct\", \"cohort_pct\", \"gap_pp\", \"levels_over_time\"]].copy()\n",
    "        t.columns = [\"Checklist item\", \"Theme\", \"n\", \"Student %\", \"Cohort %\", \"Gap pp\", \"Points over time (5/4/3/2/0)\"]\n",
    "        E += [Paragraph(title, h2), tbl(t, [70 * mm, 32 * mm, 8 * mm, 15 * mm, 15 * mm, 13 * mm, 33 * mm], num)]\n",
    "    if len(out[\"reHead\"]):\n",
    "        E += [PageBreak(), Paragraph(f\"Reassessment ({xmlEscape(', '.join(reassess))}) vs original attempt and cohort\", h2),\n",
    "              Paragraph(\"Original = the student's earlier attempt(s) at the same item code; cohort = other students on those items in the original week.\", small),\n",
    "              tbl(out[\"reHead\"].rename(columns={\"group_heading\": \"Section\", \"original_pct\": \"Original attempt %\", \"cohort_pct\": \"Cohort %\"}), None, num),\n",
    "              Spacer(1, 4),\n",
    "              tbl(out[\"reTheme\"].rename(columns={\"group\": \"Theme\", \"original_pct\": \"Original attempt %\", \"cohort_pct\": \"Cohort %\"}), None, num)]\n",
    "    E += [PageBreak(), Paragraph(\"Session log and feedback\", h2)]\n",
    "    sl = sessOut[[\"session\", \"assessor\", \"global_rating\", \"pct\", \"cohort_pct\", \"assessor_comment\", \"student_comment\"]].copy()\n",
    "    sl.columns = [\"Session\", \"Assessor\", \"Global rating\", \"Student %\", \"Cohort %\", \"Assessor feedback\", \"Student reflection\"]\n",
    "    E += [tbl(sl, [20 * mm, 22 * mm, 17 * mm, 13 * mm, 13 * mm, 50 * mm, 51 * mm], num)]\n",
    "    doc.build(E)\n",
    "    print(f\"Saved {base}.xlsx and {base}.pdf\")\n",
    "    return out\n",
    "\n",
