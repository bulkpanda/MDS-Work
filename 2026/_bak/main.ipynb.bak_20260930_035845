    "\n",
    "    num = lambda c, v: (f\"{v:.0f}\" if isinstance(v, (float, np.floating)) and not np.isnan(v) else (\"—\" if isinstance(v, float) else str(v)))\n",
    "    img = lambda p, h: RlImage(p, width=W, height=h)\n",
    "    doc = SimpleDocTemplate(base + \".pdf\", pagesize=A4, leftMargin=12 * mm, rightMargin=12 * mm, topMargin=12 * mm, bottomMargin=12 * mm,\n",
    "                            title=f\"{studentName} checklist theme report\")\n",
    "    E = [Paragraph(f\"{xmlEscape(studentName)} ({student}) — Checklist performance by section and theme\", h1),\n",
