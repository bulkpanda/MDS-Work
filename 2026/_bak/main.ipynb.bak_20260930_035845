    "# ── Item difficulty stats ──────────────────────────────────────────────────────\n",
    "def buildItemStats(scoresdf, mcDenoms, mcDesc):\n",
    "    rows = []\n",
    "    for mc in mcDenoms:\n",
    "        denom  = mcDenoms[mc]\n",
    "        vals   = scoresdf[mc]\n",
    "        meanPct = (vals / denom).mean() * 100\n",
    "        pMax    = (vals == denom).mean() * 100\n",
    "        sd      = (vals / denom).std() * 100\n",
    "\n",
    "        if meanPct >= 90:\n",
    "            diffLabel = 'Easy'\n",
    "        elif meanPct >= 70:\n",
    "            diffLabel = 'Moderate'\n",
    "        else:\n",
    "            diffLabel = 'Hard'\n",
    "\n",
    "        flags = []\n",
    "        if meanPct >= 90:\n",
    "            flags.append('⚠ Very easy — red flag if missed')\n",
    "        if meanPct < 65:\n",
    "            flags.append('★ Hard — good discriminator')\n",
    "        if sd >= 25:\n",
    "            flags.append('↔ Wide spread — separates competency')\n",
    "        if pMax >= 90:\n",
    "            flags.append('✓ Near-ceiling')\n",
    "\n",
    "        rows.append({\n",
    "            'MC': mc, 'Denominator': denom,\n",
    "            'Domain':      mcDesc.get(mc, {}).get('domain', ''),\n",
    "            'Description': mcDesc.get(mc, {}).get('desc', ''),\n",
    "            'Mean %': round(meanPct, 1),\n",
    "            'SD %':   round(sd, 1),\n",
    "            '% at Max': round(pMax, 1),\n",
    "            'Difficulty': diffLabel,\n",
    "            'Flags': '  |  '.join(flags),\n",
    "        })\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "# ── Sheet builders ─────────────────────────────────────────────────────────────\n",
    "def buildCohortOverview(wb, scoresdf, inputPath):\n",
    "    ws = wb.create_sheet('Cohort Overview')\n",
    "    n  = len(scoresdf)\n",
    "\n",
    "    filename = Path(inputPath).stem\n",
    "\n",
    "    ws.merge_cells('A1:H1')\n",
    "    c = ws['A1']\n",
    "    c.value = f'SCBD — Cohort Overview  |  {filename}'\n",
    "    c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 14)\n",
    "    c.alignment = centerAlign()\n",
    "    ws.row_dimensions[1].height = 28\n",
    "\n",
    "    domains    = [\n",
    "        'D1 Clinical Information Gathering %',\n",
    "        'D2 Diagnosis, Risk Assessment & Prognosis %',\n",
    "        'D3 Treatment Planning %', 'D4 Presentation %', 'Overall %',\n",
    "    ]\n",
    "    domShort   = ['D1 Info Gathering', 'D2 Diagnosis & Risk',\n",
    "                  'D3 Tx Planning', 'D4 Presentation', 'Overall']\n",
    "\n",
    "    ws.cell(3, 1, 'Statistic').fill  = hFill(SUBHDR_BG)\n",
    "    ws.cell(3, 1).font = hFont(SUBHDR_FG, True)\n",
    "    ws.cell(3, 1).alignment = centerAlign(); ws.cell(3, 1).border = thinBorder()\n",
    "    ws.column_dimensions['A'].width = 18\n",
    "    for j, d in enumerate(domShort):\n",
    "        c = ws.cell(3, j+2, d)\n",
    "        c.fill = hFill(SUBHDR_BG); c.font = hFont(SUBHDR_FG, True)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "        ws.column_dimensions[get_column_letter(j+2)].width = 18\n",
    "    ws.row_dimensions[3].height = 30\n",
    "\n",
    "    statNames = ['N', 'Mean', 'Median', 'SD', 'Min', 'Max', 'Pass Rate (GR≥3)']\n",
    "    for i, stat in enumerate(statNames):\n",
    "        r = i + 4\n",
    "        ws.cell(r, 1, stat).fill = hFill('FFD9E1F2')\n",
    "        ws.cell(r, 1).font = hFont('FF000000', True)\n",
    "        ws.cell(r, 1).alignment = centerAlign(); ws.cell(r, 1).border = thinBorder()\n",
    "        for j, col in enumerate(domains):\n",
    "            s = scoresdf[col]\n",
    "            if stat == 'N':                v = n\n",
    "            elif stat == 'Mean':           v = round(s.mean(), 1)\n",
    "            elif stat == 'Median':         v = round(s.median(), 1)\n",
    "            elif stat == 'SD':             v = round(s.std(), 1)\n",
    "            elif stat == 'Min':            v = round(s.min(), 1)\n",
    "            elif stat == 'Max':            v = round(s.max(), 1)\n",
    "            elif stat == 'Pass Rate (GR≥3)':\n",
    "                v = f\"{(scoresdf['GR'] >= 3).mean()*100:.1f}%\" if col == 'Overall %' else '—'\n",
    "            cell = ws.cell(r, j+2, v)\n",
    "            cell.alignment = centerAlign(); cell.border = thinBorder()\n",
    "            if i % 2 == 1: cell.fill = hFill(ALT_ROW_BG)\n",
    "\n",
    "    # GR distribution\n",
    "    grCounts   = scoresdf['GR'].value_counts().sort_index()\n",
    "    grLabelsMap = {1:'Fail', 2:'Borderline Fail', 3:'Pass', 4:'Good', 5:'Excellent'}\n",
    "    rowG = 12\n",
    "    ws.merge_cells(f'A{rowG}:H{rowG}')\n",
    "    c = ws.cell(rowG, 1, 'Grade Distribution')\n",
    "    c.fill = hFill(SUBHDR_BG); c.font = hFont(SUBHDR_FG, True); c.alignment = centerAlign()\n",
    "\n",
    "    for col_idx, hdr in enumerate(['GR', 'Label', 'N', '%'], 1):\n",
    "        c = ws.cell(rowG+1, col_idx, hdr)\n",
    "        c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "\n",
    "    for i, gr in enumerate([1, 2, 3, 4, 5]):\n",
    "        r = rowG + 2 + i\n",
    "        count = grCounts.get(gr, 0)\n",
    "        for col_idx, val in enumerate([gr, grLabelsMap[gr], int(count), f\"{count/n*100:.1f}%\"], 1):\n",
    "            c = ws.cell(r, col_idx, val)\n",
    "            c.fill = hFill(GR_COLORS[gr])\n",
    "            c.alignment = centerAlign() if col_idx != 2 else leftAlign()\n",
    "            c.border = thinBorder()\n",
    "\n",
    "    ws.freeze_panes = 'A3'\n",
    "\n",
    "\n",
    "def buildStudentScores(wb, scoresdf, mcDenoms, inputPath):\n",
