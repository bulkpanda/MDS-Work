    "         Spacer(1, 4), Paragraph(\"Summary\", h2)]\n",
    "    E += [Paragraph(\"• \" + xmlEscape(t), body) for t in summaryBullets(headSum, themeSum, sessions, items, studentName)]\n",
    "    E += [Paragraph(\"Method: each checklist item scored O1 Outstanding 5 · O2 Done well 4 · O3 Mostly done 3 · O4 Borderline 2 · \"\n",
    "                    \"O5 Unsatisfactory 0, shown as % of 5. <b>Cohort</b> = mean of all other DDS2 students on the <i>same item code and \"\n",
