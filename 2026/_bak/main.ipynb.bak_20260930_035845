    "    assessor_repeat_colors : {minCount: colour} for the assessors sheet, default\n",
    "             {2: 'amber', 3: 'red'} — cells where the student has seen that assessor that\n",
    "             many times or more; the highest matching threshold wins. Pass None (or {}) to\n",
    "             turn the highlighting off and keep just the summary columns.\n",
    "    roster : optional roster frame (loadRoster). Orders every student sheet by LAST NAME\n",
    "             and adds last_name / first_name columns. Students not on the roster are\n",
    "             appended, never dropped, and both directions of mismatch are reported.\n",
    "    period : 'FHY' (first half year, before 2026-06-15), 'SHY' (second half year,\n",
    "             on/after it) or 'ALL' (whole year — the original behaviour).\n",
    "             Semester 1 and 2 workbooks share the folder, so 'ALL' pools both.\n",
    "             min_date / max_date (inclusive) narrow it further if needed.\n",
    "    ignore_code_list : item codes to leave out entirely — shell wildcards, case-\n",
    "             insensitive, normalised on both sides (e.g. ['positioning', '2026-Week-*']).\n",
    "             They are dropped before the pivot, so they get no column, no percentile\n",
    "             threshold and no low_count contribution.\n",
    "    min_item_count : drop item codes sat by fewer than N distinct students across the\n",
    "             period. 0 = off. The automatic version of ignore_code_list.\n",
    "    suffix_out_path : True -> FHY/SHY runs get a ' (FHY)' / ' (SHY)' suffix so the\n",
    "             three periods can coexist. 'ALL' keeps the plain filename.\n",
    "    sheet_labels : header relabelling applied at WRITE time only — None (default) uses\n",
    "             COMBINED_SHEET_COLUMN_LABELS so the headers match the weekly sheets\n",
    "             ('student_number' -> 'Student Number'). Item-code columns are never\n",
    "             renamed. Pass {} for the pre-2026-08-18 snake_case headers; risk_report.py\n",
    "             reads either.\n",
    "    \"\"\"\n",
    "    if id_cols is None:\n",
    "        id_cols = list(DEFAULT_ID_COLS)\n",
    "    method = FlagMethod(method)\n",
    "\n",
    "    # Resolve the period ONCE to concrete dates, then pass those down — no chance of\n",
    "    # a nested call re-applying the period bounds differently.\n",
    "    min_date, max_date, period_label = resolvePeriod(period, min_date, max_date)\n",
    "    if suffix_out_path:\n",
    "        out_path = periodSuffixPath(out_path, period_label)\n",
    "\n",
    "    common = dict(folderPath=folder_path, idCols=id_cols, dateRegex=date_regex, filePattern=file_pattern,\n",
    "                  pivotCol = ITEM_CODE_COL, period=PERIOD_ALL, minDate=min_date, maxDate=max_date,\n",
    "                  ignoreCodeList=ignore_code_list, minItemCount=min_item_count, aggfunc=agg,\n",
    "                  includeCodeList=only_code_list)\n",
    "\n",
    "    score_df, score_long_df, score_missing_df = buildWideDf(valueCol=\"assessor_score\", **common)\n",
    "    # the ignore/low-count report is identical for all three, so only print it once\n",
    "    quiet = dict(common, verbose=False)\n",
    "    global_rating_df, global_rating_long_df, global_rating_missing_df = buildWideDf(valueCol=\"GR\", **quiet)\n",
    "    practice_readiness_df, practice_readiness_long_df, practice_readiness_missing_df = buildWideDf(valueCol=\"PR\", **quiet)\n",
    "\n",
    "    if score_df.empty:\n",
    "        print(f\"No weekly workbooks matched period={period_label} \"\n",
    "              f\"(min_date={min_date}, max_date={max_date}) in {folder_path} — nothing written.\")\n",
    "        return None\n",
    "\n",
    "    dates_used = sorted(score_long_df[\"date\"].unique())\n",
    "    codes_used = sorted(score_long_df[ITEM_CODE_COL].dropna().unique())\n",
    "    print(f\"Period {period_label}: {len(dates_used)} assessment date(s) \"\n",
    "          f\"[{dates_used[0]} … {dates_used[-1]}], {len(codes_used)} item code(s), \"\n",
    "          f\"{len(score_df)} students\")\n",
    "\n",
    "    # Subject-code cross-check (workbooks built after the stream split carry `subject`).\n",
    "    mismatch_df = pd.DataFrame()\n",
    "    if \"subject\" in score_long_df.columns:\n",
    "        m = score_long_df[[\"student_number\", \"student_name\", \"date\", ITEM_CODE_COL, \"subject\"]].copy()\n",
    "        m = m.drop_duplicates()\n",
    "        _streams = cohortStreams(cohort)\n",
    "        m[\"stream\"] = m[ITEM_CODE_COL].apply(\n",
    "            lambda c: streamForItemCode(c, _streams, cohort))\n",
    "        m[\"expected_subject\"] = m[\"stream\"].map(\n",
    "            lambda k: _streams[k][\"subject\"] if k in _streams else None)\n",
    "        mismatch_df = m[m[\"expected_subject\"].notna()\n",
    "                        & (m[\"subject\"] != m[\"expected_subject\"])].reset_index(drop=True)\n",
    "        if not mismatch_df.empty:\n",
    "            print(f\"{len(mismatch_df)} form(s) carry a subject code that disagrees with the \"\n",
    "                  f\"item code — see the 'subject_mismatches' sheet.\")\n",
    "\n",
    "    # Assessor pivot — who assessed each student on each item code, for spotting a student\n",
    "    # who keeps drawing the same assessor.\n",
    "    assessor_df, assessor_repeats = pd.DataFrame(), {}\n",
    "    if \"assessor_name\" in score_long_df.columns:\n",
    "        assessor_df, assessor_repeats = buildAssessorPivot(score_long_df, id_cols)\n",
    "        if not assessor_df.empty:\n",
    "            worst = assessor_df.sort_values(\"most_seen_count\", ascending=False).iloc[0]\n",
    "            print(f\"Assessors: most repeated pairing is {worst['most_seen_assessor']} with \"\n",
    "                  f\"{worst[id_cols[-1]]} ({int(worst['most_seen_count'])} forms) — \"\n",
    "                  f\"see the 'assessors' sheet.\")\n",
    "\n",
    "    # itables.show(score_long_df)\n",
    "    # itables.show(score_df)\n",
    "    duplicates = printDuplicateItemStudents(score_long_df, id_cols, \"assessor_score\")\n",
    "\n",
    "    # Item codes kept as columns but EXCLUDED from flag maths and all highlighting.\n",
    "    _code_cols_all = [c for c in score_df.columns if c not in id_cols and c != \"Avg Score\"]\n",
    "    excluded_codes = [c for c in _code_cols_all if matchesIgnoreCode(c, exclude_from_flags)]\n",
    "    if excluded_codes:\n",
    "        print(f\"Excluded from flags/highlights (kept as columns): {excluded_codes}\")\n",
    "\n",
    "    flagged_df, thresholds = flag_low_students( score_df,  method=method, id_cols=id_cols,\n",
    "                min_low_count=min_low_count, percentile=percentile, folder_path=folder_path,\n",
    "                borderline_gr=borderline_gr, date_regex=date_regex,   file_pattern=file_pattern,\n",
    "                period=PERIOD_ALL, min_date=min_date, max_date=max_date,\n",
    "                ignore_code_list=ignore_code_list, min_item_count=min_item_count,\n",
    "                include_code_list=only_code_list, exclude_code_list=exclude_from_flags,\n",
    "                fallback_chain=fallback_chain, blr_min_n=blr_min_n, blr_min_r2=blr_min_r2,\n",
    "                blr_min_low_gr=blr_min_low_gr, bgm_min_borderline_frac=bgm_min_borderline_frac,\n",
    "                bgm_min_borderline_n=bgm_min_borderline_n)\n",
    "\n",
    "    print(f\"Thresholds ({method.value}) per item code:\")\n",
    "    print(thresholds.sort_index())\n",
    "    print()\n",
    "\n",
    "    # Per-week method + the stats behind any fallback (fallback mode only).\n",
    "    flag_diag = thresholds.attrs.get(\"flag_diagnostics\")\n",
    "    if flag_diag is not None and not flag_diag.empty:\n",
    "        print(\"Flag cutoff method per item code (and why each fell back):\")\n",
    "        with pd.option_context(\"display.max_rows\", None, \"display.width\", 220,\n",
    "                               \"display.max_colwidth\", 60):\n",
    "            print(flag_diag.to_string(index=False))\n",
    "        print()\n",
    "        try:\n",
    "            itables.show(flag_diag)\n",
    "        except Exception:\n",
    "            pass\n",
    "\n",
    "    # Roster ordering — staff read by name, not by student number.\n",
    "    not_on_roster, no_data = pd.DataFrame(), pd.DataFrame()\n",
    "    if roster is not None and not roster.empty:\n",
    "        score_df,      not_on_roster, no_data = applyRosterOrder(score_df, roster)\n",
    "        global_rating_df,      _, _ = applyRosterOrder(global_rating_df, roster)\n",
    "        practice_readiness_df, _, _ = applyRosterOrder(practice_readiness_df, roster)\n",
    "        flagged_df,            _, _ = applyRosterOrder(flagged_df, roster)\n",
    "        if not assessor_df.empty:\n",
    "            assessor_df,       _, _ = applyRosterOrder(assessor_df, roster)\n",
    "        id_cols = [id_cols[0], \"last_name\", \"first_name\"] + id_cols[1:]\n",
    "        if not not_on_roster.empty:\n",
    "            print(f\"{len(not_on_roster)} student(s) in the data are NOT on the roster: \"\n",
    "                  + \", \".join(map(str, not_on_roster.iloc[:, -1].tolist())))\n",
    "        if not no_data.empty:\n",
    "            print(f\"{len(no_data)} roster student(s) have NO data: \"\n",
    "                  + \", \".join(f\"{r.first_name} {r.last_name}\" for r in no_data.itertuples()))\n",
    "\n",
    "    fail_ids = flagged_df.loc[flagged_df[\"Pass/Fail\"] == \"Fail\", id_cols[0]].tolist()\n",
    "    print(f\"Students flagged as Fail ({len(fail_ids)}): {fail_ids}\")\n",
    "\n",
    "    # ── Level-count summary columns, placed AFTER Pass/Fail ──────────────────\n",
    "    # Count per student how many item-code cells sit on the requested GR / PR levels.\n",
    "    # Driven by count_level_columns so columns can be added / re-levelled from config\n",
    "    # without touching this function; headers are generated from the levels.\n",
    "    countSources = {\"GR\": global_rating_df, \"PR\": practice_readiness_df}\n",
    "    count_col_names = []\n",
    "    for _src, _levels in (count_level_columns or ()):\n",
    "        if _src not in countSources:\n",
    "            raise ValueError(f\"count_level_columns: unknown source {_src!r}; \"\n",
    "                             f\"use one of {list(countSources)}\")\n",
    "        _label = countLevelColumnLabel(_src, _levels)\n",
    "        _series = countLevelsPerStudent(countSources[_src], id_cols, _levels,\n",
    "                                        excludeCols=excluded_codes)\n",
    "        if _series is None:\n",
    "            flagged_df[_label] = 0\n",
    "        else:\n",
    "            flagged_df[_label] = (flagged_df[id_cols[0]].map(_series)\n",
    "                                  .fillna(0).astype(\"Int64\"))\n",
    "        count_col_names.append(_label)\n",
    "    if count_col_names:\n",
    "        print(f\"Level-count columns added after Pass/Fail: {count_col_names}\")\n",
    "\n",
    "    # Sort the flagged sheet worst-first: most low-score weeks, then lowest average.\n",
    "    _sortCols = [c for c in [\"low_count\", \"Avg Score\"] if c in flagged_df.columns]\n",
    "    if _sortCols:\n",
    "        flagged_df = flagged_df.sort_values(\n",
    "            _sortCols, ascending=[False] + [True] * (len(_sortCols) - 1),\n",
    "            kind=\"mergesort\").reset_index(drop=True)\n",
    "\n",
    "    # ── Description sheet content ────────────────────────────────────────────\n",
    "    thresh_tbl = \", \".join(f\"{c}={thresholds[c]:.3f}\" for c in thresholds.index\n",
    "                           if pd.notna(thresholds.get(c))) or \"none computed\"\n",
    "    n_no_cutoff = int(thresholds.isna().sum()) if len(thresholds) else 0\n",
    "    desc = [\n",
    "        (\"What this workbook is\", None),\n",
    "        (\"Scope\", scope_label or \"DDS2 weekly simulation\"),\n",
    "        (\"Source folders\", folder_path if isinstance(folder_path, str) else \", \".join(folder_path)),\n",
    "        (\"Period\", f\"{period_label} (dates {min_date or 'start'} to {max_date or 'latest'})\"),\n",
    "        (\"Assessment dates\", f\"{len(dates_used)}: {dates_used[0]} to {dates_used[-1]}\"),\n",
    "        (\"Item codes\", f\"{len(codes_used)}: {', '.join(map(str, codes_used))}\"),\n",
    "        (\"Students\", len(score_df)),\n",
    "        (\"Student order\", (\"Alphabetical by LAST NAME, from the roster file.\"\n",
    "                           if roster is not None and not roster.empty\n",
    "                           else \"By student number (no roster file loaded).\")),\n",
    "        (\"Not on roster\", \", \".join(map(str, not_on_roster.iloc[:, -1].tolist()))\n",
    "                          if not not_on_roster.empty else \"none — every student matched\"),\n",
    "        (\"On roster, no data\", \", \".join(f\"{r.first_name} {r.last_name}\"\n",
    "                                         for r in no_data.itertuples())\n",
    "                               if not no_data.empty else \"none\"),\n",
    "        (\"Generated\", str(pd.Timestamp.now().strftime(\"%Y-%m-%d %H:%M\"))),\n",
    "        (None, None),\n",
    "\n",
    "        (\"How a student is flagged\", None),\n",
    "        (\"Method\", f\"{method.value} — \" + FLAG_METHOD_NOTES[method.value].format(\n",
    "            percentile=percentile, borderline_gr=borderline_gr)),\n",
    "        (\"Cutoff granularity\", \"One cutoff PER ITEM CODE (not per date), because the score \"\n",
    "                               \"tables are pivoted by item code. A code sat on several dates \"\n",
    "                               \"gets one cutoff from all of its rows pooled.\"),\n",
    "        (\"low_count\", \"Number of item codes where the student is AT OR BELOW that code's cutoff.\"),\n",
    "        (\"Pass/Fail\", f\"Fail when low_count >= {min_low_count}.\"),\n",
    "        (\"Cutoffs used\", thresh_tbl),\n",
    "        (\"Fallback chain\", \" -> \".join(fallback_chain) if fallback_chain\n",
    "                            else \"off — single method (see Method)\"),\n",
    "        (\"Cutoff method per code\",\n",
    "         \"; \".join(f\"{c}: {thresholds.attrs.get('flag_methods', {}).get(c)}\"\n",
    "                   for c in thresholds.index)\n",
    "         if fallback_chain else \"n/a (single method)\"),\n",
    "        (\"Codes without a cutoff\", f\"{n_no_cutoff} — left uncoloured and not counted \"\n",
    "                                   f\"(too few rows, or a single GR value to regress on).\"\n",
    "                                   if n_no_cutoff else \"0 — every item code has a cutoff.\"),\n",
    "        (\"Result\", f\"{len(fail_ids)} of {len(score_df)} students flagged Fail.\"),\n",
    "        (\"Excluded from flags/highlights\",\n",
    "         (\", \".join(excluded_codes) + \" — kept as columns but not counted toward flags, \"\n",
    "          \"the GR/PR level counts, or any highlighting.\") if excluded_codes else \"none\"),\n",
    "        (None, None),\n",
    "\n",
    "        (\"How the numbers are built\", None),\n",
    "        (\"Repeated item codes\", f\"aggfunc='{agg}' — a student who sits the SAME item code more \"\n",
    "                                f\"than once is scored on their \"\n",
    "                                + (\"BEST attempt.\" if agg == \"max\" else f\"'{agg}' attempt.\")\n",
    "                                + \" Repeats are listed on the 'repeated_attempts' sheet.\"),\n",
    "        (\"Avg Score\", \"Mean across that student's per-item-code values (i.e. across best attempts).\"),\n",
    "        (\"Score scale\", \"0-1. Mean of the O-code mapping across the checklist items in a form: \"\n",
    "                        \"O1=1.00, O2=0.80, O3=0.60, O4=0.40, O5=0.00, Yes=1.00, No=0.00.\"),\n",
    "        (\"GR\", \"Assessor's global rating, 1-5, from scale-global-rating.\"),\n",
    "        (\"PR\", \"Practice readiness, from scale-practice-readiness.\"),\n",
    "        (\"Ignored item codes\", \", \".join(ignore_code_list) if ignore_code_list else \"none\"),\n",
    "        (\"Only item codes (whitelist)\", \", \".join(only_code_list) if only_code_list else \"all (no whitelist)\"),\n",
    "        (\"Min students per code\", f\"{min_item_count} (codes below this were dropped)\"\n",
    "                                  if min_item_count else \"0 — no automatic drop\"),\n",
    "        (None, None),\n",
    "    ] + colourKeyLines(levelColors=gr_levels, amberMargin=amber_margin) + [\n",
    "        (None, None),\n",
    "        (\"Sheets\", None),\n",
    "        (\"scores\", \"Assessor score per item code. Red = at or below that code's cutoff.\"),\n",
    "        (\"global_ratings\", \"GR per item code. \" + describeLevelColors(gr_levels).capitalize()),\n",
    "        (\"practice_readiness\", \"PR per item code. \" + describeLevelColors(pr_levels).capitalize()),\n",
    "        (\"scores_flagged\", \"Scores plus low_count and Pass/Fail\"\n",
    "                          + (\", then \" + \", \".join(count_col_names) + \" (per-student level counts).\"\n",
    "                             if count_col_names else \".\")\n",
    "                          + \" Sorted worst-first (low_count desc, then Avg Score asc); the \"\n",
    "                          \"level-count columns are shaded 1=amber, 2=orange, 3+=red.\"),\n",
    "        (\"repeated_attempts\", \"Students who sat the same item code more than once, and each score.\"),\n",
    "        (\"scores_missing\", \"Item codes each student has no result for.\"),\n",
    "        (\"assessors\", (\"Who assessed each student on each item code. A repeated attempt shows \"\n",
    "                       \"both names joined by ' | '. \" + describeRepeatColors(assessor_repeat_colors)\n",
    "                       + \" n_assessors and most_seen_assessor summarise each student.\")\n",
    "                      if not assessor_df.empty else \"(no assessor_name column in these workbooks)\"),\n",
    "        (\"subject_mismatches\", \"Forms whose subject code disagrees with the item code's subject.\"\n",
    "                               if not mismatch_df.empty else \"(none this run)\"),\n",
    "    ]\n",
    "\n",
    "    if fallback_chain:\n",
    "        desc.append((\"flag_methods\", \"Per item code: the chosen cutoff method, the stats \"\n",
    "                     \"behind it (n, GR spread, R2, borderline-group size) and a decision \"\n",
    "                     \"trail showing why any method fell back to the next.\"))\n",
    "\n",
    "    # ── Presentation: relabel ONCE, on the way out ───────────────────────────\n",
    "    # Everything above works in snake_case; only the written headers change, exactly as\n",
    "    # formatWeeklySheet does for the weekly sheets, so the two families of workbook read\n",
    "    # the same way. Item-code columns are untouched (they are data, and `thresholds` is\n",
    "    # indexed by them). risk_report.py reverses this on read.\n",
    "    # Pass sheet_labels={} to write the pre-2026-08-18 snake_case headers.\n",
    "    fmt = lambda df: formatCombinedSheet(df, id_cols, labels=sheet_labels)\n",
    "    score_out,   out_id_cols = fmt(score_df)\n",
    "    rating_out,  _           = fmt(global_rating_df)\n",
    "    pr_out,      _           = fmt(practice_readiness_df)\n",
    "    flagged_out, _           = fmt(flagged_df)\n",
    "    dupes_out,   _           = fmt(duplicates)\n",
    "    missing_out, _           = fmt(score_missing_df)\n",
    "    assessor_out, _          = fmt(assessor_df)\n",
    "    mismatch_out, _          = fmt(mismatch_df)\n",
    "\n",
    "    with pd.ExcelWriter(out_path, engine=\"openpyxl\") as writer:\n",
    "        score_out.to_excel(writer, sheet_name=\"scores\", index=False)\n",
    "        rating_out.to_excel(writer, sheet_name=\"global_ratings\", index=False)\n",
    "        pr_out.to_excel(writer, sheet_name=\"practice_readiness\", index=False)\n",
    "        flagged_out.to_excel(writer, sheet_name=\"scores_flagged\", index=False)\n",
    "        dupes_out.to_excel(writer, sheet_name=\"repeated_attempts\", index=False)\n",
    "        missing_out.to_excel(writer, sheet_name=\"scores_missing\", index=False)\n",
    "        if not assessor_out.empty:\n",
    "            assessor_out.to_excel(writer, sheet_name=\"assessors\", index=False)\n",
    "        if not mismatch_out.empty:\n",
    "            mismatch_out.to_excel(writer, sheet_name=\"subject_mismatches\", index=False)\n",
    "        if flag_diag is not None and not flag_diag.empty:\n",
    "            flag_diag.to_excel(writer, sheet_name=\"flag_methods\", index=False)\n",
    "\n",
    "        # Every styling call below takes the RELABELLED frame and out_id_cols — the\n",
    "        # styling locates columns by name, so mixing the two spellings would silently\n",
    "        # colour the wrong columns rather than raise.\n",
    "        styleCombinedSheet(writer.sheets[\"scores\"], score_out, out_id_cols, \"score\",\n",
    "                           thresholds, amber_margin, skipHighlightCols=excluded_codes)\n",
    "        styleCombinedSheet(writer.sheets[\"global_ratings\"], rating_out, out_id_cols, \"gr\",\n",
    "                           levelColors=gr_levels, skipHighlightCols=excluded_codes)\n",
    "        styleCombinedSheet(writer.sheets[\"practice_readiness\"], pr_out, out_id_cols, \"gr\",\n",
    "                           levelColors=pr_levels, skipHighlightCols=excluded_codes)\n",
    "        styleCombinedSheet(writer.sheets[\"scores_flagged\"], flagged_out, out_id_cols, \"flagged\",\n",
    "                           thresholds, amber_margin, extraMetaCols=count_col_names,\n",
    "                           skipHighlightCols=excluded_codes)\n",
    "        if count_col_names:\n",
    "            highlightCountCells(writer.sheets[\"scores_flagged\"], flagged_out, count_col_names,\n",
    "                                colors=count_highlight or COUNT_LEVEL_HIGHLIGHT)\n",
    "        if not assessor_out.empty:\n",
    "            wsA = writer.sheets[\"assessors\"]\n",
    "            codeCols = [c for c in assessor_out.columns\n",
    "                        if c not in out_id_cols and c not in COMBINED_ASSESSOR_SUMMARY_COLS]\n",
    "            styleCombinedSheet(wsA, assessor_out, out_id_cols, \"plain\")\n",
    "            highlightRepeatAssessors(wsA, assessor_out, out_id_cols, assessor_repeats, codeCols,\n",
    "                                     levelColors=assessor_repeat_colors)\n",
    "\n",
    "        for name in (\"repeated_attempts\", \"scores_missing\", \"subject_mismatches\", \"flag_methods\"):\n",
    "            if name in writer.sheets:\n",
    "                ws = writer.sheets[name]\n",
    "                styleHeaderRow(ws, ws.max_column)\n",
    "                ws.freeze_panes = \"A2\"\n",
    "\n",
    "        for ws in writer.sheets.values():\n",
    "            autoFitColumns(ws)\n",
    "        writeDescriptionSheet(writer.book, desc)\n",
    "\n",
    "    print(f\"Saved: {out_path}\")\n",
    "    return out_path\n",
    "\n",
    "# ── Run it, once per selected stream (+ a pooled run) ────────────────────────\n",
    "# Each stream reads its OWN folder and writes its combined workbook there; the pooled run\n",
    "# reads every selected stream's folder at once and writes to the base folder.\n",
    "def runCombinedForScope(scope, key, label):\n",
    "    inFolders = weeklySimFolders(folder, scope, cohort=COHORT)\n",
    "    if not inFolders:\n",
    "        print(f\"{label}: no folder built yet — skipped.\")\n",
    "        return None\n",
