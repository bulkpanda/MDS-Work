    "def createFlaggingReport(cohort, formType, config=None, filters=None,\n",
    "                         period=PERIOD_ALL, minDate=None, maxDate=None,\n",
    "                         ignoreDates=None):\n",
    "    \"\"\"\n",
    "    Run flagging for one cohort/formType and write the Excel dashboard.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    cohort   : e.g. \"DDS2\", \"BOH1\"\n",
    "    formType : \"Clinic\" or \"Simulation\"\n",
    "    config   : FlaggingConfig — defaults to PRESETS[\"clinic_full\"]\n",
    "               Use PRESETS[\"...\"].copy(...) to override specific fields.\n",
    "    filters  : dict passed to getDataDf (defaults to {\"type\": formType})\n",
    "    period   : \"ALL\" (default, whole year — unchanged filename and behaviour),\n",
    "               \"FHY\" (semester 1, before SEMESTER_SPLIT_DATE = 2026-06-15) or\n",
    "               \"SHY\" (semester 2, on/after it). Aliases SEM1/S1/H1, SEM2/S2/H2.\n",
    "               Same selector the weekly-sim chain uses, so both pipelines split\n",
    "               the year on the same constant. FHY/SHY suffix the output file:\n",
    "               \"DDS2 Clinic Flagging (2026) (FHY).xlsx\".\n",
    "    minDate / maxDate : inclusive 'YYYY-MM-DD' overrides — they win over the\n",
    "               period's own bounds, so period=\"SHY\", maxDate=\"2026-08-01\" works.\n",
    "               Filtering is done on the Melbourne-local date (DASH stores UTC).\n",
    "    ignoreDates : list of individual session dates to remove entirely, e.g.\n",
    "               student-on-student activity days, where the forms are not evidence\n",
    "               of clinical performance. Accepts 'YYYY-MM-DD', 'DD/MM/YYYY' (day\n",
    "               first) or date objects. Applied BEFORE any average, threshold or\n",
    "               count, so nothing on the sheet is contaminated. A listed date that\n",
    "               matches no form is reported loudly — that is almost always a typo.\n",
    "               DDS2_CLINIC_IGNORE_DATES holds the eight confirmed DDS2 dates.\n",
    "\n",
    "    Examples\n",
    "    --------\n",
    "    # Full clinic dashboard with default preset:\n",
    "    createFlaggingReport(\"DDS2\", \"Clinic\")\n",
    "\n",
    "    # Semester 1 only (writes \"… Flagging (2026) (FHY).xlsx\"), dropping the\n",
    "    # student-on-student days:\n",
    "    createFlaggingReport(\"DDS2\", \"Clinic\", config=PRESETS[\"dds2_clinic\"],\n",
    "                         period=\"FHY\", ignoreDates=DDS2_CLINIC_IGNORE_DATES)\n",
    "\n",
    "    # Quick triage — summary + legend only:\n",
    "    createFlaggingReport(\"DDS2\", \"Clinic\", config=PRESETS[\"clinic_quick\"])\n",
    "\n",
    "    # Simulation run:\n",
    "    createFlaggingReport(\"DDS2\", \"Simulation\", config=PRESETS[\"sim_standard\"])\n",
    "\n",
    "    # Override one threshold from a preset:\n",
    "    createFlaggingReport(\"BOH1\", \"Clinic\",\n",
    "        config=PRESETS[\"clinic_full\"].copy(minForms=8, grThreshold=2.3))\n",
    "\n",
    "    # Turn the Operator gate on Pt Seen off for one run (old any-role count):\n",
    "    createFlaggingReport(\"DDS2\", \"Clinic\",\n",
    "        config=PRESETS[\"dds2_clinic\"].copy(requireOperatorForPtSeen=False))\n",
    "\n",
    "    # Switch the Summary Score to the per-ITEM average (default is per form).\n",
    "    # This moves avg_score, the Low Score flag and the score threshold; the\n",
    "    # Section Score Pivot shows both totals either way, and slopes stay per form:\n",
    "    createFlaggingReport(\"DDS2\", \"Clinic\",\n",
    "        config=PRESETS[\"dds2_clinic\"].copy(scoreWeighting=\"per_item\"))\n",
    "\n",
    "    # Custom — pick flags and sheets manually:\n",
    "    cfg = FlaggingConfig(\n",
    "        flags=[\"low_es\", \"low_gr\", \"high_fta\", \"clinical_incident\"],\n",
    "        sheets=[\"summary\", \"comparison\", \"legend\"],\n",
    "        esThreshold=2.3, grThreshold=2.5, minForms=12,\n",
    "    )\n",
    "    createFlaggingReport(\"DDS3\", \"Clinic\", config=cfg)\n",
    "\n",
    "    # Inspect any config before running:\n",
    "    PRESETS[\"clinic_full\"].describe()\n",
    "    \"\"\"\n",
    "    if config is None:\n",
    "        config = PRESETS[\"clinic_full\"]\n",
    "    if filters is None:\n",
    "        filters = {\"type\": formType}\n",
    "\n",
    "    clinic = filters.get(\"clinic\")\n",
    "    label  = f\"{cohort} — {formType}\" + (f\" — {clinic}\" if clinic else \"\")\n",
    "    print(f\"=== {label} ===\")\n",
    "\n",
    "    cohortDf = getDataDf(engine, cohort, filters=filters)\n",
    "    removeStudents = REMOVE_STUDENTS_DICT.get(cohort, [])\n",
    "    cohortDf = cohortDf[~cohortDf[\"student_number\"].isin(removeStudents)]\n",
    "\n",
    "    # Semester split — applied BEFORE calcScore/getFlagDf so every threshold,\n",
    "    # cohort average and pivot on the sheet describes that half year only.\n",
    "    cohortDf, periodLabel, (periodMin, periodMax) = filterCohortDfByPeriod(\n",
    "        cohortDf, period=period, minDate=minDate, maxDate=maxDate)\n",
    "\n",
    "    # Individual excluded sessions (student-on-student activity days etc.) —\n",
    "    # also before scoring, so they touch no average, threshold or count.\n",
    "    cohortDf, ignoredDates = dropIgnoredDates(cohortDf, ignoreDates)\n",
    "\n",
    "    if cohortDf.empty:\n",
    "        print(f\"[createFlaggingReport] No forms left for {label} in period {periodLabel} — nothing written.\")\n",
    "        return\n",
    "\n",
    "    cohortDf[\"scores\"] = cohortDf.apply(lambda row: calcScore(row, SCORE_MAP), axis=1)\n",
    "    print(cohortDf.columns)\n",
    "\n",
    "    flagDf, compDf, thresholds = getFlagDf(\n",
    "        cohortDf, formType=formType, config=config,\n",
    "        periodInfo=(periodLabel, periodMin, periodMax),\n",
    "        ignoredDates=ignoredDates,\n",
    "    )\n",
    "\n",
    "    import os\n",
    "    os.makedirs(cohort, exist_ok=True)\n",
    "    filename = f\"{cohort} {formType} {clinic + ' ' if clinic else ''}Flagging (2026).xlsx\"\n",
    "    filename = periodSuffixPath(filename, periodLabel)   # ALL -> unchanged\n",
    "    saveFlagDfToExcel2(\n",
    "        flagDf, compDf, thresholds, cohortDf,\n",
    "        filepath=f\"{cohort}/{filename}\",\n",
    "        formType=formType,\n",
    "        cohort=cohort,\n",
    "        config=config,\n",
    "    )\n",
    "\n",
    "\n",
    "# ── Run ──────────────────────────────────────────────────────────────────\n",
    "# DDS2 clinic, 2026-08-18 rules: Pt Seen counts Operator forms only and the four\n",
    "# headline cutoffs are inclusive — Pt Seen <= 11, ES <= 2, GR <= 3, PS <= 1.5.\n",
    "# PRESETS[\"dds2_clinic\"].describe() prints them with the actual <= / < operators.\n",
    "#\n",
    "# DDS2_CLINIC_IGNORE_DATES (flagging_utils) = the eight 2026 student-on-student\n",
    "# activity days: 21/01, 29/01, 03/02, 10/02, 26/02, 02/03, 05/03, 16/03. All in\n",
    "# FHY. Edit that constant to change the list, or pass any list of your own here.\n",
    "#\n",
    "# Summary's Score column is the PER-FORM average by default (each form's own item\n",
    "# mean, then averaged across forms) — the historical definition the July workbook\n",
    "# used. `.copy(scoreWeighting=\"per_item\")` switches it to the per-item average,\n",
    "# which also moves the Low Score flag. The Section Score Pivot always shows both.\n",
    "# createFlaggingReport(\"DDS2\", \"Clinic\", config=PRESETS[\"dds2_clinic\"],\n",
    "                    #  period=\"FHY\", ignoreDates=DDS2_CLINIC_IGNORE_DATES)\n",
    "# createFlaggingReport(\"DDS2\", \"Clinic\", config=PRESETS[\"dds2_clinic\"].copy(minPtSeen=9),\n",
    "                    #  period=\"SHY\", ignoreDates=DDS2_CLINIC_IGNORE_DATES)\n",
    "# createFlaggingReport(\"DDS2\", \"Clinic\", config=PRESETS[\"dds2_clinic\"],\n",
    "                    #  ignoreDates=DDS2_CLINIC_IGNORE_DATES)   # whole year\n",
    "# createFlaggingReport(\"DDS2\", \"Simulation\",  config=PRESETS[\"dds2_sim\"], period=\"SHY\")\n",
