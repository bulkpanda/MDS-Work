    "    (r\"separators\", \"Separators\"), (r\"fissure sealant\", \"Fissure Sealant\"), (r\"oral examination\", \"Oral Examination\"),\n",
    "    (r\"bonding fragment\", \"Bonding Fragment\"), (r\"adhesive restoration\", \"Adhesive Restoration\"),\n",
    "    (r\"resin composite\", \"Resin Composite Restoration\"), (r\"rmgic\", \"RMGIC Restoration\"),\n",
    "    (r\"preparation\", \"Preparation\"), (r\"restoration\", \"Restoration\"),\n",
    "]\n",
    "\n",
    "\n",
    "def mcNumber(mc):\n",
    "    \"\"\"'MC12' -> 12 (sort key).\"\"\"\n",
    "    m = re.search(r\"\\d+\", str(mc))\n",
    "    return int(m.group()) if m else 0\n",
    "\n",
    "\n",
    "def normaliseHeading(heading):\n",
    "    \"\"\"Section heading -> generic label ('534 and 577 Preparation' -> 'Preparation').\"\"\"\n",
    "    h = (heading or \"\").strip().lower()\n",
    "    if not h:\n",
    "        return \"No heading\"\n",
    "    for pat, label in HEADING_RULES:\n",
    "        if re.search(pat, h):\n",
    "            return label\n",
    "    h = re.sub(r\"\\b(tooth|teeth)\\s+\\d+(\\s+and\\s+\\d+)?|\\(\\s*\\)|\\b\\d+\\b\", \" \", h)\n",
    "    return re.sub(r\"\\s+\", \" \", h).strip().title() or \"No heading\"\n",
    "\n",
    "\n",
    "def headingTeeth(path):\n",
    "    \"\"\"Two-digit FDI tooth numbers mentioned in the heading path ('Tooth 14 / Isolation' -> '14').\"\"\"\n",
    "    return \", \".join(dict.fromkeys(re.findall(r\"(?<![\\d.])([1-8][1-8])(?![\\d.]|mm)\", path or \"\")))\n",
    "\n",
    "\n",
    "def headingItemNumbers(path):\n",
    "    \"\"\"Three-digit ADA item numbers in the heading ('534 and 577 Preparation' -> '534, 577').\"\"\"\n",
    "    return \", \".join(dict.fromkeys(re.findall(r\"(?<!\\d)(\\d{3})(?!\\d)\", path or \"\")))\n",
    "\n",
    "\n",
    "def normaliseCriterion(text):\n",
    "    \"\"\"Collapse wording variants: canal names, mm/degree values, file sizes and tooth numbers removed.\"\"\"\n",
    "    t = (text or \"\").lower().strip()\n",
    "    t = re.sub(r\"\\b(both buccal and palatal|all \\d+) canals\", \"all canals\", t)\n",
    "    t = re.sub(r\"\\b(mb1|mb2|mb|ml|db|d|p|distal|buccal|palatal)\\s+canal\", \"canal\", t)\n",
    "    t = re.sub(r\"\\d+(\\.\\d+)?\\s*(-|–|to)\\s*\\d+(\\.\\d+)?\\s*(mm|degrees?)\", r\"x \\4\", t)\n",
    "    t = re.sub(r\"\\d+(\\.\\d+)?\\s*(mm|degrees?)\", r\"x \\2\", t)\n",
    "    t = re.sub(r\"#\\d+(/\\d+)?\", \"#size\", t)\n",
    "    t = re.sub(r\"\\b(tooth|teeth|between)\\s+\\d+(\\s+and\\s+\\d+)?\", r\"\\1 x\", t)\n",
    "    t = t.replace(\"(s)\", \"\").replace(\"lengths\", \"length\").replace(\"inclusing\", \"including\")\n",
    "    t = re.sub(r\"\\s+\", \" \", t).strip(\" .;:)\")\n",
    "    return t\n",
    "\n",
    "\n",
    "def assignTheme(text):\n",
    "    \"\"\"First codebook rule whose regex matches the MC text -> (theme, domain).\"\"\"\n",
    "    t = (text or \"\").lower()\n",
    "    for theme, domain, pat in CHECKLIST_THEMES:\n",
    "        if re.search(pat, t):\n",
    "            return theme, domain\n",
    "    return UNASSIGNED_THEME, UNASSIGNED_THEME\n",
    "\n",
    "\n",
    "def getChecklistTemplates(engine, cohort, formType, dateFrom):\n",
    "    \"\"\"Distinct checklist set-ups (fields + headers) used on the cohort's forms, with usage counts.\"\"\"\n",
    "    sql = \"\"\"\n",
    "    SELECT item.item_code,\n",
    "           item.item_data ->> 'name'                          AS item_name,\n",
    "           item.item_data -> 'fields'                         AS fields,\n",
    "           item.item_data -> 'extra_config' -> 'headers'      AS headers,\n",
    "           COUNT(*)                                           AS n_forms,\n",
    "           SUM(CASE WHEN jsonb_exists(COALESCE(f.assessor_data -> 'checklists', '{}'::jsonb), item.item_code)\n",
    "                    THEN 1 ELSE 0 END)                        AS n_scored,\n",
    "           MIN(f.datetimeutc)                                 AS first_date,\n",
    "           MAX(f.datetimeutc)                                 AS last_date\n",
    "    FROM rawform_forms_v3 f\n",
    "    CROSS JOIN LATERAL jsonb_each(\n",
    "        COALESCE(f.assessor_config -> 'checklists' -> 'selected',\n",
    "                 f.student_config  -> 'checklists' -> 'selected', '{}'::jsonb)\n",
    "    ) AS item(item_code, item_data)\n",
    "    WHERE f.cohort = :cohort AND f.type = :formType AND f.datetimeutc >= :dateFrom\n",
    "    GROUP BY 1, 2, 3, 4;\n",
    "    \"\"\"\n",
    "    return readDf(engine, sql, {\"cohort\": cohort, \"formType\": formType, \"dateFrom\": dateFrom})\n",
    "\n",
    "\n",
    "def expandTemplates(templatesDf, cohort):\n",
    "    \"\"\"One row per template × MC; headers are sparse (first MC of a section) so they are carried forward.\"\"\"\n",
    "    rows = []\n",
    "    for t in templatesDf.itertuples(index=False):\n",
    "        fields = t.fields if isinstance(t.fields, dict) else json.loads(t.fields or \"{}\")\n",
    "        headers = t.headers if isinstance(t.headers, dict) else json.loads(t.headers or \"{}\") if t.headers else {}\n",
    "        titles = []\n",
    "        for mc in sorted((k for k in fields if re.fullmatch(r\"MC\\d+\", k)), key=mcNumber):\n",
    "            if mc in (headers or {}):\n",
    "                titles = [str(h.get(\"title\", \"\")).strip() for h in headers[mc] if str(h.get(\"title\", \"\")).strip()]\n",
    "            path = \" / \".join(titles)\n",
    "            rows.append(dict(item_code=t.item_code, item_name=t.item_name, MC=mc,\n",
    "                             section_heading=titles[-1] if titles else \"\", heading_path=path,\n",
    "                             mc_text=str(fields.get(mc) or \"\").strip(),\n",
    "                             n_forms=int(t.n_forms), n_scored=int(t.n_scored),\n",
    "                             first_date=t.first_date, last_date=t.last_date))\n",
    "    df = pd.DataFrame(rows)\n",
    "    # same code × MC × text × heading from different config versions -> one row\n",
    "    keys = [\"item_code\", \"MC\", \"mc_text\", \"section_heading\", \"heading_path\"]\n",
    "    df = (df.groupby(keys, dropna=False)\n",
    "            .agg(item_name=(\"item_name\", \"first\"), n_forms=(\"n_forms\", \"sum\"), n_scored=(\"n_scored\", \"sum\"),\n",
    "                 first_date=(\"first_date\", \"min\"), last_date=(\"last_date\", \"max\"))\n",
    "            .reset_index())\n",
    "    try:\n",
    "        df[\"stream\"] = df[\"item_code\"].apply(lambda c: streamForItemCode(c, cohort=cohort) or \"OTHER\")\n",
    "    except NameError:\n",
    "        df[\"stream\"] = \"\"\n",
    "    df[\"text_variants\"] = df.groupby([\"item_code\", \"MC\"])[\"mc_text\"].transform(\"nunique\")\n",
    "    for c in (\"first_date\", \"last_date\"):\n",
    "        df[c] = pd.to_datetime(df[c], utc=True).dt.tz_convert(\"Australia/Melbourne\").dt.date\n",
    "    return df\n",
    "\n",
    "\n",
    "def clusterCriteria(normTexts, nClusters):\n",
    "    \"\"\"TF-IDF (1–2 grams) + average-linkage cosine clustering of unique criteria, cut to nClusters\n",
    "    -> {text: 'C03: term · term · term'} (label = top 3 TF-IDF terms of the cluster).\"\"\"\n",
    "    uniq = sorted(set(normTexts))\n",
    "    vec = TfidfVectorizer(stop_words=\"english\", ngram_range=(1, 2), sublinear_tf=True,\n",
    "                          token_pattern=r\"(?u)\\b[a-z][a-z\\-]+\\b\")\n",
    "    X = vec.fit_transform(uniq).toarray()\n",
    "    labels = fcluster(linkage(X, method=\"average\", metric=\"cosine\"), t=nClusters, criterion=\"maxclust\")\n",
    "    terms = np.array(vec.get_feature_names_out())\n",
    "    names = {}\n",
    "    for k in np.unique(labels):\n",
    "        top = terms[np.argsort(X[labels == k].mean(axis=0))[::-1][:3]]\n",
    "        names[k] = \" · \".join(top)\n",
    "    order = {k: i + 1 for i, k in enumerate(sorted(np.unique(labels), key=lambda k: names[k]))}\n",
    "    return {txt: f\"C{order[k]:02d}: {names[k]}\" for txt, k in zip(uniq, labels)}\n",
    "\n",
    "\n",
    "def buildChecklistGrouping(engine, cohort=groupCohort, formType=groupFormType, dateFrom=groupDateFrom,\n",
    "                           outPath=groupOutPath, nClusters=clusterCount, templatesDf=None):\n",
    "    \"\"\"Build/refresh the grouping workbook. Returns the Grouping DataFrame.\"\"\"\n",
    "    if templatesDf is None:\n",
    "        templatesDf = getChecklistTemplates(engine, cohort, formType, dateFrom)\n",
    "    df = expandTemplates(templatesDf, cohort)\n",
    "\n",
    "    # grouping columns\n",
    "    df[\"group_heading\"] = df[\"section_heading\"].apply(normaliseHeading)\n",
    "    df[\"heading_teeth\"] = df[\"heading_path\"].apply(headingTeeth)\n",
    "    df[\"heading_items\"] = df[\"heading_path\"].apply(headingItemNumbers)\n",
    "    df[\"criterion_norm\"] = df[\"mc_text\"].apply(normaliseCriterion)\n",
    "    df[[\"group_theme\", \"group_domain\"]] = df[\"mc_text\"].apply(lambda s: pd.Series(assignTheme(s)))\n",
    "    nClusters = nClusters or len(CHECKLIST_THEMES)\n",
    "    df[\"group_cluster\"] = df[\"criterion_norm\"].map(clusterCriteria(df[\"criterion_norm\"], nClusters))\n",
    "\n",
    "    # carry forward the user's edits from an existing workbook\n",
    "    df[\"group\"], df[\"notes\"] = df[\"group_theme\"], \"\"\n",
    "    if os.path.exists(outPath):\n",
    "        old = pd.read_excel(outPath, sheet_name=\"Grouping\", dtype=str).fillna(\"\")\n",
    "        old = old.drop_duplicates([\"item_code\", \"MC\", \"mc_text\"]).set_index([\"item_code\", \"MC\", \"mc_text\"])\n",
    "        key = list(zip(df[\"item_code\"], df[\"MC\"], df[\"mc_text\"]))\n",
    "        for i, k in zip(df.index, key):\n",
    "            if k not in old.index:\n",
    "                continue\n",
    "            if old.at[k, \"group\"] and old.at[k, \"group\"] != old.at[k, \"group_theme\"]:   # only real user edits\n",
    "                df.at[i, \"group\"] = old.at[k, \"group\"]\n",
    "            df.at[i, \"notes\"] = old.at[k, \"notes\"]\n",
    "    df[\"group_edited\"] = np.where(df[\"group\"] != df[\"group_theme\"], \"Yes\", \"\")\n",
    "\n",
    "    df[\"_code\"] = df[\"item_code\"].apply(lambda c: re.sub(r\"\\d+\", lambda m: m.group().zfill(4), c.lower()))\n",
    "    df[\"_mc\"] = df[\"MC\"].apply(mcNumber)\n",
    "    df = df.sort_values([\"stream\", \"_code\", \"_mc\"]).drop(columns=[\"_code\", \"_mc\"]).reset_index(drop=True)\n",
    "    cols = [\"stream\", \"item_code\", \"item_name\", \"MC\", \"section_heading\", \"heading_path\", \"heading_teeth\",\n",
    "            \"heading_items\", \"mc_text\", \"criterion_norm\", \"group_heading\", \"group_theme\", \"group_domain\",\n",
    "            \"group_cluster\", \"group\", \"group_edited\", \"notes\", \"n_forms\", \"n_scored\", \"text_variants\",\n",
    "            \"first_date\", \"last_date\"]\n",
    "    df = df[cols]\n",
    "\n",
    "    # summary sheets\n",
    "    criteriaDf = (df.groupby(\"criterion_norm\")\n",
    "                    .agg(example_text=(\"mc_text\", \"first\"), group_theme=(\"group_theme\", lambda s: \" | \".join(sorted(set(s)))),\n",
    "                         group=(\"group\", lambda s: \" | \".join(sorted(set(s)))),\n",
    "                         group_heading=(\"group_heading\", lambda s: \" | \".join(sorted(set(s)))),\n",
    "                         group_cluster=(\"group_cluster\", \"first\"),\n",
    "                         streams=(\"stream\", lambda s: \", \".join(sorted(set(s)))),\n",
    "                         n_item_codes=(\"item_code\", \"nunique\"), n_rows=(\"MC\", \"size\"), n_forms=(\"n_forms\", \"sum\"))\n",
    "                    .reset_index().sort_values([\"group_theme\", \"n_forms\"], ascending=[True, False]))\n",
    "    themeRows = []\n",
    "    for theme, domain, pat in CHECKLIST_THEMES + [(UNASSIGNED_THEME, UNASSIGNED_THEME, \"\")]:\n",
    "        sub = df[df[\"group_theme\"] == theme]\n",
    "        themeRows.append(dict(theme=theme, domain=domain, rule_regex=pat, n_rows=len(sub),\n",
    "                              n_criteria=sub[\"criterion_norm\"].nunique(), n_item_codes=sub[\"item_code\"].nunique(),\n",
    "                              streams=\", \".join(sorted(set(sub[\"stream\"]))), n_forms=int(sub[\"n_forms\"].sum())))\n",
    "    themesDf = pd.DataFrame(themeRows)\n",
    "    clusterRows = []\n",
    "    for cl, sub in df.groupby(\"group_cluster\"):\n",
    "        vc = sub[\"group_theme\"].value_counts()\n",
    "        clusterRows.append(dict(group_cluster=cl, n_criteria=sub[\"criterion_norm\"].nunique(), n_rows=len(sub),\n",
    "                                dominant_theme=vc.index[0], purity=round(vc.iloc[0] / len(sub), 2),\n",
    "                                themes=\" | \".join(f\"{k} ({v})\" for k, v in vc.items()),\n",
    "                                criteria=\" || \".join(sorted(set(sub[\"criterion_norm\"])))[:1500]))\n",
    "    clustersDf = pd.DataFrame(clusterRows).sort_values([\"purity\", \"group_cluster\"])\n",
    "    readme = pd.DataFrame({\"Item\": [\n",
    "        \"What\", \"Grouping sheet\", \"group\", \"group_heading\", \"group_theme / group_domain\", \"group_cluster\",\n",
    "        \"Criteria sheet\", \"Themes sheet\", \"Clusters sheet\", \"Source\"],\n",
    "        \"Detail\": [\n",
    "        f\"Checklist criteria grouping for {cohort} {formType} forms since {dateFrom}.\",\n",
    "        \"One row per item code × MC (× wording variant). Section heading carried forward from the first MC of each section.\",\n",
    "        \"Editable. Defaults to group_theme; your values and notes are kept when the cell is re-run (matched on item_code + MC + mc_text).\",\n",
    "        \"Section heading normalised — tooth and item numbers removed ('534 and 577 Preparation' → 'Preparation').\",\n",
    "        \"Keyword codebook in the notebook (CHECKLIST_THEMES) — first matching rule wins; domain is the roll-up.\",\n",
    "        f\"Data-driven check: TF-IDF of the normalised text, average-linkage cosine clustering cut to {nClusters} clusters. Low purity = codebook and text similarity disagree — review those.\",\n",
    "        \"One row per normalised criterion (canal names / mm / tooth numbers removed) with its groups and usage.\",\n",
    "        \"Codebook rules with coverage counts.\",\n",
    "        \"Each text cluster with the themes it contains; sorted by purity, lowest first.\",\n",
    "        \"rawform_forms_v3: assessor_config (fallback student_config) -> checklists -> selected -> {code} -> fields / extra_config.headers.\",\n",
    "    ]})\n",
    "\n",
    "    os.makedirs(os.path.dirname(outPath), exist_ok=True)\n",
    "    sheets = {\"Grouping\": df, \"Criteria\": criteriaDf, \"Themes\": themesDf, \"Clusters\": clustersDf, \"README\": readme}\n",
    "    with pd.ExcelWriter(outPath, engine=\"openpyxl\") as xw:\n",
    "        for name, d in sheets.items():\n",
    "            d.to_excel(xw, sheet_name=name, index=False)\n",
    "        styleGroupingWorkbook(xw.book, sheets, len(themesDf))\n",
    "    print(f\"Saved {outPath}\")\n",
    "    print(f\"  {len(df)} rows · {df['item_code'].nunique()} item codes · {df['criterion_norm'].nunique()} normalised criteria\")\n",
    "    print(f\"  unassigned rows: {(df['group_theme'] == UNASSIGNED_THEME).sum()} · user-edited groups kept: {(df['group_edited'] == 'Yes').sum()}\")\n",
    "    print(f\"  clusters: {df['group_cluster'].nunique()} · mean purity {clustersDf['purity'].mean():.2f}\")\n",
    "    return df\n",
    "\n",
    "\n",
    "def styleGroupingWorkbook(wb, sheets, nThemes):\n",
    "    \"\"\"Header style, widths, freeze panes, filters; editable `group` column tinted with a theme dropdown.\"\"\"\n",
    "    headFill, editFill = XlFill(\"solid\", fgColor=\"094183\"), XlFill(\"solid\", fgColor=\"FDE9D9\")\n",
    "    wide = {\"mc_text\": 60, \"criterion_norm\": 45, \"example_text\": 60, \"heading_path\": 30, \"item_name\": 28,\n",
    "            \"themes\": 60, \"criteria\": 90, \"Detail\": 120, \"rule_regex\": 60, \"notes\": 30}\n",
    "    for name, d in sheets.items():\n",
    "        ws = wb[name]\n",
    "        for j, col in enumerate(d.columns, start=1):\n",
    "            c = ws.cell(row=1, column=j)\n",
    "            c.font, c.fill = XlFont(bold=True, color=\"FFFFFF\"), headFill\n",
    "            c.alignment = XlAlign(wrap_text=True, vertical=\"center\")\n",
    "            ws.column_dimensions[xlCol(j)].width = wide.get(col, max(12, min(26, len(str(col)) + 4)))\n",
    "        ws.freeze_panes = \"A2\" if name in (\"README\",) else (\"C2\" if name == \"Grouping\" else \"B2\")\n",
    "        ws.auto_filter.ref = ws.dimensions\n",
    "        for row in ws.iter_rows(min_row=2):\n",
    "            for c in row:\n",
    "                c.alignment = XlAlign(wrap_text=d.columns[c.column - 1] in wide, vertical=\"top\")\n",
    "    ws, d = wb[\"Grouping\"], sheets[\"Grouping\"]\n",
    "    for colName in (\"group\", \"notes\"):\n",
    "        j = list(d.columns).index(colName) + 1\n",
    "        for i in range(2, len(d) + 2):\n",
    "            ws.cell(row=i, column=j).fill = editFill\n",
    "    jGroup = xlCol(list(d.columns).index(\"group\") + 1)\n",
    "    dv = XlValidation(type=\"list\", formula1=f\"=Themes!$A$2:$A${nThemes + 1}\", allow_blank=True,\n",
    "                      showErrorMessage=False)       # dropdown of themes, but new group names are still allowed\n",
    "    dv.add(f\"{jGroup}2:{jGroup}{len(d) + 1}\")\n",
    "    ws.add_data_validation(dv)\n",
    "\n",
    "\n",
    "groupingDf = buildChecklistGrouping(engine)"
