    "### OSCE station-wise workbook + BLR standard-setting + validity (round 1)\n",
    "\n",
    "Rebuilds `OSCE/<cohort> OSCE Round1 Stationwise.xlsx` from the OSCE JSON. Support functions are in `osce_utils.py`.\n",
    "Scores items by response **label** (Very good=1, Satisfactory=.75, Borderline=.5, Unsatisfactory=0; alt scheme 1/.67/.33/0). GR is reversed to standard (5=Excellent..1=Fail); BLR cut is taken at GR=Borderline(2). Sheets are keyed by (station, checklist)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b26eff7b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# OSCE round-1 -> TWO workbooks via osce_utils.buildOsceWorkbook:\n",
    "#   stationPath  = station detail workbook (Read Me, Station Summary, S# detail sheets, MC Item Stats, Checklist Legend)\n",
    "#   analysisPath = analysis workbook (BLR Analysis, Assessor Harshness, Station Validity, Standard Setting)\n",
    "# Scoring is dynamic per MC item by rank (O-key, not label): 4-level 4/3/2/0, 3-level 2/1/0, 2-level 1/0.\n",
    "# Each item normalized to its own max (equal weight); checklist score = mean of item fractions x100.\n",
    "# GR normalized to 5=Excellent..1=Fail via reverseGr (True/False/'auto'; auto detects from the scale labels).\n",
    "#   DDS4 stores 1=Fail..5=Excellent so it is NOT reversed; DDS2 is. BLR cut at GR=Borderline(2).\n",
    "# Ignored students via osce_utils.IGNORE_STUDENT_NUMBERS.\n",
    "import importlib, osce_utils\n",
    "importlib.reload(osce_utils)\n",
    "cohort = \"DDS4\"\n",
    "\n",
    "# --- Custom scoring config (edit here) -------------------------------------\n",
    "# scoreConfig: mode 'rank'|'label' ; levelPoints {level:[best..worst]} (rank) ;\n",
    "#   labelPoints {label:value} (label) ; aggregate 'normalize'|'total'.\n",
    "#   None = default: rank / {4:[4,3,2,0],3:[2,1,0],2:[1,0]} / normalize.\n",
    "scoreConfig = None\n",
    "\n",
    "# --- Custom per-station result overrides (edit here) -----------------------\n",
    "# Key = checklist key. Directives (see osce_utils.effectivePassCut):\n",
    "#   excludeFromPassFail=True  keep sheets but never fail anyone / omit from pivot & standard-setting\n",
    "#   passAll=True              force pass (nobody fails), analytics still shown\n",
    "#   dropItems=[n,...]         remove MCn from scoring (re-derives the score AND the BLR cut)\n",
    "#   cutMethod='bgm'           use Borderline Group Method cut instead of BLR\n",
    "#   cutAdjustPct=+/-x         shift the BLR cut by x percentage points\n",
    "stationOverrides = {\n",
    "    \"diagnostics\":              {\"excludeFromPassFail\": True},  # keep sheets, exclude from pass/fail\n",
    "    \"orthodontics-paediatrics\": {\"passAll\": True},              # pass everyone\n",
    "    \"special-needs-dentistry\":  {\"dropItems\": []},             # drop MC3 from scoring\n",
    "    \"oral-surgery\":             {\"passAll\": True},              # pass everyone\n",
    "    \"extra-oral-examination\":   {\"cutMethod\": \"bgm\"},           # BGM cut instead of BLR\n",
    "    \"oral-medicine\":            {\"remapGr\": {\"assessor\": \"Amy Fam\", \"from\": 1, \"to\": 2}},  # hawk correction: reassign Amy Fam GR 1->2\n",
    "    \"health-promotion\":         {\"cutAdjustPct\": -0.4},         # lower BLR cut by 0.4 pp\n",
    "    \"fixed-prosthodontics\":     {\"excludeFromPassFail\": True},  # BoE: removed for fairness (instruction error, one circuit)\n",
    "    \"periodontics\":             {\"countsToFailLimit\": False},   # BoE: score counts to total, NOT to allowable-fail count\n",
    "}\n",
    "\n",
    "osceSummary = osce_utils.buildOsceWorkbook(\n",
    "    srcPath=\"temp 2026 osce.json\",\n",
    "    stationPath=f\"OSCE/{cohort}/{cohort} OSCE.xlsx\",\n",
    "    analysisPath=f\"OSCE/{cohort}/{cohort} BLR & Validity.xlsx\",\n",
    "    imgDir=f\"OSCE/{cohort}/{cohort} BLR\",              # BLR + harshness PNGs saved here\n",
    "    cohortLabel=cohort,\n",
    "    borderlineGr=2,\n",
    "    ignoreStudentNumbers={\"123445\"},         # or None -> osce_utils.IGNORE_STUDENT_NUMBERS\n",
    "    scoreConfig=scoreConfig,                 # custom scoring scheme (None = default)\n",
    "    stationOverrides=stationOverrides,       # per-station result overrides\n",
    "    allowedStationFailures=4,                # BoE: up to 4 station failures allowed overall\n",
    ")\n",
