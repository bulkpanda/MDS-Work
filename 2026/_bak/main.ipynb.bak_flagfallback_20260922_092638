    "def processDds4BohForms():\n",
    "    with engine.begin() as conn:\n",
    "        createTableSql, upsertSql = getBoh3Dds4FormsV3ProcessSql(replaceExisting)\n",
    "        runDdl(conn, createTableSql)\n",
    "        conn.execute(text(upsertSql), {\"targetCohorts\": targetCohorts})\n",
    "        rowCount = conn.execute(text(\"SELECT COUNT(*) FROM dds4_boh3_forms_v3\")).scalar()\n",
    "\n",
    "        # Standardize clinic names for better reporting (e.g. combine RDHM PC and Primary Care RDHM into one name)\n",
    "        stdTable = \"dds4_boh3_forms_v3\"\n",
    "        # v3 data stores clinic as a code (e.g. EC02) in external_clinic + clinic; map codes -> readable names first\n",
    "        clinicCodeSql = getClinicCodeStandardizationSql(clinicDict=CLINIC_DICT, tableName=stdTable)\n",
    "        if clinicCodeSql:\n",
    "            conn.execute(text(clinicCodeSql))\n",
    "        rdhmSql = getStandardizationSql(fromNames=['RDHM PC', 'RDHM PC Emergency', 'PC', 'Primary Care RDHM', 'pc', 'Primary Care'], toName='RDHM PC', tableName=stdTable)\n",
    "        cohealthSql = getStandardizationSql(fromNames=['Cohealth footscray', 'Cohealth Footscray'], toName='Cohealth (Footscray)', tableName=stdTable)\n",
    "        beaufortSql = getStandardizationSql(fromNames=['Beaufort and Skipton Clinic', 'Beaufort and Skipton'], toName='Beaufort and Skipton', tableName=stdTable)\n",
    "        panchSql = getStandardizationSql(fromNames=['PANCH', 'Your Community (Preston)', 'Preston'], toName='Your Community (Preston)', tableName=stdTable)\n",
    "        eemSql = getStandardizationSql(fromNames=['EEM', 'Eyes ears and mouth'], toName='Eyes, Ears and Mouth', tableName=stdTable)\n",
    "        gdcSql = getStandardizationSql(fromNames=['Gove Dental Clinic -', 'Gove Dental Clinic - Northern Territory', 'Goven Dental Clinic'], toName='Gove Dental Clinic', tableName=stdTable)\n",
    "        yourSql = getStandardizationSql(fromNames=['Your Community (Preston)313', 'Preston'], toName='Your Community (Preston)', tableName=stdTable)\n",
    "        dtcSql = getStandardizationSql(fromNames=['dtc ', 'Dental Training Clinic', 'dtc', 'DTC SND', 'DTC Yeah', 'DTC Yeah '], toName='DTC', tableName=stdTable)\n",
    "        moeSql = getStandardizationSql(fromNames=['MOE', 'moe'], toName='Moe', tableName=stdTable)\n",
    "        claytonSql = getStandardizationSql(fromNames=['Clayton', 'Clayton Clinic', 'clayton'], toName='Link Health (Clayton)', tableName=stdTable)\n",
    "        mdcSql = getStandardizationSql(fromNames=['MDC ', 'MDC Clinic', 'mdc'], toName='MDC', tableName=stdTable)\n",
    "        conn.execute(text(dtcSql))\n",
    "        conn.execute(text(rdhmSql))\n",
    "        conn.execute(text(cohealthSql))\n",
    "        conn.execute(text(beaufortSql))\n",
    "        conn.execute(text(panchSql))\n",
    "        conn.execute(text(eemSql))\n",
    "        conn.execute(text(gdcSql))\n",
    "        conn.execute(text(yourSql))\n",
    "        conn.execute(text(moeSql))\n",
    "        conn.execute(text(claytonSql))\n",
    "        conn.execute(text(mdcSql))\n",
    "        # Normalise external_clinic to Title Case (standard naming), preserving acronyms (DTC, CHC, GV...)\n",
    "        distinctClinics = [\n",
    "            r[0] for r in conn.execute(text(\n",
    "                f\"SELECT DISTINCT external_clinic FROM {stdTable} \"\n",
    "                \"WHERE external_clinic IS NOT NULL AND btrim(external_clinic) <> ''\"\n",
    "            ))\n",
    "        ]\n",
    "        for orig in distinctClinics:\n",
    "            titled = smartTitleCaseClinic(orig)\n",
    "            if titled != orig:\n",
    "                conn.execute(\n",
    "                    text(f\"UPDATE {stdTable} SET external_clinic = :titled WHERE external_clinic = :orig\"),\n",
    "                    {\"titled\": titled, \"orig\": orig},\n",
    "                )\n",
    "        deleteSql = getDeleteSql(stdTable)\n",
    "        conn.execute(text(deleteSql))\n",
    "        # Drop specific student numbers — edit general_utils.EXCLUDED_STUDENT_NUMBERS,\n",
    "        # or pass an explicit list here: getDeleteStudentsSql(stdTable, [40029860])\n",
    "        # excludeSql = getDeleteStudentsSql(stdTable)\n",
    "        # if excludeSql:\n",
    "        #     removed = conn.execute(text(excludeSql)).rowcount\n",
    "        #     print(f\"{stdTable}: removed {removed} rows for excluded students\")\n",
    "        #     rowCount = conn.execute(text(f\"SELECT COUNT(*) FROM {stdTable}\")).scalar()\n",
    "\n",
    "        # standardize rotations R5 to Rotation 5, R6 to Rotation 6, etc.\n",
    "        rotationSql = getStandardizationSql(fromNames=['R1'], toName='Rotation 1', tableName=stdTable, colName='rotation')\n",
    "        conn.execute(text(rotationSql))\n",
    "        rotationSql2 = getStandardizationSql(fromNames=['R2'], toName='Rotation 2', tableName=stdTable, colName='rotation')\n",
    "        conn.execute(text(rotationSql2))\n",
    "        rotationSql3 = getStandardizationSql(fromNames=['R3'], toName='Rotation 3', tableName=stdTable, colName='rotation')\n",
    "        conn.execute(text(rotationSql3))\n",
    "        rotationSql4 = getStandardizationSql(fromNames=['R4'], toName='Rotation 4', tableName=stdTable, colName='rotation')\n",
    "        conn.execute(text(rotationSql4))\n",
    "        rotationSql = getStandardizationSql(fromNames=['R5'], toName='Rotation 5', tableName=stdTable, colName='rotation')\n",
    "        conn.execute(text(rotationSql))\n",
    "        rotationSql2 = getStandardizationSql(fromNames=['R6'], toName='Rotation 6', tableName=stdTable, colName='rotation')\n",
    "        conn.execute(text(rotationSql2))\n",
    "        rotationSql3 = getStandardizationSql(fromNames=['R7'], toName='Rotation 7', tableName=stdTable, colName='rotation')\n",
    "        conn.execute(text(rotationSql3))\n",
    "        rotationSql4 = getStandardizationSql(fromNames=['R8'], toName='Rotation 8', tableName=stdTable, colName='rotation')\n",
    "        conn.execute(text(rotationSql4))\n",
    "        rotationSql5 = getStandardizationSql(fromNames=['R9'], toName='Rotation 9', tableName=stdTable, colName='rotation')\n",
    "        conn.execute(text(rotationSql5))\n",
    "    print(f\"dds4_boh3_forms_v3 rows: {rowCount}\")\n",
    "\n",
    "processDds4BohForms()"
   ]
  },
