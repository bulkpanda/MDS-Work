    "    fig.tight_layout()\n",
    "    return fig\n",
    "\n",
    "def dfToReportlabTable(df: pd.DataFrame, colOrder: list[str], maxRows: int = 40):\n",
    "    showDf = df[colOrder].copy()\n",
    "    if len(showDf) > maxRows:\n",
    "        showDf = showDf.head(maxRows)\n",
    "\n",
    "    data = [colOrder] + showDf.values.tolist()\n",
