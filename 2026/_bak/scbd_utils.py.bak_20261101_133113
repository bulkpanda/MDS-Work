def esc(s):
    return html.escape(str(s or ""))


def headerBand(info, cfg, W, st):
    left = RlParagraph(f'<font size="17"><b>{esc(info["name"])}</b></font><br/>'
                       f'<font size="9" color="#D0D8E8">Student ID: {esc(info["id"] or "—")} · {esc(info["cohort"])}</font>',
                       ParagraphStyle("hl", parent=st["white"], leading=20))
    right = RlParagraph(f'<para align="right"><font size="13"><b>{esc(info["subject"])}</b></font><br/>'
                        f'<font size="8.5" color="#D0D8E8">{esc(cfg["title"])}<br/>{esc(info["period"])}</font></para>',
                        ParagraphStyle("hr", parent=st["white"], leading=12))
    t = RlTable([[left, right]], colWidths=[W * 0.5, W * 0.5])
    t.setStyle(RlTableStyle([("BACKGROUND", (0, 0), (-1, -1), rlColors.HexColor(NAVY)),
                             ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
                             ("TOPPADDING", (0, 0), (-1, -1), 10), ("BOTTOMPADDING", (0, 0), (-1, -1), 10),
                             ("LEFTPADDING", (0, 0), (-1, -1), 12), ("RIGHTPADDING", (0, 0), (-1, -1), 12)]))
    return t


def sectionTable(sec, secRes, cohortRaw, row, criteria, cfg, W, st):
    title = re.sub(r"\s*\(/?\s*[\d.]+\s*\)\s*$", "", sec["title"])
    data = [[RlParagraph(f"{esc(title)} (/{fmtNum(sec['avail'])})", st["hdr"]), ""],
            ["Criterion", "Score"]]
    ts = [("SPAN", (0, 0), (-1, 0)), ("BACKGROUND", (0, 0), (-1, 0), rlColors.HexColor(NAVY)),
          ("BACKGROUND", (0, 1), (-1, 1), rlColors.HexColor(SUBHDR)),
          ("TEXTCOLOR", (0, 1), (-1, 1), rlColors.white), ("FONTNAME", (0, 1), (-1, 1), "Helvetica-Bold"),
          ("FONTSIZE", (0, 1), (-1, 1), 8.5), ("ALIGN", (1, 1), (-1, -1), "CENTER"),
          ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
          ("GRID", (0, 1), (-1, -1), 0.4, rlColors.HexColor("#C8C8C8")),
          ("TOPPADDING", (0, 0), (-1, -1), 4), ("BOTTOMPADDING", (0, 0), (-1, -1), 4)]
    excluded, zebra = [], 0
    for it in sec["items"]:
        r = len(data)
        if "subheading" in it:
            data.append([RlParagraph(esc(it["subheading"]), st["sub"]), ""])
            ts += [("SPAN", (0, r), (-1, r)), ("BACKGROUND", (0, r), (-1, r), rlColors.HexColor(SUBGRP_BG))]
            continue
        txt = esc(criteria.get(it["mc"], ""))
        if it["mc"] in cfg.get("excludeMcs", []):
            excluded.append([RlParagraph(f'<b>{it["mc"]}.</b> {txt} <i>(excluded)</i>', st["cellGrey"]), "–"])
            continue
        v = mcValue(row, it)
        data.append([RlParagraph(f'<b>{it["mc"]}.</b> {txt}', st["cell"]),
                     RlParagraph(f'<b>{fmtNum(v)}</b><font color="#707070">/{fmtNum(it["den"])}</font>', st["score"])])
        if zebra % 2:
            ts.append(("BACKGROUND", (0, r), (-1, r), rlColors.HexColor(ALT_BG)))
        zebra += 1
    data += excluded
    r = len(data)
    pctTxt = f" ({secRes['pct']:.0f}%)" if secRes["pct"] is not None else ""
    data.append([RlParagraph(f'<b>Section Total</b>&nbsp;&nbsp;&nbsp;<font color="#606060" size="8">'
                             f'Cohort Avg: {fmtNum(cohortRaw)}/{fmtNum(sec["avail"])}</font>', st["sub"]),
                 f"{fmtNum(secRes['raw'])}/{fmtNum(secRes['avail'])}{pctTxt}"])
    ts += [("BACKGROUND", (0, r), (-1, r), rlColors.HexColor(TOTAL_BG)),
           ("FONTNAME", (1, r), (1, r), "Helvetica-Bold"), ("TEXTCOLOR", (1, r), (1, r), rlColors.HexColor(NAVY)),
           ("FONTSIZE", (0, r), (-1, r), 8.5), ("LINEABOVE", (0, r), (-1, r), 1, rlColors.HexColor(NAVY))]
    t = RlTable(data, colWidths=[W * 0.86, W * 0.14], repeatRows=2)
    t.setStyle(RlTableStyle(ts))
    return t


def commentsBlock(row, W, st, includeCritical):
    def clean(v):
        s = "" if v is None or (isinstance(v, float) and np.isnan(v)) else str(v).strip()
        return "" if s.lower() in EMPTY_TXT else s
    parts = []
    gen = clean(row.get("General"))
    if gen:
        parts.append(esc(gen).replace("\n", "<br/>"))
    cc = clean(row.get("Critical comments"))
    if includeCritical and (clean(row.get("Critical concerns")).lower() == "yes" or cc):
        parts.append(f'<b>Critical concerns:</b> {esc(cc).replace(chr(10), "<br/>") or "Yes"}')
    body = "<br/><br/>".join(parts) or "No comments recorded."
    t = RlTable([[RlParagraph("Assessor Comments", st["hdr"])], [RlParagraph(body, st["comment"])]], colWidths=[W])
    t.setStyle(RlTableStyle([("BACKGROUND", (0, 0), (-1, 0), rlColors.HexColor(NAVY)),
                             ("BACKGROUND", (0, 1), (-1, 1), rlColors.HexColor("#EAF0F7")),
                             ("LEFTPADDING", (0, 0), (-1, -1), 10), ("TOPPADDING", (0, 0), (-1, -1), 6),
                             ("BOTTOMPADDING", (0, 0), (-1, -1), 8)]))
    return t


def overallBlock(res, cohortAvg, cfg, W, st, showComponentTable=False):
    grade, gCol = gradeFor(res["overall"])
    singleSum = len(cfg["parts"]) == 1 and cfg["parts"][0]["method"] == "sum"
    yours = (f"{fmtNum(res['totRaw'])}/{fmtNum(res['totAvail'])} ({res['overall']:.0f}%)" if singleSum
             else f"{res['overall']:.1f}%") if res["overall"] is not None else "–"
    cav = (f"{fmtNum(cohortAvg['totRaw'])}/{fmtNum(res['totAvail'])} ({cohortAvg['overall']:.0f}%)" if singleSum
           else f"{cohortAvg['overall']:.1f}%") if cohortAvg["overall"] is not None else "–"
    score = RlParagraph(f'<b>Your Score</b><br/><font size="16"><b>{yours}</b></font><br/>'
                        f'<font color="#E0E6F0">Cohort Average</font><br/>{cav}',
                        ParagraphStyle("sc", parent=st["white"], leading=17))
    gradeCell = RlParagraph(f'{grade}<br/><font size="8">Grade</font>', st["big"])
    head = RlTable([[RlParagraph(f'{esc(cfg["title"])} — Overall Result', st["hdr"]), ""],
                    [gradeCell, score]], colWidths=[W * 0.22, W * 0.78])
    head.setStyle(RlTableStyle([("SPAN", (0, 0), (-1, 0)), ("BACKGROUND", (0, 0), (-1, 0), rlColors.HexColor(NAVY)),
                                ("BACKGROUND", (0, 1), (-1, 1), rlColors.HexColor(gCol)),
                                ("LINEAFTER", (0, 1), (0, 1), 0.6, rlColors.white),
                                ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
                                ("TOPPADDING", (0, 1), (-1, 1), 12), ("BOTTOMPADDING", (0, 1), (-1, 1), 12),
                                ("LEFTPADDING", (0, 0), (-1, -1), 12)]))
    flow = [head]
    if showComponentTable and not singleSum:                # weighted breakdown table (optional)
        rows = [["Component", "Your %", "Weight", "Weighted contribution", "Cohort Avg %"]]
        for p, cp in zip(res["parts"], cohortAvg["parts"]):
            rows.append([p["label"], fmtNum(p["pct"]), f"{p['weight'] * 100:g}%",
                         fmtNum(p["pct"] * p["weight"] if p["pct"] is not None else None), fmtNum(cp)])
        rows.append(["Overall", "", f"{sum(p['weight'] for p in cfg['parts']) * 100:g}%",
                     fmtNum(res["overall"]), fmtNum(cohortAvg["overall"])])
        bt = RlTable(rows, colWidths=[W * 0.32, W * 0.15, W * 0.13, W * 0.22, W * 0.18])
        bt.setStyle(RlTableStyle([("BACKGROUND", (0, 0), (-1, 0), rlColors.HexColor(SUBHDR)),
                                  ("TEXTCOLOR", (0, 0), (-1, 0), rlColors.white),
                                  ("FONTNAME", (0, 0), (-1, 0), "Helvetica-Bold"),
                                  ("FONTNAME", (0, -1), (-1, -1), "Helvetica-Bold"),
                                  ("BACKGROUND", (0, -1), (-1, -1), rlColors.HexColor(TOTAL_BG)),
                                  ("FONTSIZE", (0, 0), (-1, -1), 8.5), ("ALIGN", (1, 0), (-1, -1), "CENTER"),
                                  ("GRID", (0, 0), (-1, -1), 0.4, rlColors.HexColor("#C8C8C8"))]))
        flow += [RlSpacer(1, 4), bt]
    bounds = [b[0] for b in GRADE_BANDS]
    labels = ["≥80"] + [f"{lo}–{hi - 1}" for lo, hi in zip(bounds[1:-1], bounds[:-2])] + ["<50"]
    band = RlTable([[RlParagraph(f"<b>{lab}</b><br/>{rng}", st["whiteC"]) for (_, lab, _), rng in zip(GRADE_BANDS, labels)]],
                   colWidths=[W / len(GRADE_BANDS)] * len(GRADE_BANDS))
    band.setStyle(RlTableStyle([("BACKGROUND", (i, 0), (i, 0), rlColors.HexColor(c)) for i, (_, _, c) in enumerate(GRADE_BANDS)]
                               + [("BOX", (i, 0), (i, 0), 2, rlColors.black) for i, (_, lab, _) in enumerate(GRADE_BANDS) if lab == grade]))
    flow += [RlSpacer(1, 6), band]
    return flow


class ScoreBar(RlFlowable):
    """Horizontal 0–100 bar shaded by the cohort's quartiles, with the cohort average
    (orange line) and the student's score (navy diamond) marked; quartile boxes on the right
    (1 = top 25%). value / avg / q are percentages; q = (Q1, median, Q3)."""
    QUART_FILLS = ["#EEF3FA", "#DCE7F4", "#C5D7EC", "#A9C3E2"]     # bottom → top quartile

    def __init__(self, width, value, avg, q, label="Score"):
        super().__init__()
        self.width, self.value, self.avg, self.q, self.label = width, value, avg, q, label
        self.height = 58

    def wrap(self, availW, availH):
        return self.width, self.height

    def draw(self):
        c = self.canv
        navy, orange, grey = rlColors.HexColor(NAVY), rlColors.HexColor(AVG_COLOUR), rlColors.HexColor("#6B6B6B")
        labW, boxAreaW, gap = 70, 150, 14
        x0, x1 = labW, self.width - boxAreaW - gap               # bar extent
        barY, barH = 18, 14
        X = lambda v: x0 + (x1 - x0) * max(0.0, min(100.0, v)) / 100.0
        c.setFont("Helvetica-Bold", 10); c.setFillColor(navy)
        c.drawString(0, barY + 3, self.label)
        # quartile segments
        q = self.q
        edges = [0.0, *q, 100.0] if q else [0.0, 100.0]
        fills = self.QUART_FILLS if q else ["#EEF3FA"]
        for (a, b), f in zip(zip(edges[:-1], edges[1:]), fills):
            c.setFillColor(rlColors.HexColor(f)); c.setStrokeColor(rlColors.HexColor(f))
            c.rect(X(a), barY, X(b) - X(a), barH, stroke=0, fill=1)
        if q:                                                     # quartile dividers + labels
            c.setStrokeColor(rlColors.white); c.setLineWidth(1.2)
            for v in q:
                c.line(X(v), barY, X(v), barY + barH)
        c.setStrokeColor(navy); c.setLineWidth(0.6)
        c.rect(x0, barY, x1 - x0, barH, stroke=1, fill=0)
        # ticks + labels
        c.setFont("Helvetica", 7); c.setFillColor(grey); c.setStrokeColor(grey); c.setLineWidth(0.4)
        for t in range(0, 101, 5):
            h = 3 if t % 10 == 0 else 1.5
            c.line(X(t), barY, X(t), barY - h)
            if t % 10 == 0:
                c.drawCentredString(X(t), barY - 10, str(t))
        # labels: anchored away from each other, kept inside the bar; avg label lifted if they still overlap
        from reportlab.pdfbase.pdfmetrics import stringWidth
        def place(x, txt, font, size, toLeft):
            w = stringWidth(txt, font, size)
            lo = x - 4 - w if toLeft else x + 4
            lo = max(x0, min(lo, x1 - w))                       # clamp inside bar extent
            return lo, lo + w
        labY = barY + barH + 4
        youTxt = f"You {fmtNum(round(self.value, 1))}" if self.value is not None else None     # 1 dp: 49.8 must not read as 50
        avgTxt = f"Cohort avg {fmtNum(round(self.avg, 1))}" if self.avg is not None else None
        youLeft = self.value is not None and self.avg is not None and self.value < self.avg
        youBox = place(X(self.value), youTxt, "Helvetica-Bold", 8, youLeft) if youTxt else None
        avgBox = place(X(self.avg), avgTxt, "Helvetica-Bold", 7.5, not youLeft) if avgTxt else None
        avgY = labY + 9 if youBox and avgBox and not (avgBox[1] < youBox[0] - 2 or avgBox[0] > youBox[1] + 2) else labY
        if avgTxt:
            c.setStrokeColor(orange); c.setLineWidth(1.6)
            c.line(X(self.avg), barY - 2, X(self.avg), barY + barH + 2)
            c.setFont("Helvetica-Bold", 7.5); c.setFillColor(orange)
            c.drawString(avgBox[0], avgY, avgTxt)
        if youTxt:
            vx, vy, r = X(self.value), barY + barH / 2, 5
            p = c.beginPath(); p.moveTo(vx, vy + r); p.lineTo(vx + r, vy); p.lineTo(vx, vy - r); p.lineTo(vx - r, vy); p.close()
            c.setFillColor(navy); c.setStrokeColor(rlColors.white); c.setLineWidth(1)
            c.drawPath(p, stroke=1, fill=1)
            c.setFont("Helvetica-Bold", 8); c.setFillColor(navy)
            c.drawString(youBox[0], labY, youTxt)
        # quartile boxes (4 … 1, 1 = top 25%)
        qs = quartileOf(self.value, q)
        bx0, bw, bh = self.width - boxAreaW, (boxAreaW - 9) / 4, barH + 4
        c.setFont("Helvetica-Bold", 7.5); c.setFillColor(navy)
        c.drawCentredString(bx0 + boxAreaW / 2, barY + barH + 6, "Cohort quartile")
        for i, lab in enumerate([4, 3, 2, 1]):
            bx = bx0 + i * (bw + 3)
            on = qs == lab
            c.setFillColor(navy if on else rlColors.white); c.setStrokeColor(navy); c.setLineWidth(0.6)
            c.rect(bx, barY - 2, bw, bh, stroke=1, fill=1)
            c.setFillColor(rlColors.white if on else navy); c.setFont("Helvetica-Bold" if on else "Helvetica", 8.5)
            c.drawCentredString(bx + bw / 2, barY + 3, f"Q{lab}")
        c.setFont("Helvetica", 6.5); c.setFillColor(grey)
        c.drawCentredString(bx0 + boxAreaW / 2, barY - 11, "Q1 = top 25% of cohort")


def buildStudentPdf(outPath, info, row, res, sections, cohortAvg, criteria, cfg, includeCritical=True,
                    showComponentTable=False, showDomainBars=False, showOverallBar=True):
    """Write one student's feedback PDF. Toggles: weighted component table, a quartile
    score bar under every domain table, and one under the overall result."""
    st = styles()
    doc = SimpleDocTemplate(outPath, pagesize=landscape(A4), leftMargin=12 * mm, rightMargin=12 * mm,
                            topMargin=12 * mm, bottomMargin=14 * mm,
                            title=f'{info["name"]} — {info["subject"]} {cfg["fileTag"]} Feedback')
    W = doc.width - 12                  # frame has 6pt padding each side -> usable width
    flow = [headerBand(info, cfg, W, st), RlSpacer(1, 8)]
    for i, sec in enumerate(sections):
        tbl = sectionTable(sec, res["sections"][i], cohortAvg["sections"][i], row, criteria, cfg, W, st)
        if showDomainBars:
            flow += [RlKeepTogether([tbl, RlSpacer(1, 6), ScoreBar(W, res["sections"][i]["pct"], cohortAvg["sectionPct"][i],
                                                                     cohortAvg["sectionQ"][i], "Section %")])]
        else:
            flow.append(tbl)
        flow.append(RlSpacer(1, 8))
    overallBar = [RlSpacer(1, 8), ScoreBar(W, res["overall"], cohortAvg["overall"], cohortAvg["overallQ"], "Overall %")] \
        if showOverallBar else []
    failNote = cfg.get("failNote")
    failBox = []
    if failNote and res["overall"] is not None and res["overall"] < cfg.get("failCut", 50):
        fb = RlTable([[RlParagraph(f"<b>{esc(failNote)}</b>", ParagraphStyle("fail", parent=st["cell"], fontSize=9.5,
                                                                              leading=13, textColor=rlColors.HexColor("#7A3E00")))]],
                     colWidths=[W])
        fb.setStyle(RlTableStyle([("BACKGROUND", (0, 0), (-1, -1), rlColors.HexColor("#FDF0E1")),
                                  ("LINEBEFORE", (0, 0), (0, -1), 3, rlColors.HexColor(AVG_COLOUR)),
                                  ("LEFTPADDING", (0, 0), (-1, -1), 10), ("TOPPADDING", (0, 0), (-1, -1), 7),
                                  ("BOTTOMPADDING", (0, 0), (-1, -1), 7)]))
        failBox = [RlSpacer(1, 8), fb]
    flow += [RlKeepTogether([commentsBlock(row, W, st, includeCritical), RlSpacer(1, 8),
                             *overallBlock(res, cohortAvg, cfg, W, st, showComponentTable), *overallBar, *failBox,
                             RlSpacer(1, 6),
                             RlParagraph("<b>MC</b> = Marking Criterion · Section totals exclude blank MCs. · "
                                         f"{esc(cfg.get('overallNote', ''))} · Grade bands per University of Melbourne scale: "
                                         "<b>H1</b> First-Class Honours, <b>H2A/H2B</b> Second-Class Honours, "
                                         "<b>H3</b> Third-Class Honours, <b>P</b> Pass, <b>N</b> Fail.", st["foot"])])]

    def footer(canvas, d):
        canvas.saveState()
        canvas.setStrokeColor(rlColors.HexColor("#C8C8C8"))
        canvas.line(d.leftMargin, 9 * mm, d.leftMargin + d.width, 9 * mm)
        canvas.setFont("Helvetica", 7)
        canvas.drawRightString(d.leftMargin + d.width, 6 * mm, f"Page {d.page}")
        canvas.restoreState()
    doc.build(flow, onFirstPage=footer, onLaterPages=footer)

