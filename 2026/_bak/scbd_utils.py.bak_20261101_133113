def fileStem(name, sid, tag):
    toks = re.sub(r"[^A-Za-z\s'-]", "", str(name)).split()
    surname = toks[-1] if toks else "Student"
    given = "".join(toks[:-1]) or "X"
    clean = lambda s: re.sub(r"[^A-Za-z]", "", s)
    return f"{clean(surname)}_{clean(given)}_{sid or 'NOID'}_{re.sub(r'[0-9]', '', tag)}_Feedback"


def buildScbdReports(xlsxPath, sheetName, examKey, outDir, jsonPath="temp 2026 scbd.json",
                     studentListPath=None, cohort="DDS3", periodLabel=None, includeCritical=True,
                     students=None, checkSheetTotals=True, showComponentTable=False,
                     showDomainBars=None, showOverallBar=True):
    """
    Build per-student feedback PDFs for an SCBD-family exam.
      xlsxPath / sheetName : scbd_gradio export (e.g. "DDS3-CBD (2)")
      examKey              : key in EXAM_CONFIGS ("DDS3-CBD", "SCBD_OM-OS")
      outDir               : output folder (created)
      jsonPath             : DASH API cache for criterion text (refresh via the SCBD fetch cell)
      studentListPath      : name -> student number list (default variableUtils.studentEmailFile)
      periodLabel          : header sub-title, default "<Mon YYYY>" from the Date column
      includeCritical      : also print Critical concerns/comments on the PDF (default True)
      students             : optional list of names to build only those (testing)
      showComponentTable   : weighted component table under the overall result (default False)
      showDomainBars       : quartile score bar after every domain/section table
                             (None -> EXAM_CONFIGS[examKey]["showDomainBars"], else False; CBD = True)
      showOverallBar       : quartile score bar after the overall result (default True)
    Returns the index DataFrame (also saved as <outDir>/_index.csv).
    """
    cfg = EXAM_CONFIGS[examKey]
    if showDomainBars is None:
        showDomainBars = cfg.get("showDomainBars", False)
    if studentListPath is None:
        try:
            import variableUtils
            studentListPath = variableUtils.studentEmailFile
        except Exception:
            studentListPath = "RE_ Student List.xlsx"
    df, mcMeta = loadExportSheet(xlsxPath, sheetName)
    if "Submitted" in df.columns:
        df = df[df["Submitted"].astype(str).str.strip().str.lower().isin(["yes", "true", "1"])]
    df = df[df["Student"].notna()].copy()
    df["dateParsed"] = pd.to_datetime(df.get("Date"), errors="coerce", dayfirst=True)
    df["nameKey"] = df["Student"].map(normName)
    dup = df["nameKey"].duplicated(keep=False)
    if dup.any():
        print(f"[warn] duplicate students — keeping latest row: {sorted(df.loc[dup, 'Student'].unique())}")
        df = df.sort_values("dateParsed").drop_duplicates("nameKey", keep="last")
    df = df.reset_index(drop=True)

    sections = buildSections(mcMeta, cfg)
    results, cohortAvg = scoreCohort(df, sections, cfg)          # cohort avgs always use full cohort
    if checkSheetTotals:
        bad = checkTotals(df, results)
        if len(bad):
            print(bad.to_string(index=False))
    criteria = loadCriteria(jsonPath, cfg["checklistKey"])
    ids = loadStudentIds(studentListPath, cohort)
    if periodLabel is None:
        d = df["dateParsed"].dropna()
        periodLabel = d.max().strftime("%B %Y") if len(d) else ""

    os.makedirs(outDir, exist_ok=True)
    wanted = {normName(s) for s in students} if students else None
    index = []
    for (_, row), res in zip(df.iterrows(), results):
        if wanted and normName(row["Student"]) not in wanted:
            continue
        sid = ids.get(normName(row["Student"]), "")
        if not sid:
            print(f"[warn] no student number for {row['Student']}")
        info = {"name": row["Student"], "id": sid, "cohort": row.get("Cohort", cohort),
                "subject": row.get("Subject", ""), "period": periodLabel}
        fname = fileStem(row["Student"], sid, cfg["fileTag"]) + ".pdf"
        buildStudentPdf(os.path.join(outDir, fname), info, row, res, sections, cohortAvg, criteria, cfg, includeCritical,
                        showComponentTable, showDomainBars, showOverallBar)
        grade, _ = gradeFor(res["overall"])
        rec = {"Student": row["Student"], "Student ID": sid}
        for sec, sr in zip(sections, res["sections"]):
            rec[f"{sec['title'].split(':')[0].strip()} (/{fmtNum(sec['avail'])})"] = sr["raw"]
        for p in res["parts"]:
            rec[f"{p['label']} %"] = None if p["pct"] is None else round(p["pct"], 1)
        rec.update({"Overall %": None if res["overall"] is None else round(res["overall"], 1),
                    "Grade (UoM)": grade, "PDF file": fname})
        index.append(rec)
    idx = pd.DataFrame(index).sort_values("Overall %", ascending=False)
    idx.to_csv(os.path.join(outDir, "_index.csv"), index=False)
    print(f"Built {len(idx)} {examKey} reports -> {outDir}")
    return idx
