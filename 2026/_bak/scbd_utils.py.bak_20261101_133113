# ── Loading ──────────────────────────────────────────────────────────────────
def loadExportSheet(xlsxPath, sheetName):
    """Read a scbd_gradio export sheet -> (df, mcMeta).
    mcMeta = [{"mc": "MC1", "col": "MC1 (/3)", "den": 3.0, "group": "<row-1 heading>"}, ...]"""
    ws = openpyxl.load_workbook(xlsxPath, read_only=True, data_only=True)[sheetName]
    rows = ws.iter_rows(min_row=1, max_row=2, values_only=True)
    top, head = list(next(rows)), list(next(rows))
    groups, cur = [], None                     # forward-fill merged row-1 headings
    for v in top:
        if v is not None and str(v).strip():
            cur = str(v).strip()
        groups.append(cur)
    df = pd.read_excel(xlsxPath, sheet_name=sheetName, header=1)
    mcMeta = []
    for i, h in enumerate(head):
        m = re.match(r"^\s*(MC\d+)\s*\(/\s*([\d.]+)\s*\)", str(h or ""))
        if m:
            mcMeta.append({"mc": m.group(1), "col": df.columns[i], "den": float(m.group(2)), "group": groups[i]})
    if not mcMeta:
        raise ValueError(f"No 'MCn (/d)' columns found in {xlsxPath} / {sheetName}")
    return df, mcMeta


def loadCriteria(jsonPath, checklistKey):
    """MC -> criterion text from the DASH API cache (temp <year> scbd.json); uses the
    form version with the most fields. Returns {} if the file/key is missing."""
    import json
    if not jsonPath or not os.path.exists(jsonPath):
        print(f"[criteria] {jsonPath} not found — criterion text will be blank")
        return {}
    with open(jsonPath, encoding="utf-8") as f:
        recs = json.load(f)
    best = {}
    for r in recs:
        fields = (((r.get("form") or {}).get("checklists") or {}).get(checklistKey) or {}).get("fields") or {}
        if len(fields) > len(best):
            best = fields
    if not best:
        print(f"[criteria] checklist '{checklistKey}' not in {jsonPath} — criterion text will be blank")
    return {k: html.unescape(re.sub(r"<[^>]+>", " ", str(v))).strip() for k, v in best.items()}


def normName(s):
    s = re.sub(r"[\u2019\u2018'`]\s*", "", str(s or ""))       # O’Donoghue == O' Donoghue == ODonoghue
    return re.sub(r"\s+", " ", s).strip().lower()


def loadStudentIds(studentListPath, cohort=None):
    """normalised student_name -> student_number (from RE_ Student List.xlsx / studentEmailList.csv)."""
    if not studentListPath or not os.path.exists(studentListPath):
        print(f"[ids] {studentListPath} not found — IDs will be blank")
        return {}
    sl = pd.read_csv(studentListPath) if str(studentListPath).lower().endswith(".csv") else pd.read_excel(studentListPath)
    if cohort and "cohort" in sl.columns:
        sl = sl[sl["cohort"].astype(str).str.upper() == str(cohort).upper()]
    return {normName(n): str(int(i)) for n, i in zip(sl["student_name"], sl["student_number"]) if pd.notna(i)}

# ── Structure + scoring ──────────────────────────────────────────────────────
def buildSections(mcMeta, cfg):
    """Group MCs into report sections (+ sub-headings) using cfg['sectionPattern']."""
    pat = re.compile(cfg["sectionPattern"], re.I) if cfg.get("sectionPattern") else None
    sections, lastGroup = [], object()
    for m in mcMeta:
        g = m["group"] or "Checklist"
        if g != lastGroup:
            if pat is None or pat.search(g) or not sections:
                sections.append({"title": g, "items": []})
            else:
                sections[-1]["items"].append({"subheading": g})
            lastGroup = g
        sections[-1]["items"].append(m)
    for s in sections:
        s["mcs"] = [i for i in s["items"] if "mc" in i and i["mc"] not in cfg.get("excludeMcs", [])]
        s["avail"] = sum(i["den"] for i in s["mcs"])
    return sections


def mcValue(row, m):
    v = pd.to_numeric(row.get(m["col"]), errors="coerce")
    return None if pd.isna(v) else float(v)


def scoreStudent(row, sections, cfg):
    """-> {"sections": [{raw, avail, pct}], "parts": [{label, pct, weight}], "overall": %}"""
    secRes = []
    for s in sections:
        raw = avail = 0.0; got = False
        for m in s["mcs"]:
            v = mcValue(row, m)
            if v is not None:
                raw += v; avail += m["den"]; got = True
        secRes.append({"raw": raw if got else None, "avail": avail if got else s["avail"],
                       "pct": 100 * raw / avail if got and avail else None})
    partRes = []
    for p in cfg["parts"]:
        pat = re.compile(p["match"], re.I)
        idx = [i for i, s in enumerate(sections) if pat.search(s["title"])]
        if p["method"] == "sum":
            raw = sum(secRes[i]["raw"] or 0 for i in idx if secRes[i]["raw"] is not None)
            av = sum(secRes[i]["avail"] for i in idx if secRes[i]["raw"] is not None)
            pct = 100 * raw / av if av else None
        elif p["method"] == "itemNorm":
            vals = [mcValue(row, m) / m["den"] for i in idx for m in sections[i]["mcs"]
                    if m["den"] and mcValue(row, m) is not None]
            pct = 100 * float(np.mean(vals)) if vals else None
        else:
            raise ValueError(f"Unknown part method {p['method']}")
        partRes.append({"label": p["label"], "pct": pct, "weight": p["weight"]})
    scored = [p for p in partRes if p["pct"] is not None]
    wSum = sum(p["weight"] for p in scored)
    overall = sum(p["pct"] * p["weight"] for p in scored) / wSum * sum(pp["weight"] for pp in cfg["parts"]) \
        if scored and wSum else None                 # re-scales only if a whole part is blank
    totRaw = sum(r["raw"] for r in secRes if r["raw"] is not None)
    totAvail = sum(r["avail"] for r in secRes if r["raw"] is not None)
    return {"sections": secRes, "parts": partRes, "overall": overall, "totRaw": totRaw, "totAvail": totAvail}


def scoreCohort(df, sections, cfg):
    """Score every row; returns (results list aligned to df, cohortAvg dict)."""
    results = [scoreStudent(r, sections, cfg) for _, r in df.iterrows()]
    def avg(vals):
        vals = [v for v in vals if v is not None]
        return float(np.mean(vals)) if vals else None
    cohortAvg = {
        "sections": [avg([r["sections"][i]["raw"] for r in results]) for i in range(len(sections))],
        "parts": [avg([r["parts"][j]["pct"] for r in results]) for j in range(len(cfg["parts"]))],
        "overall": avg([r["overall"] for r in results]),
        "totRaw": avg([r["totRaw"] for r in results]),
        # % distributions for the score bars (avg + 25/50/75th percentiles)
        "sectionPct": [avg([r["sections"][i]["pct"] for r in results]) for i in range(len(sections))],
        "sectionQ": [quartiles([r["sections"][i]["pct"] for r in results]) for i in range(len(sections))],
        "overallQ": quartiles([r["overall"] for r in results]),
    }
    return results, cohortAvg


def quartiles(vals):
    """(Q1, median, Q3) of the non-blank values, or None."""
    vals = [v for v in vals if v is not None]
    return tuple(float(x) for x in np.percentile(vals, [25, 50, 75])) if vals else None


def quartileOf(v, q):
    """1 = top 25% … 4 = bottom 25% (ties go to the higher quartile)."""
    if v is None or q is None:
        return None
    return 1 if v >= q[2] else 2 if v >= q[1] else 3 if v >= q[0] else 4


def checkTotals(df, results, sheetCol="Overall (%)", tol=0.15):
    """Recomputed Overall vs the sheet's Overall column. Differences ≤ tol are rounding
    (the export rounds section % before weighting). Returns rows that differ."""
    if sheetCol not in df.columns:
        print(f"[check] '{sheetCol}' not in sheet — skipped")
        return pd.DataFrame()
    out = pd.DataFrame({"Student": df["Student"].values,
                        "Sheet": pd.to_numeric(df[sheetCol], errors="coerce").values,
                        "Recomputed": [r["overall"] for r in results]})
    out["Diff"] = (out["Recomputed"] - out["Sheet"]).round(3)
    bad = out[out["Diff"].abs() > tol]
    small = ((out["Diff"].abs() > 1e-6) & (out["Diff"].abs() <= tol)).sum()
    print(f"[check] {len(out)} rows | {small} rounding-only diffs (≤{tol}) | {len(bad)} real mismatches")
    return bad


def gradeFor(pct):
    """UoM grade band for an exact % (no rounding up: 79.6 -> H2A)."""
    if pct is None:
        return "—", "#808080"
    for lo, lab, col in GRADE_BANDS:
        if pct >= lo:
            return lab, col
    return GRADE_BANDS[-1][1], GRADE_BANDS[-1][2]

