    "        ws.cell(r, 1, i+1).alignment = centerAlign(); ws.cell(r,1).border = thinBorder()\n",
    "        ws.cell(r, 2, row['Student']).alignment = leftAlign(); ws.cell(r,2).border = thinBorder()\n",
    "        if i % 2 == 0:\n",
    "            ws.cell(r,1).fill = hFill('FFF2F2F2')\n",
    "            ws.cell(r,2).fill = hFill('FFF2F2F2')\n",
    "\n",
    "        for j, mc in enumerate(mcKeys):\n",
    "            val   = int(row[mc]) if pd.notna(row[mc]) else 0\n",
    "            denom = mcDenoms[mc]\n",
