    "\n",
    "tocTable = Table(tocRows, colWidths=colWidths, repeatRows=1)\n",
    "tocTable.setStyle(TableStyle([\n",
    "    (\"BACKGROUND\",  (0, 0), (-1, 0),  uniColor),\n",
    "    (\"TEXTCOLOR\",   (0, 0), (-1, 0),  colors.white),\n",
    "    (\"FONTNAME\",    (0, 0), (-1, 0),  \"Helvetica-Bold\"),\n",
    "    (\"ROWBACKGROUNDS\", (0, 1), (-1, -1), [colors.white, colors.HexColor(\"#F3F4F6\")]),\n",
    "    (\"GRID\",        (0, 0), (-1, -1), 0.5, colors.HexColor(\"#CCCCCC\")),\n",
    "    (\"TOPPADDING\",  (0, 0), (-1, -1), 5),\n",
    "    (\"BOTTOMPADDING\",(0, 0), (-1, -1), 5),\n",
    "    (\"LEFTPADDING\", (0, 0), (-1, -1), 6),\n",
    "]))\n",
    "\n",
    "# ── Banner callbacks ──────────────────────────────────────────────────────────\n",
    "page_state = {\"label\": \"\"}\n",
    "\n",
    "def onFirst(canvas, doc):\n",
    "    getBannerDrawer(\"Student Report\", f\"{studentName} ({studentNumber_})\")(canvas, doc)\n",
    "\n",
    "def onLater(canvas, doc):\n",
    "    getBannerDrawer(\" \", f\"{page_state['label']}\")(canvas, doc)\n",
    "\n",
    "# ── Build elements ────────────────────────────────────────────────────────────\n",
    "doc = SimpleDocTemplate(\n",
