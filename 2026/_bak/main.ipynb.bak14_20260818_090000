    "\n",
    "    elements.append(_BannerMarker(label, page_state))   # before PageBreak → state ready for onLaterPages\n",
    "    elements.append(PageBreak())\n",
    "    elements.append(_BookmarkAnchor(anchor))             # after PageBreak → bookmark on correct page\n",
    "    elements.append(Spacer(1, 72))\n",
