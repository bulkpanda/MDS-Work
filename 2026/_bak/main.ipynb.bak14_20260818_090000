    "\n",
    "        gr = int(row['GR'])\n",
    "        grCol = 3 + len(mcKeys) + 5\n",
    "        ws.cell(r, grCol, gr).alignment = centerAlign(); ws.cell(r,grCol).border = thinBorder()\n",
    "        ws.cell(r, grCol).fill = hFill(GR_COLORS[gr])\n",
    "        ws.cell(r, grCol+1, row['GR Label']).alignment = centerAlign(); ws.cell(r,grCol+1).border = thinBorder()\n",
    "        ws.cell(r, grCol+1).fill = hFill(GR_COLORS[gr])\n",
    "\n",
    "    # Cohort mean row\n",
    "    meanR = 4 + n\n",
    "    ws.cell(meanR, 2, 'COHORT MEAN').fill = hFill(SUBHDR_BG)\n",
    "    ws.cell(meanR, 2).font = hFont(SUBHDR_FG, True, 9); ws.cell(meanR, 2).alignment = centerAlign()\n",
    "    for j, mc in enumerate(mcKeys):\n",
    "        c = ws.cell(meanR, j+3, round(scoresdf[mc].mean(), 2))\n",
    "        c.fill = hFill(SUBHDR_BG); c.font = hFont(SUBHDR_FG, True, 8)\n",
