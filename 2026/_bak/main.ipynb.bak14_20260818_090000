    "     Paragraph(f\"<b>Clinic</b>\",   tableTextStyleWhite),\n",
    "     Paragraph(f\"<b>Rotation</b>\", tableTextStyleWhite),\n",
    "     Paragraph(f\"<b>Assessor Submitted</b>\",     tableTextStyleWhite),\n",
    "]\n",
    "]\n",
    "for i, (_, row) in enumerate(entryDf.iterrows()):\n",
    "    date_str = f\"{row['created_date'].day} {row['created_date'].strftime('%B %Y')}\"\n",
    "    anchor   = f\"form_{i}\"\n",
    "    tocRows.append([\n",
    "        Paragraph(f'<link href=\"#{anchor}\"><u>Form {i + 1}</u></link>', linkStyle),\n",
    "        Paragraph(date_str,                      tableTextStyleSmall),\n",
    "        Paragraph(row[\"clinic\"]    or \"—\",       tableTextStyleSmall),\n",
