    "    for col in ws.columns:\n",
    "        best = max((len(str(c.value or \"\")) for c in col), default=0)\n",
    "        ws.column_dimensions[get_column_letter(col[0].column)].width = min(max_w, max(min_w, best + 2))\n",
    "\n",
    "\n",
    "def _write_pivot(ws, pivot_text, pivot_score, mc_cols, start_row, title, scored=False):\n",
    "    \"\"\"Write one pivot block (text or score) into ws starting at start_row. Returns next free row.\"\"\"\n",
    "    # Title\n",
    "    c = ws.cell(row=start_row, column=1, value=title)\n",
    "    c.font = Font(bold=True, name=\"Arial\", size=11)\n",
    "    start_row += 1\n",
    "\n",
    "    # Header row: Assessor | MC1..MCN | GR | PR | Comments\n",
    "    for j, h in enumerate([\"Assessor\"] + mc_cols + [\"GR\", \"PR\", \"Comments\"], 1):\n",
    "        _hdr(ws, start_row, j, h)\n",
    "    start_row += 1\n",
    "\n",
    "    # Data rows\n",
    "    for assessor in pivot_text.index:\n",
    "        # Assessor label\n",
    "        c = ws.cell(row=start_row, column=1, value=assessor)\n",
    "        c.font      = _LABEL_FONT\n",
    "        c.border    = _BORDER\n",
    "        c.alignment = Alignment(horizontal=\"left\", vertical=\"center\")\n",
    "\n",
    "        col_idx = 2\n",
    "        for mc in mc_cols:\n",
    "            text_val  = pivot_text.at[assessor, mc]  if mc in pivot_text.columns  else None\n",
    "            score_val = pivot_score.at[assessor, mc] if mc in pivot_score.columns else None\n",
    "\n",
    "            # NaN guard\n",
    "            text_val  = None if pd.isna(text_val)  else text_val\n",
    "            score_val = None if pd.isna(score_val) else score_val\n",
    "\n",
    "            if scored:\n",
    "                val      = int(score_val) if score_val is not None else None\n",
    "                fill_hex = _SCORE_FILLS.get(int(score_val)) if score_val is not None else None\n",
    "            else:\n",
    "                val      = text_val\n",
    "                fill_hex = _SCORE_FILLS.get(_MC_TEXT_SCORE.get(text_val)) if text_val else None\n",
    "\n",
    "            _cell(ws, start_row, col_idx, val, fill_hex=fill_hex)\n",
    "            col_idx += 1\n",
    "\n",
    "        # GR\n",
    "        gr = pivot_text.at[assessor, \"GR\"] if \"GR\" in pivot_text.columns else None\n",
    "        gr = None if pd.isna(gr) else gr\n",
    "        _cell(ws, start_row, col_idx,     int(gr) if gr is not None else None,\n",
    "              fill_hex=_GR_FILLS.get(int(gr)) if gr is not None else None)\n",
    "\n",
    "        # PR\n",
    "        pr = pivot_text.at[assessor, \"PR\"] if \"PR\" in pivot_text.columns else None\n",
    "        pr = None if pd.isna(pr) else pr\n",
    "        _cell(ws, start_row, col_idx + 1, int(pr) if pr is not None else None,\n",
    "              fill_hex=_PR_FILLS.get(int(pr)) if pr is not None else None)\n",
    "\n",
    "        # Comments\n",
    "        comments = pivot_text.at[assessor, \"Comments\"] if \"Comments\" in pivot_text.columns else None\n",
    "        comments = None if pd.isna(comments) else comments\n",
    "        _cell(ws, start_row, col_idx + 2, comments)\n",
    "\n",
    "        start_row += 1\n",
    "\n",
    "    return start_row\n",
    "\n",
    "\n",
    "# ── Public function ───────────────────────────────────────────────────────────\n",
    "\n",
    "def buildAssessorPivotReport(longDf: pd.DataFrame, outputPath: str):\n",
    "    \"\"\"\n",
    "    Write an Excel workbook with one sheet per ItemCode.\n",
    "\n",
    "    Each sheet contains two pivot tables (Assessor × MC):\n",
    "      1. Text pivot  — MCText values, colour-filled by score\n",
    "      2. Score pivot — MCScore integers (1–5), colour-filled by score\n",
    "    Both tables include GR, PR, and Comments as the final three columns.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    longDf      : DataFrame with columns:\n",
    "                  ItemCode, Assessor, StudentName, MC, MCText, MCScore, GR, PR\n",
    "    outputPath  : Destination .xlsx path\n",
    "    \"\"\"\n",
    "    wb = Workbook()\n",
    "    wb.remove(wb.active)\n",
    "    sheetCol = 'ItemCode' # column to split sheets by (final version)\n",
    "    sheetCol = 'StudentName' # column to split sheets by (diff version for exploration)\n",
    "    for item_code in sorted(longDf[sheetCol].unique()):\n",
    "        sub = longDf[longDf[sheetCol] == item_code].copy()\n",
    "\n",
    "        pivot_text = sub.pivot_table(\n",
    "            index=\"Assessor\", columns=\"MC\", values=\"MCText\", aggfunc=\"first\"\n",
    "        )\n",
    "        pivot_score = sub.pivot_table(\n",
    "            index=\"Assessor\", columns=\"MC\", values=\"MCScore\", aggfunc=\"first\"\n",
    "        )\n",
    "\n",
    "        scales = sub.groupby(\"Assessor\")[[\"GR\", \"PR\", \"Comments\"]].first()\n",
    "        pivot_text  = pivot_text.join(scales)\n",
    "        pivot_score = pivot_score.join(scales)\n",
    "\n",
    "        # Natural-sorted MC columns (exclude GR/PR which are joined, not pivoted)\n",
    "        mc_cols = sorted(\n",
    "            [c for c in pivot_text.columns if re.match(r\"^MC\\d+$\", str(c))],\n",
    "            key=_mc_sort_key,\n",
    "        )\n",
    "\n",
    "        ws = wb.create_sheet(title=str(item_code)[:31])\n",
    "        ws.sheet_view.showGridLines = False\n",
    "\n",
    "        next_row = 1\n",
    "        next_row = _write_pivot(ws, pivot_text, pivot_score, mc_cols, next_row,\n",
    "                                 f\"{item_code} — MC Responses (Text)\", scored=False)\n",
    "        next_row += 1  # blank separator row\n",
    "        _write_pivot(ws, pivot_text, pivot_score, mc_cols, next_row,\n",
    "                     f\"{item_code} — MC Scores (1–5)\", scored=True)\n",
    "\n",
    "        _autofit(ws)\n",
    "\n",
    "    wb.save(outputPath)\n",
    "\n",
    "FILE_NAME = f\"mcex_1606_assessor_pivot.xlsx\"\n",
    "LOCAL_FILE = os.path.join('mcex/BOH2', FILE_NAME)\n",
    "buildAssessorPivotReport(longDf, LOCAL_FILE)\n",
    "print(\"Saved assessor pivot report to Excel.\")"
   ]
