    "        ws.column_dimensions[get_column_letter(j+1)].width = w\n",
    "    ws.row_dimensions[2].height = 30\n",
    "    ws.freeze_panes = 'A3'\n",
    "\n",
    "\n",
    "def buildItemScoreGrid(wb, scoresdf, mcDenoms, itemStatsdf):\n",
    "    ws  = wb.create_sheet('Item Score Grid')\n",
    "    mcKeys  = list(mcDenoms.keys())\n",
    "    maxDenom = max(mcDenoms.values())\n",
    "\n",
    "    ws.merge_cells(f'A1:{get_column_letter(1+len(mcKeys))}1')\n",
    "    c = ws['A1']\n",
    "    c.value = 'SCBD — Score Count per Item  (each cell = number of students at that score level)'\n",
    "    c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 12); c.alignment = centerAlign()\n",
    "    ws.row_dimensions[1].height = 22\n",
    "\n",
    "    ws.cell(2, 1, 'Score').fill = hFill(HEADER_BG)\n",
    "    ws.cell(2, 1).font = hFont(HEADER_FG, True); ws.cell(2,1).alignment = centerAlign(); ws.cell(2,1).border = thinBorder()\n",
    "    for j, mc in enumerate(mcKeys):\n",
    "        c = ws.cell(2, j+2, f'{mc}\\n(/{mcDenoms[mc]})')\n",
    "        c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 8)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "    ws.row_dimensions[2].height = 36\n",
    "\n",
    "    # Difficulty row\n",
    "    ws.cell(3, 1, 'Difficulty').fill = hFill(SUBHDR_BG)\n",
    "    ws.cell(3,1).font = hFont(SUBHDR_FG,True,8); ws.cell(3,1).alignment = centerAlign(); ws.cell(3,1).border = thinBorder()\n",
    "    for j, (_, stat) in enumerate(itemStatsdf.iterrows()):\n",
    "        c = ws.cell(3, j+2, stat['Difficulty'])\n",
    "        c.fill = DIFF_FILLS[stat['Difficulty']]\n",
    "        c.font = Font(bold=True, name='Arial', size=8)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "\n",
    "    # Mean % row\n",
    "    ws.cell(4, 1, 'Mean %').fill = hFill(SUBHDR_BG)\n",
    "    ws.cell(4,1).font = hFont(SUBHDR_FG,True,8); ws.cell(4,1).alignment = centerAlign(); ws.cell(4,1).border = thinBorder()\n",
    "    for j, (_, stat) in enumerate(itemStatsdf.iterrows()):\n",
    "        c = ws.cell(4, j+2, stat['Mean %'])\n",
    "        c.fill = hFill(SUBHDR_BG); c.font = hFont(SUBHDR_FG, True, 8)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "\n",
    "    for score in range(maxDenom+1):\n",
    "        r = score + 5\n",
    "        ws.cell(r, 1, score).fill = hFill(SCORE_COLORS.get(score, 'FFD9D9D9'))\n",
    "        ws.cell(r, 1).font = Font(bold=True, name='Arial', size=10)\n",
    "        ws.cell(r, 1).alignment = centerAlign(); ws.cell(r, 1).border = thinBorder()\n",
    "        for j, mc in enumerate(mcKeys):\n",
    "            denom = mcDenoms[mc]\n",
    "            if score > denom:\n",
    "                c = ws.cell(r, j+2, '—')\n",
    "                c.fill = hFill('FFD9D9D9'); c.alignment = centerAlign(); c.border = thinBorder()\n",
    "            else:\n",
    "                cnt  = int((scoresdf[mc] == score).sum())\n",
    "                c = ws.cell(r, j+2, cnt)\n",
    "                c.fill = hFill(SCORE_COLORS.get(score, 'FFD9D9D9'))\n",
    "                c.alignment = centerAlign(); c.border = thinBorder()\n",
    "\n",
    "    ws.cell(maxDenom+6, 1, '% at Max').fill = hFill('FF4472C4')\n",
    "    ws.cell(maxDenom+6,1).font = hFont(HEADER_FG, True, 8); ws.cell(maxDenom+6,1).alignment = centerAlign(); ws.cell(maxDenom+6,1).border = thinBorder()\n",
    "    for j, (_, stat) in enumerate(itemStatsdf.iterrows()):\n",
    "        c = ws.cell(maxDenom+6, j+2, f\"{stat['% at Max']}%\")\n",
    "        c.fill = hFill('FF4472C4'); c.font = hFont(HEADER_FG, True, 8)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "\n",
    "    ws.column_dimensions['A'].width = 12\n",
    "    for j in range(len(mcKeys)):\n",
    "        ws.column_dimensions[get_column_letter(j+2)].width = 9\n",
    "    ws.freeze_panes = 'B3'\n",
    "\n",
    "\n",
    "def buildWeightingSimulator(wb, scoresdf):\n",
    "    ws  = wb.create_sheet('Weighting Simulator')\n",
    "\n",
    "    ws.merge_cells('A1:J1')\n",
    "    c = ws['A1']\n",
    "    c.value = 'SCBD — Weighting Simulator  |  Edit yellow cells (B4:B7, must sum to 100) to reweight domains'\n",
    "    c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 12); c.alignment = centerAlign()\n",
    "    ws.row_dimensions[1].height = 22\n",
    "\n",
    "    domDefs = [\n",
    "        ('D1 Clinical Info Gathering',  'D1 Clinical Information Gathering %'),\n",
    "        ('D2 Diagnosis & Risk',          'D2 Diagnosis, Risk Assessment & Prognosis %'),\n",
    "        ('D3 Treatment Planning',        'D3 Treatment Planning %'),\n",
    "        ('D4 Presentation',              'D4 Presentation %'),\n",
    "    ]\n",
    "    for hdr, col in [('Domain',''), ('Weight (%)',''), ('Actual Mean %','')]:\n",
    "        pass\n",
    "    ws.cell(3,1,'Domain').fill = hFill(SUBHDR_BG); ws.cell(3,1).font = hFont(SUBHDR_FG,True); ws.cell(3,1).alignment = centerAlign()\n",
    "    ws.cell(3,2,'Weight (%)').fill = hFill(SUBHDR_BG); ws.cell(3,2).font = hFont(SUBHDR_FG,True); ws.cell(3,2).alignment = centerAlign()\n",
    "    ws.cell(3,3,'Cohort Mean %').fill = hFill(SUBHDR_BG); ws.cell(3,3).font = hFont(SUBHDR_FG,True); ws.cell(3,3).alignment = centerAlign()\n",
    "\n",
    "    for i, (name, col) in enumerate(domDefs):\n",
    "        r = 4 + i\n",
    "        ws.cell(r, 1, name).alignment = leftAlign(); ws.cell(r,1).border = thinBorder()\n",
    "        wCell = ws.cell(r, 2, 25)\n",
    "        wCell.fill = hFill('FFFFFF00'); wCell.font = Font(bold=True, color='FF000000', name='Arial')\n",
    "        wCell.alignment = centerAlign(); wCell.border = thinBorder()\n",
    "        ws.cell(r, 3, round(scoresdf[col].mean(), 1)).alignment = centerAlign(); ws.cell(r,3).border = thinBorder()\n",
    "\n",
    "    ws.cell(8, 1, 'Total Weight').font = Font(bold=True, name='Arial')\n",
    "    ws.cell(8, 2, '=SUM(B4:B7)').alignment = centerAlign()\n",
    "    ws.cell(8, 2).font = Font(bold=True, name='Arial'); ws.cell(8,2).border = thinBorder()\n",
    "    ws.cell(11, 1, 'NOTE: Edit B4:B7 weights (must sum to 100). Columns G and H recalculate automatically.').font = Font(italic=True, name='Arial', size=9, color='FF666666')\n",
    "\n",
    "    dataStart = 13\n",
    "    hdrs5 = ['Student','D1 %','D2 %','D3 %','D4 %','Current Overall %','Reweighted Overall %','Δ vs Current','GR (Current)']\n",
    "    for j, h in enumerate(hdrs5):\n",
    "        c = ws.cell(dataStart, j+1, h)\n",
    "        c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 9)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "\n",
    "    sortedDf = scoresdf.sort_values('Overall %', ascending=False).reset_index(drop=True)\n",
    "    for i, row in sortedDf.iterrows():\n",
    "        r = dataStart + 1 + i\n",
    "        ws.cell(r, 1, row['Student']).alignment = leftAlign(); ws.cell(r,1).border = thinBorder()\n",
    "        vals = [\n",
    "            round(row['D1 Clinical Information Gathering %'], 1),\n",
    "            round(row['D2 Diagnosis, Risk Assessment & Prognosis %'], 1),\n",
    "            round(row['D3 Treatment Planning %'], 1),\n",
    "            round(row['D4 Presentation %'], 1),\n",
    "        ]\n",
    "        for j, v in enumerate(vals):\n",
    "            ws.cell(r, j+2, v).alignment = centerAlign(); ws.cell(r,j+2).border = thinBorder()\n",
    "        ws.cell(r, 6, round(row['Overall %'], 1)).alignment = centerAlign(); ws.cell(r,6).border = thinBorder()\n",
    "        ws.cell(r, 7, f'=(B{r}*$B$4+C{r}*$B$5+D{r}*$B$6+E{r}*$B$7)/100').alignment = centerAlign(); ws.cell(r,7).border = thinBorder()\n",
    "        ws.cell(r, 8, f'=G{r}-F{r}').alignment = centerAlign(); ws.cell(r,8).border = thinBorder()\n",
    "        gr = int(row['GR'])\n",
    "        ws.cell(r, 9, gr).alignment = centerAlign(); ws.cell(r,9).border = thinBorder()\n",
    "        ws.cell(r, 9).fill = hFill(GR_COLORS[gr])\n",
    "        if i % 2 == 0:\n",
    "            for j in [1,2,3,4,5,6]:\n",
    "                cell = ws.cell(r,j)\n",
    "                if cell.fill.fgColor.rgb in ('FF000000', '00000000'):\n",
    "                    cell.fill = hFill('FFF2F2F2')\n",
    "\n",
    "    ws.column_dimensions['A'].width = 26\n",
    "    for j in range(1, 9):\n",
    "        ws.column_dimensions[get_column_letter(j+1)].width = 16\n",
    "    ws.freeze_panes = 'B14'\n",
    "\n",
    "\n",
    "def buildExaminerHarshness(wb, scoresdf):\n",
    "    ws = wb.create_sheet('Examiner Harshness')\n",
    "\n",
    "    ws.merge_cells('A1:H1')\n",
    "    c = ws['A1']; c.value = 'SCBD — Examiner Harshness Comparison  |  Mean scores per assessor (green/red = >5% from cohort mean)'\n",
    "    c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 12); c.alignment = centerAlign()\n",
    "    ws.row_dimensions[1].height = 22\n",
    "\n",
    "    examinerStats = scoresdf.groupby('Assessor').agg(\n",
    "        N=('Overall %', 'count'),\n",
    "        MeanOverall=('Overall %', 'mean'),\n",
    "        SDOverall=('Overall %', 'std'),\n",
    "        MeanD1=('D1 Clinical Information Gathering %', 'mean'),\n",
    "        MeanD2=('D2 Diagnosis, Risk Assessment & Prognosis %', 'mean'),\n",
    "        MeanD3=('D3 Treatment Planning %', 'mean'),\n",
    "        MeanD4=('D4 Presentation %', 'mean'),\n",
    "    ).reset_index().sort_values('MeanOverall', ascending=False)\n",
    "\n",
    "    hdrs6 = ['Assessor', 'N', 'Mean Overall %', 'SD Overall %',\n",
    "             'Mean D1 %', 'Mean D2 %', 'Mean D3 %', 'Mean D4 %']\n",
    "    colWidths6 = [24, 6, 16, 14, 12, 12, 12, 12]\n",
    "    for j, (h, w) in enumerate(zip(hdrs6, colWidths6)):\n",
    "        c = ws.cell(2, j+1, h)\n",
    "        c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 9)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "        ws.column_dimensions[get_column_letter(j+1)].width = w\n",
    "\n",
    "    cohortMean = scoresdf['Overall %'].mean()\n",
    "    for i, row in examinerStats.iterrows():\n",
    "        r = i + 3\n",
    "        sdVal = round(row['SDOverall'], 1) if pd.notna(row['SDOverall']) else '—'\n",
    "        rowVals = [row['Assessor'], int(row['N']), round(row['MeanOverall'], 1),\n",
    "                   sdVal, round(row['MeanD1'],1), round(row['MeanD2'],1),\n",
    "                   round(row['MeanD3'],1), round(row['MeanD4'],1)]\n",
    "        for j, v in enumerate(rowVals):\n",
    "            cell = ws.cell(r, j+1, v)\n",
    "            cell.alignment = centerAlign() if j != 0 else leftAlign()\n",
    "            cell.border = thinBorder()\n",
    "            if i % 2 == 0: cell.fill = hFill('FFF9F9F9')\n",
    "        diff = row['MeanOverall'] - cohortMean\n",
    "        if diff > 5:\n",
    "            ws.cell(r, 3).fill = hFill(EASY_BG)\n",
    "        elif diff < -5:\n",
    "            ws.cell(r, 3).fill = hFill(HARD_BG)\n",
    "\n",
    "    cr = len(examinerStats) + 3\n",
    "    ws.cell(cr, 1, 'COHORT MEAN').fill = hFill(SUBHDR_BG); ws.cell(cr,1).font = hFont(SUBHDR_FG,True); ws.cell(cr,1).alignment = centerAlign()\n",
    "    ws.cell(cr, 3, round(cohortMean, 1)).fill = hFill(SUBHDR_BG); ws.cell(cr,3).font = hFont(SUBHDR_FG,True,9); ws.cell(cr,3).alignment = centerAlign()\n",
    "\n",
    "\n",
    "# ── Item Analysis rows (factored out to avoid duplication) ────────────────────\n",
    "def populateItemAnalysis(wb, scoresdf, mcDenoms, itemStatsdf):\n",
    "    ws = wb['Item Analysis']\n",
    "    for i, (_, stat) in enumerate(itemStatsdf.iterrows()):\n",
    "        r   = i + 3\n",
    "        mc  = stat['MC']\n",
    "        vals = scoresdf[mc]\n",
    "        distParts = [f\"{v}:{int((vals==v).sum())}\" for v in range(stat['Denominator']+1) if (vals==v).sum() > 0]\n",
    "        distStr   = '  |  '.join(distParts)\n",
    "\n",
    "        rowData = [mc, stat['Denominator'], stat['Domain'], stat['Description'],\n",
    "                   stat['Mean %'], stat['SD %'], stat['% at Max'],\n",
    "                   stat['Difficulty'], distStr, stat['Flags']]\n",
    "        for j, val in enumerate(rowData):\n",
    "            cell = ws.cell(r, j+1, val)\n",
    "            cell.border = thinBorder()\n",
    "            cell.alignment = leftAlign() if j in (2, 3, 8, 9) else centerAlign()\n",
    "            if i % 2 == 0: cell.fill = hFill('FFF9F9F9')\n",
    "        ws.cell(r, 8).fill = DIFF_FILLS[stat['Difficulty']]\n",
    "        ws.cell(r, 8).font = Font(bold=True, name='Arial', size=9)\n",
    "\n",
    "\n",
    "# ── Main ───────────────────────────────────────────────────────────────────────\n",
    "def main():\n",
    "    parser = argparse.ArgumentParser(\n",
    "        description='SCBD psychometric analysis — produces a 6-sheet Excel report.'\n",
    "    )\n",
    "\n",
    "    inputPath = Path('SCBD\\SCBD_10Jun.xlsx')\n",
    "    if not inputPath.exists():\n",
    "        print(f\"ERROR: input file not found: {inputPath}\", file=sys.stderr)\n",
    "        sys.exit(1)\n",
    "\n",
    "    outputPath = inputPath.parent / f\"{inputPath.stem}_Reformatted.xlsx\"\n",
    "\n",
    "    print(f\"Loading:  {inputPath}\")\n",
    "    scoresdf, mcDenoms, mcDesc = loadData(inputPath)\n",
    "    print(f\"  {len(scoresdf)} students  |  {len(mcDenoms)} MC items\")\n",
    "\n",
    "    itemStatsdf = buildItemStats(scoresdf, mcDenoms, mcDesc)\n",
    "\n",
    "    wb = Workbook()\n",
    "    wb.remove(wb.active)\n",
    "\n",
    "    print(\"Building sheets...\")\n",
    "    buildCohortOverview(wb, scoresdf, inputPath)\n",
    "    buildStudentScores(wb, scoresdf, mcDenoms, inputPath)\n",
