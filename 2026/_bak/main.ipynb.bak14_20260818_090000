    "def createFlaggingReport(cohort, formType, config=None, filters=None,\n",
    "                         period=PERIOD_ALL, minDate=None, maxDate=None,\n",
    "                         ignoreDates=None):\n",
    "    \"\"\"\n",
    "    Run flagging for one cohort/formType and write the Excel dashboard.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    cohort   : e.g. \"DDS2\", \"BOH1\"\n",
    "    formType : \"Clinic\" or \"Simulation\"\n",
    "    config   : FlaggingConfig — defaults to PRESETS[\"clinic_full\"]\n",
    "               Use PRESETS[\"...\"].copy(...) to override specific fields.\n",
    "    filters  : dict passed to getDataDf (defaults to {\"type\": formType})\n",
    "    period   : \"ALL\" (default, whole year — unchanged filename and behaviour),\n",
    "               \"FHY\" (semester 1, before SEMESTER_SPLIT_DATE = 2026-06-15) or\n",
    "               \"SHY\" (semester 2, on/after it). Aliases SEM1/S1/H1, SEM2/S2/H2.\n",
    "               Same selector the weekly-sim chain uses, so both pipelines split\n",
    "               the year on the same constant. FHY/SHY suffix the output file:\n",
    "               \"DDS2 Clinic Flagging (2026) (FHY).xlsx\".\n",
    "    minDate / maxDate : inclusive 'YYYY-MM-DD' overrides — they win over the\n",
    "               period's own bounds, so period=\"SHY\", maxDate=\"2026-08-01\" works.\n",
    "               Filtering is done on the Melbourne-local date (DASH stores UTC).\n",
    "    ignoreDates : list of individual session dates to remove entirely, e.g.\n",
    "               student-on-student activity days, where the forms are not evidence\n",
    "               of clinical performance. Accepts 'YYYY-MM-DD', 'DD/MM/YYYY' (day\n",
    "               first) or date objects. Applied BEFORE any average, threshold or\n",
    "               count, so nothing on the sheet is contaminated. A listed date that\n",
    "               matches no form is reported loudly — that is almost always a typo.\n",
    "               DDS2_CLINIC_IGNORE_DATES holds the eight confirmed DDS2 dates.\n",
    "\n",
    "    Examples\n",
    "    --------\n",
    "    # Full clinic dashboard with default preset:\n",
    "    createFlaggingReport(\"DDS2\", \"Clinic\")\n",
    "\n",
    "    # Semester 1 only (writes \"… Flagging (2026) (FHY).xlsx\"), dropping the\n",
    "    # student-on-student days:\n",
    "    createFlaggingReport(\"DDS2\", \"Clinic\", config=PRESETS[\"dds2_clinic\"],\n",
    "                         period=\"FHY\", ignoreDates=DDS2_CLINIC_IGNORE_DATES)\n",
    "\n",
    "    # Quick triage — summary + legend only:\n",
    "    createFlaggingReport(\"DDS2\", \"Clinic\", config=PRESETS[\"clinic_quick\"])\n",
    "\n",
    "    # Simulation run:\n",
    "    createFlaggingReport(\"DDS2\", \"Simulation\", config=PRESETS[\"sim_standard\"])\n",
    "\n",
    "    # Override one threshold from a preset:\n",
    "    createFlaggingReport(\"BOH1\", \"Clinic\",\n",
    "        config=PRESETS[\"clinic_full\"].copy(minForms=8, grThreshold=2.3))\n",
    "\n",
    "    # Turn the Operator gate on Pt Seen off for one run (old any-role count):\n",
    "    createFlaggingReport(\"DDS2\", \"Clinic\",\n",
    "        config=PRESETS[\"dds2_clinic\"].copy(requireOperatorForPtSeen=False))\n",
    "\n",
    "    # Custom — pick flags and sheets manually:\n",
    "    cfg = FlaggingConfig(\n",
    "        flags=[\"low_es\", \"low_gr\", \"high_fta\", \"clinical_incident\"],\n",
    "        sheets=[\"summary\", \"comparison\", \"legend\"],\n",
    "        esThreshold=2.3, grThreshold=2.5, minForms=12,\n",
    "    )\n",
    "    createFlaggingReport(\"DDS3\", \"Clinic\", config=cfg)\n",
    "\n",
    "    # Inspect any config before running:\n",
    "    PRESETS[\"clinic_full\"].describe()\n",
    "    \"\"\"\n",
    "    if config is None:\n",
    "        config = PRESETS[\"clinic_full\"]\n",
    "    if filters is None:\n",
    "        filters = {\"type\": formType}\n",
    "\n",
    "    clinic = filters.get(\"clinic\")\n",
    "    label  = f\"{cohort} — {formType}\" + (f\" — {clinic}\" if clinic else \"\")\n",
    "    print(f\"=== {label} ===\")\n",
    "\n",
    "    cohortDf = getDataDf(engine, cohort, filters=filters)\n",
