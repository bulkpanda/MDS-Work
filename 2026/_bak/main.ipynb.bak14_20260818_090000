    "    ws.cell(3,2,'Student').fill = hFill(HEADER_BG); ws.cell(3,2).font = hFont(HEADER_FG,True,8); ws.cell(3,2).alignment = centerAlign(); ws.cell(3,2).border = thinBorder()\n",
    "    for j, mc in enumerate(mcKeys):\n",
    "        c = ws.cell(3, j+3, f'{mc}\\n(/{mcDenoms[mc]})')\n",
    "        c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 8)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "    extraHdrs = ['D1 %', 'D2 %', 'D3 %', 'D4 %', 'Overall %', 'GR', 'Grade']\n",
    "    for k, h in enumerate(extraHdrs):\n",
    "        c = ws.cell(3, 3+len(mcKeys)+k, h)\n",
    "        c.fill = hFill(HEADER_BG); c.font = hFont(HEADER_FG, True, 8)\n",
    "        c.alignment = centerAlign(); c.border = thinBorder()\n",
    "    ws.row_dimensions[3].height = 36\n",
    "\n",
    "    sortedDf = scoresdf.sort_values('Overall %', ascending=False).reset_index(drop=True)\n",
    "    domainColsFull = [\n",
    "        'D1 Clinical Information Gathering %',\n",
    "        'D2 Diagnosis, Risk Assessment & Prognosis %',\n",
    "        'D3 Treatment Planning %', 'D4 Presentation %', 'Overall %',\n",
