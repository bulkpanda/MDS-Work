    "# ── SCBD Rubric-Based Scoring (handles per-item variable level counts) ───────\n",
    "# Relies on styleSheet / grFills / HEADER_COLOR / HEADER_FONT / autoFitColumns\n",
    "# already defined in the legacy \"SCBD Excel Report\" cell above — run that cell first.\n",
    "\n",
    "def parseJsonCol(value):\n",
    "    \"\"\"scbd.checklist_data / scbd.form come back as dict via psycopg jsonb, but\n",
    "    handle the str case defensively too.\"\"\"\n",
    "    if value is None:\n",
    "        return {}\n",
    "    if isinstance(value, str):\n",
    "        try:\n",
    "            return json.loads(value)\n",
    "        except (TypeError, ValueError):\n",
    "            return {}\n",
    "    return value\n",
    "\n",
    "def neatDomainLabel(title):\n",
    "    \"\"\"'1. Clinical Information Gathering' -> 'D1 Clinical Information Gathering'.\"\"\"\n",
    "    m = re.match(r'^(\\d+)\\.\\s*(.+)$', str(title))\n",
    "    if m:\n",
    "        return f\"D{m.group(1)} {m.group(2).strip().title()}\"\n",
    "    return str(title)\n",
    "\n",
    "def scoreScbdRow(checklistData, formJson, checklistKey):\n",
    "    \"\"\"\n",
    "    Score one SCBD assessment against its own checklist_key's rubric.\n",
    "\n",
    "    Each MCn item in form.checklists[checklistKey].extra_config.rubric has up to\n",
    "    5 slots (O1..O5, O1=best..O5=\"Not done\"). Many are blank — blank means that\n",
    "    level doesn't apply to that item, so the *count of non-blank slots* is the\n",
    "    real number of levels for that item (2, 3, 4 or 5).\n",
    "\n",
    "    The assessor's recorded text answer (e.g. \"Mostly done\") is generic across\n",
    "    all items (form.checklists[checklistKey].extra_config.options.assessor maps\n",
    "    O1->\"Done well\", O2->\"Done\", O3->\"Mostly done\", O4->\"Sometimes done\",\n",
    "    O5->\"Not done\"). We:\n",
    "      1. map the recorded text -> its O-letter via extra_config.options.assessor\n",
    "      2. find which O-letters are active (non-blank) for that specific MC\n",
    "      3. rank the active letters worst->best as 0..(n-1) and locate the chosen one\n",
    "      4. keep both the raw rank (0..n-1, an integer \"score out of n-1\") and a\n",
    "         normalized 0..1 version for domain/overall averaging, which still needs\n",
    "         to stay comparable across items with different numbers of levels.\n",
    "    All items are then averaged with equal weight (no item weighted more than\n",
    "    another) for the overall %, and again per-domain using the\n",
    "    extra_config.headers section groupings (e.g. MC1..\"1. Clinical Information\n",
    "    Gathering\", MC5..\"2. Diagnosis...\"). Checklists with no `headers` config\n",
    "    (e.g. the 4-item DDS3-SCBD-PM/AM checklists) bucket everything under \"Other\".\n",
    "    \"\"\"\n",
    "    checklists = (formJson or {}).get(\"checklists\", {}) or {}\n",
    "    cdef = checklists.get(checklistKey, {}) or {}\n",
    "    extraConfig = cdef.get(\"extra_config\") or {}\n",
    "    optionsAssessor = (extraConfig.get(\"options\") or {}).get(\"assessor\") or {}\n",
    "    rubric = extraConfig.get(\"rubric\") or {}\n",
    "    headers = extraConfig.get(\"headers\") or {}\n",
    "    fields = cdef.get(\"fields\") or {}\n",
    "\n",
    "    if not rubric or not optionsAssessor:\n",
    "        return {\n",
    "            \"item_scores\": {}, \"item_raw\": {}, \"item_max\": {}, \"domain_pct\": {}, \"overall_pct\": None,\n",
    "            \"legend\": {}, \"flags\": [f\"No rubric/options config found for checklist_key '{checklistKey}'\"],\n",
    "        }\n",
    "\n",
    "    textToLetter = {v: k for k, v in optionsAssessor.items() if v}\n",
    "    mcKeys = sorted(\n",
    "        [k for k in (checklistData or {}) if re.match(r'^MC\\d+$', k)],\n",
    "        key=lambda k: int(k[2:])\n",
    "    )\n",
    "\n",
    "    headerStarts = sorted(\n",
    "        [(int(k[2:]), neatDomainLabel(v[0].get('title') if isinstance(v, list) and v else str(v)))\n",
    "         for k, v in headers.items() if re.match(r'^MC\\d+$', k)],\n",
    "        key=lambda x: x[0]\n",
    "    )\n",
    "\n",
    "    def domainFor(mcNum):\n",
    "        domain = None\n",
    "        for startNum, title in headerStarts:\n",
    "            if mcNum >= startNum:\n",
    "                domain = title\n",
    "            else:\n",
    "                break\n",
    "        return domain or \"Other\"\n",
    "\n",
    "    itemScores, itemRaw, itemMax, flags, legend = {}, {}, {}, [], {}\n",
    "    domainScores = defaultdict(list)\n",
    "\n",
    "    for mc in mcKeys:\n",
    "        legend[mc] = {\"domain\": domainFor(int(mc[2:])), \"description\": fields.get(mc, \"\")}\n",
    "\n",
    "        itemRubric = rubric.get(mc, {}) or {}\n",
    "        active = sorted(\n",
    "            [o for o in (\"O1\", \"O2\", \"O3\", \"O4\", \"O5\") if str(itemRubric.get(o, \"\")).strip() != \"\"],\n",
    "            key=lambda o: int(o[1])\n",
    "        )\n",
    "        n = len(active)\n",
    "        if n > 1:\n",
    "            itemMax[mc] = n - 1\n",
    "\n",
    "        value = checklistData.get(mc)\n",
    "        letter = textToLetter.get(value)\n",
    "        if letter is None:\n",
    "            flags.append(f\"{mc}: unrecognized value '{value}'\")\n",
    "            itemScores[mc] = None\n",
    "            itemRaw[mc] = None\n",
    "            continue\n",
    "\n",
    "        if n <= 1 or letter not in active:\n",
    "            flags.append(f\"{mc}: value '{value}' ({letter}) not active in rubric (active={active})\")\n",
    "            itemScores[mc] = None\n",
