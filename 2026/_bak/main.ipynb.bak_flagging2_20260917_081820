   "source": [
    "# ── Which cohort ─────────────────────────────────────────────────────────────\n",
    "# The weekly-sim chain is cohort-generic now. DDS2 runs three parallel subjects on three\n",
    "# weekdays (routed by item code); BOH2 moved to one weekly Tuesday session in semester 2\n",
    "# (routed by date range, because its item codes are the free-text task names).\n",
    "# BOH1 (ORAL10005) routes by date range too (Tue/Wed in sem 1; Mon/Tue/Wed in sem 2),\n",
    "# same as BOH2 — its item codes are task/checklist names, not week numbers.\n",
    "# Streams, folders and filenames all follow from COHORT — see SIM_STREAMS in general_utils.\n",
    "COHORT = 'BOH1'          # 'DDS2' | 'BOH2' | 'BOH1'\n",
    "\n",
    "folder = weeklySimBaseFolder(COHORT)          # '<COHORT>/Weekly Sim'\n",
    "roster = loadRoster(COHORT)                   # empty frame if there's no roster file yet\n",
    "schedule = loadSessionSchedule(COHORT)        # ditto for the session schedule\n",
    "\n",
    "# ── Which sim stream(s) to work on ───────────────────────────────────────────\n",
    "# From semester 2, DDS2 sim runs three subjects on three weekdays, each with its own\n",
    "# checklist family. Forms are routed by ITEM CODE, never by subject code — students pick\n",
    "# the subject themselves and get it wrong (~4% of sem-2 forms), while the item code comes\n",
    "# from the checklist the assessor actually opened.\n",
    "#   'ALL'  every stream for COHORT, each into its own subfolder of Weekly Sim\n",
    "#   DDS2:  'PAEDS' (Mon, from 13 Jul) | 'FP' (Tue, from 30 Jun) | 'ENDO' (Wed, from 30 Jun)\n",
    "#          | 'SEM1' (2026-Week-xx, stays in Weekly Sim itself)\n",
    "#   BOH2:  'SHY' (Tue weekly, from 15 Jun) -> Weekly SHY/ | 'FHY' (stays in Weekly Sim)\n",
    "#   a subset e.g. ['PAEDS','FP']       |    None = legacy, don't split at all\n",
    "#   print({k: v['name'] for k, v in cohortStreams(COHORT).items()}) to list them\n",
    "# Each stream carries its own start/end dates, so nothing else needs setting.\n",
    "STREAM = 'ALL'\n",
    "\n",
    "# Also build a pooled all-streams set of combined/BLR/risk reports in the base folder.\n",
    "POOLED = True\n",
    "\n",
    "# Extra half-year narrowing ON TOP of the stream's own dates. Streams are already\n",
    "# semester-scoped, so leave this 'ALL' unless you want a slice.\n",
    "#   'FHY' before 2026-06-15 | 'SHY' on/after | 'ALL' no extra narrowing\n",
    "PERIOD = 'SHY'\n",
    "\n",
    "# Item codes to leave out of the BLR and combined-notebook analyses (cells below).\n",
    "# Shell-style wildcards, case-insensitive; both sides are normalised through\n",
    "# standardizeWeekFormat, so the raw DASH spelling 'Paeds 2026-Week-1' also matches.\n",
    "#   'positioning'   exact       |  '2026-Week-*'  the whole sem-1 family\n",
    "#   'Paeds*'        one family  |  '*-Week-0?'    weeks 01-09 of any family\n",
    "# Empty list = nothing ignored (unchanged behaviour). Does NOT affect workbook building.\n",
    "IGNORE_CODES = []\n",
    "# IGNORE_CODES = ['positioning', 'DDS2-MAR-31', '19-Jan-SIM']   # January test forms\n",
    "\n",
    "# Item codes to KEEP — the whitelist counterpart of IGNORE_CODES. Same shell-style\n",
    "# wildcards, case-insensitive, normalised on both sides. Empty list = keep everything\n",
    "# (unchanged behaviour). Applied to ALL three cells below: the per-date workbooks (cell 39,\n",
    "# written as separate ' (subset)' files so your complete workbooks are untouched) and the\n",
    "# combined workbook + BLR (cells 40/41, filtered at read time, output also ' (subset)').\n",
    "# IGNORE_CODES still applies on top, so you can whitelist a family and drop one member.\n",
    "#   ['531', '532']         just those two task codes\n",
    "#   ['OHP1-PL-*']          the whole perio-placement family\n",
    "#   ['5??', 'OHP1-PL-*']   numeric 5xx plus the placement family\n",
    "ONLY_CODES = ['532']\n",
    "\n",
    "# Optional automatic version: drop any item code sat by fewer than N distinct students\n",
    "# across the whole period. 0 = off. Stops a code done by one catch-up student getting\n",
    "# its own column and its own percentile threshold computed over n=1.\n",
    "MIN_ITEM_COUNT = 5\n",
    "\n",
    "# ── How students are flagged ─────────────────────────────────────────────────\n",
    "# All three methods produce ONE cutoff PER ITEM CODE (the score tables are pivoted by\n",
    "# item code); a student Fails when at or below the cutoff in >= MIN_LOW_COUNT codes.\n",
    "#   'percentile' cutoff = the PERCENTILE quantile of the cohort for that code (relative)\n",
    "#   'blr'        borderline regression: fit assessor_score ~ GR over that code's forms,\n",
    "#                read the fitted score at GR = BORDERLINE_GR\n",
    "#   'borderline' borderline group average: mean score of the forms rated GR = BORDERLINE_GR\n",
    "FLAG_METHOD   = 'blr'  # 'percentile', 'blr', or 'borderline'\n",
    "MIN_LOW_COUNT = 3\n",
    "PERCENTILE    = 0.15      # only used by 'percentile'\n",
    "BORDERLINE_GR = 2         # only used by 'blr' and 'borderline'\n",
    "\n",
    "# A student who sits the SAME item code twice is scored on their BEST attempt ('max').\n",
    "AGG = 'max'\n",
    "\n",
    "# Amber cells within this fraction ABOVE the cutoff. 0 = red only.\n",
    "AMBER_MARGIN = 0.0\n",
    "\n",
    "# Which GR / practice-readiness LEVELS to highlight. A full 1-5 gradient over every cell\n",
    "# saturates the sheet, so only the levels worth looking at are coloured and the rest are\n",
    "# left plain. Colours: 'red' | 'amber' | 'green' | 'grey', or an explicit (bg, text) pair.\n",
    "#   {1: 'red', 2: 'amber'}               default — just the low end\n",
    "#   {1: 'red', 2: 'amber', 5: 'green'}   also mark the top level\n",
    "#   [1, 2]                               shorthand, all red\n",
    "#   'scale'                              the old full 1-5 gradient\n",
    "#   None                                 no colouring\n",
    "GR_HIGHLIGHT = {1: 'red', 2: 'amber'}\n",
    "PR_HIGHLIGHT = {1: 'red', 2: 'amber'}\n",
    "\n",
    "# 'assessors' sheet: colour a cell when the student has seen that assessor at least N times.\n",
    "# Highest matching threshold wins. On FP (7 codes, ~4 assessors each) seeing someone twice is\n",
    "# routine — that lit up 49% of the grid — so raise the floor if it reads as noise.\n",
    "#   {2: 'amber', 3: 'red'}   every repeat, escalating at 3\n",
    "#   {3: 'red'}               only genuine over-exposure   <- quieter\n",
    "#   None                     summary columns only, no colouring\n",
    "ASSESSOR_REPEAT_HIGHLIGHT = {2: 'amber', 3: 'red'}\n",
    "\n",
    "# risk_report picks its per-session columns by substring match. DDS2 codes all contain\n",
    "# 'Week'; BOH2 SHY codes are task names ('51B DP (525)') with no shared word, so the risk\n",
    "# report does not currently work for BOH2 — the cell below says so and moves on.\n",
    "# '(' matches every BOH2 SHY task name if you want to try it, but it also drops the\n",
    "# bare-numeric FHY codes (522/531/532), so treat it as experimental.\n",
    "RISK_WEEK_KEYWORD = 'Week' if COHORT == 'DDS2' else None    # None = skip the risk report\n",
    "\n",
    "\n",
    "# ── Per-date weekly workbooks: scale, ordering, styling ──────────────────────\n",
    "# Turned on for BOH2 only for now — flip a cohort here to change it.\n",
    "#   MC scale '1-5'  writes the O-codes as levels, 5 = best, reading the same way round\n",
    "#                   as GR. '0-1' is the original proportion scale (O1=1.00 … O5=0.00).\n",
    "# NOTE these are not linear rescales of each other (O5 is 0.00 vs 1), so the per-item\n",
    "# stats and Cronbach's alpha in the BLR results shift when you switch. Cutoffs and\n",
    "# Pass/Fail read \"Assessor Score\" from SQL, which is always 0-1, so flagging is unchanged.\n",
    "# Changing the scale means REBUILDING the workbooks (skipExisting=False) — the numbers\n",
    "# are baked into the files.\n",
    "WEEKLY_MC_SCALE  = {'BOH2': '1-5'}.get(COHORT, '0-1')\n",
    "WEEKLY_STYLE     = {'BOH2': True}.get(COHORT, True)\n",
    "WEEKLY_ORDER_BY_ROSTER = {'BOH2': True}.get(COHORT, False)\n",
    "\n",
    "# GR colouring on the weekly sheets. Add 'TS','CS','PS','PR','PEC' to grCols in\n",
    "# styleWeeklySheet if you later want the other 1-5 scales treated the same way.\n",
    "WEEKLY_GR_LEVELS = {1: 'red', 2: 'amber', 5: 'green'}\n",
    "# MC colouring — defaults to the low end of whichever scale is active, so it can't\n",
    "# invert when you switch. Override only if you want something else.\n",
    "WEEKLY_MC_LEVELS = WEEKLY_MC_HIGHLIGHT_BY_SCALE.get(WEEKLY_MC_SCALE)\n",
    "\n",
    "\n",
    "# ── Scopes and output paths — defined ONCE, used by cells 39/40/41 ───────────\n",
    "# The writer and the reader must agree on the filename, so both go through scopedPath.\n",
    "def streamScopes():\n",
    "    \"\"\"(scope, key, label): key goes in filenames, label is for printing.\"\"\"\n",
    "    scopes = [(k, k, f\"{k} — {c['name']}\") for k, c in resolveStreams(STREAM, cohort=COHORT)]\n",
    "    if POOLED and len(scopes) > 1:\n",
    "        scopes.append((STREAM, \"POOLED\", \"pooled (all selected streams)\"))\n",
    "    return scopes\n",
    "\n",
    "def scopedPath(name, scope, key, period=None):\n",
    "    \"\"\"'<stream folder>/<cohort> <name> <KEY>.xlsx', + the FHY/SHY suffix if a period is given.\n",
    "\n",
    "    The cohort prefix matters: without it a BOH2 run writes files called 'dds2 ...'.\n",
    "    \"\"\"\n",
    "    root, ext = os.path.splitext(name)\n",
    "    path = os.path.join(weeklySimOutFolder(folder, scope, cohort=COHORT),\n",
    "                        f\"{COHORT.lower()} {root} {key}{ext}\")\n",
    "    return periodSuffixPath(path, period) if period else path\n",
    "\n",
    "\n",
    "# ── What is in the DB, per stream ────────────────────────────────────────────\n",
    "# offWeekday flags a session that did not fall on the stream's usual day — i.e. a\n",
    "# catch-up, which is exactly where the stray item codes come from.\n",
    "for _key, _cfg in resolveStreams(STREAM, cohort=COHORT):\n",
    "    _dates = getWeeklySimDates(engine, minDate=None, stream=_key, cohort=COHORT)\n",
    "    print(f\"\\n{_key} — {_cfg['name']}  ({_cfg['subject']}, {_cfg['weekday']}s\"\n",
    "          f\" from {_cfg['startDate'] or 'start of year'})\"\n",
    "          f\"  ->  {weeklySimFolder(folder, _key, cohort=COHORT)}\")\n",
    "    display(_dates)\n",
    "\n",
    "# ── Global rating distribution for the most recent date ──────────────────────\n",
    "datesDf = getWeeklySimDates(engine, minDate=SEMESTER_SPLIT_DATE, cohort=COHORT)\n",
