    "from boh3_dds4_flagging import *\n",
    "\n",
    "# Count metrics (forms / patients / age / sections): Overall + these groups — any number of groups.\n",
    "flagRotationGroups = [(\"R1-4\", [1, 2, 3, 4]), (\"R5+\", list(range(5, 21)))]\n",
    "# Entrustment / weakness trajectory windows (used by stage 2).\n",
    "flagTrajectoryGroups = [(\"R1-3\", [1, 2, 3]), (\"R4-6\", [4, 5, 6]), (\"R7+\", list(range(7, 21)))]\n",
    "\n",
    "flagMetrics = {}\n",
    "for cohort in targetCohorts:\n",
    "    flagMetrics[cohort] = buildFlaggingMetrics(\n",
    "        engine, cohort,\n",
    "        rotationGroups=flagRotationGroups,\n",
    "        trajectoryGroups=flagTrajectoryGroups,\n",
    "        excludeStudentNumbers=None,     # e.g. EXCLUDED_STUDENT_NUMBERS\n",
    "        minFormsFloor=20,               # under this -> left out of cohort mean/SD, listed in \"insufficient\"\n",
    "        expectedMinShare=0.80,          # section is \"expected\" if >= 80% of students have activity\n",
    "        k=1.5, f=0.5,                   # preview values for windowStats only\n",
    "        outPath=f\"BOH3_DDS4/{cohort}_Flagging_Metrics_Review {today}.xlsx\",\n",
    "    )\n",
    "\n",
    "display(flagMetrics[\"DDS4\"][\"windowStats\"])\n",
    "display(flagMetrics[\"DDS4\"][\"expectedSections\"].query(\"window == 'Overall'\"))\n",
    "display(flagMetrics[\"DDS4\"][\"metricsWide\"].head())\n"
