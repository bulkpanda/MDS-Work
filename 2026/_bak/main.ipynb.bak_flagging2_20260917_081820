    "# ── Build the weekly sim workbooks ───────────────────────────────────────────\n",
    "# One workbook per (stream, date) -> \"DDS2/Weekly Sim/<stream folder>/dds2 <date> assessment_data.xlsx\".\n",
    "# Dates come from the DB, and each stream contributes only its OWN item codes — so a\n",
    "# catch-up FP form filled on a Paeds Monday is written into Fixed Prosthodontics under its\n",
    "# real date, not into the Paeds workbook. Every form is counted exactly once.\n",
    "#   REBUILD      False -> an existing workbook is never overwritten, so this cell is safe\n",
    "#                to re-run every week and only builds what is new. True -> rebuild, which\n",
    "#                you need after changing the MC scale, ordering or styling.\n",
    "#   minForms     leave at 1 for a split build: within a stream a 1-form day is a real\n",
    "#                catch-up, not junk (the junk item codes belong to no stream and are\n",
    "#                excluded automatically, and reported). Raise it only for an unsplit run.\n",
    "#   dryRun       print the plan without writing anything.\n",
    "#   minDate=None -> let each stream's own startDate decide.\n",
    "#   mcScale / styleSheet / roster come from the cohort settings in the cell above.\n",
    "\n",
    "DRY_RUN = False\n",
    "\n",
    "# Overwrite workbooks that already exist. Needed whenever the CONTENT rules change — a new\n",
    "# MC scale, roster ordering, styling — because those are baked into the saved file. With\n",
    "# skipExisting the run just reports 'skipped-exists' and the old workbook stays as it was,\n",
    "# which looks like \"the cell ran but nothing saved\".\n",
    "# CAUTION with STREAM='ALL': this rewrites every stream, semester 1 included. Set STREAM to\n",
    "# a single key (e.g. 'SHY') to rebuild just that folder.\n",
    "REBUILD = False\n",
    "\n",
    "summary = buildWeeklySimReports(\n",
    "    engine,\n",
    "    folder=folder,\n",
    "    stream=STREAM,        # None = legacy unsplit build into the base folder\n",
    "    minDate=None,         # each stream's own startDate applies\n",
    "    maxDate=None,\n",
    "    skipExisting=not REBUILD,\n",
    "    minForms=1,\n",
    "    dryRun=DRY_RUN,\n",
    "    cohort=COHORT,\n",
    "    mcScale=WEEKLY_MC_SCALE,\n",
    "    styleSheet=WEEKLY_STYLE,\n",
    "    grLevels=WEEKLY_GR_LEVELS,\n",
    "    mcLevels=WEEKLY_MC_LEVELS,\n",
    "    roster=roster if WEEKLY_ORDER_BY_ROSTER else None,\n",
    "    includeCodeList=ONLY_CODES,\n",
    ")\n",
    "display(summary)\n",
    "\n",
    "# ── Subject-code mismatch report ─────────────────────────────────────────────\n",
    "# Nothing routes on `subject` — this is purely so the mis-tagged forms can be chased.\n",
    "mismatchDf = getSubjectMismatches(engine, minDate=SEMESTER_SPLIT_DATE, cohort=COHORT)\n",
    "if not mismatchDf.empty:\n",
    "    mismatchPath = os.path.join(folder, f\"{COHORT} subject code mismatches.xlsx\")\n",
    "    with pd.ExcelWriter(mismatchPath, engine=\"openpyxl\") as writer:\n",
    "        mismatchDf.to_excel(writer, sheet_name=\"mismatches\", index=False)\n",
    "        autoFitColumns(writer.sheets[\"mismatches\"])\n",
    "    print(f\"\\n{len(mismatchDf)} form(s) with a subject code that disagrees with the item code \"\n",
    "          f\"-> {mismatchPath}\")\n",
    "    display(mismatchDf.groupby([\"stream\", \"subject\", \"expected_subject\"], dropna=False)\n",
    "                      .size().rename(\"n\").reset_index())\n",
    "else:\n",
    "    print(\"\\nNo subject-code mismatches.\")\n",
    "\n",
    "# ── Other ways to call it ────────────────────────────────────────────────────\n",
    "# one stream only:\n",
