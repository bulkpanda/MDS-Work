# ══ 8. Filters ══════════════════════════════════════════════════════════════
def parseDateTs(s: str, endOfDay: bool = False):
    try:
        dt = datetime.strptime((s or "").strip(), "%Y-%m-%d")
        return (dt.replace(hour=23, minute=59, second=59) if endOfDay else dt).timestamp()
    except ValueError:
        return None


def isExcluded(name: str, hideTest: bool) -> bool:
    n = name.lower()
    return n in cfg.EXCLUDE or (hideTest and any(s in n for s in cfg.EXCLUDE_SUBSTRINGS))


def applyFilters(rows, cohorts, checklist, submittedOnly, unsubmittedOnly, ccOnly, hideTest, search,
                 sortOpt=cfg.DEFAULT_SORT, dateFrom="", dateTo=""):
    """Filter + sort cached rows (no API call)."""
    tsFrom, tsTo = parseDateTs(dateFrom), parseDateTs(dateTo, True)
    cohorts = set(cohorts or [])
    out = [r for r in rows if r["Cohort"] in cohorts
           and (tsFrom is None or r["_ts"] >= tsFrom) and (tsTo is None or r["_ts"] <= tsTo)
           and not isExcluded(r["Student"], hideTest)
           and (not checklist or checklist == "All" or r["Checklist"] == checklist)]
    if submittedOnly:
        out = [r for r in out if r["Submitted"] == "Yes"]
    elif unsubmittedOnly:
        out = [r for r in out if r["Submitted"] == "No"]
    if ccOnly:
        out = [r for r in out if r["CC_int"]]
    q = (search or "").lower().strip()
    if q:
        out = [r for r in out if any(q in str(r.get(k) or "").lower()
                                     for k in ("Student", "Assessor", "Examiner", "Cohort", "Subject", "Checklist", "Comments"))]
    col, desc = cfg.SORT_OPTIONS.get(sortOpt, ("_ts", True))
    if col == "_status":
        out.sort(key=lambda r: (r["_stateRank"], -r["_ts"]))
    elif col in ("_ts", "GR_int", "Pct", "CC_int"):
        out.sort(key=lambda r: float(r.get(col) or 0), reverse=desc)
    else:
        out.sort(key=lambda r: str(r.get(col) or "").lower(), reverse=desc)
    return out


def describeFilters(cohorts, checklist, so, uo, cco, ht, q, srt, df, dt) -> str:
    return ", ".join(x for x in [
        f"cohorts {', '.join(cohorts or [])}", f"checklist {checklist}" if checklist and checklist != "All" else "",
        f"dates {df or '…'} → {dt or '…'}", "submitted only" if so else "", "unsubmitted only" if uo else "",
        "critical concerns only" if cco else "", "dummy/test hidden" if ht else "", f"search '{q}'" if q else ""] if x)


