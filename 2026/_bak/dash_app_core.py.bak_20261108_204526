            if r["CC_int"]:
                return f'<td style="{TD}text-align:center;"><span title="{esc(r["CC"])}" style="background:#fee2e2;color:#dc2626;border-radius:4px;padding:2px 6px;font-size:11px;font-weight:700;">⚠</span></td>'
            return f'<td style="{TD}text-align:center;">' + ('<span style="color:#94a3b8;font-size:11px;">No</span>' if r["CC"] != "—" else DASH) + "</td>"
        if k == "Status":
            return f'<td style="{TD}text-align:center;">{statusCell(r)}</td>'
        if k == "View":
            return (f'<td style="{TD}text-align:center;padding:4px 6px;"><span onclick="openForm(&#39;{esc(r["_id"])}&#39;)" '
                    f'title="View full form" style="cursor:pointer;font-size:13px;color:#6366f1;display:inline-block;padding:2px 5px;'
                    f'border-radius:4px;border:1px solid #e0e7ff;background:#eef2ff;">&#128065;</span></td>')
        return f'<td style="{TD}vertical-align:top;padding-top:6px;">{commentsCell(r["Comments"])}</td>'

    body, last = [], None
    groupN = {s: sum(1 for x in rows if x["Status"] == s) for s in cfg.STATUS_RANK} if grouped else {}
    for i, r in enumerate(rows[:cfg.MAX_ROWS]):
        if grouped and r["Status"] != last:
            last = r["Status"]
            body.append(f'<tr><td colspan="{len(cols)}" style="background:#eef2ff;color:{cfg.NAVY};font-weight:700;font-size:11px;'
                        f'letter-spacing:.4px;text-transform:uppercase;padding:5px 10px;border-bottom:1px solid #c7d2fe;">'
                        f'{last} ({groupN[last]})</td></tr>')
        bg = "#fff5f5" if r["CC_int"] else ("#ffffff" if i % 2 == 0 else "#f8fafc")
        body.append(f'<tr style="background:{bg}">' + "".join(cell(r, c) for c in cols) + "</tr>")
    if len(rows) > cfg.MAX_ROWS:
        body.append(f'<tr><td colspan="{len(cols)}" style="padding:10px;color:#94a3b8;font-size:11px;">Showing {cfg.MAX_ROWS} '
                    f'of {len(rows)} records — narrow with search or filters</td></tr>')
    note = ""
    if tpl and not secs:
        note = (f'<div style="font-size:11px;color:#64748b;padding:2px 4px;">{len(tpl["sections"])} sections — '
                f'shown in the form view and Excel export.</div>')
    elif len(tids) > 1:
        note = ('<div style="font-size:11px;color:#64748b;padding:2px 4px;">Several checklist types in view — pick one in '
                '<b>Checklist</b> to see section columns.</div>')
    return (note + f'<div style="overflow:auto;max-height:{cfg.TABLE_MAX_HEIGHT};border-radius:8px;border:1px solid #e2e8f0;">'
            f'<table style="width:100%;border-collapse:collapse;table-layout:fixed;"><colgroup>{colgroup}</colgroup>'
            f'<thead style="position:sticky;top:0;z-index:1;"><tr>{hdr}</tr></thead><tbody>{"".join(body)}</tbody></table></div>')


def formHtml(row: dict, examKey: str) -> str:
    """Full-form view for the modal (built on demand)."""
    ad, prof = row["_ad"], cfg.PROFILES[row["_profile"]]
    g = row["GR_int"]
    grColor = cfg.GR_COLORS.get(g, "#64748b")
    pctTxt = f'{row["Pct"]}%' if row["Pct"] >= 0 else "—"
    if row.get("_penalty"):
        pctTxt += f' after −{row["_penalty"]:g} penalty, was {row["_pctBase"]}%'
    gp = " · ".join(f"{k} {v:.1f}%" for k, v in row["_groupPct"].items() if v is not None)
    statusTxt = row["Status"] if row["Status"] != "In progress" else \
        f'In progress ({row["_scored"]}/{row["_nItems"]} items scored{", comments started" if row["_hasComments"] else ""})'
    kv = lambda k, v: f'<div><span style="color:#64748b;">{k}:</span> {v}</div>'
    p = [f'<div style="margin-bottom:18px;padding-bottom:12px;border-bottom:2px solid #e2e8f0;">'
         f'<div style="font-size:15px;font-weight:700;color:{cfg.NAVY};margin-bottom:8px;">{esc(cfg.EXAMS[examKey]["title"])} '
         f'&middot; {esc(row["Checklist"])} &middot; {esc(row["Cohort"])} &middot; {esc(row["Subject"])} &middot; {esc(row["Date"])}</div>'
         f'<div style="display:grid;grid-template-columns:1fr 1fr;gap:4px 24px;font-size:12px;">'
         + kv("Student", f"<b>{esc(row['Student'])}</b>") + kv("Assessor", esc(row["Assessor"]))
         + kv("Examiner 2", esc(row["Examiner"])) + kv("Status", f'<b>{esc(statusTxt)}</b>')
         + kv(esc((row["_gr"] or {}).get("name", "GR")), f'<b style="color:{grColor};">{esc(row["GR"])} — {esc(row["GR_label"])}</b>')
         + kv("Overall", f'<b>{row["Total"] if row["Total"] is not None else "—"}/{row["Max"] or "—"} ({pctTxt})</b>'
              + (f' <span style="color:#64748b;">[{esc(gp)}]</span>' if gp else ""))
         + "".join(kv(esc(s["name"]), f'{s["value"] if s["value"] is not None else "—"} — {esc(s["label"])}') for s in row["_extraScales"])
         + kv("Scoring", esc(prof["title"])) + "</div></div>"]

    def banner(color, bg, title, text):
        p.append(f'<div style="margin-bottom:14px;padding:9px 12px;border:1px solid {color}55;border-radius:6px;background:{bg};'
                 f'color:{color};font-size:12px;"><b>{title}</b> {esc(text)}</div>')
    if row["_missing"]:
        banner("#b45309", "#fffbeb", "⚠ Not in this form:", row["Missing"])
    if row["_incomplete"]:
        banner("#b45309", "#fffbeb", "⚠ Submitted but incomplete:", "; ".join(row["_incomplete"]))
    if row.get("_overrideNote"):
        banner("#b91c1c", "#fff5f5", "Override:", row["_overrideNote"])

    multi = len({it["ck"] for it in row["_items"]}) > 1
    for s in row["_sec"].values():
        its = [it for it in row["_items"] if it["secKey"] == s["key"]]
        right = f'{s["score"]:g}/{s["max"]:g} · {s["pct"]:.1f}%' if s["pct"] is not None else ("not in form" if not s["present"] else "—")
        p.append(f'<div style="margin-bottom:18px;"><div style="display:flex;justify-content:space-between;gap:12px;'
                 f'background:{cfg.NAVY if s["present"] else "#b45309"};color:#e0e7ff;padding:7px 12px;border-radius:6px;margin-bottom:6px;">'
                 f'<span style="font-weight:600;font-size:13px;">{esc(s["short"])} · {esc(s["name"])}</span>'
                 f'<span style="font-size:12px;opacity:.85;white-space:nowrap;">{right}</span></div>')
        lastSub = None
        for it in its:
            if it["sub"] and it["sub"] != lastSub:
                lastSub = it["sub"]
                p.append(f'<div style="font-size:11px;font-weight:700;color:{cfg.PURPLE};padding:6px 8px 2px;">{esc(it["sub"])}</div>')
            frac = (it["points"] / it["max"]) if it["points"] is not None and it["max"] else None
            col = pctColor(100 * frac) if frac is not None else "#64748b"
            p.append(f'<div style="display:flex;justify-content:space-between;align-items:flex-start;padding:4px 8px;'
                     f'border-bottom:1px solid #f1f5f9;font-size:12px;"><span style="color:#475569;flex:1;padding-right:12px;">'
                     f'<b>{esc(it["mc"])}</b> {esc(it["question"])}</span><span style="color:{col};font-weight:600;text-align:right;'
                     f'max-width:45%;">{esc(it["disp"] or "—")} <span style="color:#94a3b8;font-weight:400;">'
                     f'({it["points"] if it["points"] is not None else "—"}/{it["max"] if it["max"] is not None else "—"})</span></span></div>')
        ckc = (ad.get(f'{s["key"]}_comments') or "").strip() if multi else ""
        if ckc:
            p.append(f'<div style="margin-top:6px;padding:5px 8px;background:#f8fafc;border-left:3px solid #c7d2fe;font-size:12px;">'
                     f'<span style="color:#64748b;font-weight:600;">Comments: </span><span style="color:#475569;">{esc(ckc)}</span></div>')
        p.append("</div>")
    if not multi:
        for k, v in ad.items():
            if k.endswith("_comments") and k != "critical_concerns_comments" and isinstance(v, str) and v.strip():
                p.append(f'<div style="margin-bottom:10px;padding:5px 8px;background:#f8fafc;border-left:3px solid #c7d2fe;font-size:12px;">'
                         f'<span style="color:#64748b;font-weight:600;">{esc(k.replace("_comments", ""))} comments: </span>'
                         f'<span style="color:#475569;">{esc(v)}</span></div>')

    isCC = row["CC_int"] == 1
    critBits = [("Critical concerns", ad.get("critical_concerns_comments")), ("Critical error", ad.get("critical_error")),
                ("Clinical incident", ad.get("clinical_incident"))]
    critTxt = "<br>".join(f"<b>{k}:</b> {esc(v)}" for k, v in critBits if meaningful(v)) or "<i>None recorded</i>"
    p.append(f'<div style="margin-bottom:12px;padding:9px 12px;border:1px solid {"#fecaca" if isCC else "#e2e8f0"};border-radius:6px;'
             f'background:{"#fff5f5" if isCC else "#fff"};"><div style="font-weight:600;color:{"#dc2626" if isCC else "#334155"};'
             f'font-size:11px;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">Critical concerns: {esc(row["CC"])}</div>'
             f'<div style="font-size:12px;color:#334155;">{critTxt}</div></div>')
    gen = (ad.get("comments") or "").strip()
    p.append(f'<div style="padding:9px 12px;border:1px solid #e2e8f0;border-radius:6px;"><div style="font-weight:600;color:#334155;'
             f'font-size:11px;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">General comments</div>'
             f'<div style="font-size:12px;color:#475569;">{esc(gen) if gen else "<i>None provided</i>"}</div></div>')
    return "".join(p)


