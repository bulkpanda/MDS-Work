"""
dash_app_core.py — data layer + rendering for dash_app.py.

  env/token/API → per-exam shared cache → generic parser/scorer (reads each form's own rubric, options,
  headers and scales) → filters → overrides → HTML (stat cards, table, on-demand form view).
Exam-specific behaviour lives only in dash_app_config.EXAMS / PROFILES.
"""
import os, re, json, time, hashlib, threading, html
from collections import OrderedDict
from datetime import datetime
from pathlib import Path
from urllib.parse import urlencode

import requests
import dash_app_config as cfg

APP_DIR = Path(__file__).resolve().parent


# ══ 1. Environment + auth ═══════════════════════════════════════════════════
def readEnvFile(path: Path) -> dict:
    """KEY=VALUE lines from .env; file values win over stale shell/Windows env vars."""
    out = {}
    try:
        for line in path.read_text(encoding="utf-8-sig").splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip().strip("'\"")
    except FileNotFoundError:
        pass
    return out


ENV_FILE = readEnvFile(APP_DIR / ".env")


def envVal(key: str) -> str:
    """.env value, else OS env, quotes stripped."""
    return (ENV_FILE.get(key) or os.getenv(key, "") or "").strip().strip("'\"")


DASH_EMAIL, DASH_PASSWORD, ENV_TOKEN = envVal("DASH_EMAIL"), envVal("DASH_PASSWORD"), envVal("DASH_TOKEN")
LOGIN_USER = envVal("DASH_APP_USERNAME") or envVal("CBD_USERNAME")     # app login gate (blank = no gate)
LOGIN_PASS = envVal("DASH_APP_PASSWORD") or envVal("CBD_PASSWORD")

tokenState, tokenLock = {"token": None}, threading.Lock()


def getToken(force: bool = False) -> str:
    """POST /accounts/login with DASH_EMAIL/DASH_PASSWORD; cached; force=True re-logs in. Never logs credentials."""
    with tokenLock:
        if tokenState["token"] and not force:
            return tokenState["token"]
        if not (DASH_EMAIL and DASH_PASSWORD):
            if ENV_TOKEN:
                return ENV_TOKEN
            raise RuntimeError("DASH_EMAIL / DASH_PASSWORD not set in .env")
        resp = requests.post(f"{cfg.API_BASE}/accounts/login",
                             json={"email": DASH_EMAIL, "password": DASH_PASSWORD}, timeout=60)
        print(f"[DASH] login status={resp.status_code}", flush=True)
        resp.raise_for_status()
        tokenState["token"] = resp.json()["result"]["user"]["token"]
        return tokenState["token"]


def fetchAll(endpoint: str, cohorts: list, token: str) -> list:
    """GET /assessment/<endpoint>/get, all pages (DRF Token auth)."""
    params = urlencode({"page_size": cfg.PAGE_SIZE, "page": 1, "cohort": ",".join(cohorts),
                        "year": cfg.YEAR, "ordering": "id"})
    url, headers, records = f"{cfg.API_BASE}/assessment/{endpoint}/get?{params}", {"Authorization": f"Token {token}"}, []
    while url:
        resp = requests.get(url, headers=headers, timeout=60)
        resp.raise_for_status()
        d = resp.json()
        if isinstance(d, list):
            records.extend(d); url = None
        else:
            records.extend(d.get("results", [])); url = d.get("next")
    print(f"[DASH] {endpoint}: {len(records)} records ({','.join(cohorts)}, {cfg.YEAR})", flush=True)
    return records


def loadRaw(examKey: str) -> list:
    """All cohorts of one exam: live API (re-login once on 400/401/403), or LOCAL_JSON_DIR file for offline tests."""
    exam = cfg.EXAMS[examKey]
    if cfg.LOCAL_JSON_DIR:
        base = Path(cfg.LOCAL_JSON_DIR)
        base = base if base.is_absolute() else APP_DIR / base
        raw = json.load(open(base / f"temp {cfg.YEAR} {exam['endpoint']}.json", encoding="utf-8"))
        raw = raw.get("results", raw) if isinstance(raw, dict) else raw
        return [r for r in raw if r.get("cohort") in exam["cohorts"]]
    try:
        return fetchAll(exam["endpoint"], exam["cohorts"], getToken())
    except requests.HTTPError as e:
        if e.response is not None and e.response.status_code in (400, 401, 403):
            return fetchAll(exam["endpoint"], exam["cohorts"], getToken(force=True))
        raise


def httpErrorMsg(e, endpoint: str) -> str:
    code = e.response.status_code if e.response is not None else "?"
    return {401: "❌ Unauthorised — check DASH credentials",
            403: f"❌ Forbidden — account may lack {endpoint} permissions",
            404: f"❌ 404 — /assessment/{endpoint}/get not found"}.get(code, f"❌ HTTP {code} from API")


# ══ 2. Generic form reading ═════════════════════════════════════════════════
def esc(s) -> str:
    return html.escape(str(s if s is not None else ""), quote=True)


def cleanText(s) -> str:
    """Strip HTML tags + collapse whitespace."""
    return " ".join(re.sub(r"<[^>]+>", " ", str(s or "")).split())


def natKey(k):
    """Natural sort key: MC2 < MC10, d1-dds4 < d2-dds4."""
    return [int(x) if x.isdigit() else x.lower() for x in re.split(r"(\d+)", str(k))]


def slotNum(o: str) -> int:
    return int(o[1:]) if str(o)[1:].isdigit() else 99


def isSlot(k) -> bool:
    return bool(re.fullmatch(r"O\d+", str(k)))


def optionLabels(meta: dict) -> dict:
    """{O1: label, …} from extra_config.options.assessor (student as fallback)."""
    opts = ((meta or {}).get("extra_config") or {}).get("options") or {}
    o = opts.get("assessor") or opts.get("student") or {}
    return {k: str(v or "").strip() for k, v in o.items() if isSlot(k)}


def rubricOf(meta: dict, mc: str) -> dict:
    return (((meta or {}).get("extra_config") or {}).get("rubric") or {}).get(mc) or {}


def enabledSlots(meta: dict, mc: str) -> list:
    """Options shown for this item (non-empty rubric slots; all options when there is no rubric), best first."""
    rub = rubricOf(meta, mc)
    en = [k for k, v in rub.items() if isSlot(k) and str(v or "").strip()]
    if not en:
        en = [k for k, v in optionLabels(meta).items() if v]
    return sorted(en, key=slotNum)


def findSlot(value: str, optLbl: dict, rub: dict):
    """Stored answer → O-slot (matches option label, then rubric label, then a literal O-code)."""
    v = value.strip().lower()
    for o, lbl in optLbl.items():
        if lbl.lower() == v:
            return o
    for o, lbl in rub.items():
        if isSlot(o) and str(lbl or "").strip().lower() == v:
            return o
    return value.strip().upper() if re.fullmatch(r"o\d+", v) else None


def slotPoints(slot: str, enabled: list, optLbl: dict, rub: dict, profile: dict) -> int:
    """Points for a slot under the profile's points method."""
    kind = profile["points"]
    if kind == "labelMap":
        lm = profile["labelMap"]
        for lbl in (optLbl.get(slot, ""), str(rub.get(slot) or "")):
            p = lm.get(lbl.strip().lower())
            if p is not None:
                return p
        nOpts = len([v for v in optLbl.values() if v]) or len(enabled)   # custom label → by slot (best = n−1)
        return max(0, nOpts - slotNum(slot))
    rank = enabled.index(slot) if slot in enabled else len(enabled) - 1
    if kind == "levels":
        scheme = cfg.LEVEL_SCHEMES.get(len(enabled)) or list(range(len(enabled)))
        return list(reversed(scheme))[rank]
    return len(enabled) - 1 - rank                                       # "slot": linear


def scoreItem(value, meta: dict, mc: str, profile: dict):
    """(points | None, itemMax | None, display label). Display = stored label + rubric wording when it differs."""
    optLbl, rub = optionLabels(meta), rubricOf(meta, mc)
    enabled = enabledSlots(meta, mc)
    val = str(value or "").strip()
    slot = findSlot(val, optLbl, rub) if val else None
    if slot and slot not in enabled and profile["points"] != "labelMap":
        enabled = sorted(enabled + [slot], key=slotNum)                  # answer outside rubric → still counted
    pts = {o: slotPoints(o, enabled, optLbl, rub, profile) for o in enabled}
    itemMax = max(pts.values()) if pts else None
    itemMax = itemMax if itemMax else None
    if not val:
        return None, itemMax, ""
    if slot:
        p = pts.get(slot, slotPoints(slot, enabled, optLbl, rub, profile))
    else:
        p = (profile.get("labelMap") or {}).get(val.lower())
        if p is None:
            m = re.search(r"\((\d+)\)", val)                             # e.g. "Good (3)"
            p = int(m.group(1)) if m else None
    rubLbl = cleanText(rub.get(slot)) if slot else ""
    disp = val + (f" · {rubLbl}" if rubLbl and rubLbl.lower() != val.lower() and len(rubLbl) < 60 else "")
    return p, itemMax, disp


def headerTitles(meta: dict, mc: str) -> list:
    hd = ((meta or {}).get("extra_config") or {}).get("headers") or {}
    v = hd.get(mc)
    return [cleanText(t.get("title")) for t in (v if isinstance(v, list) else []) if cleanText(t.get("title"))]


def sectionMap(meta: dict, mcs: list, fallback: str) -> dict:
    """{mc: (section, subsection)} from checklist headers. Multi-level headers ([top, sub]) → sections = tops."""
    hd = ((meta or {}).get("extra_config") or {}).get("headers") or {}
    multi = any(len(headerTitles(meta, k)) > 1 for k in hd)
    top, sub, out = None, None, {}
    for mc in mcs:
        ts = headerTitles(meta, mc)
        if ts:
            if multi:
                if len(ts) > 1:
                    top, sub = ts[0], ts[-1]
                else:
                    sub = ts[0]
            else:
                top, sub = ts[0], None
        out[mc] = (top or fallback, sub)
    return out


def shortLabel(title: str, idx: int) -> str:
    """Compact column label: 'DOMAIN 2: …'→D2, 'Oral Medicine – Case Scenario 1'→OM1, '3. Treatment…'→S3."""
    t = cleanText(title)
    m = re.search(r"\bdomain\s*(\d+)", t, re.I)
    if m:
        return f"D{m.group(1)}"
    om, osg = "oral medicine" in t.lower(), "oral surgery" in t.lower()
    if om or osg:
        m = re.search(r"case scenario\s*(\d+)", t, re.I)
        return ("OM" if om else "OS") + (m.group(1) if m else "")
    m = re.match(r"^\s*(\d+)\s*[.):\-]", t)
    if m:
        return f"S{m.group(1)}"
    m = re.match(r"^\s*section\s+([A-Z0-9])\b", t, re.I)
    return f"S{m.group(1).upper()}" if m else f"S{idx}"


def shortList(names: list) -> list:
    """Unique short labels for an ordered list of section names."""
    out = []
    for i, nm in enumerate(names, 1):
        s = shortLabel(nm, i)
        out.append(s if s not in out else f"S{i}")
    return out


def headerTops(meta: dict, mcs: list, fallback: str) -> list:
    """Ordered distinct section names of one checklist."""
    return list(OrderedDict((top, None) for top, _ in sectionMap(meta, mcs, fallback).values())) or [fallback]


def mcKeysOf(meta: dict, answers: dict) -> list:
    keys = [k for k in ((meta or {}).get("fields") or {}) if str(k).startswith("MC")]
    keys = keys or [k for k in (answers or {}) if str(k).startswith("MC")]
    return sorted(keys, key=natKey)


def isRichMeta(meta: dict) -> bool:
    return bool(optionLabels(meta)) and bool((meta or {}).get("fields"))


# ══ 3. Templates (which checklists belong together) + profile choice ═════════
def chooseProfile(exam: dict, metas: dict) -> str:
    """First matching profileRule on the template's checklist metadata, else the exam default."""
    for rule in exam.get("profileRules", []):
        for key, meta in metas.items():
            opts = {v.lower() for v in optionLabels(meta).values()}
            titles = [t for mc in (((meta.get("extra_config") or {}).get("headers")) or {}) for t in headerTitles(meta, mc)]
            if (("optionsAny" in rule and opts & set(rule["optionsAny"]))
                    or ("headerRegex" in rule and any(re.search(rule["headerRegex"], t, re.I) for t in titles))
                    or ("keyRegex" in rule and re.search(rule["keyRegex"], key))):
                return rule["profile"]
    return exam["defaultProfile"]


def templateLabel(keys: list, metas: dict) -> str:
    if len(keys) == 1:
        return keys[0]
    pre = os.path.commonprefix(keys)
    suf = os.path.commonprefix([k[::-1] for k in keys])[::-1]
    lbl = re.sub(r"^[\W_]+|[\W_]+$", "", pre if len(pre) >= len(suf) else suf)
    return (lbl.upper() if lbl else "+".join(keys)) + f" ({len(keys)} parts)"


def buildTemplates(raw: list, examKey: str) -> tuple:
    """Group checklist keys that appear on the same forms (union-find) → templates; richest meta per key."""
    exam, parent, metas = cfg.EXAMS[examKey], {}, {}

    def root(k):
        parent.setdefault(k, k)
        while parent[k] != k:
            parent[k] = parent[parent[k]]; k = parent[k]
        return k

    for r in sorted(raw, key=lambda x: x.get("datetime") or ""):          # newest meta wins
        cl = ((r.get("form") or {}).get("checklists") or {}) if isinstance(r.get("form"), dict) else {}
        keys = [k for k, v in cl.items() if isinstance(v, dict)]
        for k in keys:
            if isRichMeta(cl[k]) or k not in metas:
                metas[k] = cl[k]
            parent[root(k)] = root(keys[0])
    groups = {}
    for k in parent:
        groups.setdefault(root(k), []).append(k)
    templates, keyToTid = {}, {}
    for keys in groups.values():
        keys = sorted(keys, key=natKey)
        tid = "|".join(keys)
        tMetas = {k: metas.get(k, {}) for k in keys}
        multi = len(keys) > 1
        if multi:                                                          # sections = checklists (key = checklist key)
            names = [cleanText(tMetas[k].get("name")) or k for k in keys]
            shorts = [(k, nm, s) for k, nm, s in zip(keys, names, shortList(names))]
        else:                                                              # sections = header blocks (key = short label)
            m = tMetas[keys[0]]
            names = headerTops(m, mcKeysOf(m, {}), cleanText(m.get("name")) or keys[0])
            shorts = [(s, nm, s) for nm, s in zip(names, shortList(names))]
        templates[tid] = {"id": tid, "keys": keys, "multi": multi, "metas": tMetas, "sections": shorts,
                          "label": templateLabel(keys, tMetas), "profile": chooseProfile(exam, tMetas)}
        for k in keys:
            keyToTid[k] = tid
    return templates, keyToTid


# ══ 4. Aggregation ══════════════════════════════════════════════════════════
def aggregate(items: list, unansweredAsZero: bool, method: str) -> dict:
    """Section/overall maths over item dicts {points, max}."""
    use = [it for it in items if it["max"] and (unansweredAsZero or it["points"] is not None)]
    score = sum(it["points"] or 0 for it in use)
    mx = sum(it["max"] for it in use)
    if method == "itemMean":
        pct = 100 * sum((it["points"] or 0) / it["max"] for it in use) / len(use) if use else None
    else:
        pct = 100 * score / mx if mx else None
    return {"score": score, "max": mx, "pct": pct,
            "answered": sum(1 for it in items if it["points"] is not None), "n": len(items)}


def overallPct(sections: OrderedDict, items: list, profile: dict):
    """(Overall %, {group: %}) per profile['overall']."""
    o, uz = profile["overall"], profile["unansweredAsZero"]
    if o in ("raw", "item"):
        return aggregate(items, uz, "pooled" if o == "raw" else "itemMean")["pct"], {}
    if o == "sections":
        weights = profile.get("weights")
        secs = list(sections.values())
        if not any(s["pct"] is not None for s in secs):
            return None, {}
        w = {s["short"]: (weights.get(s["short"], 0.0) if weights else 1.0) for s in secs}
        keep = secs if profile.get("missingAsZero", True) else [s for s in secs if s["pct"] is not None]
        den = sum(w[s["short"]] for s in keep)
        return (sum(w[s["short"]] * (s["pct"] or 0) for s in keep) / den if den else None), {}
    if o == "groups":
        res = {}
        for label, rx, method, wt in profile["groups"]:
            its = [it for it in items if re.search(rx, it["section"], re.I)]
            if its:
                res[label] = (aggregate(its, uz, method)["pct"], wt)
        got = {k: v for k, v in res.items() if v[0] is not None}
        den = sum(w for _, w in got.values())
        return (sum(p * w for p, w in got.values()) / den if den else None), {k: v[0] for k, v in res.items()}
    raise ValueError(f"unknown overall mode {o}")


# ══ 5. Parse ════════════════════════════════════════════════════════════════
def meaningful(txt) -> bool:
    t = str(txt or "").strip().lower()
    return bool(t) and t not in {"none", "no", "nil", "n/a", "na", "-", "—", "nothing"}


def readScales(ad: dict, scales: dict, exam: dict):
    """Primary GR (preferred scale keys first) + other scales. Labels come from the form's own scale fields."""
    keys = [k for k in exam.get("grScales", []) if k in scales or k in ad]
    keys += [k for k in list(scales) + [k for k in ad if str(k).startswith("scale")] if k not in keys]
    out = []
    for k in OrderedDict.fromkeys(keys):
        try:
            v = int((ad.get(k) or {}).get("scale"))
        except (TypeError, ValueError, AttributeError):
            v = None
        sc = scales.get(k) or {}
        out.append({"key": k, "name": sc.get("name") or k, "value": v,
                    "label": (sc.get("fields") or {}).get(str(v), "") if v is not None else "",
                    "levels": len(sc.get("fields") or {}) or 5, "fields": sc.get("fields") or {}})
    prim = next((s for s in out if s["value"] is not None), out[0] if out else None)
    return prim, [s for s in out if s is not prim]


def buildComments(ad: dict, tpl, shortOf: dict) -> str:
    """'[Label] text' lines: general, per-checklist, other *_comments, critical fields."""
    parts = []
    if (ad.get("comments") or "").strip():
        parts.append(f"[General] {ad['comments'].strip()}")
    done = {"comments", "critical_concerns_comments"}
    for ck in (tpl["keys"] if tpl else []):
        v = (ad.get(f"{ck}_comments") or "").strip()
        done.add(f"{ck}_comments")
        if v:
            parts.append(f"[{shortOf.get(ck, ck)}] {v}")
    for k, v in ad.items():
        if k.endswith("comments") and k not in done and isinstance(v, str) and v.strip():
            parts.append(f"[{k.replace('_comments', '')}] {v.strip()}")
    cc, ccTxt = (ad.get("critical_concerns") or "").strip(), (ad.get("critical_concerns_comments") or "").strip()
    if cc.lower() == "yes" or ccTxt:
        parts.append(f"[Critical Concerns: {cc or '—'}] {ccTxt}")
    for fld, lbl in (("critical_error", "Critical Error"), ("clinical_incident", "Clinical Incident")):
        if meaningful(ad.get(fld)):
            parts.append(f"[{lbl}] {str(ad[fld]).strip()}")
    return "\n".join(parts) if parts else "—"


def parseRecord(r: dict, examKey: str, templates: dict, keyToTid: dict):
    """One raw DASH record → flat row (private keys start with _)."""
    exam = cfg.EXAMS[examKey]
    student = (r.get("student") or "").strip()
    if not student:
        return None
    frm = r.get("form") if isinstance(r.get("form"), dict) else {}
    ad = (frm.get("data") or {}).get("assessor") or {}
    cl = frm.get("checklists") or {}
    tid = next((keyToTid[k] for k in cl if k in keyToTid), None)
    tpl = templates.get(tid)
    profile = cfg.PROFILES[tpl["profile"] if tpl else exam["defaultProfile"]]

    items, sections = [], OrderedDict()
    if tpl:
        secInfo = {sk: (nm, s) for sk, nm, s in tpl["sections"]}
        for ck in tpl["keys"]:
            meta = cl.get(ck)
            if meta is None:
                continue
            answers = ad.get(ck) if isinstance(ad.get(ck), dict) else {}
            mcs = mcKeysOf(meta, answers)
            fields = meta.get("fields") or {}
            if tpl["multi"]:
                smap = {mc: (ck, None) for mc in mcs}
            else:                                                       # this form's own headers → short keys
                fb = cleanText(meta.get("name")) or ck
                sm = sectionMap(meta, mcs, fb)
                tops = headerTops(meta, mcs, fb)
                keyOf = dict(zip(tops, shortList(tops)))
                smap = {mc: (keyOf[top], sub) for mc, (top, sub) in sm.items()}
                for top in tops:
                    secInfo.setdefault(keyOf[top], (top, keyOf[top]))
            for mc in mcs:
                p, mx, disp = scoreItem(answers.get(mc), meta, mc, profile)
                secKey, sub = smap[mc]
                items.append({"ck": ck, "mc": mc, "secKey": secKey, "sub": sub, "points": p, "max": mx,
                              "value": str(answers.get(mc) or "").strip(), "disp": disp,
                              "question": cleanText(fields.get(mc)),
                              "section": secInfo.get(secKey, (secKey,))[0]})
        order = [sk for sk, _, _ in tpl["sections"]] + [it["secKey"] for it in items]
        for i, sk in enumerate(OrderedDict.fromkeys(order), 1):
            nm, short = secInfo.get(sk, (sk, sk))
            its = [it for it in items if it["secKey"] == sk]
            present = (sk in cl) if tpl["multi"] else bool(its)
            agg = aggregate(its, profile["unansweredAsZero"], profile["sectionPct"]) if its else \
                {"score": None, "max": None, "pct": None, "answered": 0, "n": 0}
            sections[sk] = {"key": sk, "name": nm, "short": short, "present": present, **agg}
    anyAnswer = any(it["points"] is not None for it in items)              # nothing scored yet → blank, not 0%
    pct, groupPct = overallPct(sections, items, profile) if anyAnswer else (None, {})

    gr, extraScales = readScales(ad, frm.get("scales") or {}, exam)
    grInt = gr["value"] if gr else None
    dtStr = r.get("datetime") or ""
    try:
        dt = datetime.fromisoformat(dtStr.replace("Z", "+00:00")).astimezone()
        dtDisplay, ts = f"{dt.day} {dt:%b %H:%M}", dt.timestamp()
    except Exception:
        dtDisplay, ts = dtStr or "—", 0.0

    cc = (ad.get("critical_concerns") or "").strip()
    ccFlag = cc.lower() == "yes" or meaningful(ad.get("critical_error")) or meaningful(ad.get("clinical_incident"))
    ccDisp = cc or ("Yes" if ccFlag else "—")
    missing = [s["short"] for s in sections.values() if not s["present"]]
    scored = sum(1 for it in items if it["points"] is not None or it["value"])
    hasComments = any(isinstance(v, str) and v.strip() for k, v in ad.items() if k.endswith("comments"))
    hasOther = grInt is not None or bool(cc) or meaningful(ad.get("critical_error"))
    submitted = bool(r.get("submitted"))
    status = "Submitted" if submitted else ("In progress" if (scored or hasComments or hasOther) else "Not started")
    incomplete = []                                                          # submitted but not fully filled
    if submitted:
        if grInt is None:
            incomplete.append("GR")
        if missing:
            incomplete.append("not in form: " + ", ".join(missing))
        blanks = [it for it in items if not it["value"] and it["max"]]
        if blanks:
            incomplete.append(f"{len(blanks)} item(s) blank")
        if tpl and not items:
            incomplete.append("checklist empty")

    ex2 = frm.get("examiner_2")
    examiner = ex2.strip() if isinstance(ex2, str) and ex2.strip() else \
        (f"Examiner {frm.get('examiner')}" if frm.get("examiner") not in (None, "") else "—")
    shortOf = {sk: s for sk, _, s in tpl["sections"]} if tpl and tpl["multi"] else {}
    tot = sum(s["score"] or 0 for s in sections.values()) if anyAnswer else None
    mxTot = sum(s["max"] or 0 for s in sections.values()) if anyAnswer else None
    return {
        "_id": r.get("id"), "_ts": ts, "_tid": tid, "_profile": tpl["profile"] if tpl else exam["defaultProfile"],
        "_sec": sections, "_items": items, "_groupPct": groupPct, "_missing": missing, "_incomplete": incomplete,
        "_scored": scored, "_nItems": len(items), "_hasComments": hasComments, "_stateRank": cfg.STATUS_RANK[status],
        "_ad": ad, "_gr": gr, "_extraScales": extraScales,
        "Date": dtDisplay, "Student": student, "Assessor": (r.get("assessor") or "—").strip() or "—",
        "Examiner": examiner, "Cohort": r.get("cohort") or "—", "Subject": r.get("subject") or "—",
        "Checklist": tpl["label"] if tpl else "—",
        "GR": str(grInt) if grInt is not None else "—", "GR_int": grInt if grInt is not None else -1,
        "GR_label": (gr["label"] if gr else "") or "—",
        "Total": round(tot, 2) if tot is not None else None, "Max": round(mxTot, 2) if mxTot else None,
        "Pct": round(pct, 1) if pct is not None else -1,
        "CC": ccDisp, "CC_int": 1 if ccFlag else 0,
        "Submitted": "Yes" if submitted else "No", "Status": status,
        "Comments": buildComments(ad, tpl, shortOf), "Missing": ", ".join(missing) or "—",
    }


def parseRecords(raw: list, examKey: str) -> tuple:
    templates, keyToTid = buildTemplates(raw, examKey)
    rows = [x for x in (parseRecord(r, examKey, templates, keyToTid) for r in raw) if x]
    return rows, templates


# ══ 6. Manual overrides (<exam>_overrides.json, re-read live) ════════════════
def normName(s: str) -> str:
    """Case/space-insensitive; drops bracketed nicknames: 'Yue Heng Xu (Kevin)' → 'yue heng xu'."""
    return " ".join(re.sub(r"\(.*?\)", " ", s or "").lower().split())


class OverrideStore:
    """Penalties per student/form + ignoreAssessors, reloaded when the file's mtime changes."""

    def __init__(self, examKey: str):
        self.path = APP_DIR / f"{examKey.lower()}{cfg.OVERRIDES_SUFFIX}"
        self.mtime, self.items, self.ignore, self.error = "unset", [], set(), ""

    def load(self) -> bool:
        try:
            mt = self.path.stat().st_mtime
        except FileNotFoundError:
            mt = None
        if mt == self.mtime:
            return False
        self.mtime = mt
        try:
            data = json.load(open(self.path, encoding="utf-8")) if mt else {}
            self.items = [o for o in data.get("overrides", []) if isinstance(o, dict)]
            self.ignore = {normName(a) for a in data.get("ignoreAssessors", []) if a}
            self.error = ""
        except Exception as e:                                             # bad JSON → keep last good
            self.error = f"❌ {self.path.name} not applied ({e}) — previous overrides kept"
        return True

    @staticmethod
    def matches(o: dict, r: dict) -> bool:
        hasStudent, hasForm = bool(o.get("student")), o.get("formId") not in (None, "")
        if not (hasStudent or hasForm):
            return False
        if hasForm and str(o["formId"]) != str(r["_id"]):
            return False
        return not hasStudent or normName(o["student"]) == normName(r["Student"])

    def apply(self, rows: list) -> list:
        """Reset each row to its computed % then apply penalties (idempotent); returns unmatched labels."""
        used = set()
        for r in rows:
            r.setdefault("_pctBase", r["Pct"])
            r["Pct"], r["_penalty"], r["_overrideNote"] = r["_pctBase"], 0.0, ""
            notes = []
            for i, o in enumerate(self.items):
                if not self.matches(o, r):
                    continue
                used.add(i)
                pen = float(o.get("penaltyPct") or 0)
                if r["_pctBase"] < 0 or not pen:
                    continue
                relative = str(o.get("method", "absolute")).strip().lower() == "relative"
                r["Pct"] = round(max(0.0, r["Pct"] * (1 - pen / 100) if relative else r["Pct"] - pen), 1)
                r["_penalty"] += pen
                notes.append(f'−{pen:g}{"% of score" if relative else " percentage points"}'
                             f'{" — " + o["reason"] if o.get("reason") else ""}{" (by " + o["by"] + ")" if o.get("by") else ""}')
            if notes:
                r["_overrideNote"] = (f'Manual override: {"; ".join(notes)}. Overall % {r["_pctBase"]}% → {r["Pct"]}%. '
                                      f'Raw total unchanged.')
            r["_ignored"] = normName(r["Assessor"]) in self.ignore
        seen = {normName(r["Assessor"]) for r in rows}
        return ([o.get("student") or f'form {o.get("formId")}' for i, o in enumerate(self.items) if i not in used]
                + [f"assessor '{a}'" for a in sorted(self.ignore - seen)])


# ══ 7. Shared per-exam cache ════════════════════════════════════════════════
class ExamCache:
    """One DASH pull per CACHE_TTL for ALL browser tabs; re-parse only when the payload hash changes."""

    def __init__(self, examKey: str):
        self.key, self.lock = examKey, threading.Lock()
        self.rows, self.templates, self.hash, self.version = [], {}, None, 0
        self.fetchedAt, self.error, self.unmatched = 0.0, "", []
        self.overrides = OverrideStore(examKey)

    def get(self, force: bool = False):
        """(rows, version, message); fetches only when stale/forced."""
        with self.lock:
            newData = False
            if force or time.time() - self.fetchedAt >= cfg.CACHE_TTL:
                t0 = time.time()
                try:
                    raw = loadRaw(self.key)
                    h = hashlib.md5(json.dumps(raw, sort_keys=True, default=str).encode()).hexdigest()
                    if h != self.hash:
                        self.rows, self.templates = parseRecords(raw, self.key)
                        self.hash, self.version, newData = h, self.version + 1, True
                    self.error = ""
                except requests.HTTPError as e:
                    self.error = httpErrorMsg(e, cfg.EXAMS[self.key]["endpoint"])
                except Exception as e:
                    self.error = f"❌ Load error: {e}"
                if self.error and self.rows:
                    self.error += " (showing last good data)"
                self.fetchedAt = time.time()                              # also on failure → no hammering
                print(f"[DASH] {self.key} refresh {time.time() - t0:.2f}s v{self.version} rows={len(self.rows)} "
                      f"{self.error}", flush=True)
            if self.overrides.load() or newData:
                self.unmatched = self.overrides.apply(self.rows)
                self.version += 0 if newData else 1
            msgs = [self.error, self.overrides.error]
            if self.unmatched:
                msgs.append("⚠ Override not matched: " + ", ".join(self.unmatched))
            return self.rows, self.version, " · ".join(m for m in msgs if m)

    def asOf(self) -> str:
        fa = datetime.fromtimestamp(self.fetchedAt) if self.fetchedAt else datetime.now()
        return f"*{self.key} data as of {fa:%H:%M:%S}{' (local JSON)' if cfg.LOCAL_JSON_DIR else ''}*"


