# ═══════════════════════════════════════════════════════════════════════════
# FlaggingConfig
# ═══════════════════════════════════════════════════════════════════════════
class FlaggingConfig:
    """
    Full specification for a flagging run: which flags, which sheets, which thresholds.

    Quickstart
    ----------
    Use a preset:
        createFlaggingReport("DDS2", "Clinic", config=PRESETS["clinic_full"])

    Override one field from a preset:
        cfg = PRESETS["clinic_full"].copy(minForms=8, sheets=["summary", "legend"])
        createFlaggingReport("BOH1", "Clinic", config=cfg)

    Build from scratch:
        cfg = FlaggingConfig(
            flags=["low_es", "low_gr", "high_fta", "clinical_incident"],
            sheets=["summary", "legend"],
            esThreshold=2.3, grThreshold=2.5,
        )

    Inspect before running:
        PRESETS["clinic_full"].describe()

    Available flag keys:   list(FLAG_REGISTRY)
    Available sheet keys:  list(SHEET_REGISTRY)
    """

    def __init__(
        self,
        flags,
        sheets,
        esThreshold       = None,
        grThreshold       = None,
        tsThreshold       = None,
        csThreshold       = None,
        psThreshold       = None,
        scoreThreshold    = None,
        minForms          = None,
        slopeThreshold    = 0.0,
        improvementMargin = 0.0,
        behindRatio       = 0.5,
        minOperatorPct    = 50.0,
        maxFtaPct         = 30.0,
        info_flags        = None,   # flags shown in Excel but NOT counted in high/low risk columns
        minPtSeen         = None,   # auto = cohort mean - 1 SD
        maxEsLvl1Pct      = 20.0,   # flag if es_lvl1_pct > this (DDS2 clinic)
        maxEsLvl2Pct      = 100.0,   # flag if es_lvl2_pct > this (DDS2 clinic)
        sdMultiplier      = 1.0,    # multiplier for standard deviation in auto threshold calculation
        createPdf         = False,  # also generate a companion PDF report
        borderlineGrLevel      = 2,     # GR level that defines the "borderline" peer group
        useBorderlineThreshold = True,  # if True, es/ts/cs/ps/score auto-thresholds (i.e.
                                         # esThreshold=None etc.) use the mean of borderline
                                         # (avg_gr == borderlineGrLevel) peers instead of
                                         # cohort mean - sdMultiplier*SD. Falls back to the
                                         # mean-SD method if the borderline group is empty.
                                         # gr/forms/operator%/fta%/pt_seen thresholds are
                                         # unaffected and always use the mean-SD auto method.
        highTierFlags     = None,   # flag keys counted in high_risk_flag_count; default DEFAULT_HIGH_TIER_FLAGS
        lowTierFlags      = None,   # flag keys counted in low_risk_flag_count; default DEFAULT_LOW_TIER_FLAGS
        inclusiveFlags    = None,   # flag keys compared with <= / >= instead of < / >
                                    # (e.g. ["low_es"] makes esThreshold=2 fire AT 2.0, not
                                    #  just below it). None/[] = every flag stays strict,
                                    #  which is the historical behaviour.
        requireOperatorForPtSeen = True,  # count a "patient seen" AND a "patient FTA"
                                    # form only when the student was the Operator
                                    # (Config.xlsx "All" note — a Support-Operator log
                                    # double-counts the chair either way). Forms with NO
                                    # role field (final-year DDS4/BOH3) are exempt and
                                    # still count. False = old any-role count for both.
        scoreWeighting    = SCORE_PER_FORM,  # how avg_score is aggregated — see
                                    # SCORE_WEIGHTINGS. 'per_form' (default) is the
                                    # historical behaviour and what the July 2026
                                    # workbook used; 'per_item' weights every scored
                                    # item equally instead of every form.
        checklistCountMode = "total",  # Summary "Checklists" column: "total" counts
                                    # every item-code assessment (repeats included),
                                    # "unique" counts distinct item-codes. Both are
                                    # always computed; this only picks which is shown.
        minChecklists     = None,   # low_checklist_count threshold; None = auto
                                    # (cohort mean - sdMultiplier*SD) on the shown count.
        minClasses        = None,   # low_class_count threshold (distinct dates); None = auto.
        minItemCodes      = None,   # low_item_code_count threshold (distinct item codes); None = auto.
        countLowPercentile = 0.25,  # Count Pivot sheets: a student's count for a code
                                    # /section is highlighted red when it is at/below
                                    # this per-column quantile of the cohort (default
                                    # bottom 25%). Only fires where the quantile > 0.
        countHighlightMode = "percentile",  # how the ITEM-CODE Count Pivot decides a
                                    # cell is low — see COUNT_HIGHLIGHT_MODES:
                                    # 'percentile' (default), 'mean_fraction',
                                    # 'mean_fraction_expected' (opt 2), 'mean_sd' (opt 3).
                                    # The Section Count Pivot always uses mean_fraction
                                    # with behindRatio.
        countMeanFraction  = 0.5,   # mean_fraction / _expected: red when count < this
                                    # fraction of the column mean.
        countMinMean       = 2.0,   # mean_fraction_expected: skip a column (code) whose
                                    # mean is below this — a low count on a rarely-done
                                    # code is not flagged.
        countSdK           = 1.0,   # mean_sd: red when count < column mean - countSdK*SD.
    ):
        self.flags             = list(flags)
        self.sheets            = list(sheets)
        self.esThreshold       = esThreshold
        self.grThreshold       = grThreshold
        self.tsThreshold       = tsThreshold
        self.csThreshold       = csThreshold
        self.psThreshold       = psThreshold
        self.scoreThreshold    = scoreThreshold
        self.minForms          = minForms
        self.slopeThreshold    = slopeThreshold
        self.improvementMargin = improvementMargin
        self.behindRatio       = behindRatio
        self.minOperatorPct    = minOperatorPct
        self.maxFtaPct         = maxFtaPct
        self.info_flags        = list(info_flags) if info_flags is not None else []
        self.minPtSeen         = minPtSeen
        self.maxEsLvl1Pct      = maxEsLvl1Pct
        self.maxEsLvl2Pct      = maxEsLvl2Pct
        self.sdMultiplier      = sdMultiplier
        self.createPdf         = createPdf
        self.borderlineGrLevel      = borderlineGrLevel
        self.useBorderlineThreshold = useBorderlineThreshold
        self.highTierFlags     = list(highTierFlags) if highTierFlags is not None else list(DEFAULT_HIGH_TIER_FLAGS)
        self.lowTierFlags      = list(lowTierFlags)  if lowTierFlags  is not None else list(DEFAULT_LOW_TIER_FLAGS)
        self.inclusiveFlags    = list(inclusiveFlags) if inclusiveFlags is not None else []
        self.requireOperatorForPtSeen = bool(requireOperatorForPtSeen)
        self.scoreWeighting    = resolveScoreWeighting(scoreWeighting)
        _ckMode = str(checklistCountMode).strip().lower()
        if _ckMode not in ("total", "unique"):
            raise ValueError(
                f"Unknown checklistCountMode {checklistCountMode!r} — use 'total' or 'unique'.")
        self.checklistCountMode = _ckMode
        self.minChecklists     = minChecklists
        self.minClasses        = minClasses
        self.minItemCodes      = minItemCodes
        self.countLowPercentile = countLowPercentile
        self.countHighlightMode = resolveCountHighlightMode(countHighlightMode)
        self.countMeanFraction  = countMeanFraction
        self.countMinMean       = countMinMean
        self.countSdK           = countSdK
        for key in self.inclusiveFlags:
            if key not in FLAG_REGISTRY:
                print(f"[FlaggingConfig] WARNING: inclusiveFlags key '{key}' not in FLAG_REGISTRY — ignored")

    # ── Selection ───────────────────────────────────────────────────────
    def direction_for(self, key):
        """Comparison direction actually used for flag *key* this run — the
        registry's own direction, promoted to its inclusive form when the key is
        listed in ``inclusiveFlags``."""
        spec = FLAG_REGISTRY.get(key)
        if not isinstance(spec, FlagSpec):
            return None
        if key in self.inclusiveFlags:
            return _INCLUSIVE_DIRECTION.get(spec.direction, spec.direction)
        return spec.direction

    def resolve_flags(self):
        """Return ordered list of FlagSpec/CustomFlagSpec for the active flags."""
        out = []
        for key in self.flags:
            if key not in FLAG_REGISTRY:
                raise KeyError(
                    f"Flag '{key}' not in FLAG_REGISTRY.\n"
                    f"Available: {list(FLAG_REGISTRY)}"
                )
            out.append(FLAG_REGISTRY[key])
        return out

    def resolve_tiers(self):
        """
        Return (high_tier_col_names, low_tier_col_names) — the flagDf boolean
        column names (e.g. "flag_low_es") for each tier, resolved from
        FLAG_REGISTRY. A key in both highTierFlags and lowTierFlags is treated
        as HIGH (with a warning). Unknown keys are ignored (with a warning).
        """
        high_names, low_names = set(), set()
        for key in self.highTierFlags:
            if key not in FLAG_REGISTRY:
                print(f"[FlaggingConfig] WARNING: highTierFlags key '{key}' not in FLAG_REGISTRY — ignored")
                continue
            high_names.add(FLAG_REGISTRY[key].name)
        for key in self.lowTierFlags:
            if key not in FLAG_REGISTRY:
                print(f"[FlaggingConfig] WARNING: lowTierFlags key '{key}' not in FLAG_REGISTRY — ignored")
                continue
            name = FLAG_REGISTRY[key].name
            if name in high_names:
                print(f"[FlaggingConfig] WARNING: '{key}' is in both highTierFlags and lowTierFlags — treating as HIGH tier")
                continue
            low_names.add(name)
        return high_names, low_names

    def unclassified_flags(self):
        """Active, scored (non-info) flags that aren't in either tier list —
        these still fire and show in Excel/PDF, but won't count toward
        high_risk_flag_count or low_risk_flag_count."""
        high_names, low_names = self.resolve_tiers()
        _info_names = {FLAG_REGISTRY[k].name for k in self.info_flags if k in FLAG_REGISTRY}
        out = []
        for key in self.flags:
            spec = FLAG_REGISTRY.get(key)
            if spec is None or spec.name in _info_names:
                continue
            if spec.name not in high_names and spec.name not in low_names:
                out.append(key)
        return out

    def resolve_sheets(self):
        """Return ordered list of sheet builder callables for the active sheets."""
        out = []
        for key in self.sheets:
            if key not in SHEET_REGISTRY:
                raise KeyError(
                    f"Sheet '{key}' not in SHEET_REGISTRY.\n"
                    f"Available: {list(SHEET_REGISTRY)}"
                )
            out.append(SHEET_REGISTRY[key])
        return out

    # ── Mutation ────────────────────────────────────────────────────────
    def copy(self, **overrides):
        """Return a new FlaggingConfig inheriting all settings, with overrides applied."""
        kwargs = dict(
            flags             = list(self.flags),
            sheets            = list(self.sheets),
            esThreshold       = self.esThreshold,
            grThreshold       = self.grThreshold,
            tsThreshold       = self.tsThreshold,
            csThreshold       = self.csThreshold,
            psThreshold       = self.psThreshold,
            scoreThreshold    = self.scoreThreshold,
            minForms          = self.minForms,
            slopeThreshold    = self.slopeThreshold,
            improvementMargin = self.improvementMargin,
            behindRatio       = self.behindRatio,
            minOperatorPct    = self.minOperatorPct,
            maxFtaPct         = self.maxFtaPct,
            info_flags        = list(self.info_flags),
            minPtSeen         = self.minPtSeen,
            maxEsLvl1Pct      = self.maxEsLvl1Pct,
            maxEsLvl2Pct      = self.maxEsLvl2Pct,
            sdMultiplier      = self.sdMultiplier,
            createPdf         = self.createPdf,
            borderlineGrLevel      = self.borderlineGrLevel,
            useBorderlineThreshold = self.useBorderlineThreshold,
            highTierFlags     = list(self.highTierFlags),
            lowTierFlags      = list(self.lowTierFlags),
            inclusiveFlags    = list(self.inclusiveFlags),
            requireOperatorForPtSeen = self.requireOperatorForPtSeen,
            scoreWeighting    = self.scoreWeighting,
            checklistCountMode = self.checklistCountMode,
            minChecklists     = self.minChecklists,
            minClasses        = self.minClasses,
            minItemCodes      = self.minItemCodes,
            countLowPercentile = self.countLowPercentile,
            countHighlightMode = self.countHighlightMode,
            countMeanFraction  = self.countMeanFraction,
            countMinMean       = self.countMinMean,
            countSdK           = self.countSdK,
        )
        kwargs.update(overrides)
        return FlaggingConfig(**kwargs)

    # ── Introspection ───────────────────────────────────────────────────
    def describe(self):
        """Print a human-readable summary of this config."""
        W = 62
        print("=" * W)
        print("  FlaggingConfig")
        print("=" * W)

        print(f"\nFlags ({len(self.flags)}):")
        print(f"  {'Key':<22}  {'Column':<30}  Details")
        print(f"  {'-'*22}  {'-'*30}  {'-'*18}")
        for key in self.flags:
            spec = FLAG_REGISTRY.get(key)
            tag  = " [info]" if key in self.info_flags else ""
            if spec is None:
                print(f"  !!  {key:<22}  NOT FOUND in FLAG_REGISTRY")
            elif isinstance(spec, FlagSpec):
                _dir = self.direction_for(key)
                _sym = DIRECTION_SYMBOL.get(_dir, _dir)
                _inc = " [inclusive]" if key in self.inclusiveFlags else ""
                print(f"  ok  {key:<22}  {spec.name:<30}  {_sym} '{spec.thresh_key}'{_inc}{tag}")
            else:
                print(f"  ok  {key:<22}  {spec.name:<30}  custom fn{tag}")

        if self.info_flags:
            print(f"\nInfo flags (shown in Excel, NOT counted in high/low risk columns):")
            for key in self.info_flags:
                ok = "ok" if key in FLAG_REGISTRY else "!! NOT FOUND"
                print(f"  {ok}  {key}")

        print(f"\nHigh-tier flags (-> high_risk_flag_count):")
        for key in self.highTierFlags:
            ok = "ok" if key in FLAG_REGISTRY else "!! NOT FOUND"
            print(f"  {ok}  {key}")
        print(f"\nLow-tier flags (-> low_risk_flag_count):")
        for key in self.lowTierFlags:
            ok = "ok" if key in FLAG_REGISTRY else "!! NOT FOUND"
            print(f"  {ok}  {key}")
        unclassified = self.unclassified_flags()
        if unclassified:
            print(f"\n  !! Active flags not in either tier (excluded from both risk columns): {unclassified}")

        print(f"\nBorderline auto-threshold (ES/TS/CS/PS/Score, when no explicit override given):")
        print(f"  useBorderlineThreshold : {self.useBorderlineThreshold}")
        print(f"  borderlineGrLevel      : {self.borderlineGrLevel}  "
              f"(threshold = mean of the metric among students whose avg GR rounds to this level)")

        print(f"\nSheets ({len(self.sheets)}):")
        for i, key in enumerate(self.sheets, 1):
            ok = "ok" if key in SHEET_REGISTRY else "!! NOT FOUND"
            print(f"  {i}. {key}  {'' if key in SHEET_REGISTRY else ok}")

        print(f"\nThresholds:")
        rows = [
            ("esThreshold",       "ES avg",            "auto = cohort mean - 1 SD"),
            ("grThreshold",       "GR avg",            "auto = cohort mean - 1 SD"),
            ("tsThreshold",       "TS avg",            "auto = cohort mean - 1 SD"),
            ("csThreshold",       "CS avg",            "auto = cohort mean - 1 SD"),
            ("psThreshold",       "PS avg",            "auto = cohort mean - 1 SD"),
            ("scoreThreshold",    "Score avg",         "auto = cohort mean - 1 SD"),
            ("minForms",          "Min forms",         "auto = cohort mean - 1 SD"),
            ("minChecklists",     "Min checklists",    "auto = cohort mean - 1 SD; low_checklist_count"),
            ("minClasses",        "Min classes",       "auto = cohort mean - 1 SD; low_class_count"),
            ("minItemCodes",      "Min item codes",    "auto = cohort mean - 1 SD; low_item_code_count"),
            ("slopeThreshold",    "Slope",             "0 = flag any decline"),
            ("improvementMargin", "Improvement margin","last-third <= first-third + margin"),
            ("behindRatio",       "Behind ratio",      "flag if count < cohort_avg x ratio"),
            ("minOperatorPct",    "Min operator %",    ""),
            ("maxFtaPct",         "Max FTA %",         ""),
            ("minPtSeen",         "Min patients seen", "auto = cohort mean - 1 SD"),
            ("maxEsLvl1Pct",      "Max ES L1 %",       "flag if >X% of ES ratings are level 1"),
            ("maxEsLvl2Pct",      "Max ES L2 %",       "flag if >X% of ES ratings are level 2"),
            ("sdMultiplier",      "SD Multiplier",     "multiplier for standard deviation in auto threshold calculation"),
        ]
        for attr, label, note in rows:
            val     = getattr(self, attr)
            auto    = " (auto)" if val is None else ""
            val_str = str(val) + auto
            print(f"  {label:<22}: {val_str:<16}  {note}")

        print(f"\nInclusive (<= / >=) flags: {self.inclusiveFlags or '— none, all strict'}")
        print(f"Pt Seen requires role=Operator: {self.requireOperatorForPtSeen}"
              f"  (forms with no role field are exempt)")
        print(f"Score weighting        : {self.scoreWeighting} "
              f"({SCORE_WEIGHTING_LABELS[self.scoreWeighting]}) — drives avg_score, the "
              f"Low Score flag and the score threshold; slopes stay per form")
        print(f"Checklist count mode   : {self.checklistCountMode} — Summary 'Checklists' "
              f"column ('total' = every item-code assessment, 'unique' = distinct codes)")
        print(f"Count pivot low pct    : {self.countLowPercentile} — Count Pivot cells at/below "
              f"this per-column quantile are highlighted red")
        print(f"Item-code count mode   : {self.countHighlightMode} "
              f"(fraction={self.countMeanFraction}, minMean={self.countMinMean}, sdK={self.countSdK}) "
              f"— Section Count Pivot always uses mean_fraction × behindRatio")
        print()

    def __repr__(self):
        return (
            f"FlaggingConfig(flags={self.flags}, sheets={self.sheets}, "
            f"esThreshold={self.esThreshold}, grThreshold={self.grThreshold}, "
            f"minForms={self.minForms})"
        )


# ═══════════════════════════════════════════════════════════════════════════
# Presets
# ═══════════════════════════════════════════════════════════════════════════
# Opt-in flags (2026-08-19): keep them out of the "all flags" presets so
# clinic_full / at_risk_only are unchanged. low_declining_* are BOH2-clinic;
# low_checklist_count / low_class_count are Sim (added to boh2_sim explicitly).
_OPT_IN_FLAGS = ("low_checklist_count", "low_class_count", "low_item_code_count")
_ALL_FLAGS  = [k for k in FLAG_REGISTRY.keys()
               if not k.startswith("low_declining_") and k not in _OPT_IN_FLAGS]
# item_code_score_pivot / item_code_count_pivot are BOH2-opt-in (2026-08-19): keep
# them out of _ALL_SHEETS so clinic_full / dds2_clinic are unchanged; boh2_clinic
# adds them explicitly.
_BOH2_ONLY_SHEETS = ("item_code_score_pivot", "item_code_count_pivot",
                     "low_professionalism")   # opt-in sheets (kept out of _ALL_SHEETS)
_ALL_SHEETS = [k for k in SHEET_REGISTRY.keys() if k not in _BOH2_ONLY_SHEETS]


def _sheetsWith(exclude=(), insertAfter=None, insert=()):
    """Build a sheet list from _ALL_SHEETS, dropping `exclude` and slotting
    `insert` in right after `insertAfter` (appended if that key is absent)."""
    out = [s for s in _ALL_SHEETS if s not in exclude]
    if insertAfter and insertAfter in out:
        i = out.index(insertAfter) + 1
        out[i:i] = list(insert)
    else:
        out += list(insert)
    return out

