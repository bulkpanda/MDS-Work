def parseIgnoreDates(values, defaultYear=None):
    """Normalise a mixed list of dates to sorted unique 'YYYY-MM-DD' strings.

    Accepts ``date``/``datetime``/``Timestamp`` objects and strings in ISO
    ('2026-03-16'), day-first ('16/03/2026', '16-03-2026') or written
    ('16 Mar 2026') form. Day-first is assumed for ambiguous slash dates, because
    that is how the dates are written locally — '03/02/2026' is 3 February, not
    3 March. A bare '16/03' needs ``defaultYear``.

    An unparseable entry RAISES rather than being skipped: silently ignoring a
    typo would silently leave the session in the analysis.
    """
    out = []
    for raw in (values or []):
        if raw is None:
            continue
        if isinstance(raw, (pd.Timestamp, datetime.datetime, datetime.date)):
            out.append(pd.Timestamp(raw).strftime("%Y-%m-%d"))
            continue
        text = str(raw).strip()
        if not text:
            continue
        if re.fullmatch(r"\d{4}-\d{1,2}-\d{1,2}", text):
            ts = pd.Timestamp(text)                       # ISO — unambiguous
        else:
            if re.fullmatch(r"\d{1,2}[/-]\d{1,2}", text):  # bare day/month
                if defaultYear is None:
                    raise ValueError(
                        f"Ignore date {raw!r} has no year — write it in full "
                        f"('16/03/2026') or pass defaultYear.")
                sep  = "/" if "/" in text else "-"
                text = f"{text}{sep}{defaultYear}"
            ts = pd.to_datetime(text, dayfirst=True, errors="coerce")
        if ts is None or pd.isna(ts):
            raise ValueError(f"Could not parse ignore date {raw!r} — use "
                             f"'YYYY-MM-DD' or 'DD/MM/YYYY'.")
        out.append(pd.Timestamp(ts).strftime("%Y-%m-%d"))
    return sorted(set(out))


def dropIgnoredDates(cohortDf, ignoreDates, dateCol="datetimeutc",
                     tz="Australia/Melbourne", defaultYear=None, verbose=True):
    """Drop every form sat on one of *ignoreDates*. Returns (df, parsedDates).

    Matching is on the **Melbourne-local** date, the same basis as
    filterCohortDfByPeriod — a UTC date would shift some sessions a day earlier
    and quietly spare the wrong ones.

    A listed date that matches NOTHING is called out loudly: it almost always
    means a typo or the wrong year, and a silently-ineffective exclusion is worse
    than none because the workbook looks like it was applied.
    """
    dates = parseIgnoreDates(ignoreDates, defaultYear=defaultYear)
    if not dates or cohortDf is None or len(cohortDf) == 0:
        return cohortDf, dates

    ts = pd.to_datetime(cohortDf[dateCol], utc=True, errors="coerce")
    try:
        localDate = ts.dt.tz_convert(tz).dt.strftime("%Y-%m-%d")
    except Exception:                      # pragma: no cover — tz db missing
        localDate = ts.dt.strftime("%Y-%m-%d")

    mask = localDate.isin(dates)
    out  = cohortDf[~mask].copy()

    if verbose:
        counts  = localDate[mask].value_counts().to_dict()
        matched = [d for d in dates if counts.get(d)]
        missing = [d for d in dates if not counts.get(d)]
        print(f"[ignoreDates] dropped {int(mask.sum())} forms on {len(matched)} date(s): "
              + ", ".join(f"{d} ({counts[d]})" for d in matched))
        if missing:
            print(f"[ignoreDates] WARNING: no forms found on {missing} — check the "
                  f"date or the year; these exclusions did nothing.")
        print(f"[ignoreDates] {len(out)}/{len(cohortDf)} forms remain")
    return out, dates


