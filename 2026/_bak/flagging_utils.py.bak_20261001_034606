def _styleHeader(ws, row, ncols, text):
    """Navy banner spanning ncols."""
    ws.merge_cells(start_row=row, start_column=1, end_row=row, end_column=ncols)
    c = ws.cell(row=row, column=1, value=text)
    c.font      = Font(name="Arial", bold=True, size=14, color=_WHITE)
    c.fill      = _fill(_NAVY)
    c.alignment = Alignment(horizontal="center", vertical="center")
    ws.row_dimensions[row].height = 28


def _styleColumnHeaders(ws, row, cols, friendly_map=None):
    """Apply navy header styling to a row of column names."""
    for c_idx, col in enumerate(cols, start=1):
        cell = ws.cell(row=row, column=c_idx)
        cell.value     = (friendly_map or {}).get(col, col)
        cell.font      = _HEADER_FONT
        cell.fill      = _fill(_NAVY)
        cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
        cell.border    = _thin_border()
    ws.row_dimensions[row].height = 30


def _colorPivotLowCells(ws, pivotDf, data_start_col, data_start_row, low_percentile=0.25):
    """Color cells in the bottom percentile across the cohort for that column.

    A cell is highlighted when its value is at/below that column's low quantile,
    the quantile is > 0, AND the value is strictly below the column maximum. The
    last guard fixes the "whole column red" case: for a code every student did 0
    or 1 times, the low quantile lands on 1 (the common value), so ``val <=
    threshold`` alone would redden every 1 as well as every 0. Excluding the
    column max means only the genuinely low cells (here, the 0s) are marked, and a
    column where everyone did the same amount is never highlighted at all.
    """
    numCols = pivotDf.columns[data_start_col - 1:]
    for c_offset, colName in enumerate(numCols):
        excel_col = data_start_col + c_offset
        col_vals  = pd.to_numeric(pivotDf[colName], errors="coerce")
        clean = col_vals.dropna()
        if clean.empty:
            continue
        threshold = col_vals.quantile(low_percentile)
        col_max   = clean.max()
        for r_offset, val in enumerate(col_vals):
            if pd.notna(val) and val <= threshold and threshold > 0 and val < col_max:
                cell = ws.cell(row=data_start_row + r_offset, column=excel_col)
                cell.fill = _fill(_RED_BG)
                cell.font = Font(name="Arial", size=9, color=_RED_TEXT, bold=True)


def _colorPivotBelowMeanFraction(ws, pivotDf, data_start_col, data_start_row, ratio=0.5):
    """Highlight cells below ``ratio`` × the column mean — the same 'behind' rule
    the Section Comparison uses (count < cohort average × behindRatio). The mean is
    taken over every student in the column, zeros included, so it matches the
    cohort average. Strict ``<`` so a student exactly at half the average is not
    flagged, and a column where everyone did the same amount highlights nothing."""
    numCols = pivotDf.columns[data_start_col - 1:]
    for c_offset, colName in enumerate(numCols):
        excel_col = data_start_col + c_offset
        col_vals  = pd.to_numeric(pivotDf[colName], errors="coerce")
        clean = col_vals.dropna()
        if clean.empty:
            continue
        thresh = float(clean.mean()) * ratio
        for r_offset, val in enumerate(col_vals):
            if pd.notna(val) and val < thresh:
                cell = ws.cell(row=data_start_row + r_offset, column=excel_col)
                cell.fill = _fill(_RED_BG)
                cell.font = Font(name="Arial", size=9, color=_RED_TEXT, bold=True)


def _autofitPivotHeaders(ws, columns, start_col=3, minWidth=7, pad=2, maxWidth=40):
    """Widen each data column to fit its header text (section / item-code name), so
    long section names show in full. Columns before ``start_col`` (id / name) are
    left as set by the caller."""
    for i, col in enumerate(columns[start_col - 1:], start=start_col):
        w = max(minWidth, min(maxWidth, len(str(col)) + pad))
        ws.column_dimensions[get_column_letter(i)].width = w


# ── Count-pivot low-cell highlight modes (2026-08-19) ───────────────────────
# How a Count Pivot decides a cell is "low" for its column (code/section):
#   percentile              bottom `percentile` per column (ties + col-max guard)
#   mean_fraction           below `ratio` × the column mean (the Section rule)
#   mean_fraction_expected  same, but SKIP a column whose mean < `minMean` — a low
#                           count on a rarely-done code is not a concern, so only
#                           codes students generally do get flagged  (option 2)
#   mean_sd                 below mean - `sdK` × SD of the column       (option 3)
#   zeros                   red ONLY where the count is 0 (weekly-sim: each item
#                           code is a distinct week, so most counts are 1 and a 0
#                           is the only signal -- a missed week)
#   column_gradient         per-column heatmap: shade EVERY cell by its percentile
#                           rank within its column, low (red) -> yellow -> green
COUNT_HIGHLIGHT_MODES = ("percentile", "mean_fraction", "mean_fraction_expected",
                         "mean_sd", "zeros", "column_gradient")


def _gradientHex(t):
    """ARGB hex on a 3-stop red -> yellow -> green scale for t in [0, 1]
    (0 = worst/red, 1 = best/green)."""
    t = 0.0 if t < 0 else 1.0 if t > 1 else float(t)
    stops = [(0.0, (0xF8, 0x69, 0x6B)), (0.5, (0xFF, 0xEB, 0x84)), (1.0, (0x63, 0xBE, 0x7B))]
    for (t0, c0), (t1, c1) in zip(stops, stops[1:]):
        if t <= t1:
            f = 0.0 if t1 == t0 else (t - t0) / (t1 - t0)
            r = int(round(c0[0] + (c1[0] - c0[0]) * f))
            g = int(round(c0[1] + (c1[1] - c0[1]) * f))
            b = int(round(c0[2] + (c1[2] - c0[2]) * f))
            return f"FF{r:02X}{g:02X}{b:02X}"
    return "FFFFFFFF"


def _colorPivotZeros(ws, pivotDf, data_start_col, data_start_row):
    """Red-highlight ONLY cells whose count is 0. Built for weekly-sim Item Code
    Count Pivots where each item code is a distinct week, so most counts are 1 and
    a 0 is the only signal (the student missed that week's checklist). Columns of
    all-1s show nothing; nothing else is touched."""
    numCols = pivotDf.columns[data_start_col - 1:]
    for c_offset, colName in enumerate(numCols):
        excel_col = data_start_col + c_offset
        col_vals  = pd.to_numeric(pivotDf[colName], errors="coerce")
        for r_offset, val in enumerate(col_vals):
            if pd.notna(val) and val == 0:
                cell = ws.cell(row=data_start_row + r_offset, column=excel_col)
                cell.fill = _fill(_RED_BG)
                cell.font = Font(name="Arial", size=9, color=_RED_TEXT, bold=True)


def _colorPivotColumnGradient(ws, pivotDf, data_start_col, data_start_row):
    """Per-column heatmap: shade EVERY cell by its percentile RANK within its own
    column, low (red) -> mid (yellow) -> high (green). Unlike the cutoff modes this
    colours the whole column, so a reader sees each student's relative standing on
    that item code even when the raw counts sit close together. A column where every
    value is identical gets a single mid colour (rank = 1.0)."""
    numCols = pivotDf.columns[data_start_col - 1:]
    for c_offset, colName in enumerate(numCols):
        excel_col = data_start_col + c_offset
        col_vals  = pd.to_numeric(pivotDf[colName], errors="coerce")
        ranks = col_vals.rank(method="average", pct=True)   # 0..1 within-column pct rank
        for r_offset, (val, pr) in enumerate(zip(col_vals, ranks)):
            if pd.isna(val) or pd.isna(pr):
                continue
            cell = ws.cell(row=data_start_row + r_offset, column=excel_col)
            cell.fill = _fill(_gradientHex(pr))
            cell.font = Font(name="Arial", size=9, color="FF000000")


def resolveCountHighlightMode(value):
    """Normalise a countHighlightMode; raises on anything unrecognised so a typo
    can't silently fall back to a different rule."""
    if value is None:
        return "percentile"
    text = str(value).strip().lower().replace("-", "_").replace(" ", "_")
    if text not in COUNT_HIGHLIGHT_MODES:
        raise ValueError(
            f"Unknown countHighlightMode {value!r} — use one of {COUNT_HIGHLIGHT_MODES}.")
    return text


def _colorPivotByMode(ws, pivotDf, data_start_col, data_start_row, mode="percentile",
                      ratio=0.5, minMean=0.0, sdK=1.0, percentile=0.25):
    """Dispatch count-pivot highlighting to the chosen mode (see
    COUNT_HIGHLIGHT_MODES). percentile / mean_fraction reuse the dedicated
    helpers; mean_fraction_expected and mean_sd are handled here."""
    mode = resolveCountHighlightMode(mode)
    if mode == "percentile":
        _colorPivotLowCells(ws, pivotDf, data_start_col, data_start_row, low_percentile=percentile)
        return
    if mode == "mean_fraction":
        _colorPivotBelowMeanFraction(ws, pivotDf, data_start_col, data_start_row, ratio=ratio)
        return
    if mode == "zeros":
        _colorPivotZeros(ws, pivotDf, data_start_col, data_start_row)
        return
    if mode == "column_gradient":
        _colorPivotColumnGradient(ws, pivotDf, data_start_col, data_start_row)
        return
    numCols = pivotDf.columns[data_start_col - 1:]
    for c_offset, colName in enumerate(numCols):
        excel_col = data_start_col + c_offset
        col_vals  = pd.to_numeric(pivotDf[colName], errors="coerce")
        clean = col_vals.dropna()
        if clean.empty:
            continue
        mean = float(clean.mean())
        if mode == "mean_fraction_expected":
            if mean < minMean:          # rarely-done code — leave the column alone
                continue
            thresh = mean * ratio
        else:                           # mean_sd
            sd = clean.std(ddof=0)
            sd = 0.0 if pd.isna(sd) else float(sd)
            thresh = mean - sdK * sd
        for r_offset, val in enumerate(col_vals):
            if pd.notna(val) and val < thresh:
                cell = ws.cell(row=data_start_row + r_offset, column=excel_col)
                cell.fill = _fill(_RED_BG)
                cell.font = Font(name="Arial", size=9, color=_RED_TEXT, bold=True)


def _itemCountHighlightSpec(config):
    """Highlight spec dict for item-code Count Pivots, read from the config knobs."""
    return {
        "mode":       resolveCountHighlightMode(getattr(config, "countHighlightMode", "percentile")),
        "ratio":      getattr(config, "countMeanFraction", 0.5),
        "minMean":    getattr(config, "countMinMean", 2.0),
        "sdK":        getattr(config, "countSdK", 1.0),
        "percentile": getattr(config, "countLowPercentile", 0.25),
    }


