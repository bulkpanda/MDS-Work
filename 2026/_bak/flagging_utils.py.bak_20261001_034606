_ID_COLS     = ["student_number", "student_name"]
_ID_FRIENDLY = {"student_number": "ID", "student_name": "Student"}


def _scoreWeightingLabel(config):
    """'per form' / 'per item' for the active config — used in sheet headers so a
    Score column always says which of the two definitions it is."""
    return SCORE_WEIGHTING_LABELS[
        resolveScoreWeighting(getattr(config, "scoreWeighting", SCORE_PER_FORM))]


def _canonicalNameMap(df):
    """Map each student_number to a single canonical student_name.

    Different name spellings/capitalisations for the same student_number
    (e.g. 'Hunain Jamal' vs 'Hunain JAmal') otherwise split one student into
    multiple rows when grouping/merging on (id, name). Here we pick the most
    frequently occurring name variant per student_number, breaking ties by
    first appearance order so the result is deterministic.

    Returns: dict {student_number: student_name}
    """
    if df is None or len(df) == 0:
        return {}
    if not {"student_number", "student_name"}.issubset(df.columns):
        return {}
    tmp = df[["student_number", "student_name"]].dropna(subset=["student_number"]).copy()
    if tmp.empty:
        return {}
    tmp["student_name"] = tmp["student_name"].fillna("")
    tmp = tmp.reset_index(drop=True)
    tmp["_ord"] = range(len(tmp))
    agg = (tmp.groupby(["student_number", "student_name"])
              .agg(_n=("_ord", "size"), _first=("_ord", "min"))
              .reset_index()
              .sort_values(["_n", "_first"], ascending=[False, True]))
    canon = agg.drop_duplicates("student_number").set_index("student_number")["student_name"]
    return canon.to_dict()


def _build_summary_sheet(writer, flagDf, compDf, cohortDf, thresholds,
                         cohort, formType, config, mappingFile=None):
    """Risk-ranked student overview with all active flags."""
    specs     = config.resolve_flags()
    FLAG_COLS = [s.name for s in specs]
    flag_friendly = {s.name: s.label for s in specs}

    # The ungated "(any)" counts (patient_seen_any_role / patient_fta_any_role) are
    # still computed on flagDf for audit but are NOT shown — the Summary only carries
    # the Operator-gated Pt Seen / Pt FTA, and % FTA is the gated count over all forms
    # (2026-08-19, user request: the "(any)" columns were noise).
    # Checklists column: config.checklistCountMode picks total (every item-code
    # assessment) vs unique (distinct codes). Classes = distinct session dates.
    # Both guarded so an older flagDf without them still builds. (2026-08-19)
    _ckMode  = str(getattr(config, "checklistCountMode", "total")).strip().lower()
    _ckExtra = [c for c in ("checklist_count", "checklist_unique", "n_classes") if c in flagDf.columns]
    # Operator / patient-seen columns are Clinic concepts — a Simulation form has no
    # operator role and no patient, so they are all zero/meaningless there. Dropped
    # from the Sim Summary (2026-08-19, user request); the cross-highlight blocks
    # below all guard on `in SUM_COLS`, so they simply no-op.
    if formType == "Simulation":
        _opCols = []
    else:
        _opCols = ["operator_count", "support_count", "pct_operator",
                   "patient_seen", "patient_fta", "pct_fta"]
    SUM_COLS = (
        _ID_COLS
        + ["form_count"] + _ckExtra
        + _opCols
        + ["ci_count", "high_risk_flag_count", "low_risk_flag_count",
           "avg_es", "avg_gr", "avg_ts", "avg_cs", "avg_ps", "avg_score"]
        + FLAG_COLS
        + ["flags_detail"]
    )
    FRIENDLY = {
        **_ID_FRIENDLY,
        "form_count": "Forms",
        "checklist_count": f"Checklists ({'uniq' if _ckMode == 'unique' else 'tot'})",
        "checklist_unique": "Unique Item Codes",
        "n_classes": "Classes",
        "operator_count": "Operator",
        "support_count": "Support", "pct_operator": "% Oper",
        "patient_seen": "Pt Seen (Op)", "patient_seen_any_role": "Pt Seen (any)",
        "patient_fta": "Pt FTA (Op)", "patient_fta_any_role": "Pt FTA (any)",
        "pct_fta": "% FTA", "ci_count": "CI#",
        "high_risk_flag_count": "High Risk Flags ▼", "low_risk_flag_count": "Low Risk Flags",
        "avg_es": "ES Avg", "avg_gr": "GR Avg", "avg_ts": "TS Avg",
        "avg_cs": "CS Avg", "avg_ps": "PS Avg",
        # The header names the active weighting, so a reader never has to guess
        # which of the two definitions this column (and Low Score) is using.
        "avg_score": f"Score ({_scoreWeightingLabel(config)})",
        "flags_detail": "Flags Detail",
        **flag_friendly,
    }

    sumDf = flagDf[SUM_COLS].copy()
    sumDisplay = sumDf.copy()
    for fc in FLAG_COLS:
        sumDisplay[fc] = sumDisplay[fc].apply(lambda x: "✓" if x else "")

    sumDisplay.to_excel(writer, sheet_name="Summary", index=False, startrow=2)
    ws = writer.sheets["Summary"]

    _styleHeader(ws, 1, len(SUM_COLS), f"{cohort} {formType} — Student Risk Dashboard")
    _styleColumnHeaders(ws, 3, SUM_COLS, FRIENDLY)

    avg_cols_map = {
        "avg_es": thresholds.get("es"), "avg_gr": thresholds.get("gr"),
        "avg_ts": thresholds.get("ts"), "avg_cs": thresholds.get("cs"),
        "avg_ps": thresholds.get("ps"), "avg_score": thresholds.get("score"),
    }
    max_high_risk = flagDf["high_risk_flag_count"].max() or 1
    max_low_risk  = flagDf["low_risk_flag_count"].max() or 1

    # Computed once (not per-row): which flag columns are info / high-tier / low-tier
    _info_names = {FLAG_REGISTRY[k].name for k in config.info_flags if k in FLAG_REGISTRY}
    _high_names, _low_names = config.resolve_tiers()

    for r_idx, (_, row) in enumerate(sumDf.iterrows(), start=4):
        is_alt = (r_idx % 2 == 0)
        row_bg = _fill(_LIGHT_GREY) if is_alt else _fill(_WHITE)

        for c_idx, col in enumerate(SUM_COLS, start=1):
            cell = ws.cell(row=r_idx, column=c_idx)
            cell.fill      = row_bg
            cell.font      = _BODY_FONT
            cell.border    = _thin_border()
            cell.alignment = Alignment(horizontal="center", vertical="center")

        # High/Low risk count gradients (white -> red / white -> amber as count rises)
        high_val   = row["high_risk_flag_count"]
        high_c_idx = SUM_COLS.index("high_risk_flag_count") + 1
        if high_val > 0:
            intensity = int(255 - (high_val / max_high_risk) * 120)
            ws.cell(row=r_idx, column=high_c_idx).fill = _fill(f"FF{intensity:02X}{intensity:02X}")
            ws.cell(row=r_idx, column=high_c_idx).font = _BOLD_BODY

        low_val   = row["low_risk_flag_count"]
        low_c_idx = SUM_COLS.index("low_risk_flag_count") + 1
        if low_val > 0:
            # white (FFFFFF) -> amber (FFEB9C) as count rises
            frac = min(low_val / max_low_risk, 1.0)
            g = int(255 - frac * (255 - 0xEB))
            b = int(255 - frac * (255 - 0x9C))
            ws.cell(row=r_idx, column=low_c_idx).fill = _fill(f"FF{g:02X}{b:02X}")
            ws.cell(row=r_idx, column=low_c_idx).font = _BOLD_BODY

        # Avg scale heat
        for col, thresh in avg_cols_map.items():
            if col not in SUM_COLS or thresh is None:
                continue
            val = row[col]
            c_idx = SUM_COLS.index(col) + 1
            if pd.notna(val) and pd.notna(thresh):
                cell = ws.cell(row=r_idx, column=c_idx)
                if val < thresh:
                    cell.fill = _fill(_RED_BG)
                    cell.font = Font(name="Arial", size=9, color=_RED_TEXT, bold=True)
                elif val < thresh * 1.1:
                    cell.fill = _fill(_AMBER_BG)
                    cell.font = Font(name="Arial", size=9, color=_AMBER_TEXT)

        # Cross-highlight stat cells that correspond to active flags
        if "flag_low_form_count" in FLAG_COLS and row.get("flag_low_form_count") and "form_count" in SUM_COLS:
            c = ws.cell(row=r_idx, column=SUM_COLS.index("form_count") + 1)
            c.fill = _fill(_AMBER_BG); c.font = Font(name="Arial", size=9, color=_AMBER_TEXT, bold=True)

        if "flag_low_checklist_count" in FLAG_COLS and row.get("flag_low_checklist_count") and "checklist_count" in SUM_COLS:
            c = ws.cell(row=r_idx, column=SUM_COLS.index("checklist_count") + 1)
            c.fill = _fill(_RED_BG); c.font = Font(name="Arial", size=9, color=_RED_TEXT, bold=True)

        if "flag_low_class_count" in FLAG_COLS and row.get("flag_low_class_count") and "n_classes" in SUM_COLS:
            c = ws.cell(row=r_idx, column=SUM_COLS.index("n_classes") + 1)
            c.fill = _fill(_RED_BG); c.font = Font(name="Arial", size=9, color=_RED_TEXT, bold=True)

        if "flag_low_item_code_count" in FLAG_COLS and row.get("flag_low_item_code_count") and "checklist_unique" in SUM_COLS:
            c = ws.cell(row=r_idx, column=SUM_COLS.index("checklist_unique") + 1)
            c.fill = _fill(_RED_BG); c.font = Font(name="Arial", size=9, color=_RED_TEXT, bold=True)

        if "flag_high_fta" in FLAG_COLS and row.get("flag_high_fta"):
            for _col in ("pct_fta", "patient_fta"):
                if _col in SUM_COLS:
                    c = ws.cell(row=r_idx, column=SUM_COLS.index(_col) + 1)
                    c.fill = _fill(_RED_BG); c.font = Font(name="Arial", size=9, color=_RED_TEXT, bold=True)

        if "flag_low_operator_pct" in FLAG_COLS and row.get("flag_low_operator_pct"):
            for _col in ("pct_operator", "operator_count"):
                if _col in SUM_COLS:
                    c = ws.cell(row=r_idx, column=SUM_COLS.index(_col) + 1)
                    c.fill = _fill(_AMBER_BG); c.font = Font(name="Arial", size=9, color=_AMBER_TEXT, bold=True)

        if "flag_low_pt_seen" in FLAG_COLS and row.get("flag_low_pt_seen") and "patient_seen" in SUM_COLS:
            c = ws.cell(row=r_idx, column=SUM_COLS.index("patient_seen") + 1)
            c.fill = _fill(_RED_BG); c.font = Font(name="Arial", size=9, color=_RED_TEXT, bold=True)

        ci_val = row.get("ci_count", 0)
        if pd.notna(ci_val) and ci_val > 0 and "ci_count" in SUM_COLS:
            c = ws.cell(row=r_idx, column=SUM_COLS.index("ci_count") + 1)
            c.fill = _fill(_RED_BG); c.font = Font(name="Arial", size=9, color=_RED_TEXT, bold=True)

        # Flag columns: info flags use blue styling (shown but not in either risk
        # count); triggered high-tier flags are red, triggered low-tier flags are
        # amber (matches the high_risk_flag_count / low_risk_flag_count gradients).
        for fc in FLAG_COLS:
            fc_idx  = SUM_COLS.index(fc) + 1
            cell    = ws.cell(row=r_idx, column=fc_idx)
            is_info = fc in _info_names
            if is_info:
                if row[fc]:
                    cell.fill = _fill(_INFO_BG)
                    cell.font = Font(name="Arial", size=9, color=_INFO_TEXT, bold=True)
                else:
                    cell.fill = _fill(_WHITE)
                    cell.font = _BODY_FONT
            elif row[fc]:
                if fc in _low_names and fc not in _high_names:
                    cell.fill = _fill(_AMBER_BG)
                    cell.font = Font(name="Arial", size=9, color=_AMBER_TEXT, bold=True)
                else:
                    # high-tier or unclassified flags default to red (severe)
                    cell.fill = _fill(_RED_BG)
                    cell.font = Font(name="Arial", size=9, color=_RED_TEXT, bold=True)
            else:
                cell.fill = _fill(_GREEN_BG)
                cell.font = Font(name="Arial", size=9, color=_GREEN_TEXT)

    # Left-align name columns
    for id_col in _ID_COLS:
        id_idx = SUM_COLS.index(id_col) + 1
        for r in range(4, 4 + len(sumDf)):
            ws.cell(row=r, column=id_idx).alignment = Alignment(horizontal="left", vertical="center")

    name_idx   = SUM_COLS.index("student_name") + 1
    detail_idx = SUM_COLS.index("flags_detail") + 1
    ws.column_dimensions[get_column_letter(name_idx)].width   = 24
    ws.column_dimensions[get_column_letter(detail_idx)].width = 40
    for c in range(1, len(SUM_COLS) + 1):
        if c not in (name_idx, detail_idx):
            ws.column_dimensions[get_column_letter(c)].width = 9
    # Slightly widen the long-header columns so the names show in full
    # (2026-08-19, user request): the two risk-count columns and Low Score.
    _WIDE = {"high_risk_flag_count": 15, "low_risk_flag_count": 14, "flag_low_score": 11, 'avg_score': 12, 'flag_low_declining_score': 12,
             'flag_low_declining_es': 12, 'flag_low_declining_gr': 12}
    for _col, _w in _WIDE.items():
        if _col in SUM_COLS:
            ws.column_dimensions[get_column_letter(SUM_COLS.index(_col) + 1)].width = _w
    ws.freeze_panes = "A4"


def _build_scale_trends_sheet(writer, flagDf, compDf, cohortDf, thresholds,
                               cohort, formType, config, mappingFile=None):
    """Averages, slopes, and first/last-third per scale."""
    TREND_COLS = _ID_COLS + [
        "avg_es", "es_slope", "first_third_es", "last_third_es",
        "avg_gr", "gr_slope", "first_third_gr", "last_third_gr",
        "avg_score", "score_slope",
        "avg_ts", "avg_cs", "avg_ps",
    ]
    TREND_FRIENDLY = {
        **_ID_FRIENDLY,
        "avg_es": "ES Avg", "es_slope": "ES Slope",
        "first_third_es": "ES 1st 1/3", "last_third_es": "ES Last 1/3",
        "avg_gr": "GR Avg", "gr_slope": "GR Slope",
        "first_third_gr": "GR 1st 1/3", "last_third_gr": "GR Last 1/3",
        # Score Avg follows config.scoreWeighting; the SLOPE is always computed
        # over per-form means (a form is the natural point on a time series), so
        # the two headers deliberately do not match.
        "avg_score": f"Score Avg ({_scoreWeightingLabel(config)})",
        "score_slope": "Score Slope (per form)",
        "avg_ts": "TS Avg", "avg_cs": "CS Avg", "avg_ps": "PS Avg",
    }
    trendDf = flagDf[TREND_COLS].copy()
    trendDf.to_excel(writer, sheet_name="Scale Trends", index=False, startrow=2)
    wt = writer.sheets["Scale Trends"]

    _styleHeader(wt, 1, len(TREND_COLS), f"{cohort} {formType} — Scale Averages & Trends")
    _styleColumnHeaders(wt, 3, TREND_COLS, TREND_FRIENDLY)

    slope_thresh   = thresholds.get("slope", 0.0)
    avg_thresh_map = {
        "avg_es": thresholds.get("es"), "avg_gr": thresholds.get("gr"),
        "avg_score": thresholds.get("score"), "avg_ts": thresholds.get("ts"),
        "avg_cs": thresholds.get("cs"), "avg_ps": thresholds.get("ps"),
    }

    for r_idx, (_, row) in enumerate(trendDf.iterrows(), start=4):
        is_alt = (r_idx % 2 == 0)
        row_bg = _fill(_LIGHT_GREY) if is_alt else _fill(_WHITE)
        for c_idx, col in enumerate(TREND_COLS, start=1):
            cell = wt.cell(row=r_idx, column=c_idx)
            val  = row[col]
            cell.value     = val
            cell.font      = _BODY_FONT
            cell.border    = _thin_border()
            cell.alignment = Alignment(horizontal="center", vertical="center")
            cell.fill      = row_bg

            if col.endswith("_slope") and pd.notna(val):
                if val < slope_thresh:
                    cell.fill = _fill(_RED_BG)
                    cell.font = Font(name="Arial", size=9, color=_RED_TEXT, bold=True)
                elif val > 0:
                    cell.fill = _fill(_GREEN_BG)
                    cell.font = Font(name="Arial", size=9, color=_GREEN_TEXT)

            if col in avg_thresh_map:
                t = avg_thresh_map[col]
                if t is not None and pd.notna(val) and pd.notna(t):
                    if val < t:
                        cell.fill = _fill(_RED_BG)
                        cell.font = Font(name="Arial", size=9, color=_RED_TEXT, bold=True)
                    elif val < t * 1.1:
                        cell.fill = _fill(_AMBER_BG)
                        cell.font = Font(name="Arial", size=9, color=_AMBER_TEXT)

    wt.column_dimensions["A"].width = 24
    for c in range(2, len(TREND_COLS) + 1):
        wt.column_dimensions[get_column_letter(c)].width = 11
    wt.freeze_panes = "B4"


def _build_level_distribution_sheet(writer, flagDf, compDf, cohortDf, thresholds,
                                     cohort, formType, config, mappingFile=None):
    """% at each rating level per student."""
    LEVEL_COLS = list(_ID_COLS)
    for prefix, levels in [("es", [1,2,3,4]), ("gr", [1,2,3,4,5]),
                            ("ts", [1,2,3,4]), ("cs", [1,2]), ("ps", [1,2])]:
        for lvl in levels:
            LEVEL_COLS.append(f"{prefix}_lvl{lvl}_pct")

    LEVEL_FRIENDLY = {**_ID_FRIENDLY}
    for prefix, name, levels in [("es","ES",[1,2,3,4]), ("gr","GR",[1,2,3,4,5]),
                                  ("ts","TS",[1,2,3,4]), ("cs","CS",[1,2]), ("ps","PS",[1,2])]:
        for lvl in levels:
            LEVEL_FRIENDLY[f"{prefix}_lvl{lvl}_pct"] = f"{name} L{lvl}%"

    levelDf = flagDf[LEVEL_COLS].copy()
    levelDf.to_excel(writer, sheet_name="Level Distribution", index=False, startrow=2)
    wl = writer.sheets["Level Distribution"]

    _styleHeader(wl, 1, len(LEVEL_COLS), f"{cohort} {formType} — Level Distribution (%)")
    _styleColumnHeaders(wl, 3, LEVEL_COLS, LEVEL_FRIENDLY)

    BAD_LEVEL_COLS = {f"{p}_lvl{l}_pct"
                      for p, ls in [("es",[1]),("gr",[1,2]),("ts",[1]),("cs",[1]),("ps",[1])]
                      for l in ls}
    GOOD_LEVEL_COLS = {f"{p}_lvl{l}_pct"
                       for p, ls in [("es",[3,4]),("gr",[4,5]),("ts",[3,4])]
                       for l in ls}

    for r_idx, (_, row) in enumerate(levelDf.iterrows(), start=4):
        is_alt = (r_idx % 2 == 0)
        row_bg = _fill(_LIGHT_GREY) if is_alt else _fill(_WHITE)
        for c_idx, col in enumerate(LEVEL_COLS, start=1):
            cell = wl.cell(row=r_idx, column=c_idx)
            val  = row[col]
            cell.value     = val
            cell.font      = _BODY_FONT
            cell.border    = _thin_border()
            cell.alignment = Alignment(horizontal="center", vertical="center")
            cell.fill      = row_bg

            if pd.notna(val) and col != "student_name":
                if col in BAD_LEVEL_COLS and val > 20:
                    cell.fill = _fill(_RED_BG)
                    cell.font = Font(name="Arial", size=9, color=_RED_TEXT, bold=True)
                elif col in BAD_LEVEL_COLS and val > 10:
                    cell.fill = _fill(_AMBER_BG)
                    cell.font = Font(name="Arial", size=9, color=_AMBER_TEXT)
                elif col in GOOD_LEVEL_COLS and val > 50:
                    cell.fill = _fill(_GREEN_BG)
                    cell.font = Font(name="Arial", size=9, color=_GREEN_TEXT)

    wl.column_dimensions["A"].width = 24
    for c in range(2, len(LEVEL_COLS) + 1):
        wl.column_dimensions[get_column_letter(c)].width = 9
    wl.freeze_panes = "B4"


def _build_comparison_sheet(writer, flagDf, compDf, cohortDf, thresholds,
                             cohort, formType, config, mappingFile=None):
    """Student vs cohort avg per item/section (long form)."""
    if compDf.empty:
        return

    group_col  = "item_code" if formType == "Simulation" else "Section"
    comp_sheet = "Item Comparison" if formType == "Simulation" else "Section Comparison"
    header_lbl = "Item Code" if formType == "Simulation" else "Section"

    COMP_COLS = _ID_COLS + [group_col, "count", "cohort_avg_count", "pct_of_cohort", "behind"]
    COMP_FRIENDLY = {
        **_ID_FRIENDLY,
        "item_code": "Item Code", "Section": "Section",
        "count": "Count", "cohort_avg_count": "Cohort Avg",
        "pct_of_cohort": "% of Cohort", "behind": "Behind?",
    }
    compOut = compDf[COMP_COLS].copy()
    compOut["cohort_avg_count"] = compOut["cohort_avg_count"].round(2)
    compOut.to_excel(writer, sheet_name=comp_sheet, index=False, startrow=2)
    wc = writer.sheets[comp_sheet]

    _styleHeader(wc, 1, len(COMP_COLS), f"{cohort} {formType} — {header_lbl} vs Cohort Avg")
    _styleColumnHeaders(wc, 3, COMP_COLS, COMP_FRIENDLY)

    pct_idx    = COMP_COLS.index("pct_of_cohort") + 1
    behind_idx = COMP_COLS.index("behind") + 1

    for r_idx, (_, row) in enumerate(compOut.iterrows(), start=4):
        is_alt = (r_idx % 2 == 0)
        row_bg = _fill(_LIGHT_GREY) if is_alt else _fill(_WHITE)
        for c_idx, col in enumerate(COMP_COLS, start=1):
            cell = wc.cell(row=r_idx, column=c_idx)
            cell.value     = row[col]
            cell.font      = _BODY_FONT
            cell.border    = _thin_border()
            cell.alignment = Alignment(horizontal="center", vertical="center")
            cell.fill      = row_bg

        pct_val = row["pct_of_cohort"]
        if pd.notna(pct_val):
            pc = wc.cell(row=r_idx, column=pct_idx)
            if pct_val < 0.5:
                pc.fill = _fill(_RED_BG);   pc.font = Font(name="Arial", size=9, color=_RED_TEXT,   bold=True)
            elif pct_val < 0.9:
                pc.fill = _fill(_AMBER_BG); pc.font = Font(name="Arial", size=9, color=_AMBER_TEXT)
            else:
                pc.fill = _fill(_GREEN_BG); pc.font = Font(name="Arial", size=9, color=_GREEN_TEXT)

        bc = wc.cell(row=r_idx, column=behind_idx)
        if row["behind"]:
            bc.value = "✓"; bc.fill = _fill(_RED_BG)
            bc.font  = Font(name="Arial", size=9, color=_RED_TEXT, bold=True)
        else:
            bc.value = "";  bc.fill = _fill(_GREEN_BG)
            bc.font  = Font(name="Arial", size=9, color=_GREEN_TEXT)

    wc.column_dimensions["A"].width = 24
    wc.column_dimensions["B"].width = 20
    for c in range(3, len(COMP_COLS) + 1):
        wc.column_dimensions[get_column_letter(c)].width = 14
    wc.freeze_panes = "C4"


def _build_count_pivot_sheet(writer, flagDf, compDf, cohortDf, thresholds,
                              cohort, formType, config, mappingFile=None):
    """Student x item/section count matrix. Section grouping highlights cells below
    half the column average (behindRatio, like the Section Comparison); item-code
    grouping keeps the bottom-percentile rule."""
    countPivot, groupColName = _buildCountPivot(cohortDf, formType, mappingFile)
    if countPivot.empty:
        return
    pvt_sheet = f"{'Item Code' if formType == 'Simulation' else 'Section'} Count Pivot"
    # Section Count Pivot -> below-half-average highlight (behindRatio). Item-code
    # count pivots (Simulation here) use the configurable countHighlightMode.
    if groupColName == "Section":
        highlight = {"mode": "mean_fraction", "ratio": getattr(config, "behindRatio", 0.5)}
    else:
        highlight = _itemCountHighlightSpec(config)
    _writeCountPivotSheet(writer, countPivot, groupColName, cohort, formType, pvt_sheet,
                          highlight=highlight)


def _build_item_code_count_pivot_sheet(writer, flagDf, compDf, cohortDf, thresholds,
                                        cohort, formType, config, mappingFile=None):
    """Student x item_code count matrix — the item-code twin of the Section Count
    Pivot, so Clinic gets the per-item counts alongside the Item Code Score Pivot
    (2026-08-19, user request). Skipped for Simulation, where the Count Pivot already
    groups by item_code and the sheet name would collide."""
    if formType == "Simulation":
        print("[item_code_count_pivot] skipped — Simulation already groups the "
              "Count Pivot by item_code")
        return
    countPivot, groupColName = _buildCountPivot(cohortDf, formType, mappingFile,
                                                groupBy="item_code")
    if countPivot.empty:
        return
    _writeCountPivotSheet(writer, countPivot, groupColName, cohort, formType,
                          "Item Code Count Pivot",
                          highlight=_itemCountHighlightSpec(config))


def _writeCountPivotSheet(writer, countPivot, groupColName, cohort, formType, pvt_sheet,
                          highlight=None):
    """Shared renderer for the Section / Item Code count pivots. ``highlight`` is a
    spec dict {mode, ratio, minMean, sdK, percentile} passed to _colorPivotByMode;
    None = the default bottom-25% percentile rule."""
    countPivot.to_excel(writer, sheet_name=pvt_sheet, index=False, startrow=2)
    wp = writer.sheets[pvt_sheet]

    pvt_cols = list(countPivot.columns)
    _styleHeader(wp, 1, len(pvt_cols), f"{cohort} {formType} — {groupColName} Counts per Student")
    _styleColumnHeaders(wp, 3, pvt_cols,
                        {"student_number": "ID", "student_name": "Student", "Total": "Total"})
    _colorPivotByMode(wp, countPivot, 3, 4, **(highlight or {"mode": "percentile"}))

    wp.column_dimensions["A"].width = 12
    wp.column_dimensions["B"].width = 24
    _autofitPivotHeaders(wp, pvt_cols, start_col=3)
    wp.freeze_panes = "C4"


def _build_gr_pivot_sheet(writer, flagDf, compDf, cohortDf, thresholds,
                           cohort, formType, config, mappingFile=None):
    """Student x item/section mean GR matrix."""
    grPivot, grGroupCol = _buildGrPivot(cohortDf, formType, mappingFile)
