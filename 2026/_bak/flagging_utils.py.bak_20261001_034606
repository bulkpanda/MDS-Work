def _fill(hex_color):
    return PatternFill(start_color=hex_color, end_color=hex_color, fill_type="solid")


def _thin_border():
    s = Side(style="thin", color=_MID_GREY)
    return Border(left=s, right=s, top=s, bottom=s)


def _computeSlope(series):
    vals = series.dropna()
    if len(vals) < 2:
        return np.nan
    x = np.arange(len(vals), dtype=float)
    return float(np.polyfit(x, vals.values, 1)[0])


def _itemCodeCounts(cohortDf):
    """Explode item_codes arrays into (student_number, item_code, count) long table."""
    rows = []
    for _, row in cohortDf.iterrows():
        codes = row.get("item_codes")
        if not isinstance(codes, list) or not codes:
            continue
        for code in codes:
            if code:
                rows.append({"student_number": row["student_number"], "item_code": str(code)})
    if not rows:
        return pd.DataFrame(columns=["student_number", "item_code", "count"])
    return pd.DataFrame(rows).groupby(["student_number", "item_code"]).size().reset_index(name="count")


def _levelDistribution(series, levels):
    """Return {lvl: pct} for each level in `levels`, as % of non-null values."""
    total = series.dropna().shape[0]
    if total == 0:
        return {lvl: np.nan for lvl in levels}
    return {lvl: round((series == lvl).sum() / total * 100, 1) for lvl in levels}


def _buildCountPivot(cohortDf, formType, mappingFile=None, groupBy=None):
    """Student x item_code (Sim) or student x section (Clinic) count pivot.

    ``groupBy`` overrides the formType default: "item_code" forces item-code
    grouping even for Clinic (the Item Code Count Pivot sheet), "section" forces
    Section, None keeps the historical default."""
    countLong = _itemCodeCounts(cohortDf)
    if countLong.empty:
        return pd.DataFrame(), None

    nameMap = cohortDf[["student_number", "student_name"]].drop_duplicates()
    countLong = countLong.merge(nameMap, on="student_number", how="left")

    useSection = (groupBy == "section") or (groupBy is None and formType == "Clinic")
    if useSection:
        mappingDf = _loadSectionMapping(mappingFile)
        codeToSection = mappingDf.set_index("Item Code")["Section"].to_dict()

        def _resolve(code):
            code = str(code).strip()
            if code in codeToSection:
                return codeToSection[code]
            base = code.split("/")[0].strip()
            numPart = base.split("-")[0]
            if numPart.isdigit():
                base = numPart
            return codeToSection.get(base, "Unmapped")

        countLong["group"] = countLong["item_code"].apply(_resolve)
        groupCol = "Section"
    else:
        countLong["group"] = countLong["item_code"]
        groupCol = "Item Code"

    pivot = countLong.pivot_table(
        index=["student_number", "student_name"],
        columns="group", values="count",
        aggfunc="sum", fill_value=0,
    ).reset_index()
    pivot.columns.name = None
    pivot["Total"] = pivot.iloc[:, 2:].sum(axis=1)
    pivot.sort_values("student_name", inplace=True)
    pivot.reset_index(drop=True, inplace=True)
    return pivot, groupCol


def _buildGrPivot(cohortDf, formType, mappingFile=None):
    """Student x item_code (Sim) or student x section (Clinic) mean GR pivot."""
    rows = []
    for _, row in cohortDf.iterrows():
        codes = row.get("item_codes")
        gr    = row.get("global_rating")
        if not isinstance(codes, list) or not codes:
            continue
        gr_val = pd.to_numeric(gr, errors="coerce")
        for code in codes:
            if code:
                rows.append({
                    "student_number": row["student_number"],
                    "student_name":   row["student_name"],
                    "item_code":      str(code),
                    "gr":             gr_val,
                })
    if not rows:
        return pd.DataFrame(), None

    long = pd.DataFrame(rows)

    if formType == "Clinic":
        mappingDf = _loadSectionMapping(mappingFile)
        codeToSection = mappingDf.set_index("Item Code")["Section"].to_dict()

        def _resolve(code):
            code = str(code).strip()
            if code in codeToSection:
                return codeToSection[code]
            base = code.split("/")[0].strip()
            numPart = base.split("-")[0]
            if numPart.isdigit():
                base = numPart
            return codeToSection.get(base, "Unmapped")

        long["group"] = long["item_code"].apply(_resolve)
        groupCol = "Section"
    else:
        long["group"] = long["item_code"]
        groupCol = "Item Code"

    pivot = long.pivot_table(
        index=["student_number", "student_name"],
        columns="group", values="gr",
        aggfunc="mean", fill_value=np.nan,
    ).reset_index()
    pivot.columns.name = None
    numCols = [c for c in pivot.columns if c not in ("student_number", "student_name")]
    pivot[numCols] = pivot[numCols].round(2)
    pivot.sort_values("student_name", inplace=True)
    pivot.reset_index(drop=True, inplace=True)
    return pivot, groupCol


