# ═══════════════════════════════════════════════════════════════════════════
# Role / patient-detail normalisation  (2026-08-18)
# ───────────────────────────────────────────────────────────────────────────
# DASH stores these two fields as CODES on the v3 form template ("O"/"SO"/"OB",
# "ISP"/"FTA"/…) but as full LABELS on the older one ("Operator", "I saw a
# patient"). getFlagDf used to test the label spelling only, so every v3-coded
# form counted as neither operator nor patient-seen. Both spellings are folded
# to the label form here before anything is counted.
#
# The authoritative source is each form's context_schema_snapshot (see
# boh2_dds2_dds3_utils.ROLE_LABELS_FALLBACK / PATIENT_DETAIL_LABELS_FALLBACK);
# these constants are the same fallback, duplicated rather than imported to keep
# flagging_utils free of a boh2_dds2_dds3_utils dependency.
# ═══════════════════════════════════════════════════════════════════════════
ROLE_OPERATOR       = "Operator"
ROLE_SUPPORT        = "Support Operator"
ROLE_OBSERVATION    = "Observation"
PATIENT_SEEN_LABEL  = "I saw a patient"

ROLE_CODE_TO_LABEL = {
    "O": ROLE_OPERATOR,   "OPERATOR": ROLE_OPERATOR,
    "SO": ROLE_SUPPORT,   "SUPPORT OPERATOR": ROLE_SUPPORT, "SECOND OPERATOR": ROLE_SUPPORT,
    "OB": ROLE_OBSERVATION, "OBSERVATION": ROLE_OBSERVATION, "OBSERVER": ROLE_OBSERVATION,
}
PATIENT_DETAIL_CODE_TO_LABEL = {
    "ISP": PATIENT_SEEN_LABEL, "I SAW A PATIENT": PATIENT_SEEN_LABEL,
    "FTA": "Failed to attend (FTA)", "FAILED TO ATTEND (FTA)": "Failed to attend (FTA)",
    "PCW": "Patient cancelled within 24 hours",
    "NPB": "New patient block not filled",
    "UBP": "Unable to book a patient",
}


def normalizeRole(value):
    """'O' / 'Operator' -> 'Operator'; 'SO' -> 'Support Operator'; blank/NaN -> None.

    An unrecognised value is returned stripped and unchanged (so nothing is
    silently lost) — it simply won't match ROLE_OPERATOR."""
    if value is None or (isinstance(value, float) and pd.isna(value)):
        return None
    text = str(value).strip()
    if text == "" or text.lower() in ("nan", "none", "unknown"):
        return None
    return ROLE_CODE_TO_LABEL.get(text.upper(), text)


def normalizePatientDetail(value):
    """'ISP' / 'I saw a patient' -> 'I saw a patient'; blank/NaN -> None."""
    if value is None or (isinstance(value, float) and pd.isna(value)):
        return None
    text = str(value).strip()
    if text == "" or text.lower() in ("nan", "none", "unknown"):
        return None
    return PATIENT_DETAIL_CODE_TO_LABEL.get(text.upper(), text)


def patientSeenMask(grp, requireOperator=True):
    """Boolean mask over *grp* of forms that count as "a patient was seen".

    Config.xlsx ("All" row): *students put Support Operator and Patient Attended
    together, so for the patient count we need role = Operator AS WELL AS patient
    attended — not valid for final-year forms, which have no role field.*

    So a form counts when the patient detail is "I saw a patient" AND the role is
    Operator. Forms carrying NO role at all (final-year DDS4/BOH3 templates) are
    exempt from the role half of the test and count on the patient detail alone,
    which keeps those cohorts working unchanged. ``requireOperator=False``
    restores the old any-role behaviour.
    """
    seen = grp["patient_details"].map(normalizePatientDetail).eq(PATIENT_SEEN_LABEL)
    if not requireOperator or "role" not in grp.columns:
        return seen
    role = grp["role"].map(normalizeRole)
    return seen & (role.isna() | role.eq(ROLE_OPERATOR))


def patientFtaMask(grp, requireOperator=True):
    """Boolean mask over *grp* of forms recording a patient FTA (failed to attend).

    Gated exactly like ``patientSeenMask`` (2026-08-19): an FTA logged while the
    student was only the Support Operator double-counts the same chair, so — like
    "patient seen" — an FTA counts only when role = Operator. Forms with NO role
    field (final-year templates) are exempt and count on the detail alone.
    ``requireOperator=False`` restores the old any-role count.
    """
    fta = grp["patient_details"].map(normalizePatientDetail).map(
        lambda x: bool(x) and "FTA" in str(x).upper())
    if not requireOperator or "role" not in grp.columns:
        return fta
    role = grp["role"].map(normalizeRole)
    return fta & (role.isna() | role.eq(ROLE_OPERATOR))


# ═══════════════════════════════════════════════════════════════════════════
# Semester ("half year") filter for a cohort DataFrame  (2026-08-18)
# ═══════════════════════════════════════════════════════════════════════════
def filterCohortDfByPeriod(cohortDf, period=PERIOD_ALL, minDate=None, maxDate=None,
                            dateCol="datetimeutc", tz="Australia/Melbourne", verbose=True):
    """Restrict *cohortDf* to one half of the year and return (df, label, bounds).

    ``period`` takes the same values as the weekly-sim chain — 'FHY' (before
    SEMESTER_SPLIT_DATE), 'SHY' (on/after it), 'ALL' (no filter, the default and
    the original behaviour) plus the SEM1/S1/H1 aliases. Explicit minDate/maxDate
    win over the period's own bounds. Both bounds are INCLUSIVE.

    The comparison is done on the **Melbourne-local** date, not the raw UTC one:
    DASH timestamps are stored in UTC, so a late-afternoon Melbourne session sits
    on the previous UTC day and a naive `.dt.date` would put it in the wrong
    semester around the 15 June boundary. (Same trap as the weekly-sim
    `datetimeutc::date` note.)

    Returns (filteredDf, label, (minDate, maxDate)).
    """
    minDate, maxDate, label = resolvePeriod(period, minDate, maxDate)
    if (cohortDf is None or len(cohortDf) == 0
            or (not minDate and not maxDate)):
        return cohortDf, label, (minDate, maxDate)

    ts = pd.to_datetime(cohortDf[dateCol], utc=True, errors="coerce")
    try:
        localDate = ts.dt.tz_convert(tz).dt.normalize().dt.tz_localize(None)
    except Exception:                      # pragma: no cover — tz db missing
        localDate = ts.dt.normalize().dt.tz_localize(None)

    mask = pd.Series(True, index=cohortDf.index)
    if minDate:
        mask &= localDate >= pd.Timestamp(minDate)
    if maxDate:
        mask &= localDate <= pd.Timestamp(maxDate)
    # Rows with an unparseable date are dropped from a bounded period rather than
    # silently landing in both halves.
    mask &= localDate.notna()

    out = cohortDf[mask].copy()
    if verbose:
        print(f"[period] {label}: {minDate or '—'} .. {maxDate or '—'}  "
              f"kept {len(out)}/{len(cohortDf)} forms, "
              f"{out['student_number'].nunique() if 'student_number' in out else '?'} students")
    return out, label, (minDate, maxDate)


