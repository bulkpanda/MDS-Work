# _build_item_scale_donut_sheet
# ═══════════════════════════════════════════════════════════════════════════
_PIE_SCALE_COLORS = ["#2E75B6", "#70AD47", "#FFD966", "#ED7D31", "#FF3333", "#BFBFBF"]
# O1 Done Well=blue  O2 Done=green  O3 Mostly=amber  O4 Sometimes=orange  O5 Not Done=red  O6 Not Observed=grey
_PIE_SCALE_KEYS   = ["O1", "O2", "O3", "O4", "O5", "O6"]
_PIE_PX           = 52   # pixel size of each donut

def _render_donut(sd, count, px=_PIE_PX, dpi=96):
    """Render a tiny donut PNG into a BytesIO buffer. Returns None if no data."""
    import io as _io
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt

    vals = [sd.get(k, 0) for k in _PIE_SCALE_KEYS]
    if sum(vals) == 0:
        return None
    nz = [(vals[i], _PIE_SCALE_COLORS[i]) for i in range(6) if vals[i] > 0]
    pie_vals, pie_cols = zip(*nz)

    fig = plt.figure(figsize=(px / dpi, px / dpi), dpi=dpi)
    ax  = fig.add_axes([0.02, 0.02, 0.96, 0.96])
    ax.pie(pie_vals, colors=pie_cols, startangle=90,
           wedgeprops=dict(width=0.55, linewidth=0))
    ax.text(0, 0, str(int(count)),
            ha="center", va="center",
            fontsize=max(4, px // 10), fontweight="bold", color="#222222")
    buf = _io.BytesIO()
    fig.savefig(buf, format="png", dpi=dpi, transparent=True,
                bbox_inches="tight", pad_inches=0)
    plt.close(fig)
    buf.seek(0)
    return buf


def _build_item_scale_donut_sheet(writer, flagDf, compDf, cohortDf, thresholds,
                                   cohort, formType, config, mappingFile=None):
    """
    Student × reportable-item pivot.
    Each data cell shows a tiny donut chart: slices = O1-O6 scale distribution,
    count in centre.  Operator forms only.
    """
    from openpyxl.drawing.image import Image as _XLImage

    reportableItems = DDS3_REPORTABLE_ITEMS

    # Flatten item codes in category order
    all_items = []
    cat_spans = []   # (label, n_cols)
    for cat, codes in reportableItems.items():
        strs = [str(c) for c in codes]
        all_items.extend(strs)
        cat_spans.append((cat, len(strs)))

    # ── Parse assessor_data per (student, item_code) ──────────────────────
    # scale_data[(snum, icode)] = {O1: n, O2: n, ...}
    scale_data = {}
    op_df = cohortDf[cohortDf["role"].map(normalizeRole).eq(ROLE_OPERATOR)] \
            if "role" in cohortDf.columns else cohortDf
    for _, row in op_df.iterrows():
        snum = row["student_number"]
        ad   = row.get("assessor_data")
        if ad is None:
            continue
        if isinstance(ad, str):
            try:
                ad = json.loads(ad)
            except Exception:
                continue
        if not isinstance(ad, dict):
            continue
        for icode, sub in ad.items():
            if not isinstance(sub, dict):
                continue
            key = (snum, str(icode))
            if key not in scale_data:
                scale_data[key] = {k: 0 for k in _PIE_SCALE_KEYS}
            # values are scale codes e.g. "O1", "O2" — not the keys
            for v in sub.values():
                sk = str(v).strip()
                if sk in scale_data[key]:
                    scale_data[key][sk] += 1

    # Student list ordered by name
    students = (flagDf[["student_number", "student_name"]]
                .drop_duplicates()
                .sort_values("student_name")
                .values.tolist())

    # ── Create sheet ──────────────────────────────────────────────────────
    sheet_name = "Item Scale Donuts"
    ws = writer.book.create_sheet(sheet_name)
    writer.sheets[sheet_name] = ws

    N_TOTAL = 2 + len(all_items)

    # Row 1: title (merged)
    ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=N_TOTAL)
    title_cell = ws.cell(row=1, column=1,
                         value=f"{cohort} {formType} — Item Scale Distribution (Operator forms)")
    title_cell.fill      = _fill(_NAVY)
    title_cell.font      = Font(name="Arial", size=11, color="FFFFFF", bold=True)
    title_cell.alignment = Alignment(horizontal="center", vertical="center")
    ws.row_dimensions[1].height = 20

    # Row 2: category sub-headers
    ws.cell(row=2, column=1).value = "ID"
    ws.cell(row=2, column=2).value = "Student"
    col_cursor = 3
    for cat_label, n_cols in cat_spans:
        if n_cols > 1:
            ws.merge_cells(start_row=2, start_column=col_cursor,
                           end_row=2, end_column=col_cursor + n_cols - 1)
        cell = ws.cell(row=2, column=col_cursor, value=cat_label)
        cell.fill      = _fill("2E4057")   # dark slate — distinct from item header
        cell.font      = Font(name="Arial", size=8, color="FFFFFF", bold=True)
        cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
        cell.border    = _thin_border()
        col_cursor    += n_cols
    ws.row_dimensions[2].height = 20

    # Row 3: item code headers
    for c_meta, label in enumerate(["ID", "Student"], start=1):
        cell = ws.cell(row=3, column=c_meta, value=label)
        cell.fill      = _fill(_NAVY)
        cell.font      = Font(name="Arial", size=9, color="FFFFFF", bold=True)
        cell.alignment = Alignment(horizontal="center", vertical="center")
        cell.border    = _thin_border()
    for c_idx, icode in enumerate(all_items, start=3):
        cell = ws.cell(row=3, column=c_idx, value=icode)
        cell.fill      = _fill(_NAVY)
        cell.font      = Font(name="Arial", size=8, color="FFFFFF", bold=True)
        cell.alignment = Alignment(horizontal="center", vertical="center")
        cell.border    = _thin_border()
    ws.row_dimensions[3].height = 16

    # Row height for data rows — tall enough for donut
    ROW_H_PT = 42   # points
    COL_W    = 6.5  # chars

    # ── Data rows ─────────────────────────────────────────────────────────
    for r_idx, (snum, sname) in enumerate(students, start=4):
        ws.row_dimensions[r_idx].height = ROW_H_PT
        is_alt = (r_idx % 2 == 0)
        row_bg = _fill(_LIGHT_GREY) if is_alt else _fill(_WHITE)

        for meta_col, val in [(1, snum), (2, sname)]:
            cell           = ws.cell(row=r_idx, column=meta_col, value=val)
            cell.font      = _BODY_FONT
            cell.border    = _thin_border()
            cell.fill      = row_bg
            cell.alignment = Alignment(horizontal="left", vertical="center")

        for c_idx, icode in enumerate(all_items, start=3):
            cell           = ws.cell(row=r_idx, column=c_idx)
            cell.fill      = row_bg
            cell.border    = _thin_border()

            sd  = scale_data.get((snum, icode))
            cnt = sum(sd.values()) if sd else 0
            if not sd or cnt == 0:
                cell.value     = ""
                continue

            # Leave cell value blank — count shown inside donut
            cell.value = ""

            buf = _render_donut(sd, cnt)
            if buf is None:
                continue
            img        = _XLImage(buf)
            img.width  = _PIE_PX
            img.height = _PIE_PX
            img.anchor = f"{get_column_letter(c_idx)}{r_idx}"
            ws.add_image(img)

    # ── Legend row at bottom ──────────────────────────────────────────────
    legend_row = 4 + len(students)
    ws.row_dimensions[legend_row].height = 14
    legend_labels = ["Done Well (O1)", "Done (O2)", "Mostly (O3)",
                     "Sometimes (O4)", "Not Done (O5)", "Not Observed (O6)"]
    _LEGEND_START_COL = 7  # offset so legend doesn't crowd the ID/Name columns
    for i, (label, color) in enumerate(zip(legend_labels, _PIE_SCALE_COLORS)):
        cell           = ws.cell(row=legend_row, column=_LEGEND_START_COL + i, value=label)
        cell.fill      = _fill(color.lstrip("#"))
        cell.font      = Font(name="Arial", size=8,
                              color="FFFFFF" if i in (0, 4) else "222222", bold=True)
        cell.alignment = Alignment(horizontal="center", vertical="center")
        cell.border    = _thin_border()

    # ── Column widths ─────────────────────────────────────────────────────
    ws.column_dimensions["A"].width = 12
    ws.column_dimensions["B"].width = 24
    for c in range(3, 3 + len(all_items)):
        ws.column_dimensions[get_column_letter(c)].width = COL_W

    ws.freeze_panes = "C4"


# ═══════════════════════════════════════════════════════════════════════════
# Sheet builder: average checklist score per SECTION  (2026-08-18)
# — the score twin of "Section GR Pivot". That sheet answers "how were they
#   rated overall in Restorative"; this one answers "how well did they do the
#   Restorative items themselves", using the 0-1 checklist score calcScore
#   produces (Done well=1.0, Done=0.8, Mostly=0.6, Sometimes=0.4, Not done=0.0).
# — calcScore already drops Observation / Support-Operator forms, so these are
#   the student's own operating scores.
# ═══════════════════════════════════════════════════════════════════════════
# The two overall columns. Named constants because the sheet builder, the
# colouring rules and the footnote all have to agree on the exact header text.
# Which of them Summary uses is config.scoreWeighting, so the sheet marks it at
# render time rather than baking "= Summary Score" into a header that would go
# stale the moment the switch is flipped.
OVERALL_PER_ITEM = "Overall (per item)"
OVERALL_PER_FORM = "Overall (per form)"
OVERALL_BY_WEIGHTING = {SCORE_PER_FORM: OVERALL_PER_FORM, SCORE_PER_ITEM: OVERALL_PER_ITEM}


def buildSectionScorePivot(cohortDf, formType="Clinic", mappingFile=None, groupBy=None):
    """Student x Section (Clinic) or x item_code (Simulation) mean checklist score.

    ``groupBy`` overrides the default formType-based grouping: "item_code" forces
    an item-code pivot even for Clinic (used by the Item Code Score Pivot sheet),
    "section" forces Section grouping, None keeps the historical default.

    Returns (pivotDf, groupColName, countPivotDf). ``countPivotDf`` carries the
    number of scored items behind each cell (and the number of FORMS behind the
    per-form column), so a 1.00 built on a single item can be told apart from a
    1.00 built on twenty. Empty frame if nothing is scored.

    Two totals are produced, OVERALL_PER_ITEM and OVERALL_PER_FORM — see the long
    comment where they are computed. They legitimately disagree; the per-form one
    is the number Summary shows and the low_score flag uses.
    """
    rows, formMeans = [], []
    for formIdx, (_, row) in enumerate(cohortDf.iterrows()):
        scores = row.get("scores")
        if not isinstance(scores, dict) or not scores:
            continue
        formVals = []
        for code, payload in scores.items():
            val = payload.get("score") if isinstance(payload, dict) else payload
            val = pd.to_numeric(val, errors="coerce")
            if pd.isna(val):
                continue          # null / "Not Observed" items don't drag an average down
            formVals.append(float(val))
            rows.append({
                "student_number": row["student_number"],
                "student_name":   row["student_name"],
                "item_code":      str(code),
                "score":          float(val),
                "form_idx":       formIdx,
            })
        if formVals:
            # One value per FORM — this is exactly what Summary's avg_score
            # averages (getFlagDf._meanScore -> grp["_mean_score"].mean()), kept
            # here so the sheet can show both weightings side by side.
            formMeans.append({
                "student_number": row["student_number"],
                "student_name":   row["student_name"],
                "form_score":     float(np.mean(formVals)),
            })
    if not rows:
        return pd.DataFrame(), None, pd.DataFrame()

    long = pd.DataFrame(rows)

    useSection = (groupBy == "section") or (groupBy is None and formType == "Clinic")
    if useSection:
        mappingDf     = _loadSectionMapping(mappingFile)
        codeToSection = mappingDf.set_index("Item Code")["Section"].to_dict()

        def _resolve(code):
            code = str(code).strip()
            if code in codeToSection:
                return codeToSection[code]
            base    = code.split("/")[0].strip()
            numPart = base.split("-")[0]
            if numPart.isdigit():
                base = numPart
            return codeToSection.get(base, "Unmapped")

        long["group"] = long["item_code"].apply(_resolve)
        groupCol = "Section"
    else:
        long["group"] = long["item_code"]
        groupCol = "Item Code"

    idx = ["student_number", "student_name"]
    pivot = long.pivot_table(index=idx, columns="group", values="score",
                             aggfunc="mean").reset_index()
    counts = long.pivot_table(index=idx, columns="group", values="score",
                              aggfunc="count", fill_value=0).reset_index()
    pivot.columns.name  = None
    counts.columns.name = None

    # ── The two overall columns, and why there are two ────────────────────────
    # The section cells above are ITEM-weighted: every scored (form, item) pair is
    # one observation. Two different totals can be built on top of them, and they
    # do NOT agree — on the DDS2 FHY 2026 run the gap averaged 0.021 and reached
    # 0.064, moving one student 43 rank places:
    #
    #   OVERALL_PER_ITEM  mean over every scored item. Consistent with the section
    #     cells beside it, so it reconciles with them (weighted by each section's
    #     item count — NOT the plain mean of the section means, which would give a
    #     two-item section the same say as a forty-item one; that plain mean is
    #     off by up to 0.107 here).
    #   OVERALL_PER_FORM  mean over forms of each form's own item mean. This is
    #     EXACTLY Summary's "Score" (getFlagDf._meanScore -> _mean_score.mean()),
    #     and it is what the low_score flag is tested against. A single-item form
    #     carries the same weight as a twelve-item one.
    #
    # Both are shown so the sheet explains its own discrepancy instead of leaving
    # a reader to discover that two columns called "score" disagree. Summary and
    # the flagging are unchanged — per form remains the flagged definition.
    overall = long.groupby(idx)["score"].agg(["mean", "count"]).reset_index()
    pivot   = pivot.merge(
        overall[idx + ["mean"]].rename(columns={"mean": OVERALL_PER_ITEM}),
        on=idx, how="left")
    counts  = counts.merge(
        overall[idx + ["count"]].rename(columns={"count": OVERALL_PER_ITEM}),
        on=idx, how="left")

    formDf = pd.DataFrame(formMeans)
    perForm = (formDf.groupby(idx)["form_score"].agg(["mean", "count"]).reset_index()
               if not formDf.empty else
               pd.DataFrame(columns=idx + ["mean", "count"]))
    pivot  = pivot.merge(perForm[idx + ["mean"]].rename(columns={"mean": OVERALL_PER_FORM}),
                         on=idx, how="left")
    counts = counts.merge(perForm[idx + ["count"]].rename(columns={"count": OVERALL_PER_FORM}),
                          on=idx, how="left")

    numCols = [c for c in pivot.columns if c not in idx]
    pivot[numCols] = pivot[numCols].round(3)
    pivot.sort_values("student_name", inplace=True)
    counts = counts.set_index(idx).reindex(
        pd.MultiIndex.from_frame(pivot[idx])).reset_index()
    pivot.reset_index(drop=True, inplace=True)
    counts.reset_index(drop=True, inplace=True)
    return pivot, groupCol, counts


def _build_section_score_pivot_sheet(writer, flagDf, compDf, cohortDf, thresholds,
                                      cohort, formType, config, mappingFile=None):
    """Student x section average checklist score, with a cohort-average row."""
    pivot, groupCol, counts = buildSectionScorePivot(cohortDf, formType, mappingFile)
    if pivot.empty:
        return
    sheet = f"{'Item Code' if formType == 'Simulation' else 'Section'} Score Pivot"
    _writeScorePivotSheet(writer, pivot, groupCol, counts, thresholds,
                          cohort, formType, config, sheet)


def _build_item_code_score_pivot_sheet(writer, flagDf, compDf, cohortDf, thresholds,
                                        cohort, formType, config, mappingFile=None):
    """Student x item_code mean checklist score — the item-code twin of the
    Section Score Pivot, so Clinic gets the per-item view Simulation already has
    (2026-08-19, BOH2 request). Skipped for Simulation, where the Section Score
    Pivot already groups by item_code and the sheet name would collide."""
    if formType == "Simulation":
        print("[item_code_score_pivot] skipped — Simulation already groups the "
              "Section Score Pivot by item_code")
        return
    pivot, groupCol, counts = buildSectionScorePivot(cohortDf, formType, mappingFile,
                                                     groupBy="item_code")
    if pivot.empty:
        return
    _writeScorePivotSheet(writer, pivot, groupCol, counts, thresholds,
                          cohort, formType, config, "Item Code Score Pivot")


def _writeScorePivotSheet(writer, pivot, groupCol, counts, thresholds,
                          cohort, formType, config, sheet):
    """Shared renderer for the Section / Item Code checklist-score pivots."""
    activeCol = OVERALL_BY_WEIGHTING[
        resolveScoreWeighting(getattr(config, "scoreWeighting", SCORE_PER_FORM))]
    # Show only the Overall the Summary/flag uses (2026-08-19 user request); drop
    # the other of the two Overall columns from both the values and the counts.
    _inactiveCol = OVERALL_PER_FORM if activeCol == OVERALL_PER_ITEM else OVERALL_PER_ITEM
    pivot  = pivot.drop(columns=[_inactiveCol], errors="ignore")
    counts = counts.drop(columns=[_inactiveCol], errors="ignore")

    dataCols = [c for c in pivot.columns if c not in ("student_number", "student_name")]

    # Cohort average row — the unweighted mean of the students actually assessed
    # in that section (blank cells are absent, not zero).
    cohortRow = {"student_number": "", "student_name": "COHORT AVERAGE"}
    for c in dataCols:
        vals = pivot[c].dropna()
        cohortRow[c] = round(float(vals.mean()), 3) if len(vals) else np.nan
    outDf = pd.concat([pivot, pd.DataFrame([cohortRow])], ignore_index=True)

    outDf.to_excel(writer, sheet_name=sheet, index=False, startrow=2)
    ws = writer.sheets[sheet]

    allCols = list(outDf.columns)
    _styleHeader(ws, 1, len(allCols),
                 f"{cohort} {formType} — Average Checklist Score by {groupCol} (0-1) "
                 f"· '{activeCol}' matches the Summary Score column and the Low Score flag")
    _styleColumnHeaders(ws, 3, allCols,
                        {"student_number": "ID", "student_name": "Student"})

    scoreThresh = thresholds.get("score")
    if scoreThresh is None or pd.isna(scoreThresh):
        scoreThresh = 0.6
    cohortMeans = {c: cohortRow[c] for c in dataCols}

    lastDataRow = 3 + len(pivot)          # sheet row of the final student
    for r_off, (_, row) in enumerate(outDf.iterrows(), start=4):
        isCohortRow = (r_off == lastDataRow + 1)
        for c_off, col in enumerate(allCols, start=1):
            cell = ws.cell(row=r_off, column=c_off)
            cell.font      = _BOLD_BODY if isCohortRow else _BODY_FONT
            cell.border    = _thin_border()
            cell.alignment = Alignment(horizontal="center", vertical="center")
            if isCohortRow:
                cell.fill = _fill(_LIGHT_GREY)
            if col in ("student_number", "student_name"):
                cell.alignment = Alignment(horizontal="left", vertical="center")
                continue
            val = row[col]
            if pd.isna(val):
                # Not assessed in this section — grey, so "no data" never reads
                # as "scored badly".
                cell.fill = _fill(_MID_GREY)
                continue
            if isCohortRow:
                continue
            cohortMean = cohortMeans.get(col)
            if val <= scoreThresh:
                cell.fill  = _fill(_RED_BG)
                textColor, isBold = _RED_TEXT, True
            elif cohortMean is not None and pd.notna(cohortMean) and val < cohortMean:
                cell.fill  = _fill(_AMBER_BG)
                textColor, isBold = _AMBER_TEXT, False
            else:
                cell.fill  = _fill(_GREEN_BG)
                textColor, isBold = _GREEN_TEXT, False

            # A mean built on fewer than 3 scored items is set in italic, so a
            # 1.00 off one item is not read as a settled result.
            try:
                nItems = counts.loc[r_off - 4, col]
            except Exception:
                nItems = None
            isThin = nItems is not None and pd.notna(nItems) and nItems < 3
            cell.font = Font(name="Arial", size=9, color=textColor,
                             bold=isBold, italic=bool(isThin))

    noteFont = Font(name="Arial", size=8, italic=True)
    _weighting = resolveScoreWeighting(getattr(config, "scoreWeighting", SCORE_PER_FORM))
    notes = [
        (f"Red <= {scoreThresh} (Score threshold) · Amber = below the cohort average "
         f"for that {groupCol.lower()} · Green = at/above it · Grey = not assessed · "
         f"Italic = fewer than 3 scored items behind the average"),
        "",
        (f"'{activeCol}' is the same Score the Summary shows and the Low Score flag uses "
         f"(FlaggingConfig scoreWeighting={_weighting!r}). "
         + ("Each scored item counts once — sections are weighted by their own item count."
            if _weighting == SCORE_PER_ITEM else
            "Each form's own item mean, then averaged across forms — a one-item form counts "
            "as much as a twelve-item one.")),
    ]
    for i, text in enumerate(notes):
        c = ws.cell(row=lastDataRow + 3 + i, column=1, value=text)
        c.font = noteFont

    ws.column_dimensions["A"].width = 12
    ws.column_dimensions["B"].width = 26
    _autofitPivotHeaders(ws, allCols, start_col=3)
    ws.freeze_panes = "C4"


