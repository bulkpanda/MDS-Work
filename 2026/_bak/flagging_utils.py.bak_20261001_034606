    wg.column_dimensions["B"].width = 24
    _autofitPivotHeaders(wg, gr_cols, start_col=3)
    wg.freeze_panes = "C4"


def _build_clinical_incidents_sheet(writer, flagDf, compDf, cohortDf, thresholds,
                                     cohort, formType, config, mappingFile=None):
    """All clinical incident records."""
    if "clinical_incident" not in cohortDf.columns:
        print("[clinical_incidents] no 'clinical_incident' column on the cohort frame — "
              "sheet skipped")
        return
    # Context columns are optional: a missing assessor_name/role/clinic used to
    # raise KeyError and kill the WHOLE sheet, so a workbook silently arrived with
    # no incidents at all. Drop what isn't there and carry on.
    CI_CONTEXT = [c for c in ("assessor_name", "role", "clinic") if c in cohortDf.columns]
    missing    = [c for c in ("assessor_name", "role", "clinic") if c not in cohortDf.columns]
    if missing:
        print(f"[clinical_incidents] columns absent, omitted from the sheet: {missing}")

    ciDf = cohortDf[
        cohortDf["clinical_incident"].apply(lambda x: pd.notna(x) and str(x).strip() != "")
    ][["student_number", "student_name", "datetimeutc", "clinical_incident"]
      + CI_CONTEXT].copy()
    ciDf["datetimeutc"] = pd.to_datetime(ciDf["datetimeutc"], errors="coerce").dt.date
    ciDf.sort_values(["datetimeutc", "student_name"], ascending=[False, True], inplace=True)  # date DESC (newest first), name as tiebreak
    ciDf.reset_index(drop=True, inplace=True)
    if "role" in ciDf.columns:
        ciDf["role"] = ciDf["role"].map(normalizeRole)   # show labels, not v3 codes
    print(f"[clinical_incidents] {len(ciDf)} incident form(s) across "
          f"{ciDf['student_number'].nunique() if len(ciDf) else 0} student(s)")

    CI_COLS = (_ID_COLS + ["datetimeutc"]
               + [c for c in ("assessor_name",) if c in CI_CONTEXT]
               + ["clinical_incident"]
               + [c for c in ("role", "clinic") if c in CI_CONTEXT])
    CI_FRIENDLY = {
        **_ID_FRIENDLY,
        "datetimeutc": "Date", "assessor_name": "Assessor",
        "clinical_incident": "Incident Details", "role": "Role", "clinic": "Clinic",
    }
    ciDf[CI_COLS].to_excel(writer, sheet_name="Clinical Incidents", index=False, startrow=2)
    wci = writer.sheets["Clinical Incidents"]

    _styleHeader(wci, 1, len(CI_COLS), f"{cohort} {formType} — Clinical Incidents")
    _styleColumnHeaders(wci, 3, CI_COLS, CI_FRIENDLY)

    LEFT_ALIGN_COLS = {"student_name", "assessor_name", "clinical_incident"}
    left_align_idx  = {CI_COLS.index(c) + 1 for c in LEFT_ALIGN_COLS if c in CI_COLS}

    for r_idx in range(4, 4 + len(ciDf)):
        for c_idx in range(1, len(CI_COLS) + 1):
            cell = wci.cell(row=r_idx, column=c_idx)
            cell.font   = _BODY_FONT
            cell.border = _thin_border()
            cell.fill   = _fill(_LIGHT_GREY) if r_idx % 2 == 0 else _fill(_WHITE)
            if c_idx in left_align_idx:
                cell.alignment = Alignment(horizontal="left", vertical="center")
            else:
                cell.alignment = Alignment(horizontal="center", vertical="center")

    # Column widths keyed by field name so they stay correct regardless of CI_COLS order
    CI_WIDTHS = {
        "student_number":    10,
        "student_name":      24,
        "datetimeutc":       12,
        "assessor_name":     22,
        "clinical_incident": 70,
        "role":              10,
        "clinic":            16,
    }
    for col_name, width in CI_WIDTHS.items():
        if col_name in CI_COLS:
            wci.column_dimensions[get_column_letter(CI_COLS.index(col_name) + 1)].width = width
    wci.freeze_panes = "A4"


def _stripTags(val):
    """Plain text for Excel: drop <b>…</b> label markup from the reflection composites."""
    if val is None or (isinstance(val, float) and pd.isna(val)):
        return ""
    return re.sub(r"</?[^>]+>", "", str(val)).strip()


def _formItemCodes(row):
    """Item codes on one form (scale rows excluded), from item_codes, else the scores keys."""
    codes = row.get("item_codes")
    if not isinstance(codes, list) or not codes:
        scores = row.get("scores")
        codes = list(scores.keys()) if isinstance(scores, dict) else []
    out = [str(c) for c in codes if c and not str(c).lower().startswith("scale")]
    return ", ".join(dict.fromkeys(out))   # de-duplicated, order kept


def _build_low_professionalism_sheet(writer, flagDf, compDf, cohortDf, thresholds,
                                      cohort, formType, config, mappingFile=None):
    """Every form where Professionalism == config.professionalismLevel (default 1):
    student, Melbourne-local date, item codes, GR/ES/PS, assessor, clinic and the
    assessor + student comments. Grouped by student, then date. (2026-09-30, BOH1.)"""
    level = getattr(config, "professionalismLevel", 1)
    if "professionalism" not in cohortDf.columns:
        print("[low_professionalism] no 'professionalism' column — sheet skipped")
        return
    ps  = pd.to_numeric(cohortDf["professionalism"], errors="coerce")
    sub = cohortDf[ps == level].copy()

    dt = pd.to_datetime(sub["datetimeutc"], utc=True, errors="coerce")
    sub["date"]       = dt.dt.tz_convert("Australia/Melbourne").dt.date
    sub["itemCodes"]  = sub.apply(_formItemCodes, axis=1)
    for c in ("global_rating", "entrustment", "professionalism"):
        sub[c] = pd.to_numeric(sub[c], errors="coerce") if c in sub.columns else None
    aCol = next((c for c in ("assessor_reflection_full", "assessor_reflection") if c in sub.columns), None)
    sCol = next((c for c in ("student_reflection_full", "student_reflection") if c in sub.columns), None)
    sub["assessorComments"] = sub[aCol].map(_stripTags) if aCol else ""
    sub["studentComments"]  = sub[sCol].map(_stripTags) if sCol else ""
    ctx = [c for c in ("assessor_name", "clinic") if c in sub.columns]

    cols = (_ID_COLS + ["date", "itemCodes", "global_rating", "entrustment", "professionalism"]
            + ctx + ["assessorComments", "studentComments"])
    friendly = {**_ID_FRIENDLY, "date": "Date", "itemCodes": "Item Codes",
                "global_rating": "GR", "entrustment": "ES", "professionalism": "PS",
                "assessor_name": "Assessor", "clinic": "Clinic",
                "assessorComments": "Assessor Comments", "studentComments": "Student Comments"}
    sub = sub.sort_values(["student_name", "date"]).reset_index(drop=True)[cols]
    nStu = sub["student_number"].nunique() if len(sub) else 0
    print(f"[low_professionalism] {len(sub)} form(s) with PS = {level} across {nStu} student(s)")

    sheet = f"Professionalism {level}"
    sub.to_excel(writer, sheet_name=sheet, index=False, startrow=2)
    ws = writer.sheets[sheet]
    _styleHeader(ws, 1, len(cols),
                 f"{cohort} {formType} — Forms with Professionalism = {level} "
                 f"({len(sub)} forms, {nStu} students)")
    _styleColumnHeaders(ws, 3, cols, friendly)

    wrapCols = {"assessorComments", "studentComments", "itemCodes"}
    leftCols = wrapCols | {"student_name", "assessor_name", "clinic"}
    prev, shade = None, False
    for r in range(4, 4 + len(sub)):
        stu = sub.iat[r - 4, 0]
        if stu != prev:                       # alternate shading per STUDENT block
            shade, prev = not shade, stu
        for c, name in enumerate(cols, start=1):
            cell = ws.cell(row=r, column=c)
            cell.font, cell.border = _BODY_FONT, _thin_border()
            cell.fill = _fill(_LIGHT_GREY) if shade else _fill(_WHITE)
            cell.alignment = Alignment(horizontal="left" if name in leftCols else "center",
                                       vertical="top", wrap_text=name in wrapCols)
            if name == "date":
                cell.number_format = "dd/mm/yyyy"
    widths = {"student_number": 10, "student_name": 24, "date": 12, "itemCodes": 22,
              "global_rating": 6, "entrustment": 6, "professionalism": 6,
              "assessor_name": 22, "clinic": 14, "assessorComments": 70, "studentComments": 60}
    for name, w in widths.items():
        if name in cols:
            ws.column_dimensions[get_column_letter(cols.index(name) + 1)].width = w
    ws.freeze_panes = "C4"


def _build_legend_sheet(writer, flagDf, compDf, cohortDf, thresholds,
                         cohort, formType, config, mappingFile=None):
    """Threshold reference, colour key, and scale guide — auto-derived from active flags."""
    specs = config.resolve_flags()
    wleg  = writer.book.create_sheet("Legend")

    def _lh(row, text):
        wleg.merge_cells(f"A{row}:D{row}")
        c = wleg.cell(row=row, column=1, value=text)
        c.font = _HEADER_FONT; c.fill = _fill(_NAVY)
        c.alignment = Alignment(horizontal="left", vertical="center")
        wleg.row_dimensions[row].height = 20

    def _lr(row, label, value, note=""):
        wleg.cell(row=row, column=1, value=label).font = _BOLD_BODY
        wleg.cell(row=row, column=2, value=value).font = _BODY_FONT
        wleg.cell(row=row, column=3, value=note).font  = Font(name="Arial", size=9, italic=True)
        for c in range(1, 4):
            wleg.cell(row=row, column=c).border    = _thin_border()
            wleg.cell(row=row, column=c).alignment = Alignment(vertical="center")

    _THRESH_LABELS = {
        "es": "ES avg", "gr": "GR avg", "ts": "TS avg",
        "cs": "CS avg", "ps": "PS avg", "score": "Score avg",
        "forms": "Min forms", "slope": "Slope",
        "min_operator_pct": "Min operator %", "max_fta_pct": "Max FTA %",
        "min_pt_seen":      "Min patients seen",
        "max_es_lvl1_pct":  "Max ES L1 %",
        "max_es_lvl2_pct":  "Max ES L2 %",
    }

    r = 1
    _lh(r, f"{cohort} {formType} — Threshold Reference"); r += 1
    _lr(r, "Flag", "Threshold Value", "Description"); r += 1

    # Derive legend rows from active flag specs — dedup by thresh_key.
    # The value column carries the ACTUAL comparison used ("<= 2" vs "< 2"), so a
    # workbook always states whether a student sitting exactly on the cutoff was
    # flagged (see FlaggingConfig.inclusiveFlags).
    seen_thresh_keys = set()
    for flag_key, spec in zip(config.flags, specs):
        if isinstance(spec, FlagSpec):
            key = spec.thresh_key
            if key not in seen_thresh_keys:
                seen_thresh_keys.add(key)
                label  = _THRESH_LABELS.get(key, key)
                symbol = DIRECTION_SYMBOL.get(config.direction_for(flag_key), "")
                value  = thresholds.get(key, "—")
                _lr(r, label, f"{symbol} {value}".strip(), spec.description); r += 1
        elif isinstance(spec, CustomFlagSpec) and spec.description:
            _lr(r, spec.label, "—", spec.description); r += 1

    # Period + patient-count rules that shaped the whole run
    _period = thresholds.get("period_label")
    if _period:
        _lr(r, "Period", _period,
            f"Forms restricted to {thresholds.get('period_min') or 'start of year'} .. "
            f"{thresholds.get('period_max') or 'end of year'} "
            f"(Melbourne local date; semester split {SEMESTER_SPLIT_DATE})"); r += 1
    _ignored = thresholds.get("ignored_dates")
    if _ignored:
        _lr(r, "Dates excluded", f"{len(_ignored)} date(s)",
            "Forms sat on these dates were removed BEFORE any average, threshold or "
            "count was computed (student-on-student or otherwise non-assessable "
            "sessions): " + ", ".join(_ignored)); r += 1
    _scoreW = thresholds.get("score_weighting", SCORE_PER_FORM)
    _lr(r, "Score weighting", SCORE_WEIGHTING_LABELS.get(_scoreW, _scoreW),
        ("Score = each form's own item mean, then averaged across forms — a one-item "
         "form counts as much as a twelve-item one."
         if _scoreW == SCORE_PER_FORM else
         "Score = the mean over every scored item — a four-item session carries four "
         "times the weight of a single-item one.")
        + " Switch with FlaggingConfig(scoreWeighting=...). The Section Score Pivot "
          "shows BOTH totals; they differ, and the Low Score flag uses this one. "
          "Score Slope stays per form either way."); r += 1
    _lr(r, "Pt Seen / FTA counts",
        "Operator only" if thresholds.get("pt_seen_operator_only", True) else "Any role",
        "Only forms where the student was the Operator count towards Pt Seen AND Pt FTA; "
        "Support Operator sessions are excluded from both. Forms with no role field "
        "(final-year templates) still count. 'Pt Seen (any)' / 'Pt FTA (any)' on Summary "
        "show the ungated numbers for comparison."); r += 1

    # Always show improvement_margin and behind_ratio
    _lr(r, "Improvement margin", thresholds.get("improvement_margin", 0.0),
        "last-third avg <= first-third + margin flags No Improvement"); r += 1
    _lr(r, "Behind ratio",       thresholds.get("behind_ratio", 0.5),
        "item/section flagged if count < cohort avg x ratio"); r += 1
    _lr(r, "Borderline reference",
        f"GR level {thresholds.get('borderline_gr_level', '—')}"
        + ("" if config.useBorderlineThreshold else " (off)"),
        f"ES/TS/CS/PS/Score auto-thresholds = mean of n={thresholds.get('borderline_n', '—')} "
        f"students whose avg GR rounds to this level (falls back to mean - SD if empty)"); r += 1

    r += 1
    _lh(r, "Colour Key"); r += 1
    for label, bg, txt, note in [
        ("Red cell",   _RED_BG,   _RED_TEXT,   "Below threshold / high-tier flag triggered"),
        ("Amber cell", _AMBER_BG, _AMBER_TEXT, "Within 10% of threshold, or low-tier flag triggered"),
        ("Green cell", _GREEN_BG, _GREEN_TEXT, "Above threshold / no issue"),
        ("Blue cell",  _INFO_BG,  _INFO_TEXT,  "Info flag — shown for context, NOT counted in either risk column"),
    ]:
        c = wleg.cell(row=r, column=1, value=label)
        c.fill = _fill(bg); c.font = Font(name="Arial", size=9, color=txt, bold=True)
        c.border = _thin_border()
        wleg.cell(row=r, column=2, value=note).font   = _BODY_FONT
        wleg.cell(row=r, column=2, value=note).border = _thin_border()
        r += 1

    if config.info_flags:
        r += 1
        _lh(r, "Info Flags (not counted in high/low risk columns)"); r += 1
        _lr(r, "Flag", "Column", "Description"); r += 1
        for key in config.info_flags:
            spec = FLAG_REGISTRY.get(key)
            if spec is None:
                _lr(r, key, "—", "NOT FOUND in FLAG_REGISTRY"); r += 1
            else:
                note = spec.description if hasattr(spec, "description") else ""
                _lr(r, spec.label, spec.name if hasattr(spec, "col") else "custom", note); r += 1

    r += 1
    _lh(r, "Flag Tiers (high_risk_flag_count / low_risk_flag_count)"); r += 1
    _lr(r, "Tier", "Flag", "Description"); r += 1
    _active_keys = set(config.flags)
    for key in config.highTierFlags:
        if key not in _active_keys:
            continue
        spec = FLAG_REGISTRY.get(key)
        if spec is not None:
            _lr(r, "High", spec.label, spec.description); r += 1
    for key in config.lowTierFlags:
        if key not in _active_keys:
            continue
        spec = FLAG_REGISTRY.get(key)
        if spec is not None:
            _lr(r, "Low", spec.label, spec.description); r += 1
    _unclassified = config.unclassified_flags()
    if _unclassified:
        _lr(r, "!! Unclassified", ", ".join(_unclassified),
            "Active flags not in highTierFlags/lowTierFlags — excluded from both risk columns"); r += 1

    r += 1
    _lh(r, "Level Distribution Colour Rules"); r += 1
    for note in [
        "Red:   >20% at a bad level (ES L1, GR L1/L2, TS L1, CS L1, PS L1)",
        "Amber: >10% at a bad level",
        "Green: >50% at a good level (ES L3/L4, GR L4/L5, TS L3/L4)",
    ]:
        _lr(r, "", "", note); r += 1

    r += 1
    _lh(r, "Scale Reference"); r += 1
    for label, note in [
        ("ES / PR (1-4)", "1=not ready, 2=direct supv, 3=periodic supv, 4=indirect supv"),
        ("GR (1-5)",      "1=Unsatisfactory, 2=Borderline, 3=Satisfactory, 4=Good, 5=Excellent"),
        ("TS (1-4)",      "1=not completed, 2=safe to leave, 3=completed, 4=completed+records"),
        ("CS (1-2)",      "1=communicates, 2=matches style + active listening"),
        ("PS (1-2)",      "1=attends, 2=presents professionally"),
        ("Score (0-1)",   "Done well=1.0, Done=0.8, Mostly=0.6, Sometimes=0.4, Not done=0.0"),
    ]:
        _lr(r, label, "", note); r += 1

    for c, w in zip(range(1, 5), [22, 14, 65, 0]):
        wleg.column_dimensions[get_column_letter(c)].width = w


