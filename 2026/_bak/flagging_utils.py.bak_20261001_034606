@dataclass
class FlagSpec:
    """A simple threshold-comparison flag: fire if flagDf[col] < or > thresholds[thresh_key].

    ``direction`` is "below" / "above" (strict, the historical behaviour) or
    "below_eq" / "above_eq" (inclusive, <= / >=). A config can promote a strict
    flag to its inclusive form per run via FlaggingConfig.inclusiveFlags — the
    registry entry itself does not have to change, so one cohort asking for
    "ES <= 2" does not move every other cohort's cutoff.
    """
    name: str        # column name written to flagDf, e.g. "flag_low_es"
    col: str         # column in flagDf to compare, e.g. "avg_es"
    thresh_key: str  # key in the thresholds dict, e.g. "es"
    direction: str   # "below" | "below_eq" | "above" | "above_eq"
    label: str       # short friendly name for Excel column headers
    description: str # longer text for the Legend sheet


# Strict -> inclusive promotion used by FlaggingConfig.inclusiveFlags
_INCLUSIVE_DIRECTION = {"below": "below_eq", "above": "above_eq",
                        "below_eq": "below_eq", "above_eq": "above_eq"}
# Symbol shown in the Legend for each direction
DIRECTION_SYMBOL = {"below": "<", "below_eq": "<=", "above": ">", "above_eq": ">="}


# ═══════════════════════════════════════════════════════════════════════════
# How avg_score is aggregated  (2026-08-18)
# ───────────────────────────────────────────────────────────────────────────
# The same per-item checklist scores can be averaged at two levels, and the two
# do NOT agree — on the DDS2 FHY 2026 run the gap averaged 0.021, reached 0.064,
# moved one student 43 rank places, and changed low_score from 8 flagged to 6:
#
#   SCORE_PER_FORM  each form's own item mean, then the mean across forms. A
#     one-item form counts as much as a twelve-item one. The historical
#     behaviour and what the July 2026 workbook was built on — hence the default.
#   SCORE_PER_ITEM  the mean over every scored item. Each assessed item is one
#     observation, so a session with four items carries four times the weight of
#     a single-item one. Arguably the better measure of a student; switching
#     moves the low_score flag, so it is opt-in.
#
# The setting drives avg_score, therefore the Low Score flag, the auto/borderline
# score threshold, the Summary column header and the Scale Trends column.
# It deliberately does NOT change score_slope / first_third / last_third: a FORM
# is the natural point on a time series, so trends stay per form either way.
# The Section Score Pivot always shows BOTH totals side by side regardless.
# ═══════════════════════════════════════════════════════════════════════════
SCORE_PER_FORM = "per_form"
SCORE_PER_ITEM = "per_item"
SCORE_WEIGHTINGS = (SCORE_PER_FORM, SCORE_PER_ITEM)
SCORE_WEIGHTING_LABELS = {
    SCORE_PER_FORM: "per form",
    SCORE_PER_ITEM: "per item",
}


def resolveScoreWeighting(value):
    """Normalise a scoreWeighting value; raises on anything unrecognised so a typo
    can't silently fall back to the default weighting."""
    if value is None:
        return SCORE_PER_FORM
    text = str(value).strip().lower().replace("-", "_").replace(" ", "_")
    aliases = {"per_form": SCORE_PER_FORM, "form": SCORE_PER_FORM, "by_form": SCORE_PER_FORM,
               "per_item": SCORE_PER_ITEM, "item": SCORE_PER_ITEM, "by_item": SCORE_PER_ITEM}
    if text not in aliases:
        raise ValueError(
            f"Unknown scoreWeighting {value!r} — use {SCORE_PER_FORM!r} or {SCORE_PER_ITEM!r}.")
    return aliases[text]


