# getFlagDf
# ═══════════════════════════════════════════════════════════════════════════
def getFlagDf(cohortDf, formType, config, mappingFile=None, periodInfo=None,
              ignoredDates=None):
    """
    Produce (flagDf, comparisonDf, thresholds) from a cohortDf
    already filtered to submitted_by_assessor + calcScore applied.

    Parameters
    ----------
    cohortDf    : pre-filtered DataFrame with scores column populated
    formType    : "Clinic" or "Simulation"
    config      : FlaggingConfig — controls which flags fire and what thresholds to use
    mappingFile : optional path to item_section_mapping file (Clinic only)
    periodInfo  : optional (label, minDate, maxDate) from filterCohortDfByPeriod —
                  recorded in thresholds and printed on the Legend sheet so the
                  workbook says which half of the year it covers. Purely
                  documentation: cohortDf must ALREADY be filtered.
    ignoredDates : optional list of 'YYYY-MM-DD' from dropIgnoredDates — likewise
                  recorded for the Legend only; the rows must already be gone.

    Returns
    -------
    flagDf       : one row per student with aggregated stats, bool flags,
                   high_risk_flag_count, low_risk_flag_count
    comparisonDf : one row per (student, item_code/section) vs cohort avg
    thresholds   : dict of actual values used
    """
    if cohortDf.empty:
        return pd.DataFrame(), pd.DataFrame(), {}

    df = cohortDf.copy()
    df["datetimeutc"]     = pd.to_datetime(df["datetimeutc"], utc=True, errors="coerce")
    df["global_rating"]   = pd.to_numeric(df["global_rating"],   errors="coerce")
    df["entrustment"]     = pd.to_numeric(df["entrustment"],     errors="coerce")
    df["time_management"] = pd.to_numeric(df["time_management"], errors="coerce")
    df["communication"]   = pd.to_numeric(df["communication"],   errors="coerce")
    df["professionalism"] = pd.to_numeric(df["professionalism"], errors="coerce")

    def _scoreVals(scoresDict):
        """Every non-null item score on one form, as a plain list."""
        if not isinstance(scoresDict, dict) or not scoresDict:
            return []
        out = []
        for v in scoresDict.values():
            raw = v.get("score") if isinstance(v, dict) else v
            if raw is None:
                continue
            num = pd.to_numeric(raw, errors="coerce")
            if pd.notna(num):
                out.append(float(num))
        return out

    def _meanScore(scoresDict):
        vals = _scoreVals(scoresDict)
        return float(np.mean(vals)) if vals else np.nan

    df["_mean_score"] = df["scores"].apply(_meanScore)
    # Item sum/count per form so the per-ITEM weighting can be aggregated without
    # re-walking the scores dicts (and without the mean-of-means bias).
    _vals = df["scores"].apply(_scoreVals)
    df["_score_sum"] = _vals.apply(lambda v: float(np.sum(v)) if v else np.nan)
    df["_score_n"]   = _vals.apply(len)

    requireOperator = getattr(config, "requireOperatorForPtSeen", True)
    scoreWeighting  = resolveScoreWeighting(getattr(config, "scoreWeighting", SCORE_PER_FORM))
    checklistMode   = str(getattr(config, "checklistCountMode", "total")).strip().lower()

    # ── Per-student aggregation ──────────────────────────────────────────
    records = []
    for snum, grp in df.sort_values("datetimeutc").groupby("student_number"):
        sname = grp["student_name"].iloc[0]
        n     = len(grp)

        avg_es    = grp["entrustment"].mean()
        avg_gr    = grp["global_rating"].mean()
        avg_ts    = grp["time_management"].mean()
        avg_cs    = grp["communication"].mean()
        avg_ps    = grp["professionalism"].mean()
        # Two weightings of the SAME item scores; config.scoreWeighting picks which
        # one becomes avg_score (and so what low_score is tested against). See the
        # SCORE_WEIGHTINGS block — they legitimately disagree.
        _itemN    = float(grp["_score_n"].sum())
        avg_score = (grp["_mean_score"].mean() if scoreWeighting == SCORE_PER_FORM
                     else (float(grp["_score_sum"].sum()) / _itemN if _itemN > 0 else np.nan))

        es_slope    = _computeSlope(grp["entrustment"])
        gr_slope    = _computeSlope(grp["global_rating"])
        score_slope = _computeSlope(grp["_mean_score"])

        third          = max(1, n // 3)
        first_third_es = round(grp["entrustment"].iloc[:third].mean(), 3)
        last_third_es  = round(grp["entrustment"].iloc[-third:].mean(), 3)
        first_third_gr = round(grp["global_rating"].iloc[:third].mean(), 3)
        last_third_gr  = round(grp["global_rating"].iloc[-third:].mean(), 3)

        def _lvl_dist(series, levels):
            total = series.dropna().shape[0]
            if total == 0:
                return {lvl: 0.0 for lvl in levels}
            counts = series.dropna().astype(int).value_counts()
            return {lvl: round(counts.get(lvl, 0) / total * 100, 1) for lvl in levels}

        es_dist = _lvl_dist(grp["entrustment"],     [1, 2, 3, 4])
        gr_dist = _lvl_dist(grp["global_rating"],   [1, 2, 3, 4, 5])
        ts_dist = _lvl_dist(grp["time_management"], [1, 2, 3, 4])
        cs_dist = _lvl_dist(grp["communication"],   [1, 2])
        ps_dist = _lvl_dist(grp["professionalism"], [1, 2])

        # Role / patient detail arrive as CODES on the v3 template ("O", "ISP")
        # and as LABELS on the older one ("Operator", "I saw a patient") — fold
        # both to the label form before counting anything (see normalizeRole).
        role_norm      = grp["role"].map(normalizeRole) if "role" in grp.columns \
                         else pd.Series([None] * n, index=grp.index)
        role_counts    = role_norm.fillna("Unknown").value_counts()
        operator_count = int(role_counts.get(ROLE_OPERATOR, 0))
        support_count  = int(role_counts.get(ROLE_SUPPORT, 0))
        pct_operator   = round(operator_count / n * 100, 1) if n > 0 else 0.0

        pd_norm          = grp["patient_details"].map(normalizePatientDetail)
        pd_counts        = pd_norm.fillna("Unknown").value_counts()
        # Pt Seen counts ONLY forms where the student was the Operator — students
        # log Support Operator sessions with the patient attended too, which
        # double-counted the chair. Forms with no role field at all (final-year
        # templates) are exempt. Config.xlsx, "All" row.
        patient_seen_any_role = int(pd_counts.get(PATIENT_SEEN_LABEL, 0))
        patient_seen     = int(patientSeenMask(grp, requireOperator).sum())
        # FTA is gated the SAME way as Pt Seen (2026-08-19): a Support-Operator FTA
        # double-counts the chair too. patient_fta_any_role keeps the ungated count
        # for audit, exactly like patient_seen_any_role.
        patient_fta_any_role = int(patientFtaMask(grp, requireOperator=False).sum())
        patient_fta      = int(patientFtaMask(grp, requireOperator).sum())
        pct_patient_seen = round(patient_seen  / n * 100, 1) if n > 0 else 0.0
        pct_fta          = round(patient_fta   / n * 100, 1) if n > 0 else 0.0

        has_ci   = grp["clinical_incident"].dropna().apply(lambda x: str(x).strip() != "").any()
        ci_count = int(grp["clinical_incident"].dropna().apply(lambda x: str(x).strip() != "").sum())

        # ── Checklists and classes (2026-08-19, BOH2 request) ────────────────
        # A "checklist" is one scored item-code on a form (same unit the item-code
        # score pivot uses). We keep BOTH counts — checklist_total counts every
        # item-code assessment (repeats included), checklist_unique counts distinct
        # codes — and the Summary sheet shows whichever config.checklistCountMode
        # selects. Scale rows ("scale…") are not checklists and are excluded, the
        # same rule as _itemCodeCounts. "Classes" = distinct session dates, on the
        # MELBOURNE-LOCAL date (DASH stores UTC; a late session sits on the previous
        # UTC day — the same tz trap as filterCohortDfByPeriod).
        _codeList = []
        if "item_codes" in grp.columns:
            for _codes in grp["item_codes"]:
                if isinstance(_codes, str):
                    try:
                        _codes = json.loads(_codes)
                    except Exception:
                        _codes = None
                if isinstance(_codes, (list, set)):
                    _codeList.extend(str(c) for c in _codes
                                     if c and not str(c).startswith("scale"))
        checklist_total  = len(_codeList)
        checklist_unique = len(set(_codeList))
        # The count the Summary shows and low_checklist_count flags against, per
        # config.checklistCountMode (both raw counts are kept too, for audit).
        checklist_count  = checklist_unique if checklistMode == "unique" else checklist_total
        _localDates = (pd.to_datetime(grp["datetimeutc"], utc=True, errors="coerce")
                       .dt.tz_convert("Australia/Melbourne").dt.date)
        n_classes = int(_localDates.dropna().nunique())

        rec = {
            "student_number":    snum,
            "student_name":      sname,
            "form_count":        n,
            "checklist_count":   checklist_count,
            "checklist_total":   checklist_total,
            "checklist_unique":  checklist_unique,
            "n_classes":         n_classes,
            "operator_count":    operator_count,
            "support_count":     support_count,
            "pct_operator":      pct_operator,
            "patient_seen":      patient_seen,
            "patient_seen_any_role": patient_seen_any_role,
            "patient_fta":       patient_fta,
            "patient_fta_any_role": patient_fta_any_role,
            "pct_patient_seen":  pct_patient_seen,
            "pct_fta":           pct_fta,
            "ci_count":          ci_count,
            "avg_es":    round(avg_es, 3) if pd.notna(avg_es) else np.nan,
            "avg_gr":    round(avg_gr, 3) if pd.notna(avg_gr) else np.nan,
            "avg_ts":    round(avg_ts, 3) if pd.notna(avg_ts) else np.nan,
            "avg_cs":    round(avg_cs, 3) if pd.notna(avg_cs) else np.nan,
            "avg_ps":    round(avg_ps, 3) if pd.notna(avg_ps) else np.nan,
            "avg_score": round(avg_score, 3) if pd.notna(avg_score) else np.nan,
            "es_slope":    round(es_slope, 4) if pd.notna(es_slope) else np.nan,
            "gr_slope":    round(gr_slope, 4) if pd.notna(gr_slope) else np.nan,
            "score_slope": round(score_slope, 4) if pd.notna(score_slope) else np.nan,
            "first_third_es":  round(first_third_es, 3),
            "last_third_es":   round(last_third_es,  3),
            "first_third_gr":  round(first_third_gr, 3),
            "last_third_gr":   round(last_third_gr,  3),
        }
        for lvl, pct in es_dist.items(): rec[f"es_lvl{lvl}_pct"] = pct
        for lvl, pct in gr_dist.items(): rec[f"gr_lvl{lvl}_pct"] = pct
        for lvl, pct in ts_dist.items(): rec[f"ts_lvl{lvl}_pct"] = pct
        for lvl, pct in cs_dist.items(): rec[f"cs_lvl{lvl}_pct"] = pct
        for lvl, pct in ps_dist.items(): rec[f"ps_lvl{lvl}_pct"] = pct
        records.append(rec)

    flagDf = pd.DataFrame(records)

    # ── Resolve thresholds ────────────────────────────────────────────────
    # Legacy auto method: cohort mean - sdMultiplier * SD. Used for gr, forms,
    # min_pt_seen — and as the fallback for the borderline method below.
    def _auto(col, override):
        m, s = flagDf[col].mean(), flagDf[col].std()
        mult = config.sdMultiplier or 1.0
        return override if override is not None else round(m - mult * s, 3)

    # "Borderline" peer group: students whose avg_gr rounds to config.borderlineGrLevel
    # (default 2 = "Borderline" on the GR 1-5 scale). Used as the auto-threshold for
    # es/ts/cs/ps/score so a student is flagged against what a borderline peer actually
    # scores on that metric, rather than an SD-based cutoff.
    _borderlineGrLevel = config.borderlineGrLevel if config.borderlineGrLevel is not None else 2
    _borderlineMask     = flagDf["avg_gr"].round() == _borderlineGrLevel
    _borderlineGrp      = flagDf[_borderlineMask]
    _borderlineN         = int(_borderlineMask.sum())

    def _autoBorderline(col, override):
        """Auto-threshold for ES/TS/CS/PS/Score: mean of `col` among borderline-GR
        peers. Falls back to the legacy mean - SD method if borderline-threshold use
        is disabled, or the borderline peer group is empty for this metric."""
        if override is not None:
            return override
        if config.useBorderlineThreshold and _borderlineN > 0 and col in _borderlineGrp:
            bl_vals = _borderlineGrp[col].dropna()
            if not bl_vals.empty:
                return round(float(bl_vals.mean()), 3)
        return _auto(col, None)

    thresholds = {
        "es":               _autoBorderline("avg_es",    config.esThreshold),
        "gr":               _auto("avg_gr",    config.grThreshold),
        "ts":               _autoBorderline("avg_ts",    config.tsThreshold),
        "cs":               _autoBorderline("avg_cs",    config.csThreshold),
        "ps":               _autoBorderline("avg_ps",    config.psThreshold),
        "score":            _autoBorderline("avg_score", config.scoreThreshold),
        "forms":            config.minForms if config.minForms is not None
                            else int(flagDf["form_count"].mean() - flagDf["form_count"].std()),
        # Checklist / class minimums — auto = cohort mean - sdMultiplier*SD via _auto
        # (rounded, so a single-student cohort gives NaN rather than the int() crash
        # the 'forms' threshold has). config.minChecklists / minClasses override.
        # getattr so an older/autoreloaded FlaggingConfig without these attrs still
        # runs (falls back to auto) instead of raising AttributeError — same guard
        # used for requireOperatorForPtSeen / scoreWeighting.
        "min_checklists":   _auto("checklist_count", getattr(config, "minChecklists", None)),
        "min_classes":      _auto("n_classes",       getattr(config, "minClasses", None)),
        "min_item_codes":   _auto("checklist_unique", getattr(config, "minItemCodes", None)),
        "slope":            config.slopeThreshold,
        "improvement_margin": config.improvementMargin,
        "behind_ratio":     config.behindRatio,
        "min_operator_pct": config.minOperatorPct,
        "max_fta_pct":      config.maxFtaPct,
        "min_pt_seen":      config.minPtSeen if config.minPtSeen is not None
                            else round(flagDf["patient_seen"].mean() - flagDf["patient_seen"].std(), 1)
                            if "patient_seen" in flagDf.columns and not flagDf["patient_seen"].isna().all()
                            else 0.0,
        "max_es_lvl1_pct":  config.maxEsLvl1Pct,
        "max_es_lvl2_pct":  config.maxEsLvl2Pct,
        "sd_multiplier":    config.sdMultiplier or 1.0,
        "borderline_gr_level":     _borderlineGrLevel,
        "borderline_n":            _borderlineN,
        "borderline_threshold_on": bool(config.useBorderlineThreshold),
        # Documentation-only entries — surfaced on the Legend sheet so a workbook
        # always says which rules produced it. Not compared against anything.
        "inclusive_flags":         list(getattr(config, "inclusiveFlags", []) or []),
        "pt_seen_operator_only":   bool(requireOperator),
        "score_weighting":         scoreWeighting,
    }
    if periodInfo:
        _pLabel, _pMin, _pMax = (list(periodInfo) + [None, None, None])[:3]
        if _pLabel and _pLabel != PERIOD_ALL:
            thresholds["period_label"] = _pLabel
            thresholds["period_min"]   = _pMin
            thresholds["period_max"]   = _pMax
    if ignoredDates:
        thresholds["ignored_dates"] = list(ignoredDates)

    print(f"[getFlagDf] {formType}  n={len(flagDf)} students")
    for k, v in thresholds.items():
        print(f"  {k:<22}: {v}")

    # ── Apply flags from registry ────────────────────────────────────────
    # config.direction_for(key) is the registry direction, promoted to <= / >=
    # when the key is listed in config.inclusiveFlags (dds2_clinic uses this for
    # "ES <= 2 / GR <= 3 / PS <= 1.5 / Pt Seen <= 11").
    specs = config.resolve_flags()
    for key, spec in zip(config.flags, specs):
        if isinstance(spec, FlagSpec):
            thresh    = thresholds[spec.thresh_key]
            direction = config.direction_for(key) or spec.direction
            if direction == "below":
                flagDf[spec.name] = flagDf[spec.col] < thresh
            elif direction == "below_eq":
                flagDf[spec.name] = flagDf[spec.col] <= thresh
            elif direction == "above_eq":
                flagDf[spec.name] = flagDf[spec.col] >= thresh
            else:  # "above"
                flagDf[spec.name] = flagDf[spec.col] > thresh
        elif isinstance(spec, CustomFlagSpec):
            flagDf[spec.name] = flagDf.apply(lambda row: spec.fn(row, thresholds), axis=1)

    FLAG_COLS = [s.name for s in specs]
    # info_flags are shown in Excel but excluded from both risk columns
    _info_names = {FLAG_REGISTRY[k].name for k in config.info_flags if k in FLAG_REGISTRY}
    RISK_COLS   = [c for c in FLAG_COLS if c not in _info_names]

    # risk_score is split into two counts — high_risk_flag_count (severe/urgent
    # flags) and low_risk_flag_count (early-warning/trend flags) — per
    # config.highTierFlags / config.lowTierFlags (see DEFAULT_HIGH_TIER_FLAGS /
    # DEFAULT_LOW_TIER_FLAGS near FLAG_REGISTRY).
    _highNames, _lowNames = config.resolve_tiers()
    HIGH_RISK_COLS = [c for c in RISK_COLS if c in _highNames]
    LOW_RISK_COLS  = [c for c in RISK_COLS if c in _lowNames]
    _unclassifiedCols = [c for c in RISK_COLS if c not in _highNames and c not in _lowNames]
    if _unclassifiedCols:
        print(f"[getFlagDf] WARNING: scored flags not in highTierFlags/lowTierFlags "
              f"(excluded from both risk counts): {_unclassifiedCols}")

    flagDf["high_risk_flag_count"] = flagDf[HIGH_RISK_COLS].sum(axis=1) if HIGH_RISK_COLS else 0
    flagDf["low_risk_flag_count"]  = flagDf[LOW_RISK_COLS].sum(axis=1)  if LOW_RISK_COLS  else 0
    flagDf["flags_detail"] = flagDf[FLAG_COLS].apply(
        lambda row: ", ".join(c.replace("flag_", "") for c in FLAG_COLS if row[c]),
        axis=1,
    )
    flagDf.sort_values(["high_risk_flag_count", "low_risk_flag_count"],
                        ascending=[False, False], inplace=True)
    flagDf.reset_index(drop=True, inplace=True)

    # ── Item/section comparison ──────────────────────────────────────────
    countLong = _itemCodeCounts(df)
    if countLong.empty:
        return flagDf, pd.DataFrame(), thresholds

    nStudents = flagDf["student_number"].nunique()
    # One canonical name per student_number so name-spelling/capitalisation
    # variants (e.g. 'Hunain Jamal' vs 'Hunain JAmal') don't duplicate rows
    # when merged onto the id-keyed comparison.
    nameMap   = pd.DataFrame(
        [{"student_number": k, "student_name": v}
         for k, v in _canonicalNameMap(df).items()]
    )
    if nameMap.empty:
        nameMap = pd.DataFrame(columns=["student_number", "student_name"])

    if formType == "Simulation":
        cohortAvg = (countLong.groupby("item_code")["count"].sum() / nStudents).reset_index()
        cohortAvg.columns = ["item_code", "cohort_avg_count"]
        comp = countLong.merge(cohortAvg, on="item_code", how="outer")
        comp["count"] = comp["count"].fillna(0)
        comp = comp.merge(nameMap, on="student_number", how="left")
        comp["behind"]        = comp["count"] < (comp["cohort_avg_count"] * thresholds["behind_ratio"])
        comp["pct_of_cohort"] = (comp["count"] / comp["cohort_avg_count"]).replace(
            [np.inf, -np.inf], np.nan).round(3)
    else:
        mappingFile = mappingFile or _loadSectionMapping(None)
        countLong   = _mergeSection(countLong, mappingFile, codeCol="item_code")
        countLong   = countLong.groupby(["student_number", "Section"])["count"].sum().reset_index()
        cohortAvg   = (countLong.groupby("Section")["count"].sum() / nStudents).reset_index()
        cohortAvg.columns = ["Section", "cohort_avg_count"]
        comp = countLong.merge(cohortAvg, on="Section", how="outer")
        comp["count"] = comp["count"].fillna(0)
        comp = comp.merge(nameMap, on="student_number", how="left")
        comp["behind"]        = comp["count"] < (comp["cohort_avg_count"] * thresholds["behind_ratio"])
        comp["pct_of_cohort"] = (comp["count"] / comp["cohort_avg_count"]).replace(
            [np.inf, -np.inf], np.nan).round(3)

    return flagDf, comp, thresholds


# ═══════════════════════════════════════════════════════════════════════════
# _itemCodeCounts
# ═══════════════════════════════════════════════════════════════════════════
def _itemCodeCounts(df):
    """Count (student, item_code) form occurrences from the raw cohort data."""
    records = []
    for _, row in df.iterrows():
        codes = row.get("item_codes")
        if codes is None:
            continue
        if isinstance(codes, str):
            try:
                codes = json.loads(codes)
            except Exception:
                continue
        if not isinstance(codes, (list, set)):
            continue
        snum = row["student_number"]
        for code in codes:
            if code and not str(code).startswith("scale"):
                records.append({"student_number": snum, "item_code": str(code)})
    if not records:
        return pd.DataFrame()
    long = pd.DataFrame(records)
    return long.groupby(["student_number", "item_code"]).size().reset_index(name="count")


# ═══════════════════════════════════════════════════════════════════════════
# saveFlagDfToExcel2
# ═══════════════════════════════════════════════════════════════════════════
def saveFlagDfToPdf(flagDf, compDf, thresholds, cohortDf, filepath,
                    formType, cohort, config, mappingFile=None):
    """
    Generate a companion PDF report.
    Layout (landscape A4):
      1. Student Risk Summary — all students × key stats + flag columns
      2. Item Scale Distribution — items as rows, O1-O6 counts + avg score
         (only emitted if config has DDS3-style reportable items)
      3. Reportable Item Counts — one sub-table per category (avoids 47-column wide table)
    """
    from reportlab.lib.pagesizes import A4, landscape
    from reportlab.lib.units import cm
    from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
    from reportlab.lib import colors
    from reportlab.platypus import (SimpleDocTemplate, Table, TableStyle,
                                    Paragraph, Spacer, PageBreak, KeepTogether)
    from reportlab.lib.enums import TA_CENTER, TA_LEFT

    PAGE = landscape(A4)
    doc  = SimpleDocTemplate(
        filepath, pagesize=PAGE,
        leftMargin=1.2*cm, rightMargin=1.2*cm,
        topMargin=1.2*cm,  bottomMargin=1.2*cm,
    )

    _RL_NAVY  = colors.HexColor("#1F3864")
    _RL_RED   = colors.HexColor("#FFCCCC")
    _RL_AMB   = colors.HexColor("#FFF2CC")
    _RL_GRN   = colors.HexColor("#E2EFDA")
    _RL_GREY  = colors.HexColor("#F2F2F2")
    _RL_INFO  = colors.HexColor("#DDEBF7")
    _RL_SCALE = {
        "Done Well":    colors.HexColor("#C6EFCE"),
        "Done":         colors.HexColor("#D9EAD3"),
        "Mostly":       colors.HexColor("#FFF2CC"),
        "Sometimes":    colors.HexColor("#FCE4D6"),
        "Not Done":     colors.HexColor("#FFCCCC"),
        "Not Observed": colors.HexColor("#EFEFEF"),
    }

    base    = getSampleStyleSheet()
    h1      = ParagraphStyle("h1", parent=base["Heading1"],
                             textColor=_RL_NAVY, fontSize=13, spaceAfter=4)
    h2      = ParagraphStyle("h2", parent=base["Heading2"],
                             textColor=_RL_NAVY, fontSize=10, spaceAfter=3)
    caption = ParagraphStyle("cap", parent=base["Normal"], fontSize=7,
                             textColor=colors.grey, spaceAfter=6)
    story   = []

    def _hdr_style(n_cols, col_widths):
        return TableStyle([
            ("BACKGROUND",   (0, 0), (-1, 0), _RL_NAVY),
            ("TEXTCOLOR",    (0, 0), (-1, 0), colors.white),
            ("FONTNAME",     (0, 0), (-1, 0), "Helvetica-Bold"),
            ("FONTSIZE",     (0, 0), (-1, -1), 7),
            ("ALIGN",        (0, 0), (-1, -1), "CENTER"),
            ("ALIGN",        (0, 1), (0, -1), "LEFT"),
            ("VALIGN",       (0, 0), (-1, -1), "MIDDLE"),
            ("GRID",         (0, 0), (-1, -1), 0.25, colors.HexColor("#CCCCCC")),
            ("ROWBACKGROUNDS", (0, 1), (-1, -1), [colors.white, _RL_GREY]),
            ("LEFTPADDING",  (0, 0), (-1, -1), 3),
            ("RIGHTPADDING", (0, 0), (-1, -1), 3),
            ("TOPPADDING",   (0, 0), (-1, -1), 2),
            ("BOTTOMPADDING",(0, 0), (-1, -1), 2),
        ])

    # ── 1. Student Risk Summary ───────────────────────────────────────────
    story.append(Paragraph(
        f"{cohort} {formType} — Flagging Report  "
        f"<font size='9' color='grey'>Generated {pd.Timestamp.now().strftime('%Y-%m-%d')}</font>",
        h1))
    story.append(Paragraph("Student Risk Summary", h2))

    specs        = config.resolve_flags()
    FLAG_COLS    = [s.name for s in specs]
    flag_labels  = {s.name: s.label for s in specs}
    _info_names  = {FLAG_REGISTRY[k].name for k in config.info_flags if k in FLAG_REGISTRY}

    _high_names, _low_names = config.resolve_tiers()

    SUM_STAT_COLS = [
        ("student_name", "Student",  3.8*cm),
        ("form_count",   "Forms",    1.0*cm),
        ("operator_count","Op",      0.8*cm),
        ("pct_operator", "%Op",      0.9*cm),
        ("patient_seen", "Pt Seen",  0.9*cm),
        ("patient_fta",  "Pt FTA",   0.8*cm),
        ("pct_fta",      "%FTA",     0.9*cm),
        ("ci_count",     "CI#",      0.7*cm),
        ("high_risk_flag_count", "High Risk Flags", 1.7*cm),
        ("low_risk_flag_count",  "Low Risk Flags",  1.7*cm),
        ("avg_es",       "ES",       0.8*cm),
        ("avg_gr",       "GR",       0.8*cm),
        ("avg_score",    "Score",    0.9*cm),
    ]
    stat_cols = [(c, h, w) for c, h, w in SUM_STAT_COLS if c in flagDf.columns]
    flag_w    = 0.65*cm
    all_cols  = stat_cols + [(fc, flag_labels.get(fc, fc), flag_w) for fc in FLAG_COLS if fc in flagDf.columns]
    hdr_row   = [h for _, h, _ in all_cols]
    col_w     = [w for _, _, w in all_cols]

    sum_data  = [hdr_row]
    max_high_risk = flagDf["high_risk_flag_count"].max() or 1
    max_low_risk  = flagDf["low_risk_flag_count"].max() or 1
    for _, row in flagDf.iterrows():
        r = []
        for col, _, _ in all_cols:
            v = row.get(col)
            if col in FLAG_COLS:
                r.append("✓" if v else "")
            elif pd.isna(v) if not isinstance(v, str) else False:
                r.append("")
            elif isinstance(v, float):
                r.append(f"{v:.1f}")
            else:
                r.append(str(v) if v is not None else "")
        sum_data.append(r)

    sum_tbl = Table(sum_data, colWidths=col_w, repeatRows=1)
    ts      = _hdr_style(len(all_cols), col_w)

    high_ci = next((i for i, (c,_,_) in enumerate(all_cols) if c == "high_risk_flag_count"), None)
    low_ci  = next((i for i, (c,_,_) in enumerate(all_cols) if c == "low_risk_flag_count"), None)
    for ri, (_, row) in enumerate(flagDf.iterrows(), start=1):
        hv = row.get("high_risk_flag_count", 0)
        if high_ci is not None and hv and hv > 0:
            intensity = int(255 - (hv / max_high_risk) * 120)
            ts.add("BACKGROUND", (high_ci, ri), (high_ci, ri),
                   colors.Color(1, intensity/255, intensity/255))
        lv = row.get("low_risk_flag_count", 0)
        if low_ci is not None and lv and lv > 0:
            frac = min(lv / max_low_risk, 1.0)
            g = (255 - frac * (255 - 0xEB)) / 255
            b = (255 - frac * (255 - 0x9C)) / 255
            ts.add("BACKGROUND", (low_ci, ri), (low_ci, ri), colors.Color(1, g, b))
        for ci, (fc, _, _) in enumerate(all_cols):
            if fc in FLAG_COLS and row.get(fc):
                if fc in _info_names:
                    bg = _RL_INFO
                elif fc in _low_names and fc not in _high_names:
                    bg = _RL_AMB
                else:
                    bg = _RL_RED
                ts.add("BACKGROUND", (ci, ri), (ci, ri), bg)

    sum_tbl.setStyle(ts)
    story.append(sum_tbl)

    # ── 2. Item Scale Distribution (DDS3) ─────────────────────────────────
    try:
        distDf = _buildItemScaleDist(cohortDf, DDS3_REPORTABLE_ITEMS)
        if not distDf.empty:
            story.append(PageBreak())
            story.append(Paragraph("Item Scale Distribution (Operator Forms — Cohort Totals)", h2))
            story.append(Paragraph(
                "Counts of each scale rating across all Operator forms for the cohort.  "
                "Green = positive, Amber = partial, Red = negative.",
                caption))

            dist_hdr = ["Cat", "Item"] + _SCALE_LABELS + ["Avg Score"]
            dist_w   = [2.5*cm, 1.2*cm] + [2.2*cm]*6 + [1.8*cm]
            dist_rows = [dist_hdr]
            for _, row in distDf.iterrows():
                r = [row.get("Category",""), row.get("Item Code","")]
                r += [str(int(row.get(lbl, 0))) for lbl in _SCALE_LABELS]
                avg = row.get("Avg Score")
                r.append(f"{avg:.2f}" if pd.notna(avg) else "")
                dist_rows.append(r)

            dist_tbl = Table(dist_rows, colWidths=dist_w, repeatRows=1)
            dts      = _hdr_style(len(dist_hdr), dist_w)
            # colour scale columns
            for ci, lbl in enumerate(_SCALE_LABELS, start=2):
                bg = _RL_SCALE.get(lbl, colors.white)
                dts.add("BACKGROUND", (ci, 1), (ci, -1), bg)
            dist_tbl.setStyle(dts)
            story.append(dist_tbl)
    except Exception as _e:
        print(f"[PDF] Item scale dist section skipped: {_e}")

    # ── 3. Reportable Item Count Pivot (split by category) ────────────────
    try:
        pivot, item_to_cat = _buildItemCountPivot(cohortDf, DDS3_REPORTABLE_ITEMS)
        if not pivot.empty:
            story.append(PageBreak())
            story.append(Paragraph("Reportable Item Counts per Student (by Category)", h2))
            story.append(Paragraph(
                "Each sub-table shows one item category.  "
                "Red = below 50% cohort avg, Amber = below 80%.",
                caption))

            for cat, codes in DDS3_REPORTABLE_ITEMS.items():
                cat_cols = [str(c) for c in codes if str(c) in pivot.columns]
                if not cat_cols:
                    continue
                sub = pivot[["student_number", "student_name"] + cat_cols].copy()
                sub_sorted = sub.sort_values("student_name")

                cohort_avg = sub[cat_cols].mean()
                cohort_min = sub[cat_cols].min()
                cohort_max = sub[cat_cols].max()

                hdr    = ["Student"] + cat_cols
                cat_w  = [3.5*cm] + [max(0.7*cm, 14.0/len(cat_cols)*cm)] * len(cat_cols)

                tbl_data = [hdr]
                for _, row in sub_sorted.iterrows():
                    r = [row["student_name"]]
                    r += [str(int(row[c])) if pd.notna(row[c]) and row[c] != 0 else "" for c in cat_cols]
                    tbl_data.append(r)
                tbl_data.append(["Cohort Avg"] + [f"{cohort_avg[c]:.1f}" for c in cat_cols])
                tbl_data.append(["Min"]        + [str(int(cohort_min[c])) for c in cat_cols])
                tbl_data.append(["Max"]        + [str(int(cohort_max[c])) for c in cat_cols])

                cat_tbl = Table(tbl_data, colWidths=cat_w, repeatRows=1)
                cts = _hdr_style(len(hdr), cat_w)
                n_data = len(sub_sorted)
                for ri, (_, row) in enumerate(sub_sorted.iterrows(), start=1):
                    for ci, c in enumerate(cat_cols, start=1):
                        v   = row[c]
                        avg = cohort_avg[c]
                        if avg > 0:
                            if v < avg * 0.5:
                                cts.add("BACKGROUND", (ci, ri), (ci, ri), _RL_RED)
                            elif v < avg * 0.8:
                                cts.add("BACKGROUND", (ci, ri), (ci, ri), _RL_AMB)
                for fi in range(n_data + 1, n_data + 4):
                    cts.add("BACKGROUND", (0, fi), (-1, fi), colors.HexColor("#D6DCE4"))
                    cts.add("FONTNAME",   (0, fi), (-1, fi), "Helvetica-Bold")
                cat_tbl.setStyle(cts)

                block = [
                    Paragraph(cat, ParagraphStyle("cath", parent=h2, fontSize=9,
                                                  spaceAfter=2, spaceBefore=8)),
                    cat_tbl,
                ]
                story.append(KeepTogether(block))

    except Exception as _e:
        print(f"[PDF] Reportable items section skipped: {_e}")

    doc.build(story)
    print(f"[PDF] Saved → {filepath}")


def saveFlagDfToExcel2(flagDf, compDf, thresholds, cohortDf, filepath,
                       formType, cohort, config, mappingFile=None):
    """Write the full flagging workbook — sheets driven by config.sheets."""
    with pd.ExcelWriter(filepath, engine="openpyxl") as writer:
        for sheet_key in config.sheets:
            if sheet_key not in SHEET_REGISTRY:
                print(f"[saveFlagDfToExcel2] Unknown sheet key '{sheet_key}' — skipping")
                continue
            try:
                SHEET_REGISTRY[sheet_key](
                    writer, flagDf, compDf, cohortDf, thresholds,
                    cohort, formType, config, mappingFile=mappingFile,
                )
            except Exception as e:
                print(f"[saveFlagDfToExcel2] Sheet '{sheet_key}' failed: {e}")
    print(f"[saveFlagDfToExcel2] Saved → {filepath}")

    if getattr(config, "createPdf", False):
        pdf_path = filepath.replace(".xlsx", ".pdf")
        try:
            saveFlagDfToPdf(flagDf, compDf, thresholds, cohortDf, pdf_path,
                            formType, cohort, config, mappingFile=mappingFile)
        except Exception as e:
            import traceback
            print(f"[PDF] Generation failed: {e}")
            traceback.print_exc()
