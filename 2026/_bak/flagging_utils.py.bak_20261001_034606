# ── Sheet 1 helper: count pivot ────────────────────────────────────────────
def _buildItemCountPivot(cohortDf, reportableItems=None):
    """
    Returns a DataFrame: rows = students, columns = item codes (str).
    Values = count of Operator forms where that item appears.
    Only includes items in DDS3_REPORTABLE_ITEMS (or override dict).
    """
    if reportableItems is None:
        reportableItems = DDS3_REPORTABLE_ITEMS
    item_to_cat = {
        str(c): cat
        for cat, codes in reportableItems.items()
        for c in codes
    }
    all_codes = set(item_to_cat)

    records = []
    for _, row in cohortDf.iterrows():
        if normalizeRole(row.get("role")) not in (None, ROLE_OPERATOR):
            continue
        codes = row.get("item_codes") or []
        if isinstance(codes, str):
            try:
                codes = json.loads(codes)
            except Exception:
                codes = []
        snum  = row["student_number"]
        for c in codes:
            cs = str(c)
            if cs in all_codes:
                records.append({"student_number": snum, "item_code": cs})

    if not records:
        return pd.DataFrame(), item_to_cat

    # One canonical name per student_number (avoids name-variant duplicate rows)
    canon = _canonicalNameMap(cohortDf)

    long = pd.DataFrame(records)
    counts = long.groupby(["student_number", "item_code"]).size().reset_index(name="count")
    pivot = counts.pivot_table(
        index="student_number",
        columns="item_code",
        values="count",
        aggfunc="sum",
        fill_value=0,
    ).reset_index()
    pivot.columns.name = None

    # Attach the canonical name as an extra column keyed off student_number
    pivot.insert(1, "student_name", pivot["student_number"].map(canon).fillna(""))

    # Ensure all reportable item columns present even if zero
    for code in all_codes:
        if code not in pivot.columns:
            pivot[code] = 0

    # Sort columns by item code (numeric)
    item_cols = sorted([c for c in pivot.columns if c not in ("student_number", "student_name")],
                       key=lambda x: int(x))
    pivot = pivot[["student_number", "student_name"] + item_cols]
    return pivot, item_to_cat


# ── Sheet 2 helper: scale distribution ────────────────────────────────────
def _buildItemScaleDist(cohortDf, reportableItems=None):
    """
    Returns a DataFrame: rows = item codes, columns = scale labels + avg_score.
    Values = raw counts of O1/O2/O3/O4/O5/O6 across all Operator forms × all sub-items.
    """
    if reportableItems is None:
        reportableItems = DDS3_REPORTABLE_ITEMS
    item_to_cat = {
        str(c): cat
        for cat, codes in reportableItems.items()
        for c in codes
    }
    all_codes = set(item_to_cat)

    resp_counts = {code: {lbl: 0 for lbl in _SCALE_LABELS} for code in all_codes}
    score_sums  = {code: [] for code in all_codes}

    for _, row in cohortDf.iterrows():
        if normalizeRole(row.get("role")) not in (None, ROLE_OPERATOR):
            continue
        ad = row.get("assessor_data")
        if not isinstance(ad, dict):
            continue
        sc = row.get("scores") or {}

        for code_str, item_data in ad.items():
            if code_str not in all_codes:
                continue
            if not isinstance(item_data, dict):
                continue
            for v in item_data.values():
                label = _SCORE_TO_LABEL.get(str(v).strip())
                if label:
                    resp_counts[code_str][label] += 1
            # avg score for this form × this item
            item_score = sc.get(code_str, {})
            if isinstance(item_score, dict) and item_score.get("score") is not None:
                s = item_score["score"]
                if not np.isnan(s):
                    score_sums[code_str].append(s)

    rows = []
    for code in sorted(all_codes, key=lambda x: int(x)):
        rec = {
            "Category":  item_to_cat[code],
            "Item Code": code,
            **resp_counts[code],
            "Avg Score": round(float(np.mean(score_sums[code])), 3)
                         if score_sums[code] else np.nan,
        }
        rows.append(rec)

    return pd.DataFrame(rows)


# ── Sheet builder 1: item count pivot ─────────────────────────────────────
def _build_reportable_items_pivot_sheet(writer, flagDf, compDf, cohortDf, thresholds,
                                         cohort, formType, config, mappingFile=None):
    """Student × item-code count pivot with cohort stats footer."""
    reportableItems = getattr(config, "reportableItems", None) or DDS3_REPORTABLE_ITEMS
    pivot, item_to_cat = _buildItemCountPivot(cohortDf, reportableItems)
    if pivot.empty:
        return

    item_cols = [c for c in pivot.columns if c not in ("student_number", "student_name")]

    # Category order header row (for display above column headers)
    cat_order = list(dict.fromkeys(
        item_to_cat.get(c, "") for c in item_cols
    ))

    # Compute cohort stats per item
    stats = {}
    for ic in item_cols:
        col = pivot[ic]
        stats[ic] = {
            "avg": round(col.mean(), 1),
            "min": int(col.min()),
            "max": int(col.max()),
        }

    # Build display DF: student ID + name, then item counts
    display = pivot[["student_number", "student_name"] + item_cols].copy()

    N_ID = 2  # student_number + student_name occupy columns 1 and 2
    ITEM_START = N_ID + 1  # first item column index (1-based)

    ws_name = "Reportable Items"
    display.to_excel(writer, sheet_name=ws_name, index=False, startrow=3)
    ws = writer.sheets[ws_name]

    n_students = len(display)
    N_COLS = N_ID + len(item_cols)  # id + name + items

    _styleHeader(ws, 1, N_COLS, f"{cohort} {formType} — Reportable Item Counts by Student")

    # Row 2: category sub-headers (merged per category block)
    ws.cell(row=2, column=1, value="ID").font = _BOLD_BODY
    ws.cell(row=2, column=2, value="Student").font = _BOLD_BODY
    current_cat = None
    cat_start = ITEM_START
    for i, ic in enumerate(item_cols):
        cat = item_to_cat.get(ic, "")
        col_idx = i + ITEM_START
        if cat != current_cat:
            if current_cat is not None:
                if col_idx - 1 > cat_start:
                    ws.merge_cells(start_row=2, start_column=cat_start,
                                   end_row=2, end_column=col_idx - 1)
                c = ws.cell(row=2, column=cat_start, value=current_cat)
                c.font = Font(name="Arial", bold=True, size=9, color=_WHITE)
                c.fill = _fill(_NAVY)
                c.alignment = Alignment(horizontal="center", vertical="center")
            current_cat = cat
            cat_start = col_idx
    # last group
    if current_cat:
        last_col = len(item_cols) + N_ID
        if last_col > cat_start:
            ws.merge_cells(start_row=2, start_column=cat_start,
                           end_row=2, end_column=last_col)
        c = ws.cell(row=2, column=cat_start, value=current_cat)
        c.font = Font(name="Arial", bold=True, size=9, color=_WHITE)
        c.fill = _fill(_NAVY)
        c.alignment = Alignment(horizontal="center", vertical="center")

    # Row 4: column headers
    for c_idx, col_name in enumerate(["ID", "Student"] + item_cols, start=1):
        cell = ws.cell(row=4, column=c_idx)
        cell.value = col_name
        cell.font = _BOLD_BODY
        cell.fill = _fill(_LIGHT_GREY)
        cell.alignment = Alignment(horizontal="center", vertical="center")
        cell.border = _thin_border()

    # Data rows
    DATA_START = 5
    for r_idx, (_, row) in enumerate(display.iterrows(), start=DATA_START):
        is_alt = (r_idx % 2 == 0)
        row_bg = _fill(_LIGHT_GREY) if is_alt else _fill(_WHITE)
        # Student ID
        cid = ws.cell(row=r_idx, column=1, value=row["student_number"])
        cid.font = _BODY_FONT; cid.fill = row_bg; cid.border = _thin_border()
        cid.alignment = Alignment(horizontal="center", vertical="center")
        # Student name
        c = ws.cell(row=r_idx, column=2, value=row["student_name"])
        c.font = _BODY_FONT; c.fill = row_bg; c.border = _thin_border()
        c.alignment = Alignment(horizontal="left", vertical="center")
        # Item counts with colour coding vs cohort avg
        for i, ic in enumerate(item_cols):
            val = row[ic]
            avg = stats[ic]["avg"]
            cell = ws.cell(row=r_idx, column=i + ITEM_START, value=val)
            cell.border = _thin_border()
            cell.alignment = Alignment(horizontal="center", vertical="center")
            if avg > 0:
                if val < avg * 0.5:
                    cell.fill = _fill(_RED_BG)
                    cell.font = Font(name="Arial", size=9, color=_RED_TEXT, bold=True)
                elif val < avg * 0.8:
                    cell.fill = _fill(_AMBER_BG)
                    cell.font = Font(name="Arial", size=9, color=_AMBER_TEXT)
                else:
                    cell.fill = row_bg
                    cell.font = _BODY_FONT
            else:
                cell.fill = row_bg
                cell.font = _BODY_FONT

    # Stats footer (Avg / Min / Max)
    FOOTER_START = DATA_START + n_students
    for label_idx, (stat_label, stat_key) in enumerate([
        ("Cohort Avg", "avg"), ("Cohort Min", "min"), ("Cohort Max", "max")
    ]):
        r = FOOTER_START + label_idx
        # Label spans the ID + Student columns
        ws.merge_cells(start_row=r, start_column=1, end_row=r, end_column=N_ID)
        c = ws.cell(row=r, column=1, value=stat_label)
        c.font = Font(name="Arial", bold=True, size=9, color=_WHITE)
        c.fill = _fill(_NAVY)
        c.border = _thin_border()
        c.alignment = Alignment(horizontal="center", vertical="center")
        ws.cell(row=r, column=2).fill = _fill(_NAVY)
        ws.cell(row=r, column=2).border = _thin_border()
        for i, ic in enumerate(item_cols):
            val = stats[ic][stat_key]
            cell = ws.cell(row=r, column=i + ITEM_START, value=val)
            cell.font = Font(name="Arial", bold=True, size=9, color=_WHITE)
            cell.fill = _fill(_NAVY)
            cell.border = _thin_border()
            cell.alignment = Alignment(horizontal="center", vertical="center")

    # Column widths
    ws.column_dimensions["A"].width = 12   # ID
    ws.column_dimensions["B"].width = 22   # Student
    for i in range(len(item_cols)):
        ws.column_dimensions[get_column_letter(i + ITEM_START)].width = 7
    ws.freeze_panes = "C5"


# ── Sheet builder 2: item scale distribution ───────────────────────────────
def _build_item_scale_dist_sheet(writer, flagDf, compDf, cohortDf, thresholds,
                                  cohort, formType, config, mappingFile=None):
    """Item × scale (O1-O6) count table for entire cohort."""
    reportableItems = getattr(config, "reportableItems", None) or DDS3_REPORTABLE_ITEMS
    distDf = _buildItemScaleDist(cohortDf, reportableItems)
    if distDf.empty:
        return

    COLS = ["Category", "Item Code"] + _SCALE_LABELS + ["Avg Score"]
    for col in COLS:
        if col not in distDf.columns:
            distDf[col] = 0

    distDf[COLS].to_excel(writer, sheet_name="Item Scale Distribution",
                           index=False, startrow=2)
    ws = writer.sheets["Item Scale Distribution"]

    N_COLS = len(COLS)
    _styleHeader(ws, 1, N_COLS,
                 f"{cohort} {formType} — Item Scale Response Distribution (Cohort)")
    _styleColumnHeaders(ws, 3, COLS, {c: c for c in COLS})

    # Colour code: more red = worse (Not Done / Sometimes); more green = Done Well
    col_color = {
        "Done Well":    (_GREEN_BG, _GREEN_TEXT),
        "Done":         (_GREEN_BG, _GREEN_TEXT),
        "Mostly":       (_AMBER_BG, _AMBER_TEXT),
        "Sometimes":    (_RED_BG,   _RED_TEXT),
        "Not Done":     (_RED_BG,   _RED_TEXT),
        "Not Observed": (_LIGHT_GREY, _MID_GREY),
    }

    for r_idx, (_, row) in enumerate(distDf.iterrows(), start=4):
        is_alt = (r_idx % 2 == 0)
        for c_idx, col in enumerate(COLS, start=1):
            cell = ws.cell(row=r_idx, column=c_idx, value=row[col])
            cell.border = _thin_border()
            cell.alignment = Alignment(horizontal="center", vertical="center")
            if col in col_color and pd.notna(row[col]) and row[col] > 0:
                bg, txt = col_color[col]
                cell.fill = _fill(bg)
                cell.font = Font(name="Arial", size=9, color=txt)
            else:
                cell.fill = _fill(_LIGHT_GREY if is_alt else _WHITE)
                cell.font = _BODY_FONT

        # Category and Item Code — left-align
        ws.cell(row=r_idx, column=1).alignment = Alignment(horizontal="left", vertical="center")
        ws.cell(row=r_idx, column=2).alignment = Alignment(horizontal="left", vertical="center")

    ws.column_dimensions["A"].width = 16
    ws.column_dimensions["B"].width = 10
    for i in range(2, N_COLS + 1):
        ws.column_dimensions[get_column_letter(i + 1)].width = 13
    ws.freeze_panes = "C4"


# ── Sheet builder 3: operator/FTA by clinic ────────────────────────────────
def _build_operator_by_clinic_sheet(writer, flagDf, compDf, cohortDf, thresholds,
                                     cohort, formType, config, mappingFile=None):
    """Per-student operator/support/FTA session counts broken down by clinic."""
    if "clinic" not in cohortDf.columns:
        return

    df = cohortDf[["student_number", "student_name", "clinic",
                    "role", "patient_details"]].copy()
    df["clinic"] = df["clinic"].fillna("Unknown")
    df["role"]   = df["role"].map(normalizeRole)   # fold v3 codes (O/SO/OB) to labels

    def _is_fta(pd_val):
        return "FTA" in str(pd_val).upper()

    records = []
    for (snum, sname, clinic), grp in df.groupby(
            ["student_number", "student_name", "clinic"]):
        role_counts = grp["role"].fillna("Unknown").value_counts()
        records.append({
            "student_number": snum,
            "student_name":   sname,
            "clinic":         clinic,
            "Operator":       int(role_counts.get("Operator", 0)),
            "Support":        int(role_counts.get("Support Operator", 0)),
            "FTA":            int(grp["patient_details"].apply(_is_fta).sum()),
            "Total":          len(grp),
        })

    if not records:
        return

    detailDf = pd.DataFrame(records)

    # Cohort averages per clinic
    clinic_avg = detailDf.groupby("clinic")[
        ["Operator", "Support", "FTA", "Total"]
    ].mean().round(1).reset_index()
    clinic_avg.insert(0, "student_name", "Cohort Avg")
    clinic_avg.insert(0, "student_number", -1)

    DISPLAY_COLS = ["student_name", "clinic", "Operator", "Support", "FTA", "Total"]
    FRIENDLY = {
        "student_name": "Student", "clinic": "Clinic",
        "Operator": "Operator", "Support": "Support",
        "FTA": "FTA", "Total": "Total Forms",
    }

    detailDf[DISPLAY_COLS].to_excel(writer, sheet_name="Operator by Clinic",
                                     index=False, startrow=2)
    ws = writer.sheets["Operator by Clinic"]
    N_COLS = len(DISPLAY_COLS)

    _styleHeader(ws, 1, N_COLS,
                 f"{cohort} {formType} — Operator / FTA Sessions by Clinic")
    _styleColumnHeaders(ws, 3, DISPLAY_COLS, FRIENDLY)

    # Compute cohort avg per clinic for colour reference
    cohort_avg_map = clinic_avg.set_index("clinic")[["Operator", "FTA"]].to_dict("index")

    DATA_START = 4
    for r_idx, (_, row) in enumerate(detailDf.iterrows(), start=DATA_START):
        is_alt = (r_idx % 2 == 0)
        row_bg = _fill(_LIGHT_GREY) if is_alt else _fill(_WHITE)
        for c_idx, col in enumerate(DISPLAY_COLS, start=1):
            cell = ws.cell(row=r_idx, column=c_idx, value=row[col])
            cell.font = _BODY_FONT
            cell.border = _thin_border()
            cell.alignment = Alignment(
                horizontal="left" if col in ("student_name", "clinic") else "center",
                vertical="center",
            )
            cell.fill = row_bg

        # Colour code Operator and FTA vs cohort avg for that clinic
        clinic_val = row["clinic"]
        avgs = cohort_avg_map.get(clinic_val, {})
        for col, avg_val in [("Operator", avgs.get("Operator", 0)),
                              ("FTA",      avgs.get("FTA", 0))]:
            col_idx = DISPLAY_COLS.index(col) + 1
            cell = ws.cell(row=r_idx, column=col_idx)
            val = row[col]
            if avg_val > 0:
                if col == "FTA":  # high FTA = bad
                    if val > avg_val * 1.5:
                        cell.fill = _fill(_RED_BG)



