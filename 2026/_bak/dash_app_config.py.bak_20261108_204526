# ── Scoring profiles ─────────────────────────────────────────────────────────
# points:   "labelMap" = points by the answer's option LABEL (fallback: by slot)
#           "levels"   = rank among the item's enabled rubric options, scheme by level count (LEVEL_SCHEMES)
#           "slot"     = linear by slot (best enabled = n-1 … worst = 0)
# unansweredAsZero: True = unanswered item scores 0 but stays in the max; False = left out of score and max
# sectionPct: "pooled" (Σpoints ÷ Σmax) | "itemMean" (mean of item point/max)
# overall:  "raw"      = Σpoints ÷ Σmax over the whole form
#           "item"     = mean of item point/max over the whole form
#           "sections" = Σ weight × section % (weights by section short label; None = equal);
#                        missingAsZero: a section with no score counts 0% and keeps its weight
#           "groups"   = groups of sections (by name regex), each with its own % method, then weighted
LABEL5 = {"done well": 4, "done": 3, "mostly done": 2, "sometimes done": 1, "not done": 0}
LEVEL_SCHEMES = {2: [0, 1], 3: [0, 1, 2], 4: [0, 2, 3, 4], 5: [0, 1, 2, 3, 4]}   # worst → best

