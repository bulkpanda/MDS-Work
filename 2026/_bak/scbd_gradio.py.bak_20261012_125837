def _sectionLabels(meta, mc_sorted):    # per-MC section title from checklist headers
    hdrs   = (meta.get("extra_config") or {}).get("headers") or {}
    starts = {k: (v[0].get("title") if isinstance(v, list) and v else "") for k, v in hdrs.items()}
    out, cur = [], "Checklist"
    for mc in mc_sorted:
        if mc in starts:
            cur = (starts[mc] or "").strip() or cur
        out.append(cur)
    return out

def buildCombinedSheet(wb, rows):       # overview of every record (MC columns can't align across types)
    ws = wb.create_sheet("All Records")
    cols = ["Date","Student","Assessor","Cohort","Subject","Checklist","GR",
            "Submitted","Critical concerns","General comments"]
