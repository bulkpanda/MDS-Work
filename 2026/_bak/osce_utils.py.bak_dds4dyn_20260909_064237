# ───────────────────────── pure support functions ─────────────────────────
def isTestStudent(name):
    """True for test/dummy/model placeholder students (excluded from analysis)."""
    n = (name or "").lower()
    return any(t in n for t in ["dummy", "model", "test"])


def loadRoster(rosterPath):
    """Return {studentNumber(str): studentName} from the roster CSV (student_number, student_name)."""
    roster = {}
    if rosterPath and os.path.exists(rosterPath):
        with open(rosterPath, newline="", encoding="utf-8-sig") as fh:
            for row in csv.DictReader(fh):
                num = (row.get("student_number") or "").strip()
                nm = (row.get("student_name") or "").strip()
                if num:
                    roster[num] = nm
    return roster


def resolveIgnoreNames(ignoreNumbers, rosterPath):
    """Map a set of student numbers to lower-cased student names via the roster."""
    roster = loadRoster(rosterPath)
    names = set()
    for num in (ignoreNumbers or set()):
        nm = roster.get(str(num).strip())
        if nm:
            names.add(nm.strip().lower())
    return names


def loadOsceRecords(srcPath, ignoreStudentNumbers=None, rosterPath="studentEmailList.csv"):
    """Load OSCE JSON; keep submitted, real students, minus any ignored-by-number students."""
    with open(srcPath, encoding="utf-8") as fh:
        data = json.load(fh)
    ignoreNames = resolveIgnoreNames(
        IGNORE_STUDENT_NUMBERS if ignoreStudentNumbers is None else ignoreStudentNumbers, rosterPath)
    out = []
    for r in data:
        if not r.get("submitted"):
            continue
        nm = r.get("student")
        if isTestStudent(nm) or (nm or "").strip().lower() in ignoreNames:
            continue
        out.append(r)
    return out


def checklistScale(cfg, usedLabels):
    """
    Decide a checklist's scoring scale. Returns (pointMap, maxPerItem, levelCount).
    4-level if the rubric defines 4 distinct O-keys OR 'Borderline' is used; else 3-level.
    """
    okeys = set()
    for mk, rub in (cfg.get("extra_config", {}) or {}).get("rubric", {}).items():
        for k in rub:
            if k != "label" and str(k).startswith("O"):
                okeys.add(k)
    fourLevel = (len(okeys) >= 4) or ("Borderline" in usedLabels)
    if fourLevel:
        return POINTS_4LEVEL, MAXPTS[4], 4
    return POINTS_3LEVEL, MAXPTS[3], 3


def buildStationSpecs(records):
    """
    Group records by (station, checklist) actually filled, tidy each into rows, and attach
    the per-checklist scoring scale. GR is reversed to the standard 5..1 direction.
    Returns list of dicts: {st, ck, cfg, rows, pointMap, maxPerItem, levels}.
    """
    groups = OrderedDict()
    for r in records:
        for ck, cv in r["form_data"].get("checklists", {}).items():
            if cv:
                groups.setdefault((r["station"], ck), []).append(r)

    specs = []
    for (st, ck), recs in sorted(groups.items()):
        cfg = recs[0]["form_config"]["checklists"][ck]
        usedLabels = set()
        for r in recs:
            for mv in r["form_data"]["checklists"][ck].values():
                if isinstance(mv, dict) and mv.get("value"):
                    usedLabels.add(mv["value"])
        pointMap, maxPerItem, levels = checklistScale(cfg, usedLabels)

        rows = []
        for r in recs:
            cv = r["form_data"]["checklists"][ck]
            labels, points = {}, {}
            for i in range(1, 11):
                c = cv.get(f"MC{i}")
                lab = c["value"] if isinstance(c, dict) and c.get("value") in pointMap else None
                labels[i] = lab
                points[i] = pointMap[lab] if lab is not None else None
            got = [points[i] for i in range(1, 11) if points[i] is not None]
            gk = r["form_data"].get("scales", {}).get("global-rating", {}).get("key")
            rows.append({
                "circuit": r["circuit"], "student": r["student"], "assessor": r["assessor"],
                "gr": (6 - int(gk)) if str(gk).isdigit() else None,
                "labels": labels, "points": points,
                "score": (sum(got) / (len(got) * maxPerItem)) if got else None,   # fraction 0..1
                "feedback": r["form_data"].get("texts", {}).get("feedback-on-student-performance", "") or "",
                "blfail": r["form_data"].get("texts", {}).get(
                    "if-you-have-awarded-a-global-rating-of-borderline-or-fail-please-provide-additional-information", "") or "",
                "optComments": r["form_data"].get("texts", {}).get("comments-on-the-osce", "") or "",
            })
        specs.append({"st": st, "ck": ck, "cfg": cfg, "rows": rows,
                      "pointMap": pointMap, "maxPerItem": maxPerItem, "levels": levels})
    return specs


def computeBlr(rows, borderlineGr=2):
    """Borderline-Regression on the score fraction: cut = predicted score at the borderline grade."""
    grs = np.array([r["gr"] for r in rows if r["gr"] is not None and r["score"] is not None])
    scs = np.array([r["score"] for r in rows if r["gr"] is not None and r["score"] is not None])
    slope, intercept, rval, pval, se = stats.linregress(grs, scs)
    cut = slope * borderlineGr + intercept
    m = float(scs.mean()) if len(scs) else float("nan")
    sd = float(scs.std(ddof=1)) if len(scs) > 1 else 0.0
    return dict(slope=slope, intercept=intercept, r2=rval ** 2, p=pval,
                cut=cut, cutPct=round(cut * 100, 1), grs=grs, scs=scs,
                mean=m, sd=sd, mean2sd=m - 2 * sd, mean2sdPct=round((m - 2 * sd) * 100, 1))


def pct1(x):
    """Score fraction -> percentage rounded to 1 dp (canonical for pass/fail comparisons)."""
    return round(x * 100, 1)


def gradientHex(t):
    """t in [0,1] -> hex on a red->yellow->green scale (Excel-style)."""
    t = max(0.0, min(1.0, t))
    stops = [(0.0, (248, 105, 107)), (0.5, (255, 235, 132)), (1.0, (99, 190, 123))]
    for i in range(len(stops) - 1):
        t0, c0 = stops[i]; t1, c1 = stops[i + 1]
        if t <= t1:
            f = (t - t0) / (t1 - t0) if t1 > t0 else 0.0
            return "%02X%02X%02X" % tuple(round(c0[k] + (c1[k] - c0[k]) * f) for k in range(3))
    return "%02X%02X%02X" % stops[-1][1]


def countBelow(scs, cutFrac):
    """Number of scores strictly below the 1-dp-rounded cut."""
    cp = round(cutFrac * 100, 1)
    return int(sum(1 for x in scs if round(x * 100, 1) < cp))


def cronbachAlpha(rows):
    """Cronbach's alpha over the 10 checklist items (using the stored integer points)."""
    M = np.array([[r["points"][i] for i in range(1, 11)]
                  for r in rows if all(r["points"][i] is not None for i in range(1, 11))], float)
    k = M.shape[1]
    if k <= 1:
        return float("nan")
    itemVar = M.var(axis=0, ddof=1).sum()
    totalVar = M.sum(axis=1).var(ddof=1)
    return (k / (k - 1)) * (1 - itemVar / totalVar) if totalVar > 0 else float("nan")


def itemTotalCorrs(rows):
    """Item-total correlation (discrimination) for each of the 10 items, on integer points."""
    items = list(range(1, 11))
    tot = np.array([np.mean([r["points"][j] for j in items if r["points"][j] is not None]) for r in rows])
    out = []
    for i in items:
        v = np.array([r["points"][i] if r["points"][i] is not None else np.nan for r in rows], float)
        out.append(np.corrcoef(v, tot)[0, 1] if np.nanstd(v) > 0 else np.nan)
    return out


def alphaInterpretation(a):
    if a != a:
        return "-"
    if a >= 0.9:
        return "Excellent"
    if a >= 0.8:
        return "Good"
    if a >= 0.7:
        return "Acceptable"
    if a >= 0.6:
        return "Questionable"
    return "Poor"


def difficultyBand(fracMean):
    return "Easy" if fracMean >= 0.8 else ("Hard" if fracMean < 0.6 else "Moderate")


