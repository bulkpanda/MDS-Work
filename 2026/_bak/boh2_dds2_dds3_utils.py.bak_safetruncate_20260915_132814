            "Clinic Global Rating Pivot": clinicGlobalRatingPivot,
            "Clinic Entrustment Pivot": clinicEntrustmentPivot,
            "Clinic Item Code": mergedDf,
        })
    saveToExcel(filepathPivot, sheetDataPivot)

    sheetDataSubmission = {}
