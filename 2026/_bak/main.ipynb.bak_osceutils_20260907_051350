   "source": [
    "sql = f\"\"\"\n",
    "SELECT DISTINCT (student_number), student_name, student_email from rawform_forms\n",
    "WHERE cohort = 'BOH1'\n",
    "AND datetimeutc >= '2026-01-01'\n",
    "\"\"\"\n",
    "emailDf = pd.read_sql(sql, engine)\n",
    "display(emailDf)\n",
    "nameEmailDict = dict(zip(emailDf['student_name'], emailDf['student_email']))\n",
    "for name, email in nameEmailDict.items():\n",
    "    print(f\"{name}: {email}\")\n",
    "    file = f\"{name}.pdf\"\n",
    "    send_email(email, file, subject=\"BOH1 OSCE Report\", body=f\"Dear {name},\\n\\nPlease find attached your BOH1 test OSCE report.\\n\\nBest regards,\\nAssessment Team\",\n",
    "               savefolder = \"OSCE/BOH1/Student Reports\")"
   ]
  },
