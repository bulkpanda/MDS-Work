"""
writtenexam_utils.py
─────────────────────────────────────────────────────────────────────────────
Helper functions to generate individual student PDF feedback reports from a
per-student score spreadsheet. Supports two source layouts, auto-detected:

  "paired"  - one row per student; a name/id column, then repeating
              (RawScore, Percentage[.N]) column pairs per section, ending in
              a final (Total, Percentage[.N]) pair. Optional trailing summary
              rows ("Marks available" / "Class average" / "Class average
              percent"). Example: Extra/DDS2/Results to release to students.xlsx
              (DDS2 written exam).

  "rubric"  - one row per student; criteria columns scored out of a fixed
              max (declared via an "Out of N" sub-header row), ending in a
              Total and a Percentage column. May span a 2-row header (a
              group label row + a field-name/"Out of N" row), and may include
              a free-text Comments column and a Supervisor column.
              Example: Extra/DDS3/research progress summary Raed.xlsx
              (DDS3 research progress rubric).

The loader auto-detects which layout a workbook uses and extracts sections,
max points, name/id columns, comments and supervisor columns accordingly.
Cohort averages are read from an existing "Class average" row when present,
otherwise computed as a plain mean across student rows; display of the
cohort-average column/row is controlled by `show_cohort_avg` (some rubric
sheets are graded by different supervisors per group, so a single cohort
average isn't a fair comparison and can be turned off).

Visual style matches the existing DDS4 written-exam template:
  Extra/DDS4/DENT90124_WrittenExam_Feedback/*.pdf
(navy header banner, section performance table, grade-coloured overall-result
box — green for high grades through orange to red for low grades).

Reusable across cohorts/years/assessment types — call
generate_all_written_exam_reports() with a different input_file / output_dir
/ course_code / exam_title (and, for rubric-style sheets, id_col and
show_cohort_avg=False) each time.

Used from main.ipynb, e.g.:

    import writtenexam_utils as wxu

    # DDS2 written exam (paired score/percentage columns)
    wxu.generate_all_written_exam_reports(
        input_file="Extra/DDS2/Results to release to students.xlsx",
        output_dir="Extra/DDS2/Student Reports",
        course_code="DENT90146",
        exam_title="Mid-Year Examination 2026",
    )

    # DDS3 research progress rubric (single-score "Out of N" columns,
    # comments, no numeric student ID, no fair cohort average)
    wxu.generate_all_written_exam_reports(
        input_file="Extra/DDS3/research progress summary Raed.xlsx",
        output_dir="Extra/DDS3/Student Reports",
        course_code="DDS3",
        exam_title="Research Progress Summary 2026",
        id_col="DDS3 year now",           # group code column, e.g. DDS2-Grp-01-A
        section_bar_label="Research Progress Summary",
        show_cohort_avg=False,
    )
"""

import os
import re
from html import escape as _xmlEscape
import pandas as pd

from reportlab.lib.pagesizes import A4
from reportlab.lib import colors
from reportlab.lib.units import cm
from reportlab.lib.styles import ParagraphStyle
from reportlab.lib.enums import TA_LEFT, TA_CENTER, TA_JUSTIFY
from reportlab.platypus import (
    SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle,
)

# ── House palette (sampled directly from the DDS4 written-exam PDF) ────────
NAVY          = colors.HexColor("#003087")
ORANGE        = colors.HexColor("#F57F17")
ROW_ALT       = colors.HexColor("#F4F4F4")
ROW_WHITE     = colors.white
TOTAL_BG      = colors.HexColor("#E8EFF7")
SUBTITLE_BLUE = colors.HexColor("#AEC6E8")
TEXT_DARK     = colors.HexColor("#222222")
GREY_LINE     = colors.HexColor("#C3D5E8")

PAGE_W, PAGE_H = A4
MARGIN    = 1.8 * cm
CONTENT_W = PAGE_W - 2 * MARGIN

# ── Default grade bands (University of Melbourne honours scale) ────────────
# Applied to the *unrounded* overall percentage.
# Confirmed by reverse-engineering the DDS4 sample report: 76/109 = 69.72%
# displays as grade "H3" (65-69% band) even though the rounded "70%" shown
# in the table would sit on the H2B boundary — so banding must use the
# unrounded value.
# Override per cohort by passing a different `grade_bands` list.
DEFAULT_GRADE_BANDS = [
    (80.0, "H1"),
    (75.0, "H2A"),
    (70.0, "H2B"),
    (65.0, "H3"),
    (50.0, "P"),
    (0.0,  "N"),
]

# ── Overall-result box colour, keyed by grade label ─────────────────────────
# Green (best) -> yellow-green -> gold -> orange (middle) -> deep orange ->
# red (worst) — six visually distinct stops rather than shades of one colour.
# H3 and P are sampled directly from the DDS4 template's PDFs (each grade has
# one fixed colour across the cohort, not a per-student gradient by %); the
# others are spread out further along the same hue progression so the top
# three bands no longer all read as "green".
# Override per cohort by passing a different `grade_colors` dict to
# generate_student_pdf() / generate_all_written_exam_reports().
DEFAULT_GRADE_COLORS = {
    "H1":  "#1B5E20",   # dark green
    "H2A": "#7CB342",   # yellow-green
    "H2B": "#FBC02D",   # gold / yellow
    "H3":  "#F57F17",   # orange (middle of the scale)
    "P":   "#E65100",   # deep orange
    "N":   "#C62828",   # red
}
FALLBACK_GRADE_COLOR = "#F57F17"


def grade_color(grade, grade_colors=DEFAULT_GRADE_COLORS):
    """Look up the result-box colour for a grade label, with an orange fallback."""
    hex_code = grade_colors.get(grade, FALLBACK_GRADE_COLOR) if grade else FALLBACK_GRADE_COLOR
    return colors.HexColor(hex_code)


SUMMARY_ROW_LABELS = {
    "marks available", "class average", "class average percent",
    "cohort average", "average", "cohort average percent",
}

TITLE_PREFIX_RE = re.compile(r'^(mr|mrs|ms|miss|mx|dr|prof)\.?\s+', re.IGNORECASE)
OUT_OF_RE = re.compile(r'out of\s+([\d.]+)', re.IGNORECASE)


# ═══════════════════════════════════════════════════════════════════════════
# Data loading
# ═══════════════════════════════════════════════════════════════════════════
def _dedupe_columns(header):
    """
    Rename repeated header labels the same way pandas does when it parses a
    header row itself (name, name.1, name.2, ...). Needed here because we
    build headers manually from raw cell text, which - unlike
    pd.read_excel(header=0) - doesn't auto-dedupe repeated literal labels
    (e.g. a sheet with the column header "Percentage" typed out seven times).
    Without this, label-based lookups on a repeated name return a DataFrame
    instead of a Series and break downstream code.
    """
    seen = {}
    out = []
    for h in header:
        if h not in seen:
            seen[h] = 0
            out.append(h)
        else:
            seen[h] += 1
            out.append(f"{h}.{seen[h]}")
    return out


def _find_col(columns, keywords):
    for c in columns:
        cl = str(c).lower()
        if any(k in cl for k in keywords):
            return c
    return None


def _clean_section_name(raw):
    name = str(raw).strip()
    name = re.sub(r"\s+", " ", name)
    name = re.sub(r"\s+score$", "", name, flags=re.IGNORECASE)
    return name


def compute_grade(pct, grade_bands=DEFAULT_GRADE_BANDS):
    """Map an overall percentage (0-100, unrounded) to a grade label."""
    if pct is None or pd.isna(pct):
        return None
    for threshold, label in sorted(grade_bands, key=lambda x: -x[0]):
        if pct >= threshold:
            return label
    return sorted(grade_bands, key=lambda x: x[0])[0][1]


def _is_numeric_series(s, min_frac=0.6):
    """True if a good fraction of the non-null values in s are numbers."""
    non_null = s.dropna()
    if len(non_null) == 0:
        return False
    numeric_count = sum(
        1 for v in non_null
        if isinstance(v, (int, float)) and not isinstance(v, bool)
    )
    return (numeric_count / len(non_null)) >= min_frac


def _detect_header(raw):
    """
    raw: DataFrame read with header=None (no assumptions about header shape).

    Returns (header_labels, sub_header_labels, data_start_row):
      header_labels     - list of column names to use (anchor row, filled in
                           from the sub-header row where the anchor is blank)
      sub_header_labels  - the raw sub-header row values (e.g. "Out of 5"),
                           or None if there wasn't a second header row.
                           Positions align with header_labels.
      data_start_row     - first row index (into `raw`) containing real data.

    Anchor row = first of the first 6 rows containing a cell that reads
    exactly "total" (case-insensitive). If the row immediately below looks
    like more header labels (mostly text, not scores) rather than a real
    data row, it's treated as a second header row and merged in.
    Falls back to "row 0 is the header, data starts at row 1" (the original
    single-row-header assumption) if no "total" cell is found at all.
    """
    anchor = None
    for i in range(min(6, len(raw))):
        row = raw.iloc[i]
        if any(pd.notna(v) and str(v).strip().lower() == "total" for v in row):
            anchor = i
            break

    if anchor is None:
        header = [str(v).strip() if pd.notna(v) else None for v in raw.iloc[0]]
        header = [h if h else f"col_{i}" for i, h in enumerate(header)]
        return header, None, 1

    header = [str(v).strip() if pd.notna(v) else None for v in raw.iloc[anchor]]
    sub_header = None
    data_start = anchor + 1

    if anchor + 1 < len(raw):
        nxt = raw.iloc[anchor + 1]
        text_like = sum(1 for v in nxt if pd.notna(v) and isinstance(v, str))
        numeric_like = sum(1 for v in nxt if pd.notna(v) and isinstance(v, (int, float)))
        if text_like > 0 and text_like >= numeric_like:
            sub_header = [str(v).strip() if pd.notna(v) else None for v in nxt]
            header = [h if h else s for h, s in zip(header, sub_header)]
            data_start = anchor + 2

    header = [h if h else f"col_{i}" for i, h in enumerate(header)]
    return header, sub_header, data_start


def _resolve_name_column(df, name_col=None):
    """
    Return (name_col, df) where df[name_col] holds a clean display name.

    Tries, in order: an explicit override; a direct "name" column (DDS2-style);
    synthesizing "{Preferred name} {Last name}"; stripping a title prefix
    ("Mr "/"Ms "/...) off a "Legal name" column; any column with "name" in
    its header.
    """
    if name_col:
        return name_col, df

    cols = list(df.columns)
    lower = {c: str(c).strip().lower() for c in cols}

    preferred = next((c for c in cols if lower[c] == "preferred name"), None)
    last = next((c for c in cols if lower[c] == "last name"), None)
    if preferred and last:
        df = df.copy()
        df["__display_name__"] = (
            df[preferred].astype(str).str.strip() + " " + df[last].astype(str).str.strip()
        )
        return "__display_name__", df

    legal = next((c for c in cols if "legal name" in lower[c]), None)
    if legal:
        df = df.copy()
        df["__display_name__"] = df[legal].astype(str).str.replace(TITLE_PREFIX_RE, "", regex=True).str.strip()
        return "__display_name__", df

    found = _find_col(df.columns, ["name"])
    if found:
        return found, df

    raise ValueError(
        "Could not auto-detect a name column - pass name_col= explicitly. "
        f"Columns found: {list(df.columns)}"
    )


def load_written_exam_results(input_file, sheet_name=0, name_col=None, id_col=None,
                               comments_col=None, supervisor_col=None):
    """
    Load a per-student score workbook, auto-detecting whether it uses the
    "paired" (score, percentage) column layout or the "rubric" (single score
    out of a fixed max, no per-criterion percentage) layout — see module
    docstring for details of each.

    Returns a dict with:
      students        - DataFrame, one row per real student (summary/blank
                         rows dropped)
      sections        - list of {name, score_col, pct_col, max_points}
      total_col, total_pct_col, total_max
      name_col, id_col, comments_col, supervisor_col  (None if not found)
      cohort_avg      - {section_name: mean raw score}, plus "__total__"
      cohort_avg_pct  - {section_name: mean percentage}, plus "__total__"
      mode            - "paired" or "rubric", whichever was detected

    id_col has no reliable auto-detection heuristic for rubric-style sheets
    that have no numeric student ID (e.g. group-work rosters) — pass it
    explicitly in that case (e.g. id_col="DDS3 year now" for the DDS3
    research-progress workbook, which is really a group/section code column
    despite its header text).
    """
    raw = pd.read_excel(input_file, sheet_name=sheet_name, header=None)
    header, sub_header, data_start = _detect_header(raw)
    header = _dedupe_columns(header)

    df = raw.iloc[data_start:].copy()
    df.columns = header
    df = df.reset_index(drop=True)

    name_col, df = _resolve_name_column(df, name_col)
    id_col = id_col or _find_col(df.columns, ["sis_id", "student_id", "student_number", "id"])
    if id_col is None:
        raise ValueError(
            "Could not auto-detect an id column - pass id_col= explicitly "
            "(rubric-style sheets with no numeric student ID need this, e.g. "
            "a group/section code column). "
            f"Columns found: {list(df.columns)}"
        )

    comments_col = comments_col or _find_col(df.columns, ["comment"])
    supervisor_col = supervisor_col or _find_col(df.columns, ["supervisor"])

    total_col = _find_col(df.columns, ["total"])
    if total_col is None:
        raise ValueError("Could not find a 'Total' column.")
    total_idx = list(df.columns).index(total_col)
    total_pct_col = None
    for j in range(total_idx + 1, min(total_idx + 3, len(df.columns))):
        if "percent" in str(df.columns[j]).lower():
            total_pct_col = df.columns[j]
            break

    sub_header_by_col = dict(zip(header, sub_header)) if sub_header else {}

    # A "Marks available" row (if present) gives exact per-section max points.
    marks_row = None
    for _, r in df.iterrows():
        if str(r[name_col]).strip().lower() == "marks available":
            marks_row = r
            break

    id_idx = list(df.columns).index(id_col)
    candidate_cols = list(df.columns)[id_idx + 1: total_idx]

    # --- Try "paired" mode first: consecutive (score, "Percentage...") pairs.
    sections = []
    i = 0
    while i < len(candidate_cols) - 1:
        score_col, pct_col = candidate_cols[i], candidate_cols[i + 1]
        if str(pct_col).lower().startswith("percentage"):
            if marks_row is not None and pd.notna(marks_row.get(score_col)):
                max_points = float(marks_row[score_col])
            else:
                ratios = (df[score_col] / (df[pct_col] / 100.0)).replace([float("inf")], pd.NA).dropna()
                max_points = round(float(ratios.mode().iloc[0]), 2) if not ratios.empty else None
            sections.append({
                "name": _clean_section_name(score_col),
                "score_col": score_col,
                "pct_col": pct_col,
                "max_points": max_points,
            })
            i += 2
        else:
            i += 1
    mode = "paired"

    # --- Fall back to "rubric" mode: single numeric score columns, max
    # points declared via an "Out of N" sub-header.
    if not sections:
        mode = "rubric"
        skip = {c for c in (comments_col, supervisor_col) if c}
        for col in candidate_cols:
            if col in skip:
                continue
            if not _is_numeric_series(df[col]):
                continue
            max_points = None
            sub_text = sub_header_by_col.get(col)
            if sub_text:
                m = OUT_OF_RE.search(sub_text)
                if m:
                    max_points = float(m.group(1))
            if max_points is None:
                # last resort: use the largest observed score, rounded up
                obs_max = pd.to_numeric(df[col], errors="coerce").max()
                max_points = float(obs_max) if pd.notna(obs_max) else None
            sections.append({
                "name": _clean_section_name(col),
                "score_col": col,
                "pct_col": None,
                "max_points": max_points,
            })

    # --- Total max points.
    total_sub = sub_header_by_col.get(total_col)
    total_max = None
    if total_sub:
        m = OUT_OF_RE.search(total_sub)
        if m:
            total_max = float(m.group(1))
    if total_max is None:
        if marks_row is not None and pd.notna(marks_row.get(total_col)):
            total_max = float(marks_row[total_col])
        elif total_pct_col is not None:
            ratios = (df[total_col] / (df[total_pct_col] / 100.0)).replace([float("inf")], pd.NA).dropna()
            total_max = round(float(ratios.mode().iloc[0]), 2) if not ratios.empty else None
        else:
            total_max = sum(s["max_points"] for s in sections if s["max_points"]) or None

    students = df[df[id_col].notna()].copy()
    students = students[~students[name_col].astype(str).str.strip().str.lower().isin(SUMMARY_ROW_LABELS)]
    students = students.reset_index(drop=True)

    cohort_avg = {s["name"]: pd.to_numeric(students[s["score_col"]], errors="coerce").mean() for s in sections}
    cohort_avg["__total__"] = pd.to_numeric(students[total_col], errors="coerce").mean()
    if total_pct_col:
        cohort_avg_pct = {s["name"]: None for s in sections}
        cohort_avg_pct["__total__"] = pd.to_numeric(students[total_pct_col], errors="coerce").mean()
    else:
        cohort_avg_pct = {"__total__": (cohort_avg["__total__"] / total_max * 100) if total_max else None}

    return {
        "students": students,
        "sections": sections,
        "total_col": total_col,
        "total_pct_col": total_pct_col,
        "total_max": total_max,
        "name_col": name_col,
        "id_col": id_col,
        "comments_col": comments_col,
        "supervisor_col": supervisor_col,
        "cohort_avg": cohort_avg,
        "cohort_avg_pct": cohort_avg_pct,
        "mode": mode,
    }


