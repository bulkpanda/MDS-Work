    leg = [("BBFFD9", "Full marks / ≥ 99%"), ("BFDBFE", "≥ 70%"), ("A5F3FC", "45–69%"), ("FEF08A", "> 0 and < 45%"),
           ("FECACA", "0 / critical concern / not submitted"), ("FEF3C7", "Section not in this form"),
           ("FED7AA", "Submitted but incomplete / borderline GR")]
