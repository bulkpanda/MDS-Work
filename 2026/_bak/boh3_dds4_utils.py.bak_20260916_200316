  FROM (
    SELECT e->>'value' AS v
    FROM jsonb_array_elements(COALESCE(b.assessor_data->'multi-select'->'weakness-other','[]'::jsonb)) e
    UNION ALL
    SELECT e->>'value' AS v
    FROM jsonb_array_elements(COALESCE(b.assessor_data->'multi-select'->'strengths','[]'::jsonb)) e
    WHERE COALESCE(e->>'key','') = 'Other'
